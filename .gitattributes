# =============================================================================
# .gitattributes - AgoraHub360 ERP
# Normalización de finales de línea y codificación
# =============================================================================

# Detección automática de texto
* text=auto

# C# y Razor → CRLF + UTF-8
*.cs        text eol=crlf working-tree-encoding=UTF-8
*.razor     text eol=crlf working-tree-encoding=UTF-8
*.cshtml    text eol=crlf working-tree-encoding=UTF-8
*.csproj    text eol=crlf
*.sln       text eol=crlf

# Web
*.html      text eol=crlf working-tree-encoding=UTF-8
*.css       text eol=crlf
*.js        text eol=crlf
*.ts        text eol=crlf

# Configuración y datos
*.json      text eol=lf working-tree-encoding=UTF-8
*.xml       text eol=crlf working-tree-encoding=UTF-8
*.sql       text eol=crlf working-tree-encoding=UTF-8
*.md        text eol=lf working-tree-encoding=UTF-8

# Scripts → LF
*.sh        text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf

# Binarios → sin normalización
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
*.nupkg     binary
