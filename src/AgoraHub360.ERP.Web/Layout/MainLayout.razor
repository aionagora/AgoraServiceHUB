@inherits LayoutComponentBase
@using System.Security.Claims
@using AgoraHub360.ERP.Shared.Constants
@inject EmpresaHttpService EmpresaSvc
@inject EmpresaStateService EmpresaState
@inject SesionUsuarioStateService SesionState
@inject UiAuthorizationService UiAuth
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">AgoraHUB360 ERP</MudText>
        <MudSpacer />

        @* ── Sección de usuario en topbar derecha ── *@
        @if (_isAuthenticated)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="topbar-user-area">
                <MudStack Spacing="0" Class="d-none d-md-flex text-end">
                    <MudText Typo="Typo.caption" Style="color:white;">
                        @EmpresaDisplay
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(SucursalDisplay))
                    {
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.75);">
                            @SucursalDisplay
                        </MudText>
                    }
                </MudStack>

                <MudMenu AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Dense="true">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   Class="px-2">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                            <MudStack Spacing="0" Class="ms-2 d-none d-md-flex text-start">
                                <MudText Typo="Typo.body2" Style="color:white; line-height:1.1;">
                                    @UsuarioDisplay
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.75); line-height:1.1;">
                                    @RolDisplay
                                </MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Class="ms-1" />
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudPaper Class="pa-3" Elevation="0" Style="min-width:260px;">
                            <MudText Typo="Typo.subtitle2">@UsuarioDisplay</MudText>
                            @if (!string.IsNullOrWhiteSpace(_userEmail))
                            {
                                <MudText Typo="Typo.caption">@_userEmail</MudText>
                            }
                            <MudText Typo="Typo.caption">@RolDisplay</MudText>
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption">Empresa: @EmpresaDisplay</MudText>
                            @if (!string.IsNullOrWhiteSpace(SucursalDisplay))
                            {
                                <MudText Typo="Typo.caption">Sucursal: @SucursalDisplay</MudText>
                            }
                        </MudPaper>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle" OnClick="@GoToProfile">
                            Mi perfil
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@LogoutAsync">
                            Cerrar sesión
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="color:white;">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />
                No autenticado
            </MudText>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="@DrawerVariant.Responsive"
               Elevation="1"
               ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="agora-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isAuthenticated;
    private bool _isLoaded;
    private string _userName = "";
    private string _userEmail = "";
    private string _userRole = "";
    private string _empresaName = "";
    private string _sucursalName = "";

    private string UsuarioDisplay =>
        !string.IsNullOrWhiteSpace(_userName) ? _userName
        : !string.IsNullOrWhiteSpace(_userEmail) ? _userEmail
        : "Usuario";

    private string EmailDisplay => _userEmail ?? "";
    private string RolDisplay => !string.IsNullOrWhiteSpace(_userRole) ? _userRole : "—";
    private string EmpresaDisplay => !string.IsNullOrWhiteSpace(_empresaName) ? _empresaName : "Empresa no seleccionada";
    private string SucursalDisplay => _sucursalName ?? "";

    protected override async Task OnInitializedAsync()
    {
        SesionState.OnChange += async () =>
        {
            await InvokeAsync(LoadUserData);
            StateHasChanged();
        };

        EmpresaState.OnChange += async () =>
        {
            await InvokeAsync(LoadUserData);
            StateHasChanged();
        };

        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;

            _isAuthenticated = user.Identity?.IsAuthenticated == true;

            if (_isAuthenticated)
            {
                _userName = user.FindFirst(ClaimTypes.Name)?.Value
                            ?? user.FindFirst("name")?.Value
                            ?? user.FindFirst(ClaimTypes.Email)?.Value
                            ?? "";

                _userEmail = user.FindFirst(ClaimTypes.Email)?.Value
                             ?? user.FindFirst("email")?.Value
                             ?? "";

                _userRole = SesionState.PlatformRole != Roles.None
                    ? SesionState.PlatformRole
                    : SesionState.TenantRole;

                var empresa = EmpresaState.EmpresaActiva;
                _empresaName = empresa?.Nombre ?? "";

                var sucursalId = SesionState.SucursalActivaId;
                _sucursalName = sucursalId.HasValue
                    ? $"Sucursal #{sucursalId.Value}"
                    : "";

                _isLoaded = true;
            }
        }
        catch
        {
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void GoToProfile()
    {
        Nav.NavigateTo("/mi-perfil");
    }

    private void GoToCompanyContext()
    {
        Nav.NavigateTo("/cambiar-empresa");
    }

    private async Task LogoutAsync()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        SesionState.OnChange -= async () =>
        {
            await InvokeAsync(LoadUserData);
            StateHasChanged();
        };

        EmpresaState.OnChange -= async () =>
        {
            await InvokeAsync(LoadUserData);
            StateHasChanged();
        };
    }
}
