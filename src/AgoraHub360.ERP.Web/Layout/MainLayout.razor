@inherits LayoutComponentBase
@using System.Security.Claims
@inject EmpresaHttpService EmpresaSvc
@inject EmpresaStateService EmpresaState
@inject SesionUsuarioStateService SesionState
@inject UiAuthorizationService UiAuth
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav
@implements IDisposable

<div class="app-layout @(SidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="sidebar">
        <NavMenu OnToggle="ToggleSidebar" />
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-left">
                <button class="btn-toggle" @onclick="ToggleSidebar" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="breadcrumb-text">AgoraHub360 ERP</span>
            </div>
            <div class="topbar-right">
                <!-- Selector de Empresa (solo se muestra si tiene más de una empresa asignada) -->
                @if (EmpresaState.Empresas.Count > 1)
                {
                    <div class="empresa-selector">
                        <i class="bi bi-building"></i>
                        <select class="empresa-select" @onchange="OnEmpresaChanged" disabled="@_changingEmpresa">
                            @if (EmpresaState.Empresas.Count == 0)
                            {
                                <option>Sin empresas</option>
                            }
                            else
                            {
                                @foreach (var emp in EmpresaState.Empresas.Where(e => e.Activo))
                                {
                                    <option value="@emp.Id" selected="@(emp.Id == EmpresaState.EmpresaActivaId)">
                                        @emp.Nombre
                                    </option>
                                }
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(_empresaError))
                        {
                            <span class="text-danger small ms-2">@_empresaError</span>
                        }
                    </div>
                }

                @if (SesionState.Sucursales.Count > 1)
                {
                    <div class="empresa-selector">
                        <i class="bi bi-shop"></i>
                        <select class="empresa-select" @onchange="OnSucursalChanged">
                            @foreach (var suc in SesionState.Sucursales.Where(x => x.Activo))
                            {
                                <option value="@suc.SucursalId" selected="@(suc.SucursalId == SesionState.SucursalActivaId)">
                                    Sucursal #@suc.SucursalId
                                </option>
                            }
                        </select>
                    </div>
                }
                else if (SesionState.SucursalActivaId.HasValue)
                {
                    <div class="empresa-badge">
                        <i class="bi bi-shop"></i>
                        <span class="empresa-nombre">Sucursal #@SesionState.SucursalActivaId</span>
                    </div>
                }
                else if (EmpresaState.EmpresaActiva != null)
                {
                    <!-- Mostrar nombre de la empresa sin selector si solo tiene una -->
                    <div class="empresa-badge">
                        <i class="bi bi-building"></i>
                        <span class="empresa-nombre">@EmpresaState.EmpresaActiva.Nombre</span>
                    </div>
                }
                
                <!-- Menú de Usuario -->
                <AuthorizeView>
                    <Authorized>
                        <div class="user-menu">
                            <button class="user-menu-toggle" @onclick="ToggleUserMenu">
                                <i class="bi bi-person-circle"></i>
                                <span class="user-name">@context.User.Identity?.Name</span>
                                <i class="bi bi-chevron-down ms-1"></i>
                            </button>
                            
                            @if (_showUserMenu)
                            {
                                <div class="user-dropdown">
                                    <div class="user-dropdown-header">
                                        <div class="user-avatar">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="user-details">
                                            <div class="user-name-full">@context.User.Identity?.Name</div>
                                            <div class="user-email">@GetUserEmail(context.User)</div>
                                        </div>
                                    </div>
                                    <div class="user-dropdown-divider"></div>
                                    <a href="/perfil" class="user-dropdown-item" @onclick="CloseUserMenu">
                                        <i class="bi bi-person"></i>
                                        <span>Mi Perfil</span>
                                    </a>
                                    @if (UiAuth.CanAccessConfigSection())
                                    {
                                        <a href="/config/usuarios" class="user-dropdown-item" @onclick="CloseUserMenu">
                                            <i class="bi bi-gear"></i>
                                            <span>Configuración</span>
                                        </a>
                                    }
                                    <div class="user-dropdown-divider"></div>
                                    <button class="user-dropdown-item logout" @onclick="HandleLogout">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Cerrar Sesión</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Iniciar Sesión
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>

        <footer class="app-footer">
            <span>AgoraHub360 ERP v1.0.0 &copy; @DateTime.Now.Year — Gestión @DateTime.Now.Year</span>
        </footer>
    </div>
</div>

@code {
    private bool SidebarCollapsed { get; set; }
    private bool _showUserMenu { get; set; }
    private bool _changingEmpresa { get; set; }
    private string? _empresaError;

    protected override async Task OnInitializedAsync()
    {
        EmpresaState.OnChange += StateHasChanged;
        SesionState.OnChange += StateHasChanged;
        await LoadEmpresasAsync();
        await SesionState.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EmpresaState.LoadFromStorageAsync();
            StateHasChanged();
        }
    }

    private async Task LoadEmpresasAsync()
    {
        try
        {
            // Cargar solo las empresas asignadas al usuario autenticado
            var empresas = await EmpresaSvc.GetMisEmpresasAsync();
            EmpresaState.SetEmpresas(empresas);
            
            // Si solo tiene una empresa, establecerla automáticamente como activa
            if (empresas.Count == 1)
            {
                await EmpresaState.SetEmpresaActivaAsync(empresas[0]);
            }
        }
        catch
        {
            // API no disponible - se mostrara "Sin empresas"
        }
    }

    private async Task OnEmpresaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var empresa = EmpresaState.Empresas.FirstOrDefault(emp => emp.Id == id);
            if (empresa is not null)
            {
                _empresaError = null;
                _changingEmpresa = true;
                var result = await EmpresaState.CambiarEmpresaActivaAsync(empresa.Id);
                _changingEmpresa = false;

                if (result.Success)
                {
                    await SesionState.InitializeAsync(forceReload: true);
                    Nav.NavigateTo(Nav.Uri, forceLoad: true);
                }
                else
                {
                    _empresaError = result.Message ?? "No se pudo cambiar la empresa.";
                }
            }
        }
    }

    private async Task OnSucursalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            await SesionState.SetSucursalActivaAsync(id);
    }

    private void ToggleSidebar()
    {
        SidebarCollapsed = !SidebarCollapsed;
    }

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
    }

    private void CloseUserMenu()
    {
        _showUserMenu = false;
    }

    private async Task HandleLogout()
    {
        _showUserMenu = false;
        await LogoutAsync();
    }

    private async Task LogoutAsync()
    {
        // Limpiar el estado de la empresa
        await EmpresaState.ClearAsync();
        await SesionState.ClearAsync();
        
        // Cerrar sesión
        await AuthState.LogoutAsync();
        
        // Redirigir al login
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private string GetUserEmail(ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Email)?.Value ?? "Sin email";
    }

    public void Dispose()
    {
        EmpresaState.OnChange -= StateHasChanged;
        SesionState.OnChange -= StateHasChanged;
    }
}
