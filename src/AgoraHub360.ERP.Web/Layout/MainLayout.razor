@inherits LayoutComponentBase
@inject EmpresaHttpService EmpresaSvc
@inject EmpresaStateService EmpresaState
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav
@implements IDisposable

<div class="app-layout @(SidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="sidebar">
        <NavMenu OnToggle="ToggleSidebar" />
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-left">
                <button class="btn-toggle" @onclick="ToggleSidebar" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="breadcrumb-text">AgoraHub360 ERP</span>
            </div>
            <div class="topbar-right">
                <!-- Selector de Empresa -->
                <div class="empresa-selector">
                    <i class="bi bi-building"></i>
                    <select class="empresa-select" @onchange="OnEmpresaChanged">
                        @if (EmpresaState.Empresas.Count == 0)
                        {
                            <option>Sin empresas</option>
                        }
                        else
                        {
                            @foreach (var emp in EmpresaState.Empresas.Where(e => e.Activo))
                            {
                                <option value="@emp.Id" selected="@(emp.Id == EmpresaState.EmpresaActivaId)">
                                    @emp.Nombre
                                </option>
                            }
                        }
                    </select>
                </div>
                <AuthorizeView>
                    <Authorized>
                        <span class="user-info">
                            <i class="bi bi-person-circle"></i>
                            @context.User.Identity?.Name
                        </span>
                        <button class="btn btn-outline-light btn-sm ms-2" @onclick="LogoutAsync" title="Cerrar sesión">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>
    </div>
</div>

@code {
    private bool SidebarCollapsed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        EmpresaState.OnChange += StateHasChanged;
        await LoadEmpresasAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EmpresaState.LoadFromStorageAsync();
            StateHasChanged();
        }
    }

    private async Task LoadEmpresasAsync()
    {
        try
        {
            var empresas = await EmpresaSvc.GetAllAsync();
            EmpresaState.SetEmpresas(empresas);
        }
        catch
        {
            // API no disponible - se mostrara "Sin empresas"
        }
    }

    private async Task OnEmpresaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var empresa = EmpresaState.Empresas.FirstOrDefault(emp => emp.Id == id);
            if (empresa is not null)
            {
                await EmpresaState.SetEmpresaActivaAsync(empresa);
            }
        }
    }

    private void ToggleSidebar()
    {
        SidebarCollapsed = !SidebarCollapsed;
    }

    private async Task LogoutAsync()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        EmpresaState.OnChange -= StateHasChanged;
    }
}
