@inherits LayoutComponentBase
@using System.Security.Claims
@inject EmpresaHttpService EmpresaSvc
@inject EmpresaStateService EmpresaState
@inject SesionUsuarioStateService SesionState
@inject UiAuthorizationService UiAuth
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">AgoraHUB360 ERP</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Sistema ERP</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="@DrawerVariant.Responsive"
               Elevation="1"
               ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="agora-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose() { }
}
