@page "/ventas/pedidos"
@using AgoraHub360.ERP.Shared.DTOs
@using AgoraHub360.ERP.Shared.DTOs.Ventas
@using AgoraHub360.ERP.Web.Services

<PageTitle>Pedidos - AgoraHub360 ERP</PageTitle>

<div class="page-header">
    <h1>Pedidos de Venta</h1>
    <p class="text-muted mb-0">Ventas &rsaquo; Pedidos</p>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <span>Listado de Pedidos</span>
        <button class="btn btn-primary btn-sm" @onclick="GoToNuevo">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Pedido
        </button>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">Cargando pedidos...</div>
        }
        else if (pedidos.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt" style="font-size: 3rem; color: var(--agora-text-light);"></i>
                <p class="text-muted mt-3">No hay pedidos registrados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">Impuestos</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in pedidos)
                        {
                            <tr>
                                <td>
                                    <a href="/ventas/pedidos/editar/@pedido.Id" class="fw-semibold text-decoration-none">
                                        @pedido.Numero
                                    </a>
                                </td>
                                <td>@pedido.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @GetEstadoBadge(pedido.Estado)">@pedido.Estado</span>
                                </td>
                                <td class="text-end">@pedido.Subtotal.ToString("N2")</td>
                                <td class="text-end">@pedido.Impuestos.ToString("N2")</td>
                                <td class="text-end fw-semibold">@pedido.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a href="/ventas/pedidos/editar/@pedido.Id"
                                           class="btn btn-outline-secondary btn-sm"
                                           title="Editar pedido">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (string.Equals(pedido.Estado, "Borrador", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="btn btn-success btn-sm"
                                                    @onclick="() => ConfirmarPedidoAsync(pedido)"
                                                    disabled="@(confirmandoId == pedido.Id)"
                                                    title="Confirmar pedido y reservar stock">
                                                @if (confirmandoId == pedido.Id)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2-all"></i>
                                                }
                                            </button>
                                        }
                                        @if (CanGenerarVenta(pedido))
                                        {
                                            <button class="btn btn-primary btn-sm"
                                                    @onclick="() => GenerarVentaDesdePedidoAsync(pedido)"
                                                    disabled="@isGeneratingVenta"
                                                    title="Generar venta desde este pedido">
                                                <i class="bi bi-cart-check"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ?? Preview del componente de Workflow (disponible al implementar el módulo) ?? *@
@if (mostrarPreviewWorkflow)
{
    <div class="card mt-3">
        <div class="card-header py-2">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Preview — TareasTab para OrdenVenta. Se activará con el módulo de ventas.
            </small>
        </div>
        <div class="card-body">
            <TareasTab EntityType="OrdenVenta"
                       EntityId="@previewOrdenVentaId"
                       IsReadOnly="@previewIsReadOnly"
                       OnTareaCompletada="() => { }" />
        </div>
    </div>
}

@code {
    @inject NavigationManager Nav
    @inject PedidoVentaHttpService PedidoService
    @inject VentaHttpService VentaService

    // Variables preparadas para el módulo de OrdenVenta
    private bool mostrarPreviewWorkflow = false;
    private int  previewOrdenVentaId   = 0;
    private bool previewIsReadOnly     = false;
    private List<PedidoVentaDto> pedidos = new();
    private bool isLoading;
    private bool isGeneratingVenta;
    private long? confirmandoId;          // Id del pedido que está siendo confirmado
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPedidosAsync();
    }

    private async Task LoadPedidosAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            pedidos = await PedidoService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el listado de pedidos: {ex.Message}";
            pedidos = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToNuevo()
    {
        Nav.NavigateTo("/ventas/pedidos/nuevo");
    }

    private static bool CanGenerarVenta(PedidoVentaDto pedido)
    {
        var estado = pedido.Estado?.Trim();
        return string.Equals(estado, "Confirmado", StringComparison.OrdinalIgnoreCase)
               && !string.Equals(estado, "Anulado", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ConfirmarPedidoAsync(PedidoVentaDto pedido)
    {
        if (confirmandoId.HasValue)
            return; // Ya hay una confirmación en proceso

        confirmandoId = pedido.Id;
        errorMessage = null;
        successMessage = null;

        try
        {
            var res = await PedidoService.ConfirmarAsync(pedido.Id);

            if (res.Success)
            {
                successMessage = $"Pedido {pedido.Numero} confirmado correctamente. Stock reservado.";
                await LoadPedidosAsync();
            }
            else
            {
                errorMessage = res.Message ?? $"No se pudo confirmar el pedido {pedido.Numero}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al confirmar el pedido {pedido.Numero}: {ex.Message}";
        }
        finally
        {
            confirmandoId = null;
        }
    }

    private async Task GenerarVentaDesdePedidoAsync(PedidoVentaDto pedido)
    {
        isGeneratingVenta = true;
        errorMessage = null;

        try
        {
            var response = await VentaService.CrearDesdePedidoAsync(new GenerarVentaDesdePedidoRequestDto
            {
                PedidoVentaId = pedido.Id
            });

            if (response.Success && response.Data is not null)
            {
                Nav.NavigateTo($"/ventas/comercial/{response.Data.Id}");
                return;
            }

            errorMessage = BuildGenerarVentaError(response);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo generar la venta desde el pedido {pedido.Numero}: {ex.Message}";
        }
        finally
        {
            isGeneratingVenta = false;
        }
    }

    private static string BuildGenerarVentaError(ApiResponse<VentaDto> response)
    {
        if (response.Errors is { Count: > 0 })
            return $"{response.Message} {string.Join(" | ", response.Errors)}";

        return response.Message ?? "No se pudo generar la venta desde el pedido seleccionado.";
    }

    private static string GetEstadoBadge(string? estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "borrador"     => "bg-secondary",
        "confirmado"   => "bg-success",
        "enpreparacion" => "bg-info text-dark",
        "despachado"   => "bg-primary",
        "entregado"    => "bg-success",
        "anulado"      => "bg-danger",
        _              => "bg-secondary"
    };
}

