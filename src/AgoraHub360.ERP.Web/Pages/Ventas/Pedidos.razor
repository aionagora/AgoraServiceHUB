@page "/ventas/pedidos"
@using AgoraHub360.ERP.Shared.DTOs
@using AgoraHub360.ERP.Shared.DTOs.Ventas
@using AgoraHub360.ERP.Web.Services

<PageTitle>Pedidos - AgoraHub360 ERP</PageTitle>

<div class="page-header">
    <h1>Pedidos de Venta</h1>
    <p class="text-muted mb-0">Ventas &rsaquo; Pedidos</p>
</div>

@* ─── Panel de Filtros ──────────────────────────────────────────────────── *@
<form @onsubmit="BuscarAsync" @onsubmit:preventDefault class="card border-0 shadow-sm mb-4 bg-white text-dark">
    <div class="card-body p-3">
        <h5 class="card-title mb-3 fs-6 fw-bold text-dark">
            <i class="bi bi-funnel-fill me-1 text-primary"></i> Filtros de Búsqueda
        </h5>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input type="text" class="form-control form-control-sm" placeholder="Nro pedido..." @bind="filtroBusqueda" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Nro Pedido</label>
                <input type="text" class="form-control form-control-sm" placeholder="Número exacto..." @bind="filtroNumero" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Cliente</label>
                <select class="form-select form-select-sm text-dark" @bind="filtroClienteId">
                    <option value="">-- Todos --</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Id">@c.RazonSocial (@c.Codigo)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Estado</label>
                <select class="form-select form-select-sm text-dark" @bind="filtroEstado">
                    <option value="">-- Todos --</option>
                    <option value="Borrador">Borrador</option>
                    <option value="Confirmado">Confirmado</option>
                    <option value="EnPreparacion">En Preparación</option>
                    <option value="Despachado">Despachado</option>
                    <option value="Entregado">Entregado</option>
                    <option value="Anulado">Anulado</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Prioridad</label>
                <select class="form-select form-select-sm text-dark" @bind="filtroPrioridad">
                    <option value="">-- Todas --</option>
                    <option value="Baja">Baja</option>
                    <option value="Normal">Normal</option>
                    <option value="Alta">Alta</option>
                    <option value="Urgente">Urgente</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Fecha Desde</label>
                <input type="date" class="form-control form-control-sm" @bind="filtroFechaDesde" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Fecha Hasta</label>
                <input type="date" class="form-control form-control-sm" @bind="filtroFechaHasta" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Top</label>
                <select class="form-select form-select-sm text-dark" @bind="filtroTop">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Tam. Página</label>
                <select class="form-select form-select-sm text-dark" @bind="filtroTamanoPagina">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2 justify-content-end">
                <button type="submit" class="btn btn-primary btn-sm px-4" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                    }
                    Buscar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltrosAsync" disabled="@isLoading" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
                </button>
            </div>
        </div>
    </div>
</form>

@* ─── Barra de acciones ─────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="small text-muted">
        @if (totalRegistros > 0)
        {
            <text>Mostrando @(totalRegistros > 0 ? (paginaActual - 1) * tamanoPaginaActual + 1 : 0) a @(Math.Min(paginaActual * tamanoPaginaActual, totalRegistros)) de @totalRegistros registros</text>
        }
    </span>
    <button class="btn btn-primary btn-sm" @onclick="GoToNuevo">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Pedido
    </button>
</div>

@* ─── Mensajes ──────────────────────────────────────────────────────────── *@
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@* ─── Tabla de pedidos ──────────────────────────────────────────────────── *@
<div class="card">
    <div class="card-header py-3">
        <span>Listado de Pedidos</span>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">Cargando pedidos...</div>
        }
        else if (pedidos.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt" style="font-size: 3rem; color: var(--agora-text-light);"></i>
                <p class="text-muted mt-3">No hay pedidos registrados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in pedidos)
                        {
                            <tr>
                                <td>
                                    <a href="/ventas/pedidos/editar/@pedido.Id" class="fw-semibold text-decoration-none">
                                        @pedido.Numero
                                    </a>
                                </td>
                                <td>@pedido.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@pedido.Cliente?.RazonSocial</td>
                                <td>
                                    <span class="badge @GetPrioridadBadge(pedido.Prioridad)">@pedido.Prioridad</span>
                                </td>
                                <td>
                                    <span class="badge @GetEstadoBadge(pedido.Estado)">@pedido.Estado</span>
                                </td>
                                <td class="text-end">@pedido.Subtotal.ToString("N2")</td>
                                <td class="text-end fw-semibold">@pedido.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a href="/ventas/pedidos/editar/@pedido.Id"
                                           class="btn btn-outline-secondary btn-sm"
                                           title="Editar pedido">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (string.Equals(pedido.Estado, "Borrador", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="btn btn-success btn-sm"
                                                    @onclick="() => ConfirmarPedidoAsync(pedido)"
                                                    disabled="@(confirmandoId == pedido.Id)"
                                                    title="Confirmar pedido y reservar stock">
                                                @if (confirmandoId == pedido.Id)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2-all"></i>
                                                }
                                            </button>
                                        }
                                        @if (CanGenerarVenta(pedido))
                                        {
                                            <button class="btn btn-primary btn-sm"
                                                    @onclick="() => GenerarVentaDesdePedidoAsync(pedido)"
                                                    disabled="@isGeneratingVenta"
                                                    title="Generar venta desde este pedido">
                                                <i class="bi bi-cart-check"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ─── Paginación ─────────────────────────────────────────────── *@
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="small text-muted">
                    Página @paginaActual de @totalPaginas
                </span>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="PaginaAnterior" disabled="@(paginaActual <= 1 || isLoading)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas || isLoading)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@* ?? Preview del componente de Workflow ?? *@
@if (mostrarPreviewWorkflow)
{
    <div class="card mt-3">
        <div class="card-header py-2">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Preview — TareasTab para OrdenVenta. Se activará con el módulo de ventas.
            </small>
        </div>
        <div class="card-body">
            <TareasTab EntityType="OrdenVenta"
                       EntityId="@previewOrdenVentaId"
                       IsReadOnly="@previewIsReadOnly"
                       OnTareaCompletada="() => { }" />
        </div>
    </div>
}

@code {
    @inject NavigationManager Nav
    @inject PedidoVentaHttpService PedidoService
    @inject VentaHttpService VentaService
    @inject ClienteHttpService ClienteService

    // Variables preparadas para el módulo de OrdenVenta
    private bool mostrarPreviewWorkflow = false;
    private int  previewOrdenVentaId   = 0;
    private bool previewIsReadOnly     = false;

    // ─── Filtros ────────────────────────────────────────────────────────────
    private string? filtroBusqueda;
    private string? filtroNumero;
    private int? filtroClienteId;
    private string? filtroEstado;
    private string? filtroPrioridad;
    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;
    private int filtroTop = 100;
    private int filtroTamanoPagina = 50;

    // ─── Paginación ─────────────────────────────────────────────────────────
    private int paginaActual = 1;
    private int tamanoPaginaActual = 50;
    private int totalRegistros = 0;
    private int totalPaginas = 1;

    // ─── Datos ──────────────────────────────────────────────────────────────
    private List<PedidoVentaDto> pedidos = new();
    private List<AgoraHub360.ERP.Shared.DTOs.MDM.ClienteDto> clientes = new();
    private bool isLoading;
    private bool isGeneratingVenta;
    private long? confirmandoId;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await ClienteService.GetAllAsync();
        }
        catch { /* ignorar — el filtro de cliente funcionará sin la lista */ }
        await LoadPedidosAsync();
    }

    private async Task LoadPedidosAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var filter = new PedidoVentaFilterDto
            {
                Busqueda = filtroBusqueda,
                NumeroPedido = filtroNumero,
                ClienteId = filtroClienteId,
                EstadoPedido = filtroEstado,
                Prioridad = filtroPrioridad,
                FechaDesde = filtroFechaDesde,
                FechaHasta = filtroFechaHasta,
                Top = filtroTop,
                Pagina = paginaActual,
                TamanoPagina = filtroTamanoPagina
            };

            var response = await PedidoService.GetPagedAsync(filter);
            pedidos.Clear();
            if (response.Success && response.Data != null)
            {
                pedidos.AddRange(response.Data.Items);
                totalRegistros = response.Data.TotalItems;
                totalPaginas = response.Data.TotalPaginas;
                tamanoPaginaActual = response.Data.TamanoPagina;
            }
            else
            {
                errorMessage = response.Message ?? "Error al obtener pedidos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el listado de pedidos: {ex.Message}";
            pedidos = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BuscarAsync()
    {
        paginaActual = 1;
        await LoadPedidosAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtroBusqueda = null;
        filtroNumero = null;
        filtroClienteId = null;
        filtroEstado = null;
        filtroPrioridad = null;
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        filtroTop = 100;
        filtroTamanoPagina = 50;
        paginaActual = 1;
        await LoadPedidosAsync();
    }

    private async Task PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await LoadPedidosAsync();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            await LoadPedidosAsync();
        }
    }

    private void GoToNuevo()
    {
        Nav.NavigateTo("/ventas/pedidos/nuevo");
    }

    private static bool CanGenerarVenta(PedidoVentaDto pedido)
    {
        var estado = pedido.Estado?.Trim();
        return string.Equals(estado, "Confirmado", StringComparison.OrdinalIgnoreCase)
               && !string.Equals(estado, "Anulado", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ConfirmarPedidoAsync(PedidoVentaDto pedido)
    {
        if (confirmandoId.HasValue)
            return;

        confirmandoId = pedido.Id;
        errorMessage = null;
        successMessage = null;

        try
        {
            var res = await PedidoService.ConfirmarAsync(pedido.Id);

            if (res.Success)
            {
                successMessage = $"Pedido {pedido.Numero} confirmado correctamente. Stock reservado.";
                await LoadPedidosAsync();
            }
            else
            {
                errorMessage = res.Message ?? $"No se pudo confirmar el pedido {pedido.Numero}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al confirmar el pedido {pedido.Numero}: {ex.Message}";
        }
        finally
        {
            confirmandoId = null;
        }
    }

    private async Task GenerarVentaDesdePedidoAsync(PedidoVentaDto pedido)
    {
        isGeneratingVenta = true;
        errorMessage = null;

        try
        {
            var response = await VentaService.CrearDesdePedidoAsync(new GenerarVentaDesdePedidoRequestDto
            {
                PedidoVentaId = pedido.Id
            });

            if (response.Success && response.Data is not null)
            {
                Nav.NavigateTo($"/ventas/comercial/{response.Data.Id}");
                return;
            }

            errorMessage = BuildGenerarVentaError(response);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo generar la venta desde el pedido {pedido.Numero}: {ex.Message}";
        }
        finally
        {
            isGeneratingVenta = false;
        }
    }

    private static string BuildGenerarVentaError(ApiResponse<VentaDto> response)
    {
        if (response.Errors is { Count: > 0 })
            return $"{response.Message} {string.Join(" | ", response.Errors)}";

        return response.Message ?? "No se pudo generar la venta desde el pedido seleccionado.";
    }

    private static string GetEstadoBadge(string? estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "borrador"      => "bg-secondary",
        "confirmado"    => "bg-success",
        "enpreparacion" => "bg-info text-dark",
        "despachado"    => "bg-primary",
        "entregado"     => "bg-success",
        "anulado"       => "bg-danger",
        _               => "bg-secondary"
    };

    private static string GetPrioridadBadge(string? prioridad) => prioridad?.Trim().ToLowerInvariant() switch
    {
        "urgente" => "bg-danger",
        "alta"    => "bg-warning text-dark",
        "normal"  => "bg-info text-dark",
        "baja"    => "bg-secondary",
        _         => "bg-secondary"
    };
}

