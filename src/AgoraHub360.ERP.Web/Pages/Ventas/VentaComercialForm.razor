    private async Task SeleccionarClienteBusqueda(MdmClienteDto cliente)
    {
        if (cliente is null)
            return;

        clienteSeleccionadoActual = cliente;
        clienteBusquedaTexto = cliente.RazonSocial ?? string.Empty;
            nitBusquedaTexto = cliente.NIT ?? string.Empty;
        clientesFiltradosBusqueda.Clear();
        mostrarResultadosClientes = false;

        await OnClienteChanged(cliente.Id);
    }

    private void SincronizarClienteSeleccionado()
    {
        if (!form.ClienteId.HasValue)
        {
            clienteSeleccionadoActual = null;
            return;
        }

        clienteSeleccionadoActual = clientes.FirstOrDefault(c => c.Id == form.ClienteId.Value);
        if (clienteSeleccionadoActual is null)
            return;

        if (string.IsNullOrWhiteSpace(clienteBusquedaTexto))
            clienteBusquedaTexto = clienteSeleccionadoActual.RazonSocial ?? string.Empty;

        if (string.IsNullOrWhiteSpace(nitBusquedaTexto))
            nitBusquedaTexto = clienteSeleccionadoActual.NIT ?? string.Empty;
    }

    private void RefrescarFiltroClientesBusqueda()
    {
        var termino = (clienteBusquedaTexto ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(termino))
        {
            clientesFiltradosBusqueda = clientes.Take(8).ToList();
            return;
        }

        clientesFiltradosBusqueda = clientes
            .Where(c => CoincideClienteBusqueda(c, termino))
            .Take(15)
            .ToList();
    }

    private static bool CoincideClienteBusqueda(MdmClienteDto cliente, string termino)
    {
        if (cliente is null || string.IsNullOrWhiteSpace(termino))
            return false;

        return Contiene(cliente.RazonSocial, termino)
               || Contiene(cliente.Codigo, termino)
               || Contiene(cliente.NIT, termino)
               || Contiene(cliente.Email, termino)
               || Contiene(cliente.Telefono, termino);
    }

    private static bool Contiene(string? value, string termino)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(termino, StringComparison.OrdinalIgnoreCase);

    private async Task LoadPerfilesFiscalesAsync(int? clienteId, bool preserveCurrentSelection)
    {
        perfilesFiscalesCliente = new List<ClientePerfilFiscalDto>();
        perfilesFiscalesFiltradosBusqueda = new List<ClientePerfilFiscalDto>();
        mostrarResultadosPerfilesFiscales = false;
        perfilFiscalBusquedaTexto = string.Empty;

        if (!clienteId.HasValue || clienteId.Value <= 0)
        {
            form.FacturacionDatos.ClientePerfilFiscalId = null;
            return;
        }

        try
        {
            var perfiles = await ClientePerfilFiscalService.GetByClienteAsync(clienteId.Value);
            perfilesFiscalesCliente = perfiles
                .Where(x => x.Activo)
                .OrderByDescending(x => x.EsPredeterminado)
                .ThenBy(x => x.Alias)
                .ToList();
        }
        catch
        {
            perfilesFiscalesCliente = new List<ClientePerfilFiscalDto>();
        }

        if (preserveCurrentSelection
            && form.FacturacionDatos.ClientePerfilFiscalId.HasValue
            && perfilesFiscalesCliente.Any(x => x.Id == form.FacturacionDatos.ClientePerfilFiscalId.Value))
        {
            return;
        }

        RefrescarFiltroPerfilesFiscalesBusqueda();

        if (form.FacturacionDatos.FacturarAlMismoCliente)
        {
            AplicarReglaFacturarMismoCliente(forceOverwrite: !DatosFiscalesModificadosManual);
            return;
        }

        if (!preserveCurrentSelection)
            form.FacturacionDatos.ClientePerfilFiscalId = null;
    }

    private long? GetPerfilFiscalSelectorValue()
    {
        if (form.FacturacionDatos.ClientePerfilFiscalId.HasValue)
            return form.FacturacionDatos.ClientePerfilFiscalId.Value;

        return IsDatoOcasionalFiscal() ? PerfilFiscalDatoOcasionalId : null;
    }

    private void OnPerfilFiscalChanged(long? perfilId)
    {
        if (!perfilId.HasValue)
        {
            form.FacturacionDatos.ClientePerfilFiscalId = null;
            return;
        }

        if (perfilId.Value == PerfilFiscalDatoOcasionalId)
        {
            form.FacturacionDatos.ClientePerfilFiscalId = null;
            return;
        }

        var perfil = perfilesFiscalesCliente.FirstOrDefault(x => x.Id == perfilId.Value);
        if (perfil is null)
            return;

        ApplyPerfilFiscal(perfil, markExplicitSelection: true);
    }

    private void ApplyPerfilFiscal(ClientePerfilFiscalDto perfil, bool markExplicitSelection = false)
    {
        suppressFiscalManualTracking = true;
        form.FacturacionDatos.ClientePerfilFiscalId = perfil.Id;
        form.FacturacionDatos.TipoDocumentoIdentidad = perfil.TipoDocumentoIdentidad;
        form.FacturacionDatos.NitFactura = perfil.NumeroDocumento;
        form.FacturacionDatos.Complemento = perfil.Complemento;
        form.FacturacionDatos.RazonSocialFactura = perfil.RazonSocial;
        form.FacturacionDatos.EmailFactura = perfil.EmailFactura;
        form.FacturacionDatos.TelefonoFactura = perfil.TelefonoFactura;
        suppressFiscalManualTracking = false;

        if (markExplicitSelection)
        {
            nitFacturaEditadoManual = false;
            razonSocialFacturaEditadaManual = false;
        }

            perfilFiscalBusquedaTexto = perfil.RazonSocial ?? perfil.Alias ?? string.Empty;
        mostrarResultadosPerfilesFiscales = false;
    }

    private Task OnFacturarAlMismoClienteChanged(bool value)
    {
        form.FacturacionDatos.FacturarAlMismoCliente = value;
        if (!form.FacturacionDatos.Facturar || !form.ClienteId.HasValue)
            return Task.CompletedTask;

        if (value)
        {
            AplicarReglaFacturarMismoCliente(forceOverwrite: true);
            return Task.CompletedTask;
        }

        form.FacturacionDatos.ClientePerfilFiscalId = null;
        RefrescarFiltroPerfilesFiscalesBusqueda();
        return Task.CompletedTask;
    }

    private void AplicarReglaFacturarMismoCliente(bool forceOverwrite)
    {
        if (!form.ClienteId.HasValue)
            return;

        var predeterminado = perfilesFiscalesCliente.FirstOrDefault(x => x.EsPredeterminado);
        if (predeterminado is not null)
        {
            if (forceOverwrite || !DatosFiscalesModificadosManual)
                ApplyPerfilFiscal(predeterminado, markExplicitSelection: true);

            return;
        }

        var cliente = clientes.FirstOrDefault(c => c.Id == form.ClienteId.Value);
        if (cliente is null)
            return;

        if (!forceOverwrite && DatosFiscalesModificadosManual)
            return;

        suppressFiscalManualTracking = true;
        form.FacturacionDatos.ClientePerfilFiscalId = null;
        form.FacturacionDatos.TipoDocumentoIdentidad = string.IsNullOrWhiteSpace(form.FacturacionDatos.TipoDocumentoIdentidad)
            ? "NIT"
            : form.FacturacionDatos.TipoDocumentoIdentidad;
        form.FacturacionDatos.NitFactura = cliente.NIT;
        form.FacturacionDatos.RazonSocialFactura = cliente.RazonSocial;
        form.FacturacionDatos.EmailFactura = cliente.Email;
        form.FacturacionDatos.TelefonoFactura = cliente.Telefono;
        suppressFiscalManualTracking = false;
        nitFacturaEditadoManual = false;
        razonSocialFacturaEditadaManual = false;

        if (string.IsNullOrWhiteSpace(form.FacturacionDatos.NitFactura)
            || string.IsNullOrWhiteSpace(form.FacturacionDatos.RazonSocialFactura))
        {
            ShowWarningModal("El cliente no tiene datos fiscales completos.");
        }
    }

    private Task OnRazonSocialBusquedaTextoChanged()
    {
        perfilFiscalBusquedaTexto = perfilFiscalBusquedaTexto?.Trim() ?? string.Empty;
        RefrescarFiltroPerfilesFiscalesBusqueda();
        mostrarResultadosPerfilesFiscales = !string.IsNullOrWhiteSpace(perfilFiscalBusquedaTexto)
                                          && perfilesFiscalesFiltradosBusqueda.Count > 0;
        return Task.CompletedTask;
    }

    private void OnRazonSocialBusquedaFocused()
    {
        RefrescarFiltroPerfilesFiscalesBusqueda();
        mostrarResultadosPerfilesFiscales = perfilesFiscalesFiltradosBusqueda.Count > 0;
    }

    private void RefrescarFiltroPerfilesFiscalesBusqueda()
    {
        if (!form.ClienteId.HasValue)
        {
            perfilesFiscalesFiltradosBusqueda = new List<ClientePerfilFiscalDto>();
            return;
        }

        var termino = (perfilFiscalBusquedaTexto ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(termino))
        {
            perfilesFiscalesFiltradosBusqueda = perfilesFiscalesCliente.Take(10).ToList();
            return;
        }

        perfilesFiscalesFiltradosBusqueda = perfilesFiscalesCliente
            .Where(p => CoincidePerfilFiscalBusqueda(p, termino))
            .Take(12)
            .ToList();
    }

    private static bool CoincidePerfilFiscalBusqueda(ClientePerfilFiscalDto perfil, string termino)
    {
        if (perfil is null || string.IsNullOrWhiteSpace(termino))
            return false;

        return Contiene(perfil.RazonSocial, termino)
               || Contiene(perfil.NumeroDocumento, termino)
               || Contiene(perfil.Alias, termino);
    }

