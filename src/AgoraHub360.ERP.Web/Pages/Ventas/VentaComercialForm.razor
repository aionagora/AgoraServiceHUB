    private static string BuildErrorMessage(ApiResponse<VentaDto> response)
    {
        if (response.Errors is { Count: > 0 })
            return $"{response.Message} {string.Join(" | ", response.Errors)}";

        return response.Message ?? "Error no controlado al ejecutar la operación.";
    }

    private static string BuildErrorMessage(ApiResponse<FacturaVentaDto> response)
    {
        if (response.Errors is { Count: > 0 })
            return $"{response.Message} {string.Join(" | ", response.Errors)}";

        return response.Message ?? "Error no controlado al ejecutar la operación de factura.";
    }

    private async Task GuardarAsync()
    {
        errorMessage = null;
        successMessage = null;

        var validation = ValidateForm();
        if (!string.IsNullOrWhiteSpace(validation))
        {
            ShowErrorModal(validation);
            return;
        }

        isSaving = true;

        try
        {
            ApiResponse<VentaDto> response;
            var ventaId = form.Id;
            var wasNew = IsNew;

            if (wasNew)
            {
                response = await VentaService.CreateAsync(BuildCreateRequest());
            }
            else
            {
                if (!ventaId.HasValue || ventaId.Value <= 0)
                {
                    ShowErrorModal("No se pudo identificar el Id de la venta para actualizar. Recargue la página e intente nuevamente.");
                    return;
                }

                response = await VentaService.UpdateAsync(ventaId.Value, BuildUpdateRequest());
            }

            if (!response.Success || response.Data is null)
            {
                ShowErrorModal(BuildErrorMessage(response));
                return;
            }

            if (wasNew)
            {
                if (response.Data.Id <= 0)
                {
                    ShowErrorModal("La venta se guardó, pero no se recibió un Id válido para continuar en modo edición.");
                    return;
                }

                ventaId = response.Data.Id;
                Id = response.Data.Id;
                form.Id = response.Data.Id;
            }

            ShowSuccessModal(wasNew ? "Venta creada en borrador." : "Venta actualizada en borrador.");

            if (ventaId.HasValue && ventaId.Value > 0)
            {
                await LoadVentaAsync(ventaId.Value);
                await LoadFacturaAsync(ventaId.Value);
                RecalcularTotales();

                if (wasNew)
                    Nav.NavigateTo($"/ventas/comercial/{ventaId.Value}", replace: true);
            }
        }
        catch (Exception ex)
        {
            ShowErrorModal($"No se pudo guardar la venta: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmarAsync()
    {
        if (IsNew || !form.Id.HasValue || form.Id.Value <= 0)
        {
            ShowWarningModal("Debe guardar la venta antes de confirmar.");
            return;
        }

        if (!form.ClienteId.HasValue || form.ClienteId.Value <= 0)
        {
            ShowWarningModal("Debe seleccionar o registrar un cliente antes de confirmar la venta.");
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        var response = await VentaService.ConfirmarAsync(form.Id.Value, new ConfirmarVentaRequestDto
        {
            Observaciones = form.Observaciones
        });

        if (response.Success)
        {
            ShowSuccessModal("Venta confirmada correctamente.");
            await LoadVentaAsync(form.Id.Value);
            await LoadFacturaAsync(form.Id.Value);
            RecalcularTotales();
        }
        else
        {
            ShowErrorModal(BuildErrorMessage(response));
        }

        isSaving = false;
    }

    private async Task AnularAsync()
    {
        if (IsNew || !form.Id.HasValue) return;

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        var response = await VentaService.AnularAsync(form.Id.Value, new AnularVentaRequestDto
        {
            MotivoAnulacion = string.IsNullOrWhiteSpace(form.Observaciones)
                ? "Anulación desde formulario comercial"
