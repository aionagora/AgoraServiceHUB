    private async Task LoadCatalogosAsync()
    {
        try
        {
            var clientesTask = ClienteService.GetAllAsync();
            var sucursalesTask = SucursalService.GetActivasAsync();
            var almacenesTask = AlmacenService.GetAllAsync();
            var productosTask = CompanyProductService.GetAllAsync();
            var productosBaseTask = ProductoService.GetAllAsync();

            await Task.WhenAll(clientesTask, sucursalesTask, almacenesTask, productosTask, productosBaseTask);

            clientes = (await clientesTask).Where(x => x.Activo).OrderBy(x => x.RazonSocial).ToList();
            sucursales = (await sucursalesTask).Where(x => x.Activo).OrderBy(x => x.Nombre).ToList();
            almacenes = (await almacenesTask).Where(x => x.Activo).OrderBy(x => x.Nombre).ToList();
            productos = (await productosTask).Where(x => x.Activo).OrderBy(x => x.NombreComercial).ToList();
            productosBasePorId = (await productosBaseTask).Where(x => x.Activo).ToDictionary(x => x.ProductId, x => x);
        }
        catch (Exception ex)
        {
            ShowErrorModal($"No se pudieron cargar catálogos: {ex.Message}");
        }

        ApplyAutoSelectionsForNewVenta();
        FiltrarAlmacenes();
        SincronizarClienteSeleccionado();
        RefrescarFiltroClientesBusqueda();
    }

