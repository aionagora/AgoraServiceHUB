    private void OnTipoItemChanged(int idx, string tipo)
    {
        if (idx < 0 || idx >= form.Detalles.Count) return;

        var det = form.Detalles[idx];
        det.TipoItemVenta = tipo;

        if (string.Equals(tipo, "Servicio", StringComparison.OrdinalIgnoreCase))
        {
            det.AlmacenId = null;
            det.DescuentaInventario = false;

            if (det.CompanyProductId.HasValue)
            {
                var cp = serviciosCatalogados.FirstOrDefault(x => x.CompanyProductId == det.CompanyProductId.Value);
                if (cp is null)
                {
                    // Mantener selección; solo se omite autocompletado cuando no se encuentra en el lookup.
                }
                else
                {
                    if (string.IsNullOrWhiteSpace(det.Descripcion))
                        det.Descripcion = cp.NombreComercial;
                }
            }
        }
        else
        {
            det.DescuentaInventario = true;
            det.AlmacenId ??= form.AlmacenId;

            if (det.CompanyProductId.HasValue && !productosCatalogados.Any(x => x.CompanyProductId == det.CompanyProductId.Value))
                det.CompanyProductId = null;
        }

        RecalcularTotales();
    }

    private void OnCompanyProductSelected(int idx, long? companyProductId)
    {
        if (idx < 0 || idx >= form.Detalles.Count) return;

        var det = form.Detalles[idx];
        det.CompanyProductId = companyProductId;

        if (!companyProductId.HasValue)
            return;

        if (EsProducto(det))
        {
            var cp = productosCatalogados.FirstOrDefault(x => x.CompanyProductId == companyProductId.Value);
            if (cp is null)
            {
                det.CompanyProductId = null;
                return;
            }

            if (string.IsNullOrWhiteSpace(det.Descripcion))
                det.Descripcion = cp.NombreComercial;
            return;
        }

        var servicio = serviciosCatalogados.FirstOrDefault(x => x.CompanyProductId == companyProductId.Value);
        if (servicio is null)
        {
            return;
        }

        det.AlmacenId = null;
        det.DescuentaInventario = false;
        if (string.IsNullOrWhiteSpace(det.Descripcion))
            det.Descripcion = servicio.NombreComercial;
    }

