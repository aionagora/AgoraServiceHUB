    private List<VentaDetalleDto> CloneDetallesForRequest()
        => form.Detalles.Select(d => new VentaDetalleDto
        {
            TipoItemVenta = d.TipoItemVenta,
            CompanyProductId = d.CompanyProductId,
            AlmacenId = d.AlmacenId,
            Descripcion = d.Descripcion,
            DetalleAdicional = d.DetalleAdicional,
            Cantidad = d.Cantidad,
            PrecioUnitario = d.PrecioUnitario,
            DescuentoPorcentaje = d.DescuentoPorcentaje,
            DescuentoMonto = d.DescuentoMonto,
            ImpuestoMonto = d.ImpuestoMonto,
            TotalLinea = d.TotalLinea,
            CostoUnitario = d.CostoUnitario,
            DescuentaInventario = d.DescuentaInventario
        }).ToList();

    private void NormalizeDetalles()
    {
        foreach (var det in form.Detalles)
        {
            if (!EsProducto(det))
            {
                det.AlmacenId = null;
                det.DescuentaInventario = false;
            }
            else
            {
                det.DescuentaInventario = true;
            }

            det.TotalLinea = CalcularTotalLinea(det);
        }
    }

    private string? ValidateForm()
    {
        if (!form.ClienteId.HasValue || form.ClienteId.Value <= 0)
            return "Debe seleccionar o registrar un cliente antes de guardar la venta.";

        if (form.SucursalId <= 0)
            return "Debe seleccionar una sucursal.";

        if (form.TipoVenta == "DesdePedido" && (!form.PedidoVentaId.HasValue || form.PedidoVentaId <= 0))
            return "Debe indicar PedidoVentaId cuando el tipo de venta es DesdePedido.";

        if (form.Detalles.Count == 0)
            return "Debe registrar al menos una línea de detalle.";

        for (var i = 0; i < form.Detalles.Count; i++)
        {
            var d = form.Detalles[i];
            var nro = i + 1;

            if (string.IsNullOrWhiteSpace(d.TipoItemVenta))
                return $"La línea {nro} no tiene TipoItemVenta.";

            if (EsProducto(d) && (!d.CompanyProductId.HasValue || d.CompanyProductId <= 0))
                return $"La línea {nro} es Producto y requiere CompanyProductId.";

            if (!EsProducto(d))
            {
                d.AlmacenId = null;
                d.DescuentaInventario = false;
            }

            if (d.Cantidad <= 0)
                return $"La línea {nro} debe tener cantidad mayor a cero.";

            if (d.PrecioUnitario < 0)
                return $"La línea {nro} tiene precio unitario inválido.";

            if (string.IsNullOrWhiteSpace(d.Descripcion) && !d.CompanyProductId.HasValue)
                return $"La línea {nro} debe tener descripción o producto seleccionado.";
        }

        if (form.FacturacionDatos.Facturar)
        {
            if (string.IsNullOrWhiteSpace(form.FacturacionDatos.NitFactura))
                return "NIT Factura es obligatorio cuando Facturar = true.";

            if (string.IsNullOrWhiteSpace(form.FacturacionDatos.RazonSocialFactura))
                return "Razón Social Factura es obligatorio cuando Facturar = true.";
        }

        for (var i = 0; i < form.Pagos.Count; i++)
        {
            var p = form.Pagos[i];
            if (p.Monto <= 0)
                return $"El pago #{i + 1} debe tener monto mayor a cero.";
        }

        return null;
    }

    private static bool EsProducto(VentaDetalleDto d)
        => string.Equals(d.TipoItemVenta, "Producto", StringComparison.OrdinalIgnoreCase);

    private List<CompanyProductDto> productosCatalogados
        => productos.Where(cp =>
            productosBasePorId.TryGetValue(cp.ProductId, out var p)
            && p.ProductKind != 2)
            .ToList();

    private List<CompanyProductDto> serviciosCatalogados
        => productos.Where(cp =>
            productosBasePorId.TryGetValue(cp.ProductId, out var p)
            && (p.ProductKind == 2 || !p.IsStockable))
            .ToList();

    private decimal CalcularTotalLinea(VentaDetalleDto det)
    {
        var baseLinea = det.Cantidad * det.PrecioUnitario;
        var descuentoPorcentaje = baseLinea * (det.DescuentoPorcentaje / 100m);
        var descuentoTotalLinea = descuentoPorcentaje + det.DescuentoMonto;
        var total = baseLinea - descuentoTotalLinea + det.ImpuestoMonto;
        return total < 0 ? 0 : decimal.Round(total, 2);
    }

    private void RecalcularTotales()
    {
        decimal subtotal = 0;
        decimal descuento = 0;
        decimal impuesto = 0;
        decimal total = 0;

        foreach (var det in form.Detalles)
        {
            var baseLinea = det.Cantidad * det.PrecioUnitario;
            var descuentoPorcentaje = baseLinea * (det.DescuentoPorcentaje / 100m);
            var descuentoLinea = descuentoPorcentaje + det.DescuentoMonto;
            var totalLinea = CalcularTotalLinea(det);
            det.TotalLinea = totalLinea;

            subtotal += baseLinea;
            descuento += descuentoLinea;
            impuesto += det.ImpuestoMonto;
            total += totalLinea;
        }

        var totalPagado = form.Pagos.Sum(x => x.Monto);

        resumen.Subtotal = decimal.Round(subtotal, 2);
        resumen.DescuentoTotal = decimal.Round(descuento, 2);
        resumen.ImpuestoTotal = decimal.Round(impuesto, 2);
        resumen.Total = decimal.Round(total, 2);
        resumen.TotalPagado = decimal.Round(totalPagado, 2);
        resumen.Saldo = decimal.Round(total - totalPagado, 2);
    }



    private static string GetEstadoSiatBadge(string? estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "bg-secondary";

        return estado.ToLowerInvariant() switch
        {
            "noenviada" => "bg-secondary",
            "pendiente" => "bg-warning text-dark",
            "validada" => "bg-success",
            "rechazada" => "bg-danger",
            "anulada" => "bg-dark",
            _ => "bg-secondary"
        };
    }

