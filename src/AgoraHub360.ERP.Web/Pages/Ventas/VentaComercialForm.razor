    private void RemovePagoLocal(VentaPagoDto pago)
    {
        if (pago is null)
            return;

        if (!IsNew && pagosCargadosDesdeBackend.Contains(pago))
        {
            ShowWarningModal("La eliminación de pagos registrados se implementará en una siguiente fase.");
            return;
        }

        var removed = form.Pagos.Remove(pago);

        if (!removed)
        {
            var index = form.Pagos.IndexOf(pago);
            if (index >= 0)
                form.Pagos.RemoveAt(index);
        }

        RecalcularTotales();
        StateHasChanged();
    }

