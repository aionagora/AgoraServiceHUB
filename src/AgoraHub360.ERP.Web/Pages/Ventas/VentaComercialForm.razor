@page "/ventas/comercial/nueva"
@page "/ventas/comercial/{Id:long}"
@attribute [Authorize]
@using AgoraHub360.ERP.Web.Helpers
@using AgoraHub360.ERP.Shared.DTOs.MDM
@using AgoraHub360.ERP.Shared.DTOs.Sucursal
@using AgoraHub360.ERP.Shared.DTOs.Ventas
@using MdmClienteDto = AgoraHub360.ERP.Shared.DTOs.MDM.ClienteDto
@inject IJSRuntime JSRuntime
@inject VentaHttpService VentaService
@inject FacturaVentaHttpService FacturaVentaService
@inject ClienteHttpService ClienteService
@inject ClienteCreditoConfiguracionHttpService CreditoConfigService
@inject ClientePerfilFiscalHttpService ClientePerfilFiscalService
@inject HttpSucursalService SucursalService
@inject AlmacenHttpService AlmacenService
@inject MdmCompanyProductHttpService CompanyProductService
@inject ProductoHttpService ProductoService
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Nueva Venta Comercial" : "Editar Venta Comercial") - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/ventas/comercial">Ventas Comercial</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(IsNew ? "Nueva" : "Editar")</li>
                </ol>
            </nav>
            <h3 class="mb-0">
                <i class="bi bi-receipt-cutoff me-2"></i>
                @(IsNew ? "Nueva Venta Comercial" : $"Venta {form.NumeroVentaVisual}")
            </h3>

            <div class="card shadow-sm mt-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-center small">
                        <div class="col-md-3">
                            <span class="text-muted me-1">Número:</span>
                            <span class="fw-semibold">@(IsNew ? "BORRADOR / Sin guardar" : form.NumeroVentaVisual)</span>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted me-1">Estado venta:</span>
                            <span class="@BadgeCssHelper.GetEstadoVentaBadge(form.EstadoVenta)">@form.EstadoVenta</span>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted me-1">Estado pago:</span>
                            <span class="@BadgeCssHelper.GetEstadoPagoBadge(form.EstadoPago)">@form.EstadoPago</span>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted me-1">Facturación:</span>
                            @if (facturaActual is not null)
                            {
                                <span class="@BadgeCssHelper.GetEstadoFacturaBadge(facturaActual.EstadoFactura)">@facturaActual.EstadoFactura</span>
                            }
                            else
                            {
                                <span class="badge @(form.FacturaGenerada ? "bg-success" : "bg-secondary")">@(form.FacturaGenerada ? "Generada" : "Sin generar")</span>
                            }
                        </div>
                        <div class="col-md-1">
                            <span class="text-muted me-1">Tipo:</span>
                            <span class="fw-semibold">@form.TipoVenta</span>
                        </div>
                        <div class="col-md-2 text-md-end">
                            <span class="text-muted me-1">Total:</span>
                            <span class="fw-bold text-primary">@FormatMoney(resumen.Total)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (form.PedidoVentaId.HasValue && form.PedidoVentaId.Value > 0)
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-link-45deg me-1"></i>
            Generada desde Pedido @form.PedidoVentaId.Value
        </div>
    }

    @if (!IsNew && form.FacturaGenerada)
    {
        <div class="alert alert-success" role="alert">
            <span class="badge bg-success me-2">Factura generada</span>
            La venta tiene facturación interna registrada.
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Cargando formulario...</p>
        </div>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-journal-text me-1"></i> Datos de Venta</span>
                    <span class="small text-muted">
                        <span class="badge bg-light text-dark me-2"><i class="bi bi-currency-exchange me-1"></i>Moneda: @form.MonedaCodigo</span>
                        <span class="badge bg-light text-dark"><i class="bi bi-graph-up-arrow me-1"></i>TC: @form.TipoCambio.ToString("N4")</span>
                    </span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Fecha Venta</label>
                            <InputText class="form-control form-control-sm"
                                       type="datetime-local"
                                       @bind-Value="fechaVentaLocalTexto"
                                       @bind-Value:event="oninput" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Fecha Vencimiento Pago</label>
                            <InputDate TValue="DateTime?" class="form-control form-control-sm"
                                       Value="form.FechaVencimientoPago"
                                       ValueChanged="OnFechaVencimientoChanged"
                                       ValueExpression="() => form.FechaVencimientoPago" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Sucursal *</label>
                            <InputSelect TValue="int" class="form-select form-select-sm"
                                         Value="form.SucursalId"
                                         ValueChanged="@((int v) => OnSucursalChanged(v))"
                                         ValueExpression="@(() => form.SucursalId)">
                                <option value="0">-- Seleccione sucursal --</option>
                                @foreach (var s in sucursales)
                                {
                                    <option value="@s.Id">@s.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Almacén</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="form.AlmacenId">
                                <option value="">-- Sin almacén --</option>
                                @foreach (var a in almacenesFiltrados)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Observaciones</label>
                            <InputText class="form-control form-control-sm" @bind-Value="form.Observaciones" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Campos ocultos para TipoVenta y PedidoVentaId -->
            <input type="hidden" @bind="form.TipoVenta" />
            @if (form.PedidoVentaId.HasValue)
            {
                <input type="hidden" @bind="form.PedidoVentaId" />
            }

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person me-1"></i> Cliente Comercial</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                        <i class="bi bi-person-plus me-1"></i> Registro rápido (próximamente)
                    </button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8 position-relative">
                            <label class="form-label">Cliente</label>
                            <div class="input-group input-group-sm">
                                <InputText class="form-control"
                                           placeholder="Buscar cliente por nombre o NIT..."
                                           @bind-Value="clienteBusquedaTexto"
                                           @bind-Value:after="OnClienteBusquedaTextoChanged"
                                           @onfocus="OnClienteBusquedaFocused" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="BuscarClientePorNit">
                                    Buscar por NIT
                                </button>
                            </div>

                            @if (mostrarResultadosClientes && clientesFiltradosBusqueda.Count > 0)
                            {
                                <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 260px; overflow-y: auto;">
                                    @foreach (var c in clientesFiltradosBusqueda)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action"
                                                @onclick="(() => SeleccionarClienteBusqueda(c))">
                                            <div class="fw-semibold">@c.RazonSocial</div>
                                            <small class="text-muted">@c.Codigo · NIT: @(string.IsNullOrWhiteSpace(c.NIT) ? "S/N" : c.NIT)</small>
                                        </button>
                                    }
                                </div>
                            }

                            @if (form.ClienteId.HasValue && clienteSeleccionadoActual is not null)
                            {
                                <div class="form-text">
                                    Seleccionado: <span class="fw-semibold">@clienteSeleccionadoActual.RazonSocial</span>
                                </div>
                            }
                            else
                            {
                                <div class="form-text text-muted">Sin cliente seleccionado.</div>
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">NIT cliente (búsqueda rápida)</label>
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="nitBusquedaTexto"
                                       @bind-Value:event="oninput"
                                       placeholder="Ingrese NIT del cliente" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold"><i class="bi bi-box-seam me-1"></i> Detalle:</span>
                        <InputSelect class="form-select form-select-sm" style="width:auto;min-width:130px;"
                                     @bind-Value="form.TipoDetalleVenta"
                                     @bind-Value:after="OnTipoDetalleVentaChanged">
                            <option value="Producto">Producto</option>
                            <option value="Servicio">Servicio</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="card-body">
                    @* Buscador rápido *@
                    <div class="input-group input-group-sm mb-3">
                        <input type="text" class="form-control"
                               placeholder="Buscar por código, SKU o nombre del producto..."
                               @bind="busquedaRapidaTexto"
                               @bind:event="oninput"
                               @onfocus="OnBuscarProductoFocus"
                               @onkeydown="OnBusquedaRapidaKeyDown" />
                        <button type="button" class="btn btn-primary" @onclick="AgregarProductoPorBusquedaActual" disabled="@(string.IsNullOrWhiteSpace(busquedaRapidaTexto))">
                            <i class="bi bi-plus-circle me-1"></i> Adicionar
                        </button>
                    </div>

                    @if (sugerenciasBusqueda.Count > 0)
                    {
                        <div class="list-group shadow-sm mb-3" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var sug in sugerenciasBusqueda)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                        @onclick="() => AgregarProductoPorBusqueda(sug)">
                                    <div>
                                        <span class="fw-semibold">@sug.NombreComercial</span>
                                        <small class="text-muted d-block">@sug.Sku @(string.IsNullOrEmpty(sug.CodigoInterno) ? "" : $" | {sug.CodigoInterno}")</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">Agregar</span>
                                </button>
                            }
                        </div>
                    }

                    @if (form.Detalles.Count == 0)
                    {
                        <div class="text-center py-4 text-muted">Agregue líneas usando el buscador rápido.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0" style="font-size:0.85rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width:32px;">#</th>
                                        <th style="width:80px;">SKU</th>
                                        <th style="min-width:120px;">Producto / Servicio</th>
                                        <th style="min-width:100px;">Detalle</th>
                                        <th class="text-end" style="width:75px;">Cantidad</th>
                                        <th class="text-end" style="width:90px;">Precio Unit.</th>
                                        <th class="text-end" style="width:70px;">Descuento</th>
                                        <th class="text-end" style="width:90px;">Total</th>
                                        <th class="text-center" style="width:36px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < form.Detalles.Count; i++)
                                    {
                                        var det = form.Detalles[i];
                                        var idx = i;
                                        var productoNombre = ObtenerNombreProducto(det);
                                        var codigoSku = ObtenerCodigoSku(det);
                                        var esLineaRecienAgregada = det.Cantidad == 0 && string.IsNullOrWhiteSpace(det.DetalleAdicional);
                                        <tr style="@(esLineaRecienAgregada ? "background-color:#eef8ff;" : "")">
                                            <td class="text-center text-muted small">@(idx + 1)</td>
                                            <td><small class="text-muted">@codigoSku</small></td>
                                            <td><span class="fw-semibold">@(string.IsNullOrWhiteSpace(det.Descripcion) ? (productoNombre ?? "(sin descripción)") : det.Descripcion)</span></td>
                                            <td>
                                                <InputText class="form-control form-control-sm" placeholder="Seriales / observaciones..."
                                                           @bind-Value="det.DetalleAdicional" />
                                            </td>
                                            <td>
                                                <InputNumber class="form-control form-control-sm text-end" placeholder="Cant."
                                                             @bind-Value="det.Cantidad"
                                                             @bind-Value:after="RecalcularTotales" />
                                            </td>
                                            <td>
                                                <InputNumber class="form-control form-control-sm text-end" @bind-Value="det.PrecioUnitario"
                                                             @bind-Value:after="RecalcularTotales" />
                                            </td>
                                            <td>
                                                <InputNumber class="form-control form-control-sm text-end" @bind-Value="det.DescuentoPorcentaje"
                                                             @bind-Value:after="RecalcularTotales" />
                                            </td>
                                            <td class="text-end fw-semibold">@FormatMoney(CalcularTotalLinea(det))</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="() => RequestRemoveDetalleAsync(idx)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-receipt me-1"></i> Facturación
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="form.FacturacionDatos.Facturar" />
                                <label class="form-check-label">Facturar</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check mt-2">
                                <InputCheckbox class="form-check-input"
                                               Value="form.FacturacionDatos.FacturarAlMismoCliente"
                                               ValueChanged="OnFacturarAlMismoClienteChanged"
                                               ValueExpression="@(() => form.FacturacionDatos.FacturarAlMismoCliente)"
                                               disabled="@(!form.FacturacionDatos.Facturar || !form.ClienteId.HasValue)" />
                                <label class="form-check-label">Facturar al mismo cliente</label>
                            </div>
                        </div>

                        @if (form.FacturacionDatos.Facturar && !form.FacturacionDatos.FacturarAlMismoCliente)
                        {
                            <div class="col-md-6 position-relative">
                                <label class="form-label">Facturar a</label>
                                <InputSelect TValue="long?" class="form-select form-select-sm mb-2"
                                             Value="@GetPerfilFiscalSelectorValue()"
                                             ValueChanged="@OnPerfilFiscalChanged"
                                             ValueExpression="@(() => form.FacturacionDatos.ClientePerfilFiscalId)"
                                             disabled="@(!form.ClienteId.HasValue)">
                                    <option value="">-- Seleccione perfil fiscal --</option>
                                    <option value="@PerfilFiscalDatoOcasionalId">Nuevo dato de facturación</option>
                                    @foreach (var perfil in perfilesFiscalesCliente)
                                    {
                                        <option value="@perfil.Id">@perfil.Alias (@perfil.NumeroDocumento)@(perfil.EsPredeterminado ? " [Predeterminado]" : string.Empty)</option>
                                    }
                                </InputSelect>

                                <InputText class="form-control form-control-sm"
                                           placeholder="Buscar por razón social, NIT o alias..."
                                           @bind-Value="perfilFiscalBusquedaTexto"
                                           @bind-Value:after="OnRazonSocialBusquedaTextoChanged"
                                           @onfocus="OnRazonSocialBusquedaFocused"
                                           disabled="@(!form.ClienteId.HasValue)" />

                                @if (mostrarResultadosPerfilesFiscales && perfilesFiscalesFiltradosBusqueda.Count > 0)
                                {
                                    <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 260px; overflow-y: auto;">
                                        @foreach (var perfil in perfilesFiscalesFiltradosBusqueda)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action"
                                                    @onclick="(() => SeleccionarPerfilFiscalBusqueda(perfil))">
                                                <div class="fw-semibold">@perfil.RazonSocial</div>
                                                <small class="text-muted">@perfil.Alias · @perfil.NumeroDocumento</small>
                                            </button>
                                        }
                                    </div>
                                }

                                @if (form.ClienteId.HasValue && !perfilesFiscalesFiltradosBusqueda.Any() && !string.IsNullOrWhiteSpace(perfilFiscalBusquedaTexto))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="GuardarComoNuevoDatoFacturacionAsync">
                                        Guardar como nuevo dato de facturación
                                    </button>
                                }
                            </div>
                        }

                        <div class="col-md-3">
                            <label class="form-label">Tipo Documento</label>
                            <InputText class="form-control form-control-sm" @bind-Value="form.FacturacionDatos.TipoDocumentoIdentidad" disabled="@(!form.FacturacionDatos.Facturar)" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">NIT Factura</label>
                            <InputText class="form-control form-control-sm"
                                       placeholder="Ingrese NIT o documento"
                                       @bind-Value="form.FacturacionDatos.NitFactura"
                                       @bind-Value:after="OnNitFacturaChanged"
                                       disabled="@(!form.FacturacionDatos.Facturar)" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Complemento</label>
                            <InputText class="form-control form-control-sm" placeholder="Ingrese complemento (opcional)" @bind-Value="form.FacturacionDatos.Complemento" disabled="@(!form.FacturacionDatos.Facturar)" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Razón Social Factura</label>
                            <InputText class="form-control form-control-sm"
                                       placeholder="Ingrese razón social"
                                       @bind-Value="form.FacturacionDatos.RazonSocialFactura"
                                       @bind-Value:after="OnRazonSocialFacturaChanged"
                                       disabled="@(!form.FacturacionDatos.Facturar)" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Email Factura</label>
                            <InputText class="form-control form-control-sm" placeholder="correo@empresa.com" @bind-Value="form.FacturacionDatos.EmailFactura" disabled="@(!form.FacturacionDatos.Facturar)" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Teléfono Factura</label>
                            <InputText class="form-control form-control-sm" placeholder="Ingrese teléfono" @bind-Value="form.FacturacionDatos.TelefonoFactura" disabled="@(!form.FacturacionDatos.Facturar)" />
                        </div>

                        @if (DatosFiscalesModificadosManual)
                        {
                            <div class="col-12">
                                <div class="alert alert-info py-2 mb-0" role="alert">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Datos fiscales modificados para esta venta.
                                </div>
                            </div>
                        }

                        @if (!IsNew)
                        {
                            <div class="col-12">
                                @if (!HasValidFiscalData())
                                {
                                    <div class="alert alert-warning py-2 mb-0" role="alert">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Complete NIT y Razón Social para generar factura.
                                    </div>
                                }

                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @if (CanGenerateFactura())
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="RequestGenerarFacturaAsync" disabled="@isFacturaActionLoading">
                                            @if (isFacturaActionLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            <i class="bi bi-file-earmark-plus me-1"></i> Generar Factura
                                        </button>
                                    }

                                    @if (CanAnularFactura())
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RequestAnularFacturaAsync" disabled="@isFacturaActionLoading">
                                            @if (isFacturaActionLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            <i class="bi bi-file-earmark-x me-1"></i> Anular Factura
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (!IsNew && facturaActual is not null)
            {
                <div class="card shadow-sm mb-3 border-success">
                    <div class="card-header bg-success bg-opacity-10 fw-bold text-success">
                        <i class="bi bi-file-earmark-text me-1"></i> Resumen Factura Interna
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label text-muted">Número Factura</label>
                                <div class="fw-semibold">@facturaActual.NumeroFactura</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Fecha Emisión</label>
                                <div class="fw-semibold">@facturaActual.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">NIT</label>
                                <div class="fw-semibold">@facturaActual.NitFactura</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Razón Social</label>
                                <div class="fw-semibold">@facturaActual.RazonSocialFactura</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Total</label>
                                <div class="fw-bold text-primary">@FormatMoney(facturaActual.Total)</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Estado Factura</label>
                                <div><span class="@BadgeCssHelper.GetEstadoFacturaBadge(facturaActual.EstadoFactura)">@facturaActual.EstadoFactura</span></div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Estado SIAT</label>
                                <div><span class="badge @GetEstadoSiatBadge(facturaActual.EstadoSiat)">@facturaActual.EstadoSiat</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-cash-coin me-1"></i> Pagos Iniciales</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarPago">
                        <i class="bi bi-plus-circle me-1"></i> Agregar pago
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (IsNew)
                    {
                        <div class="alert alert-info m-3 mb-0 py-2" role="alert">
                            <i class="bi bi-info-circle me-1"></i>
                            Este pago se guardará al guardar la venta.
                        </div>
                    }

                    @if (form.Pagos.Count == 0)
                    {
                        <div class="text-center py-3 text-muted">Sin pagos iniciales.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Tipo Pago</th>
                                        <th>Modo Pago</th>
                                        <th class="text-end">Monto</th>
                                        <th>Moneda</th>
                                        <th class="text-end">Tipo Cambio</th>
                                        <th>Referencia</th>
                                        <th>CuentaCajaBancoId</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < form.Pagos.Count; i++)
                                    {
                                        var pago = form.Pagos[i];
                                        var pagoRegistrado = IsPagoRegistrado(pago);
                                        var isPagoGuardando = pagosEnGuardado.Contains(pago);
                                        <tr>
                                            <td><InputDate class="form-control form-control-sm" @bind-Value="pago.FechaPago" /></td>
                                            <td>
                                                <InputSelect class="form-select form-select-sm" @bind-Value="pago.TipoPago">
                                                    @foreach (var tipo in tipoPagoOptions)
                                                    {
                                                        <option value="@tipo">@tipo</option>
                                                    }
                                                </InputSelect>
                                            </td>
                                            <td>
                                                <InputSelect class="form-select form-select-sm" @bind-Value="pago.ModoPago">
                                                    @foreach (var modo in modoPagoOptions)
                                                    {
                                                        <option value="@modo">@modo</option>
                                                    }
                                                </InputSelect>
                                            </td>
                                            <td><InputNumber class="form-control form-control-sm text-end" @bind-Value="pago.Monto" @bind-Value:after="RecalcularTotales" /></td>
                                            <td><InputText class="form-control form-control-sm" @bind-Value="pago.MonedaCodigo" /></td>
                                            <td><InputNumber class="form-control form-control-sm text-end" @bind-Value="pago.TipoCambio" /></td>
                                            <td><InputText class="form-control form-control-sm" @bind-Value="pago.Referencia" /></td>
                                            <td><InputNumber class="form-control form-control-sm" @bind-Value="pago.CuentaCajaBancoId" /></td>
                                            <td>
                                                @if (pagoRegistrado)
                                                {
                                                    <span class="badge bg-success">Registrado</span>
                                                }
                                                else if (IsNew)
                                                {
                                                    <span class="badge bg-secondary">Pendiente local</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Pendiente de guardar</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (!pagoRegistrado && !IsNew)
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-success btn-sm me-1"
                                                            title="Guardar pago"
                                                            disabled="@isPagoGuardando"
                                                            @onclick="() => GuardarPagoAsync(pago)">
                                                        @if (isPagoGuardando)
                                                        {
                                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-check2-circle"></i>
                                                        }
                                                        <span class="ms-1">Guardar pago</span>
                                                    </button>
                                                }

                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Eliminar pago"
                                                        disabled="@pagoRegistrado"
                                                        @onclick="() => RemovePagoLocal(pago)"
                                                        @onclick:stopPropagation="true">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-calculator me-1"></i> Resumen
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label text-muted">Subtotal</label>
                            <div class="fw-semibold text-end">@FormatMoney(resumen.Subtotal)</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted">Descuento Total</label>
                            <div class="fw-semibold text-end">@FormatMoney(resumen.DescuentoTotal)</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted">Impuesto Total</label>
                            <div class="fw-semibold text-end">@FormatMoney(resumen.ImpuestoTotal)</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted">Total</label>
                            <div class="fw-bold text-end text-primary">@FormatMoney(resumen.Total)</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted">Total Pagado</label>
                            <div class="fw-semibold text-end">@FormatMoney(resumen.TotalPagado)</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted">Saldo</label>
                            <div class="fw-bold text-end @(resumen.Saldo > 0 ? "text-warning" : "text-success")">@FormatMoney(resumen.Saldo)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-4">
                <button type="button" class="btn btn-outline-info" @onclick="AbrirModalImprimir" disabled="@isSaving">
                    <i class="bi bi-printer me-1"></i> @(IsNew ? "Vista previa" : "Imprimir Venta")
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="VolverListado" disabled="@isSaving">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </button>

                @if (!IsNew)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="RequestAnularAsync" disabled="@isSaving">
                        <i class="bi bi-x-circle me-1"></i> Anular
                    </button>

                    <button type="button" class="btn btn-outline-success" @onclick="RequestConfirmarAsync" disabled="@isSaving">
                        <i class="bi bi-check-circle me-1"></i> Confirmar
                    </button>
                }

                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    <i class="bi bi-save me-1"></i> Guardar borrador
                </button>
            </div>
        </EditForm>
    }
</div>

@if (showModalImprimir)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, .5);" @onclick:stopPropagation>
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content" style="border:none; border-radius:0;">
                <div class="modal-header d-print-none" style="background:#1a1a2e; color:white; border-radius:0; padding:10px 20px;">
                    <h5 class="modal-title mb-0" style="font-size:1rem;"><i class="bi bi-printer me-2"></i>Vista previa de impresión</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalImprimir" style="font-size:0.8rem;"></button>
                </div>

                @* ═══════ COMPROBANTE IMPRIMIBLE ═══════ *@
                <div class="modal-body p-4" id="venta-print-area">

                    @* Encabezado corporativo *@
                    <div class="text-center mb-4" style="border-bottom:2px solid #1a1a2e; padding-bottom:12px;">
                        <h3 class="mb-0" style="font-weight:600; letter-spacing:1px; color:#1a1a2e;">NOTA DE VENTA</h3>
                        <div style="font-size:0.85rem; color:#555; margin-top:4px;">@form.NumeroVentaVisual</div>
                    </div>

                    @* Datos generales *@
                    <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:0.8rem; line-height:1.7;">
                        <div style="width:48%;">
                            <div><strong>Cliente:</strong> @(clienteSeleccionadoActual?.RazonSocial ?? "-")</div>
                            <div><strong>NIT:</strong> @(clienteSeleccionadoActual?.NIT ?? "-")</div>
                            <div><strong>Dirección:</strong> @(clienteSeleccionadoActual?.Direccion ?? "-")</div>
                        </div>
                        <div style="width:48%; text-align:right;">
                            <div><strong>Fecha:</strong> @form.FechaVenta.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            <div><strong>Vto. Pago:</strong> @(form.FechaVencimientoPago?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</div>
                            <div><strong>Moneda:</strong> @form.MonedaCodigo <span style="color:#888;">TC: @form.TipoCambio.ToString("N4")</span></div>
                        </div>
                    </div>

                    <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:0.78rem; color:#555; line-height:1.6;">
                        <div style="width:48%;"><strong>Sucursal:</strong> @ObtenerNombreSucursal()</div>
                        <div style="width:48%; text-align:right;"><strong>Almacén:</strong> @ObtenerNombreAlmacen()</div>
                    </div>

                    @* Tabla detalle *@
                    <table style="width:100%; border-collapse:collapse; font-size:0.78rem; margin-bottom:16px;">
                        <thead>
                            <tr style="background:#f0f0f0; border-bottom:1px solid #ccc;">
                                <th style="padding:5px 4px; text-align:center; width:28px;">#</th>
                                <th style="padding:5px 4px; text-align:left; width:60px;">SKU</th>
                                <th style="padding:5px 4px; text-align:left;">Producto / Servicio</th>
                                <th style="padding:5px 4px; text-align:left;">Detalle</th>
                                <th style="padding:5px 4px; text-align:right; width:52px;">Cant.</th>
                                <th style="padding:5px 4px; text-align:right; width:68px;">P.Unit</th>
                                <th style="padding:5px 4px; text-align:right; width:55px;">Desc.</th>
                                <th style="padding:5px 4px; text-align:right; width:72px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < form.Detalles.Count; i++)
                            {
                                var d = form.Detalles[i];
                                <tr style="border-bottom:1px solid #eee;">
                                    <td style="padding:4px; text-align:center;">@(i + 1)</td>
                                    <td style="padding:4px; text-align:left;">@ObtenerCodigoSku(d)</td>
                                    <td style="padding:4px; text-align:left;">@d.Descripcion</td>
                                    <td style="padding:4px; text-align:left;">@(d.DetalleAdicional ?? "")</td>
                                    <td style="padding:4px; text-align:right;">@d.Cantidad.ToString("N2")</td>
                                    <td style="padding:4px; text-align:right;">@FormatMoney(d.PrecioUnitario)</td>
                                    <td style="padding:4px; text-align:right;">@FormatMoney(d.DescuentoPorcentaje > 0 ? (d.Cantidad * d.PrecioUnitario * d.DescuentoPorcentaje / 100m) + d.DescuentoMonto : d.DescuentoMonto)</td>
                                    <td style="padding:4px; text-align:right; font-weight:600;">@FormatMoney(CalcularTotalLinea(d))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td colspan="7" style="padding:4px; text-align:right; font-weight:600; border-top:2px solid #1a1a2e;">Subtotal</td><td style="padding:4px; text-align:right; border-top:2px solid #1a1a2e;">@FormatMoney(resumen.Subtotal)</td></tr>
                            <tr><td colspan="7" style="padding:4px; text-align:right;">Descuento</td><td style="padding:4px; text-align:right;">@FormatMoney(resumen.DescuentoTotal)</td></tr>
                            <tr style="background:#f8f8f8;"><td colspan="7" style="padding:6px 4px; text-align:right; font-weight:700; font-size:0.9rem;">TOTAL</td><td style="padding:6px 4px; text-align:right; font-weight:700; font-size:0.9rem;">@FormatMoney(resumen.Total)</td></tr>
                        </tfoot>
                    </table>

                    @if (!string.IsNullOrWhiteSpace(form.Observaciones))
                    {
                        <div style="margin-top:8px; font-size:0.78rem; color:#555; border-top:1px dashed #ccc; padding-top:8px;">
                            <strong>Observaciones:</strong> @form.Observaciones
                        </div>
                    }

                    @* Pie corporativo *@
                    <div style="margin-top:20px; text-align:center; font-size:0.7rem; color:#999; border-top:1px solid #ddd; padding-top:10px;">
                        Documento generado por AgoraHUB360 ERP — @DateTime.Now.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="modal-footer d-print-none" style="border-top:1px solid #eee; padding:10px 20px;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarModalImprimir" style="border-radius:0;">Cerrar</button>
                    <button type="button" class="btn btn-sm" style="background:#1a1a2e; color:white; border-radius:0;" @onclick="EjecutarImpresion">
                        <i class="bi bi-printer me-1"></i> Imprimir
                    </button>
                    <button type="button" class="btn btn-sm" style="background:#dc3545; color:white; border-radius:0;" @onclick="GenerarPdfAsync">
                        <i class="bi bi-filetype-pdf me-1"></i> PDF
                    </button>
                </div>
            </div>
        </div>
    </div>
}

