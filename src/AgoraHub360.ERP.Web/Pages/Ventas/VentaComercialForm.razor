    private async Task GuardarComoNuevoDatoFacturacionAsync()
    {
        if (!form.ClienteId.HasValue)
        {
            ShowWarningModal("Seleccione un cliente antes de guardar un dato de facturación.");
            return;
        }

        if (string.IsNullOrWhiteSpace(form.FacturacionDatos.NitFactura)
            || string.IsNullOrWhiteSpace(form.FacturacionDatos.RazonSocialFactura))
        {
            ShowWarningModal("Complete NIT y Razón Social para guardar el dato de facturación.");
            return;
        }

        var createDto = new CreateClientePerfilFiscalDto
        {
            Alias = string.IsNullOrWhiteSpace(perfilFiscalBusquedaTexto)
                ? form.FacturacionDatos.RazonSocialFactura ?? "Dato fiscal"
                : perfilFiscalBusquedaTexto,
            TipoDocumentoIdentidad = string.IsNullOrWhiteSpace(form.FacturacionDatos.TipoDocumentoIdentidad)
                ? "NIT"
                : form.FacturacionDatos.TipoDocumentoIdentidad!,
            NumeroDocumento = form.FacturacionDatos.NitFactura!,
            Complemento = form.FacturacionDatos.Complemento,
            RazonSocial = form.FacturacionDatos.RazonSocialFactura!,
            EmailFactura = form.FacturacionDatos.EmailFactura,
            TelefonoFactura = form.FacturacionDatos.TelefonoFactura,
            RequiereEmail = false,
            EsPredeterminado = false
        };

        var response = await ClientePerfilFiscalService.CreateAsync(form.ClienteId.Value, createDto);
        if (!response.Success || response.Data is null)
        {
            ShowErrorModal(response.Message ?? "No se pudo guardar el nuevo dato de facturación.");
            return;
        }

        await LoadPerfilesFiscalesAsync(form.ClienteId, preserveCurrentSelection: false);
        ApplyPerfilFiscal(response.Data, markExplicitSelection: true);
        ShowSuccessModal("Dato de facturación registrado correctamente.");
    }

