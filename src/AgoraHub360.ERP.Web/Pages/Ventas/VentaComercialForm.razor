    private Task RequestGenerarFacturaAsync()
    {
        if (!form.Id.HasValue)
            return Task.CompletedTask;

        ShowConfirmModal(
            "Generar factura",
            "¿Desea generar la factura interna de esta venta?",
            ExecuteGenerarFacturaAsync);

        return Task.CompletedTask;
    }

    private async Task ExecuteGenerarFacturaAsync()
    {
        if (!form.Id.HasValue) return;

        isFacturaActionLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await FacturaVentaService.GenerarAsync(new GenerarFacturaVentaRequestDto
            {
                VentaId = form.Id.Value,
                TipoDocumentoFactura = "Factura",
                NitFactura = form.FacturacionDatos.NitFactura,
                Complemento = form.FacturacionDatos.Complemento,
                RazonSocialFactura = form.FacturacionDatos.RazonSocialFactura,
                EmailFactura = form.FacturacionDatos.EmailFactura,
                TelefonoFactura = form.FacturacionDatos.TelefonoFactura,
                Observaciones = form.Observaciones
            });

            if (!response.Success || response.Data is null)
            {
                ShowErrorModal(BuildErrorMessage(response));
                return;
            }

            ShowSuccessModal("Factura interna generada correctamente.");
            await LoadVentaAsync(form.Id.Value);
            await LoadFacturaAsync(form.Id.Value);
            RecalcularTotales();
        }

        catch (Exception ex)
        {
            ShowErrorModal($"No se pudo generar la factura: {ex.Message}");
        }
        finally
        {
            isFacturaActionLoading = false;
        }
    }

    private bool IsPagoRegistrado(VentaPagoDto pago)
        => pago is not null && pagosCargadosDesdeBackend.Contains(pago);

    private async Task GuardarPagoAsync(VentaPagoDto pago)
    {
        if (pago is null)
            return;

        if (IsNew || !form.Id.HasValue || form.Id.Value <= 0)
        {
            ShowWarningModal("Guarde la venta antes de registrar pagos independientes.");
            return;
        }

        if (IsPagoRegistrado(pago))
        {
            ShowWarningModal("Este pago ya está registrado.");
            return;
        }

        var pagoValidation = ValidatePagoForRegistro(pago);
        if (!string.IsNullOrWhiteSpace(pagoValidation))
        {
            ShowWarningModal(pagoValidation);
            return;
        }

        pagosEnGuardado.Add(pago);

        try
        {
            var response = await VentaService.RegistrarPagoAsync(form.Id.Value, new RegistrarPagoVentaRequestDto
            {
                FechaPago = pago.FechaPago,
                TipoPago = pago.TipoPago,
                ModoPago = pago.ModoPago,
                CuentaCajaBancoId = pago.CuentaCajaBancoId,
                Monto = pago.Monto,
                MonedaId = pago.MonedaId,
                MonedaCodigo = pago.MonedaCodigo,
                TipoCambio = pago.TipoCambio,
                Referencia = pago.Referencia,
                EstadoPago = string.IsNullOrWhiteSpace(pago.EstadoPago) ? "Pagado" : pago.EstadoPago
            });

            if (!response.Success || response.Data is null)
            {
                ShowErrorModal(BuildErrorMessage(response));
                return;
            }

            await LoadVentaAsync(form.Id.Value);
            RecalcularTotales();
            ShowSuccessModal("Pago registrado correctamente.");
        }
        catch (Exception ex)
        {
            ShowErrorModal($"No se pudo registrar el pago: {ex.Message}");
        }
        finally
        {
            pagosEnGuardado.Remove(pago);
        }
    }

    private string? ValidatePagoForRegistro(VentaPagoDto pago)
    {
        if (pago.Monto <= 0)
            return "El monto del pago debe ser mayor a cero.";

        if (string.IsNullOrWhiteSpace(pago.ModoPago))
            return "Debe seleccionar el modo de pago.";

        if (string.IsNullOrWhiteSpace(pago.TipoPago))
            return "Debe seleccionar el tipo de pago.";

        if (pago.FechaPago == default || pago.FechaPago.Year < 2000)
            return "Debe ingresar una fecha de pago válida.";

        var saldoPendienteRegistrable = ObtenerSaldoPendienteRegistrable();
        if (pago.Monto > saldoPendienteRegistrable)
            return $"El monto no puede ser mayor al saldo pendiente ({FormatMoney(saldoPendienteRegistrable)}).";

        return null;
    }

    private decimal ObtenerSaldoPendienteRegistrable()
    {
        var totalRegistrado = form.Pagos
            .Where(IsPagoRegistrado)
            .Sum(x => x.Monto);

        var saldo = resumen.Total - totalRegistrado;
        return saldo <= 0 ? 0 : decimal.Round(saldo, 2);
    }

    private async Task OnClienteChanged(int? clienteId)
    {
        form.ClienteId = clienteId;
        SincronizarClienteSeleccionado();
        mostrarResultadosClientes = false;
        await LoadPerfilesFiscalesAsync(clienteId, preserveCurrentSelection: false);

        if (clienteId.HasValue)
        {
            try
            {
                var config = await CreditoConfigService.GetByClienteAsync(clienteId.Value);
                if (config != null && config.CreditoHabilitado && config.DiasCredito > 0)
                {
                    if (!fechaVencimientoModificadaManualmente)
                    {
                        form.FechaVencimientoPago = form.FechaVenta.AddDays(config.DiasCredito);
                    }
                }
                else
                {
                    if (!fechaVencimientoModificadaManualmente)
                    {
                        form.FechaVencimientoPago = form.FechaVenta;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al sugerir fecha de vencimiento por crédito: {ex.Message}");
            }
        }
        else
        {
            if (!fechaVencimientoModificadaManualmente)
            {
                form.FechaVencimientoPago = form.FechaVenta;
            }
        }
    }

