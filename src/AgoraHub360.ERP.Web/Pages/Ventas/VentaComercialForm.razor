@code {
    [Parameter] public long? Id { get; set; }

    private bool IsNew => !Id.HasValue || Id.Value == 0;

    private readonly VentaFormModel form = new();
    private readonly VentaResumenUx resumen = new();

    private List<MdmClienteDto> clientes = new();
    private List<MdmClienteDto> clientesFiltradosBusqueda = new();
    private MdmClienteDto? clienteSeleccionadoActual;
    private List<ClientePerfilFiscalDto> perfilesFiscalesCliente = new();
    private List<SucursalListadoDto> sucursales = new();
    private List<AlmacenDto> almacenes = new();
    private List<AlmacenDto> almacenesFiltrados = new();
    private List<CompanyProductDto> productos = new();
    private Dictionary<long, ProductDto2> productosBasePorId = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool isFacturaActionLoading;
    private string? errorMessage;
    private string? successMessage;
    private FacturaVentaDto? facturaActual;
    private HashSet<VentaPagoDto> pagosCargadosDesdeBackend = new();
    private HashSet<VentaPagoDto> pagosEnGuardado = new();
    private const long PerfilFiscalDatoOcasionalId = -1;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;
    private string modalType = "info";
    private bool showModal;
    private Func<Task>? pendingConfirmAction;
    private string clienteBusquedaTexto = string.Empty;
    private string nitBusquedaTexto = string.Empty;
    private bool mostrarResultadosClientes;
    private string perfilFiscalBusquedaTexto = string.Empty;
    private bool mostrarResultadosPerfilesFiscales;
    private List<ClientePerfilFiscalDto> perfilesFiscalesFiltradosBusqueda = new();
    private bool nitFacturaEditadoManual;
    private bool razonSocialFacturaEditadaManual;
    private bool suppressFiscalManualTracking;
    private bool fechaVencimientoModificadaManualmente;
    private bool showModalImprimir;
    private string busquedaRapidaTexto = string.Empty;
    private List<CompanyProductDto> sugerenciasBusqueda = new();

    private void MostrarMensajeImprimirBorrador()
    {
        errorMessage = "Debe guardar la venta antes de imprimir.";
    }

    private void AbrirModalImprimir()
    {
        if (IsNew || !form.Id.HasValue || form.Id.Value <= 0)
        {
            errorMessage = "Debe guardar la venta antes de imprimir.";
            return;
        }
        showModalImprimir = true;
    }

    private void CerrarModalImprimir()
    {
        showModalImprimir = false;
    }

    private async Task EjecutarImpresion()
    {
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task GenerarPdfAsync()
    {
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task CopiarAlPortapapelesYDescargar()
    {
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private string ObtenerNombreSucursal()
    {
        if (form.SucursalId <= 0) return "-";
        var s = sucursales.FirstOrDefault(x => x.Id == form.SucursalId);
        return s?.Nombre ?? "-";
    }

    private string ObtenerNombreAlmacen()
    {
        if (!form.AlmacenId.HasValue) return "-";
        var a = almacenes.FirstOrDefault(x => x.Id == form.AlmacenId.Value);
        return a?.Nombre ?? "-";
    }

    private void OnBuscarProductoFocus()
    {
        if (!form.AlmacenId.HasValue)
            return;

        MostrarSugerenciasTop20();
    }

    private void MostrarSugerenciasTop20()
    {
        var catalogo = string.Equals(form.TipoDetalleVenta, "Servicio", StringComparison.OrdinalIgnoreCase)
            ? serviciosCatalogados
            : productosCatalogados;

        var termino = (busquedaRapidaTexto ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(termino))
        {
            sugerenciasBusqueda = catalogo.Take(20).ToList();
            return;
        }

        sugerenciasBusqueda = catalogo
            .Where(p =>
                (p.Sku?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.CodigoInterno?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.NombreComercial?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(20)
            .ToList();
    }

    private async Task OnBusquedaRapidaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AgregarProductoPorBusquedaActual();
        }
        else if (e.Key == "Escape")
        {
            sugerenciasBusqueda = new();
        }
        else
        {
            MostrarSugerenciasTop20();
        }
        await Task.CompletedTask;
    }

    private async Task AgregarProductoPorBusquedaActual()
    {
        var termino = (busquedaRapidaTexto ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(termino))
        {
            ShowWarningModal("Ingrese un código, nombre o SKU para buscar.");
            return;
        }

        if (!form.AlmacenId.HasValue)
        {
            ShowWarningModal("Seleccione un almacén en Datos de Venta para consultar disponibilidad.");
            return;
        }

        // Buscar coincidencia exacta primero
        var catalogo = string.Equals(form.TipoDetalleVenta, "Servicio", StringComparison.OrdinalIgnoreCase)
            ? serviciosCatalogados
            : productosCatalogados;

        var exacta = catalogo.FirstOrDefault(p =>
            string.Equals(p.Sku, termino, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(p.CodigoInterno, termino, StringComparison.OrdinalIgnoreCase));

        if (exacta is not null)
        {
            await AgregarProductoPorBusqueda(exacta);
            return;
        }

        // Coincidencia parcial — mostrar sugerencias
        MostrarSugerenciasTop20();
        if (sugerenciasBusqueda.Count == 1)
        {
            await AgregarProductoPorBusqueda(sugerenciasBusqueda[0]);
        }
        else if (sugerenciasBusqueda.Count == 0)
        {
            ShowWarningModal("No se encontraron productos con el criterio ingresado.");
        }
    }

    private async Task AgregarProductoPorBusqueda(CompanyProductDto producto)
    {
        if (producto is null)
            return;

        var esServicio = serviciosCatalogados.Any(s => s.CompanyProductId == producto.CompanyProductId);
        var tipoItem = esServicio ? "Servicio" : "Producto";

        // Verificar tipo único
        if (!string.Equals(tipoItem, form.TipoDetalleVenta, StringComparison.OrdinalIgnoreCase))
        {
            ShowWarningModal($"No puede agregar un {tipoItem} porque la venta está configurada para {form.TipoDetalleVenta}s.");
            return;
        }

        // Si ya existe en la grilla, aumentar cantidad
        var existente = form.Detalles.FirstOrDefault(d => d.CompanyProductId == producto.CompanyProductId);
        if (existente is not null)
        {
            existente.Cantidad += 1;
            RecalcularTotales();
            busquedaRapidaTexto = string.Empty;
            sugerenciasBusqueda = new();
            return;
        }

        form.Detalles.Add(new VentaDetalleDto
        {
            TipoItemVenta = tipoItem,
            CompanyProductId = producto.CompanyProductId,
            AlmacenId = esServicio ? null : form.AlmacenId,
            Descripcion = producto.NombreComercial ?? string.Empty,
            DetalleAdicional = string.Empty,
            Cantidad = 0,
            PrecioUnitario = 0m,
            DescuentoPorcentaje = 0,
            DescuentoMonto = 0,
            ImpuestoMonto = 0,
            DescuentaInventario = !esServicio
        });

        RecalcularTotales();
        busquedaRapidaTexto = string.Empty;
        sugerenciasBusqueda = new();
        await Task.CompletedTask;
    }

