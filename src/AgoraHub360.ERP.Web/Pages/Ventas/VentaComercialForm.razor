    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogosAsync();

        if (!IsNew)
        {
            await LoadVentaAsync(Id!.Value);
            await LoadFacturaAsync(Id!.Value);
        }
        else
        {
            form.MonedaCodigo = "BOB";
            form.TipoCambio = 1m;
            form.FechaVenta = DateTime.Now;
            form.TipoVenta = "Directa";
            pagosCargadosDesdeBackend.Clear();
