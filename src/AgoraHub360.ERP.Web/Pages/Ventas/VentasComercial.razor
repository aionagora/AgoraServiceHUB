@page "/ventas/comercial"
@attribute [Authorize]
@using AgoraHub360.ERP.Web.Helpers
@using AgoraHub360.ERP.Shared.DTOs
@using AgoraHub360.ERP.Shared.DTOs.Ventas
@using AgoraHub360.ERP.Shared.DTOs.MDM
@inject VentaHttpService VentaService
@inject ClienteHttpService ClienteService
@inject NavigationManager Nav
@inject FacturaVentaHttpService FacturaVentaService

<PageTitle>Ventas Comercial - AgoraHub360 ERP</PageTitle>

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="mb-0">Ventas Comercial</h1>
        <p class="text-muted mb-0">Ventas &rsaquo; Comercial</p>
    </div>
    <button class="btn btn-primary" @onclick="GoToNueva">
        <i class="bi bi-plus-circle me-1"></i> Nueva venta
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i>@successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<!-- Panel de Filtros -->
<form @onsubmit="BuscarAsync" @onsubmit:preventDefault class="card border-0 shadow-sm mb-4 bg-white text-dark">
    <div class="card-body p-3">
        <h5 class="card-title mb-3 fs-6 fw-bold text-dark"><i class="bi bi-funnel-fill me-1 text-primary"></i> Filtros de Búsqueda</h5>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input type="text" class="form-control form-control-sm text-dark bg-light" placeholder="Nro venta, cliente..." @bind="filterBusqueda" />
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small text-muted mb-1">Cliente</label>
                <select class="form-select form-select-sm text-dark" @bind="filterClienteId">
                    <option value="">-- Todos los Clientes --</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Id">@c.RazonSocial (@c.Codigo)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Estado Venta</label>
                <select class="form-select form-select-sm text-dark" @bind="filterEstadoVenta">
                    <option value="">-- Todos --</option>
                    <option value="Borrador">Borrador</option>
                    <option value="Confirmada">Confirmada</option>
                    <option value="Facturada">Facturada</option>
                    <option value="Anulada">Anulada</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Estado Pago</label>
                <select class="form-select form-select-sm text-dark" @bind="filterEstadoPago">
                    <option value="">-- Todos --</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Parcial">Parcial</option>
                    <option value="Pagado">Pagado</option>
                    <option value="Anulado">Anulado</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Fecha Desde</label>
                <input type="date" class="form-control form-control-sm" @bind="filterFechaDesde" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Fecha Hasta</label>
                <input type="date" class="form-control form-control-sm" @bind="filterFechaHasta" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Top</label>
                <select class="form-select form-select-sm text-dark" @bind="topLimit">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Tam. Página</label>
                <select class="form-select form-select-sm text-dark" @bind="tamanoPagina">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2 justify-content-end">
                <button type="submit" class="btn btn-primary btn-sm px-4" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                    }
                    Buscar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltrosAsync" disabled="@isLoading" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
                </button>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <span>Listado de Ventas</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">
            <i class="bi bi-arrow-repeat me-1"></i> Recargar
        </button>
    </div>
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 mb-0">Cargando ventas...</p>
            </div>
        }
        else if (ventas.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt-cutoff" style="font-size: 3rem; color: var(--agora-text-light);"></i>
                <p class="text-muted mt-3 mb-0">No hay ventas registradas.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Tipo</th>
                            <th>Estado Venta</th>
                            <th>Estado Pago</th>
                            <th class="text-end">Total</th>
                            <th>Factura</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venta in ventas)
                        {
                            <tr>
                                <td class="fw-semibold">@venta.NumeroVenta</td>
                                <td>@venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(string.IsNullOrWhiteSpace(venta.ClienteNombre) ? "-" : venta.ClienteNombre)</td>
                                <td>
                                    <span class="badge bg-secondary">@venta.TipoVenta</span>
                                </td>
                                <td>
                                    <span class="@BadgeCssHelper.GetEstadoVentaBadge(venta.EstadoVenta)">@venta.EstadoVenta</span>
                                </td>
                                <td>
                                    <span class="@BadgeCssHelper.GetEstadoPagoBadge(venta.EstadoPago)">@venta.EstadoPago</span>
                                </td>
                                <td class="text-end fw-semibold">@FormatMoney(venta.Total)</td>
                                <td>
                                    <span class="badge @(venta.FacturaGenerada ? "bg-success" : "bg-secondary")">
                                        @(venta.FacturaGenerada ? "Generada" : "Sin generar")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToDetalle(venta.Id)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    @if (!IsAnulada(venta.EstadoVenta) && !IsBorrador(venta.EstadoVenta))
                                    {
                                        <button class="btn btn-sm btn-outline-success ms-1"
                                                @onclick="() => GoToPago(venta.Id)"
                                                title="Registrar pago">
                                            <i class="bi bi-cash-coin"></i>
                                        </button>
                                    }

                                    @if (IsBorrador(venta.EstadoVenta))
                                    {
                                        <button class="btn btn-sm btn-outline-success ms-1"
                                                @onclick="() => ConfirmarAsync(venta.Id)"
                                                disabled="@isActionLoading">
                                            <i class="bi bi-check2-circle"></i>
                                        </button>
                                    }

                                    @if (!IsAnulada(venta.EstadoVenta))
                                    {
                                        <button class="btn btn-sm btn-outline-danger ms-1"
                                                @onclick="() => AnularAsync(venta.Id)"
                                                disabled="@isActionLoading">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!-- Paginación UI -->
            <div class="card-footer bg-white border-top d-flex align-items-center justify-content-between p-3">
                <div class="text-muted small">
                    Mostrando de @(totalRegistros > 0 ? (paginaActual - 1) * tamanoPagina + 1 : 0) a @(Math.Min(paginaActual * tamanoPagina, totalRegistros)) de @totalRegistros registros
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PaginaAnterior" disabled="@(paginaActual <= 1 || isLoading)">
                        <i class="bi bi-chevron-left me-1"></i> Anterior
                    </button>
                    <span class="small fw-semibold text-dark">Página @paginaActual de @totalPaginas</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas || isLoading)">
                        Siguiente <i class="bi bi-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<VentaResumenDto> ventas = new();
    private bool isLoading;
    private bool isActionLoading;
    private string? errorMessage;
    private string? successMessage;

    // Filtros
    private int? filterClienteId;
    private string? filterEstadoVenta;
    private string? filterEstadoPago;
    private DateTime? filterFechaDesde;
    private DateTime? filterFechaHasta;
    private string? filterBusqueda;
    private int topLimit = 100;
    private int paginaActual = 1;
    private int tamanoPagina = 50;
    private int totalRegistros = 0;
    private int totalPaginas = 1;
    private List<AgoraHub360.ERP.Shared.DTOs.MDM.ClienteDto> clientes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await ClienteService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar clientes: {ex.Message}";
        }
        await LoadAsync();
    }

    private async Task BuscarAsync()
    {
        paginaActual = 1;
        await LoadAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filterClienteId = null;
        filterEstadoVenta = null;
        filterEstadoPago = null;
        filterFechaDesde = null;
        filterFechaHasta = null;
        filterBusqueda = null;
        topLimit = 100;
        paginaActual = 1;

        await LoadAsync();
    }

    private async Task PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await LoadAsync();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var filter = new VentaFilterDto
            {
                Busqueda = filterBusqueda,
                ClienteId = filterClienteId,
                EstadoVenta = filterEstadoVenta,
                EstadoPago = filterEstadoPago,
                FechaDesde = filterFechaDesde,
                FechaHasta = filterFechaHasta,
                Top = topLimit,
                Pagina = paginaActual,
                TamanoPagina = tamanoPagina
            };

            var response = await VentaService.GetAllAsync(filter);
            ventas.Clear();
            if (response.Success && response.Data != null)
            {
                ventas.AddRange(response.Data.Items);
                totalRegistros = response.Data.TotalItems;
                totalPaginas = response.Data.TotalPaginas;
            }
            else
            {
                errorMessage = response.Message ?? "Error al listar ventas.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el listado de ventas: {ex.Message}";
            ventas.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToNueva() => Nav.NavigateTo("/ventas/comercial/nueva");

        private void GoToDetalle(long id) => Nav.NavigateTo($"/ventas/comercial/{id}");

    private void GoToPago(long id) => Nav.NavigateTo($"/ventas/pagos/{id}");

    private async Task ConfirmarAsync(long id)
    {
        isActionLoading = true;
        errorMessage = null;
        successMessage = null;

        var response = await VentaService.ConfirmarAsync(id, new ConfirmarVentaRequestDto());
        if (response.Success)
        {
            successMessage = "Venta confirmada correctamente.";
            await LoadAsync();
        }
        else
        {
            errorMessage = response.Message ?? "No se pudo confirmar la venta.";
        }

        isActionLoading = false;
    }

    private async Task AnularAsync(long id)
    {
        isActionLoading = true;
        errorMessage = null;
        successMessage = null;

        var response = await VentaService.AnularAsync(id, new AnularVentaRequestDto
        {
            MotivoAnulacion = "Anulación desde listado comercial"
        });

        if (response.Success)
        {
            successMessage = "Venta anulada correctamente.";
            await LoadAsync();
        }
        else
        {
            errorMessage = response.Message ?? "No se pudo anular la venta.";
        }

        isActionLoading = false;
    }

    private static bool IsBorrador(string? estadoVenta)
        => string.Equals(estadoVenta, "Borrador", StringComparison.OrdinalIgnoreCase);

    private static bool IsAnulada(string? estadoVenta)
        => string.Equals(estadoVenta, "Anulada", StringComparison.OrdinalIgnoreCase)
           || string.Equals(estadoVenta, "Anulado", StringComparison.OrdinalIgnoreCase);

    private static string FormatMoney(decimal value)
        => FormatHelper.Money(value);
}
