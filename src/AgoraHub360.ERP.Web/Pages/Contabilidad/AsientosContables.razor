                    </div>
                </div>
                @if (!isViewing)
                {
                    <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-3" style="font-size:.72rem;color:#9ca3af">
                        <span><kbd>Ctrl</kbd>+<kbd>S</kbd> Guardar borrador</span>
                        <span><kbd>Ctrl</kbd>+<kbd>P</kbd> Vista previa</span>
                        <span><kbd>Enter</kbd> en Haber agrega l�nea</span>
                        <span><kbd>Esc</kbd> cerrar modales</span>
