    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        docErrorMsg = null;
        if (editingId == 0) { docErrorMsg = "Guarde el comprobante primero para adjuntar documentos."; return; }
        var file = e.File;
        if (adjuntos.Count >= MaxAdjuntos) { docErrorMsg = $"M�ximo {MaxAdjuntos} archivos."; return; }
        if (file.Size > MaxDocSizeBytes) { docErrorMsg = "El archivo excede el tama�o m�ximo (10 MB)."; return; }
        try
        {
            uploadingDoc = true;
            var buffer = new byte[file.Size];
            using var stream = file.OpenReadStream(MaxDocSizeBytes);
            await stream.ReadAsync(buffer);
            var ext = Path.GetExtension(file.Name)?.ToLower();
            var mime = ext switch
            {
                ".pdf"  => "application/pdf",
                ".jpg"  => "image/jpeg",
                ".jpeg" => "image/jpeg",
                ".png"  => "image/png",
                ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                ".xls"  => "application/vnd.ms-excel",
                _       => null
            };
            if (mime == null) { docErrorMsg = "Tipo de archivo no permitido."; return; }
            adjuntos.Add(new ComprobanteDocumentoDto
            {
                FileName = file.Name, MimeType = mime,
                SizeBytes = file.Size, Contenido = Convert.ToBase64String(buffer)
            });
        }
        catch (Exception ex) { docErrorMsg = $"Error al adjuntar: {ex.Message}"; }
        finally { uploadingDoc = false; }
    }

    private void RemoverDocumento(ComprobanteDocumentoDto doc) { if (!uploadingDoc) adjuntos.Remove(doc); }

    private async Task ExportarComprobanteFormato(string formato)
    {
        exportando = true; errorMessage = null;
        try
        {
            var numSafe = formNumero.Replace("/", "-").Replace("\\", "-");

            if (formato == "xlsx")
            {
                var fileBytes = await AsientoService.ExportarExcelIndividualAsync(editingId);
                if (fileBytes is { Length: > 0 })
                    await JS.InvokeVoidAsync("downloadFileFromBase64", $"Comprobante_{numSafe}.xlsx",
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                        Convert.ToBase64String(fileBytes));
                else errorMessage = "No se pudo generar el archivo Excel.";
                return;
            }

            if (formato == "xlsx-plano")
            {
                var fileBytes = await AsientoService.ExportarExcelPlanoAsync(search: formNumero);
                if (fileBytes is { Length: > 0 })
                    await JS.InvokeVoidAsync("downloadFileFromBase64", $"Comprobante_Plano_{numSafe}.xlsx",
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                        Convert.ToBase64String(fileBytes));
                else errorMessage = "No se pudo generar el archivo Excel plano.";
                return;
            }

            var dto = BuildDtoDesdeFormulario();
            var lista = new List<AsientoContableDto> { dto };
            string content; string fileName; string mimeType;
            switch (formato)
            {
                case "json": content = ExportFormatHelper.GenerarJsonPlano(lista);  fileName = $"Comprobante_{numSafe}.json"; mimeType = "application/json"; break;
                case "xml":  content = ExportFormatHelper.GenerarXmlPlano(lista);   fileName = $"Comprobante_{numSafe}.xml";  mimeType = "application/xml";  break;
                case "csv":  content = ExportFormatHelper.GenerarCsvListado(lista); fileName = $"Comprobante_{numSafe}.csv";  mimeType = "text/csv";         break;
                default: throw new Exception("Formato no reconocido.");
            }
            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, mimeType, Convert.ToBase64String(bytes));
            successMessage = $"Archivo {formato.ToUpper()} generado.";
        }
        catch (Exception ex) { errorMessage = $"Error al exportar: {ex.Message}"; }
        finally { exportando = false; }
    }

