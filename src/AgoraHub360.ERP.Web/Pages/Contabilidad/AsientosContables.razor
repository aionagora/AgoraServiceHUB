    private bool _preventDefaultKey;

    private decimal TotalDebe  => tempLineas.Sum(l => l.Debe);
    private decimal TotalHaber => tempLineas.Sum(l => l.Haber);

    private IEnumerable<CuentaContableDto> cuentasFiltradas =>
        string.IsNullOrWhiteSpace(searchCuenta)
            ? cuentasMov.Take(20)
            : cuentasMov.Where(c =>
                c.Codigo.Contains(searchCuenta, StringComparison.OrdinalIgnoreCase) ||
                c.Nombre.Contains(searchCuenta, StringComparison.OrdinalIgnoreCase)).Take(20);

    private bool BotonGuardarDeshabilitado =>
        saving || string.IsNullOrWhiteSpace(formGlosa) || tempLineas.Count < 2;

    private string TooltipGuardar =>
        saving ? "Guardando..." :
        string.IsNullOrWhiteSpace(formGlosa) ? "La glosa es obligatoria" :
        tempLineas.Count < 2 ? "Se requieren al menos 2 l�neas" :
        "Guardar como borrador (Ctrl+S)";

    private string TooltipContabilizar =>
        saving ? "Guardando..." :
        string.IsNullOrWhiteSpace(formGlosa) ? "La glosa es obligatoria" :
        tempLineas.Count < 2 ? "Se requieren al menos 2 l�neas" :
        "Guardar y contabilizar";

    private string BarraEstadoStyle =>
        tempLineas.Count == 0   ? "background:#f9fafb;color:#9ca3af" :
        TotalDebe == TotalHaber ? "background:#dcfce7;color:#15803d" :
                                  "background:#fee2e2;color:#b91c1c";

    private record TempLinea(
        long    CuentaId,
        string  CuentaCodigo,
        string  CuentaNombre,
        string? Glosa,
        decimal Debe,
        decimal Haber,
        int?    CentroCostoId,
        string? CentroCostoCodigo);

    private int paginaActual = 1;
    private int tamPagina    = 20;
    private int TotalPaginas => asientos.Count == 0 ? 1 : (int)Math.Ceiling(asientos.Count / (double)tamPagina);
    private List<AsientoContableDto> AsientosPagina =>
        asientos.Skip((paginaActual - 1) * tamPagina).Take(tamPagina).ToList();

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            const int maxVisible = 5;
            var pages = new List<int>();
            int start = Math.Max(1, paginaActual - 2);
            int end   = Math.Min(TotalPaginas, start + maxVisible - 1);
            start = Math.Max(1, end - maxVisible + 1);
            if (start > 1) { pages.Add(1); if (start > 2) pages.Add(-1); }
            for (int i = start; i <= end; i++) pages.Add(i);
            if (end < TotalPaginas) { if (end < TotalPaginas - 1) pages.Add(-1); pages.Add(TotalPaginas); }
            return pages;
        }
    }

    private void CambiarPagina(int p) { if (p >= 1 && p <= TotalPaginas) paginaActual = p; }
    private void OnTamPaginaChanged() => paginaActual = 1;

    private bool FiltrosActivos =>
        filtroDesde.HasValue || filtroHasta.HasValue
        || !string.IsNullOrEmpty(filtroEstado)
