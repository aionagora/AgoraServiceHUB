                            <button class="btn btn-primary" @onclick="GuardarYContabilizar"
                                    disabled="@BotonGuardarDeshabilitado" title="@TooltipContabilizar">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-check2-circle me-1"></i>Contabilizar
