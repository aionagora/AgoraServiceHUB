@page "/contabilidad/asientos"
@attribute [Authorize]
@inject AsientoContableHttpService AsientoService
@inject CuentaContableHttpService CuentaService
@inject IJSRuntime JS

<PageTitle>Asientos Contables - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-journal-text"></i> Asientos Contables</h3>
            <p class="text-muted mb-0">Libro Diario — Registro de comprobantes contables</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nuevo Asiento
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* ?? Filtros ?? *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Estado</label>
                    <select class="form-select form-select-sm" @bind="filtroEstado">
                        <option value="">Todos</option>
                        <option value="Borrador">Borrador</option>
                        <option value="Contabilizado">Contabilizado</option>
                        <option value="Anulado">Anulado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Buscar</label>
                    <input class="form-control form-control-sm" @bind="filtroSearch" placeholder="Número o glosa..." />
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-sm btn-primary" @onclick="LoadData"><i class="bi bi-search"></i> Filtrar</button>
                </div>
                <div class="col-md-auto ms-auto">
                    <span class="badge bg-secondary">@asientos.Count asientos</span>
                </div>
            </div>
        </div>
    </div>

    @* ?? Lista ?? *@
    <div class="card">
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else if (asientos.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-3">No hay asientos contables registrados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px"></th>
                                <th>Número</th>
                                <th>Fecha</th>
                                <th>Glosa</th>
                                <th>Tipo</th>
                                <th>Origen</th>
                                <th class="text-end">Debe</th>
                                <th class="text-end">Haber</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in asientos)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(a.AsientoContableId)">
                                            <i class="bi @(expandedId == a.AsientoContableId ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        </button>
                                    </td>
                                    <td><strong>@a.Numero</strong></td>
                                    <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@a.Glosa</td>
                                    <td>
                                        <span class="badge @(a.Tipo == "Automático" ? "bg-info text-dark" : "bg-outline-secondary border")">
                                            @a.Tipo
                                        </span>
                                    </td>
                                    <td><small class="text-muted">@(a.OrigenReferencia ?? "—")</small></td>
                                    <td class="text-end"><strong>@a.TotalDebe.ToString("N2")</strong></td>
                                    <td class="text-end"><strong>@a.TotalHaber.ToString("N2")</strong></td>
                                    <td>
                                        <span class="badge @GetEstadoBadge(a.Estado)">
                                            @a.Estado
                                            @if (a.Cuadrado && a.Estado != "Anulado") { <i class="bi bi-check-circle ms-1"></i> }
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        @if (a.Estado == "Borrador")
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => Contabilizar(a)" title="Contabilizar"><i class="bi bi-check2-all"></i> Contabilizar</button>
                                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteAsiento(a)" title="Eliminar"><i class="bi bi-trash"></i></button>
                                        }
                                        @if (a.Estado == "Contabilizado")
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => Anular(a)" title="Anular"><i class="bi bi-x-circle"></i> Anular</button>
                                        }
                                    </td>
                                </tr>
                                @if (expandedId == a.AsientoContableId)
                                {
                                    <tr>
                                        <td colspan="10" class="bg-light p-0">
                                            <div class="p-3">
                                                <table class="table table-sm table-bordered mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Código</th>
                                                            <th>Cuenta</th>
                                                            <th>Glosa</th>
                                                            <th>Referencia</th>
                                                            <th class="text-end">Debe</th>
                                                            <th class="text-end">Haber</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var l in a.Lineas)
                                                        {
                                                            <tr>
                                                                <td>@l.NumeroLinea</td>
                                                                <td><code>@l.CuentaCodigo</code></td>
                                                                <td>@l.CuentaNombre</td>
                                                                <td><small>@(l.Glosa ?? "—")</small></td>
                                                                <td><small class="text-muted">@(l.Referencia ?? "—")</small></td>
                                                                <td class="text-end @(l.Debe > 0 ? "text-primary fw-bold" : "")">@(l.Debe > 0 ? l.Debe.ToString("N2") : "")</td>
                                                                <td class="text-end @(l.Haber > 0 ? "text-success fw-bold" : "")">@(l.Haber > 0 ? l.Haber.ToString("N2") : "")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot class="table-light">
                                                        <tr>
                                                            <td colspan="5" class="text-end"><strong>Totales:</strong></td>
                                                            <td class="text-end"><strong class="text-primary">@a.TotalDebe.ToString("N2")</strong></td>
                                                            <td class="text-end"><strong class="text-success">@a.TotalHaber.ToString("N2")</strong></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ?????? Modal Crear Asiento ?????? *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-journal-plus"></i> Nuevo Asiento Contable</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Fecha *</label>
                            <input type="date" class="form-control" @bind="formFecha" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Glosa / Concepto *</label>
                            <input class="form-control" @bind="formGlosa" placeholder="Descripción del asiento..." />
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong><i class="bi bi-list-ol"></i> Líneas del Asiento</strong>
                    </div>

                    @* Formulario agregar línea *@
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-4">
                            <label class="form-label small">Cuenta *</label>
                            <select class="form-select form-select-sm" @bind="newLineaCuentaId">
                                <option value="0">-- Seleccionar cuenta --</option>
                                @foreach (var c in cuentasMovimiento)
                                {
                                    <option value="@c.CuentaContableId">@c.Codigo — @c.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Debe</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="newLineaDebe" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Haber</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="newLineaHaber" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Glosa</label>
                            <input class="form-control form-control-sm" @bind="newLineaGlosa" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success btn-sm w-100" @onclick="AddLinea"
                                    disabled="@(newLineaCuentaId == 0 || (newLineaDebe == 0 && newLineaHaber == 0))">
                                <i class="bi bi-plus"></i> Agregar
                            </button>
                        </div>
                    </div>

                    @if (tempLineas.Count > 0)
                    {
                        <table class="table table-sm table-bordered mb-2">
                            <thead>
                                <tr>
                                    <th>#</th><th>Código</th><th>Cuenta</th><th>Glosa</th>
                                    <th class="text-end">Debe</th><th class="text-end">Haber</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < tempLineas.Count; i++)
                                {
                                    var idx = i;
                                    var l = tempLineas[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><code>@l.CuentaCodigo</code></td>
                                        <td>@l.CuentaNombre</td>
                                        <td><small>@(l.Glosa ?? "—")</small></td>
                                        <td class="text-end @(l.Debe > 0 ? "text-primary fw-bold" : "")">@(l.Debe > 0 ? l.Debe.ToString("N2") : "")</td>
                                        <td class="text-end @(l.Haber > 0 ? "text-success fw-bold" : "")">@(l.Haber > 0 ? l.Haber.ToString("N2") : "")</td>
                                        <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => tempLineas.RemoveAt(idx)"><i class="bi bi-x-lg"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="text-end"><strong>Totales:</strong></td>
                                    <td class="text-end"><strong class="text-primary">@tempLineas.Sum(l => l.Debe).ToString("N2")</strong></td>
                                    <td class="text-end"><strong class="text-success">@tempLineas.Sum(l => l.Haber).ToString("N2")</strong></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-end">
                                        @{ var diff = tempLineas.Sum(l => l.Debe) - tempLineas.Sum(l => l.Haber); }
                                        @if (diff == 0 && tempLineas.Count >= 2)
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Partida doble cuadrada</span>
                                        }
                                        else if (tempLineas.Count > 0)
                                        {
                                            <span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Diferencia: @Math.Abs(diff).ToString("N2") @(diff > 0 ? "(Debe mayor)" : diff < 0 ? "(Haber mayor)" : "")</span>
                                        }
                                    </td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveAsiento"
                            disabled="@(saving || string.IsNullOrWhiteSpace(formGlosa) || tempLineas.Count < 2 || tempLineas.Sum(l => l.Debe) != tempLineas.Sum(l => l.Haber))">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-journal-plus"></i> Crear Asiento
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AsientoContableDto> asientos = new();
    private List<CuentaContableDto> cuentasMovimiento = new();
    private bool loading = true;
    private bool saving = false;
    private string? successMessage;
    private string? errorMessage;
    private long expandedId;

    // Filters
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private string filtroEstado = "";
    private string filtroSearch = "";

    // Create modal
    private bool showCreateModal;
    private DateTime formFecha = DateTime.Today;
    private string formGlosa = "";
    private List<TempLinea> tempLineas = new();
    private int newLineaCuentaId;
    private decimal newLineaDebe;
    private decimal newLineaHaber;
    private string? newLineaGlosa;

    private record TempLinea(int CuentaId, string CuentaCodigo, string CuentaNombre, decimal Debe, decimal Haber, string? Glosa);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true; errorMessage = null;
        try
        {
            asientos = await AsientoService.GetAllAsync(filtroDesde, filtroHasta,
                string.IsNullOrEmpty(filtroEstado) ? null : filtroEstado,
                null, string.IsNullOrEmpty(filtroSearch) ? null : filtroSearch);
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }

    private void ToggleDetail(long id) => expandedId = expandedId == id ? 0 : id;

    // ?? Create ??
    private async Task ShowCreateModal()
    {
        formFecha = DateTime.Today; formGlosa = ""; tempLineas = new();
        newLineaCuentaId = 0; newLineaDebe = 0; newLineaHaber = 0; newLineaGlosa = null;
        try
        {
            cuentasMovimiento = await CuentaService.GetAllAsync(permiteMovimientos: true);
        }
        catch (Exception ex) { errorMessage = ex.Message; return; }
        showCreateModal = true;
    }

    private void AddLinea()
    {
        if (newLineaCuentaId == 0 || (newLineaDebe == 0 && newLineaHaber == 0)) return;
        if (newLineaDebe > 0 && newLineaHaber > 0) { errorMessage = "Una línea no puede tener Debe y Haber al mismo tiempo."; return; }
        var cuenta = cuentasMovimiento.FirstOrDefault(c => c.CuentaContableId == newLineaCuentaId);
        if (cuenta is null) return;

        tempLineas.Add(new TempLinea(cuenta.CuentaContableId, cuenta.Codigo, cuenta.Nombre, newLineaDebe, newLineaHaber, newLineaGlosa));
        newLineaCuentaId = 0; newLineaDebe = 0; newLineaHaber = 0; newLineaGlosa = null;
    }

    private async Task SaveAsiento()
    {
        saving = true; errorMessage = null;
        try
        {
            var dto = new CreateAsientoContableDto
            {
                Fecha = formFecha,
                Glosa = formGlosa,
                Lineas = tempLineas.Select(l => new CreateAsientoLineaDto
                {
                    CuentaContableId = l.CuentaId,
                    Debe = l.Debe,
                    Haber = l.Haber,
                    Glosa = l.Glosa
                }).ToList()
            };
            var r = await AsientoService.CreateAsync(dto);
            if (r.Success) { successMessage = $"Asiento {r.Data?.Numero} creado en Borrador."; showCreateModal = false; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { saving = false; }
    }

    private async Task Contabilizar(AsientoContableDto asiento)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Contabilizar {asiento.Numero}? Esto actualizará los saldos de las cuentas.")) return;
        try
        {
            var r = await AsientoService.ContabilizarAsync(asiento.AsientoContableId);
            if (r.Success) { successMessage = $"{asiento.Numero} contabilizado. Saldos actualizados."; await LoadData(); expandedId = asiento.AsientoContableId; }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task Anular(AsientoContableDto asiento)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Anular {asiento.Numero}? Esto revertirá los saldos de las cuentas.")) return;
        try
        {
            var r = await AsientoService.AnularAsync(asiento.AsientoContableId);
            if (r.Success) { successMessage = $"{asiento.Numero} anulado. Saldos revertidos."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task DeleteAsiento(AsientoContableDto asiento)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar {asiento.Numero}?")) return;
        try
        {
            var r = await AsientoService.DeleteAsync(asiento.AsientoContableId);
            if (r.Success) { successMessage = "Asiento eliminado."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private static string GetEstadoBadge(string estado) => estado switch
    {
        "Borrador" => "bg-secondary",
        "Contabilizado" => "bg-success",
        "Anulado" => "bg-danger",
        _ => "bg-secondary"
    };
}
