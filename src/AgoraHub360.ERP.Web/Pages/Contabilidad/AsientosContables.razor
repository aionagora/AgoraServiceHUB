@page "/contabilidad/asientos"
@attribute [Authorize]
@using AgoraHub360.ERP.Shared.Utils
@inject AsientoContableHttpService AsientoService
@inject CuentaContableHttpService CuentaService
@inject CentroCostoHttpService CentroCostoService
@inject IJSRuntime JS

<PageTitle>Comprobantes Contables - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-journal-text"></i> Comprobantes Contables</h3>
            <p class="text-muted mb-0">Libro Diario � Registro de comprobantes contables</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-success btn-sm" @onclick="SeedCatalogos" disabled="@seeding">
                @if (seeding) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <i class="bi bi-magic"></i> Generar Cat�logos
            </button>
            <button class="btn btn-primary" @onclick="NuevoComprobante">
                <i class="bi bi-plus-circle"></i> Nuevo Comprobante
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* VISTA LISTA *@
    @if (!showForm)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Desde</label>
                        <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Hasta</label>
                        <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Tipo</label>
                        <select class="form-select form-select-sm" @bind="filtroTipoComp">
                            <option value="0">Todos</option>
                            @foreach (var t in tiposComprobante)
                            {
                                <option value="@t.TipoComprobanteId">@t.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Estado</label>
                        <select class="form-select form-select-sm" @bind="filtroEstado">
                            <option value="">Todos</option>
                            <option value="Borrador">Borrador</option>
                            <option value="Contabilizado">Contabilizado</option>
                            <option value="Anulado">Anulado</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input class="form-control form-control-sm" @bind="filtroSearch" @bind:event="oninput"
                               @onkeydown="OnFiltroSearchKeyDown" placeholder="Buscar..." />
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-sm btn-primary" @onclick="LoadData"><i class="bi bi-search"></i></button>
                        @if (FiltrosActivos)
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="LimpiarFiltros" title="Limpiar filtros">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                    <div class="col-md-auto ms-auto">
                        <div class="btn-group" style="position:relative">
                            <button class="btn btn-outline-secondary dropdown-toggle"
                                    disabled="@(exportando || asientos.Count == 0)"
                                    @onclick="() => showExportListDropdown = !showExportListDropdown"
                                    @onclick:stopPropagation>
                                @if (exportando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                else { <i class="bi bi-download me-1"></i> }
                                Exportar
                            </button>
                            @if (showExportListDropdown)
                            {
                                <div style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:1000"
                                     @onclick="() => showExportListDropdown = false"></div>
                                <ul class="dropdown-menu dropdown-menu-end show" style="z-index:1001">
                                    <li><h6 class="dropdown-header"><i class="bi bi-list-ul me-1"></i>Resumen (cabecera)</h6></li>
                                    <li>
                                        <button class="dropdown-item" @onclick="() => { showExportListDropdown = false; ExportarExcel(); }">
                                            <i class="bi bi-file-earmark-excel text-success me-2"></i> Excel resumen (.xlsx)
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header"><i class="bi bi-table me-1"></i>Detalle plano</h6></li>
                                    <li>
                                        <button class="dropdown-item" @onclick="() => { showExportListDropdown = false; ExportarExcelPlano(); }">
                                            <i class="bi bi-file-earmark-excel text-success me-2"></i> Excel plano (.xlsx)
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item" @onclick='() => { showExportListDropdown = false; ExportarListadoFormato("csv"); }'>
                                            <i class="bi bi-file-earmark-text text-secondary me-2"></i> CSV plano (.csv)
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item" @onclick='() => { showExportListDropdown = false; ExportarListadoFormato("json"); }'>
                                            <i class="bi bi-filetype-json text-warning me-2"></i> JSON plano (.json)
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item" @onclick='() => { showExportListDropdown = false; ExportarListadoFormato("xml"); }'>
                                            <i class="bi bi-filetype-xml text-info me-2"></i> XML plano (.xml)
                                        </button>
                                    </li>
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                @if (loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (asientos.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-x" style="font-size:2.5rem;"></i>
                        <p class="text-muted mt-3">No hay comprobantes.</p>
                        @if (FiltrosActivos)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltros">
                                <i class="bi bi-x-lg me-1"></i>Limpiar filtros
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light" style="font-size:.82rem">
                        <span class="text-muted">
                            Mostrando <strong>@AsientosPagina.Count</strong> de <strong>@asientos.Count</strong> comprobantes
                            @if (FiltrosActivos) { <span class="badge bg-secondary ms-1">Filtrado</span> }
                        </span>
                        <div class="d-flex gap-3">
                            <span>Debe total: <strong class="text-primary">@asientos.Sum(a => a.TotalDebe).ToString("N2")</strong></span>
                            <span>Haber total: <strong class="text-success">@asientos.Sum(a => a.TotalHaber).ToString("N2")</strong></span>
                            <span>L�neas: <strong>@asientos.Sum(a => a.Lineas.Count)</strong></span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:36px" class="text-center">#</th>
                                    <th>Tipo</th><th>N�mero</th><th>Fecha</th><th>Gesti�n</th>
                                    <th>Concepto / Glosa</th><th>Registro</th><th>T/C</th><th>Documento</th>
                                    <th class="text-end">Debe</th><th class="text-end">Haber</th>
                                    <th class="text-center">L�n.</th><th class="text-center">?</th>
                                    <th>Estado</th><th style="width:90px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNum = (paginaActual - 1) * tamPagina; }
                                @foreach (var a in AsientosPagina)
                                {
                                    rowNum++;
                                    <tr class="@(a.Estado == "Anulado" ? "text-decoration-line-through text-muted" : "")"
                                        style="cursor:pointer" @onclick="() => VerComprobante(a)">
                                        <td class="text-center text-muted" style="font-size:.75rem">@rowNum</td>
                                        <td><span class="badge bg-secondary">@a.TipoComprobanteCodigo</span></td>
                                        <td><strong>@a.Numero</strong></td>
                                        <td style="white-space:nowrap">@a.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@a.Gestion</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(a.Concepto)) { <small class="d-block fw-semibold">@a.Concepto</small> }
                                            <small class="text-muted">@(a.Glosa.Length > 60 ? a.Glosa[..60] + "..." : a.Glosa)</small>
                                        </td>
                                        <td>
                                            <span class="badge @(a.TipoRegistro == "Autom�tico" ? "bg-info text-dark" : "bg-light text-dark border")">
                                                @a.TipoRegistro
                                            </span>
                                        </td>
                                        <td>
                                            @if (a.ValorTipoCambio.HasValue)
                                            { <small>@a.TipoCambioMoneda @a.ValorTipoCambio.Value.ToString("N2")</small> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(a.TipoPagoCodigo) && a.TipoPagoCodigo != "S/D")
                                            {
                                                <small>@a.TipoPagoNombre</small>
                                                @if (!string.IsNullOrEmpty(a.NumeroDocumentoPago))
                                                { <small class="text-muted d-block">@a.NumeroDocumentoPago</small> }
                                            }
                                        </td>
                                        <td class="text-end fw-semibold text-primary">@a.TotalDebe.ToString("N2")</td>
                                        <td class="text-end fw-semibold text-success">@a.TotalHaber.ToString("N2")</td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill bg-light text-dark border" style="font-size:.7rem">@a.Lineas.Count</span>
                                        </td>
                                        <td class="text-center">
                                            @if (a.Cuadrado) { <i class="bi bi-check-circle-fill text-success"></i> }
                                            else { <i class="bi bi-exclamation-triangle-fill text-warning"></i> }
                                        </td>
                                        <td><span class="badge @GetEstadoBadge(a.Estado)">@a.Estado</span></td>
                                        <td class="text-end" @onclick:stopPropagation>
                                            @if (a.Estado == "Borrador")
                                            {
                                                <button class="btn btn-sm btn-outline-success p-0 px-1" @onclick="() => Contabilizar(a)" title="Contabilizar">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger p-0 px-1 ms-1" @onclick="() => EliminarComprobante(a)" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td colspan="9" class="text-end text-muted" style="font-size:.82rem">TOTALES P�GINA (@AsientosPagina.Count):</td>
                                    <td class="text-end text-primary">@AsientosPagina.Sum(a => a.TotalDebe).ToString("N2")</td>
                                    <td class="text-end text-success">@AsientosPagina.Sum(a => a.TotalHaber).ToString("N2")</td>
                                    <td class="text-center text-muted" style="font-size:.78rem">@AsientosPagina.Sum(a => a.Lineas.Count)</td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    @if (TotalPaginas > 1)
                    {
                        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top">
                            <div class="d-flex align-items-center gap-2" style="font-size:.82rem">
                                <span class="text-muted">Filas por p�gina:</span>
                                <select class="form-select form-select-sm" style="width:70px"
                                        @bind="tamPagina" @bind:after="OnTamPaginaChanged">
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(1)"><i class="bi bi-chevron-double-left"></i></button>
                                    </li>
                                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)"><i class="bi bi-chevron-left"></i></button>
                                    </li>
                                    @foreach (var p in PaginasVisibles)
                                    {
                                        @if (p == -1) { <li class="page-item disabled"><span class="page-link">�</span></li> }
                                        else
                                        {
                                            <li class="page-item @(p == paginaActual ? "active" : "")">
                                                <button class="page-link" @onclick="() => CambiarPagina(p)">@p</button>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)"><i class="bi bi-chevron-right"></i></button>
                                    </li>
                                    <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(TotalPaginas)"><i class="bi bi-chevron-double-right"></i></button>
                                    </li>
                                </ul>
                            </nav>
                            <span class="text-muted" style="font-size:.82rem">P�gina @paginaActual de @TotalPaginas</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @* VISTA FORMULARIO *@
    @if (showForm)
    {
        <div class="card"
             @onkeydown="OnKeyDown"
             @onkeydown:preventDefault="@_preventDefaultKey"
             tabindex="-1"
             id="form-comprobante">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-journal-text"></i>
                    @if (isViewing) { <text>Comprobante @formNumero</text> }
                    else if (isEditing) { <text>Editar Comprobante @formNumero</text> }
                    else { <text>Nuevo Comprobante</text> }
                </h5>
                <div>
                    @if (isViewing) { <span class="badge @GetEstadoBadge(viewingEstado) fs-6">@viewingEstado</span> }
                    <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="VolverALista"><i class="bi bi-arrow-left"></i> Volver</button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-2">
                        <label class="form-label">Tipo Comprobante *</label>
                        <select class="form-select" @bind="formTipoCompId" disabled="@isViewing">
                            @foreach (var t in tiposComprobante)
                            { <option value="@t.TipoComprobanteId">@t.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nro Comprobante</label>
                        <input class="form-control" value="@formNumero" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha *</label>
                        <input type="date" class="form-control" @bind="formFecha" disabled="@isViewing" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Gesti�n</label>
                        <input class="form-control" value="@formFecha.Year" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tipo Cambio</label>
                        <select class="form-select" @bind="formTipoCambioId" disabled="@isViewing">
                            <option value="0">-- Sin T/C --</option>
                            @foreach (var tc in tiposCambio)
                            { <option value="@tc.TipoCambioId">@tc.Moneda � @tc.TasaVenta.ToString("N2")</option> }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Documento Pago</label>
                        <select class="form-select" @bind="formTipoPagoId" disabled="@isViewing">
                            @foreach (var tp in tiposPago)
                            { <option value="@tp.TipoPagoId">@tp.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Nro Doc.</label>
                        <input class="form-control" @bind="formNroDocPago" disabled="@isViewing" placeholder="Nro..." />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Concepto</label>
                        <input class="form-control" @bind="formConcepto" disabled="@isViewing" placeholder="Por concepto de..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Glosa General *</label>
                        <input class="form-control" @bind="formGlosa" disabled="@isViewing" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Registrado por</label>
                        <input class="form-control" value="@formRegistradoPor" readonly />
                    </div>
                </div>

                <hr />

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="mb-0"><i class="bi bi-list-ol me-1"></i> Detalle del Comprobante</h6>
                    @if (!isViewing)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                style="border-color:#7c3aed;color:#7c3aed"
                                @onclick="AbrirModalPlantilla">
                            <i class="bi bi-file-earmark-ruled me-1"></i>Usar Plantilla
                        </button>
                    }
                </div>

                @if (!isViewing)
                {
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-5">
                            <label class="form-label small">Cuenta</label>
                            <input class="form-control form-control-sm" list="cuentasList"
                                   @bind="searchCuenta" @bind:event="oninput"
                                   @onchange="OnCuentaSelected" placeholder="Ej: 1.1.3.01 o Inventario..." />
                            <datalist id="cuentasList">
                                @foreach (var c in cuentasFiltradas)
                                { <option value="@c.Codigo - @c.Nombre" /> }
                            </datalist>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Glosa detalle</label>
                            <input class="form-control form-control-sm" @bind="newGlosa" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">C. Costo</label>
                            <select class="form-select form-select-sm" @bind="newCentroCostoId">
                                <option value="0">� Ninguno �</option>
                                @foreach (var cc in centrosCosto)
                                { <option value="@cc.Id">@cc.Codigo � @cc.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Debe</label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   value="@newDebe" @oninput="OnNewDebeInput" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">Haber</label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   value="@newHaber" @oninput="OnNewHaberInput" @onkeydown="OnHaberKeyDown" />
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-success btn-sm w-100" @onclick="AddLinea" disabled="@(newCuentaId == 0)">
                                <i class="bi bi-plus"></i> Agregar
                            </button>
                        </div>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-bordered table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">#</th>
                                <th style="width:120px">C�digo</th>
                                <th>Nombre Cuenta</th>
                                <th>Glosa Detalle</th>
                                <th style="width:110px">C. Costo</th>
                                <th class="text-end" style="width:130px">Debe</th>
                                <th class="text-end" style="width:130px">Haber</th>
                                @if (!isViewing) { <th style="width:120px"></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (tempLineas.Count == 0)
                            {
                                <tr><td colspan="@(isViewing ? 7 : 8)" class="text-center text-muted py-3">Sin l�neas de detalle</td></tr>
                            }
                            @for (int i = 0; i < tempLineas.Count; i++)
                            {
                                var idx = i;
                                var l = tempLineas[i];
                                <tr>
                                    <td class="text-center">@(i + 1)</td>
                                    <td><code>@l.CuentaCodigo</code></td>
                                    <td>@l.CuentaNombre</td>
                                    <td>
                                        @if (!isViewing && editingLineIdx == idx) { <input class="form-control form-control-sm" @bind="editGlosa" /> }
                                        else { @l.Glosa }
                                    </td>
                                    <td>
                                        @if (l.CentroCostoId.HasValue && !string.IsNullOrEmpty(l.CentroCostoCodigo))
                                        { <span class="badge" style="background:#ede9fe;color:#7c3aed;font-size:.7rem">@l.CentroCostoCodigo</span> }
                                    </td>
                                    <td class="text-end">
                                        @if (!isViewing && editingLineIdx == idx)
                                        { <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="editDebe" /> }
                                        else { <span class="@(l.Debe > 0 ? "fw-semibold text-primary" : "")">@l.Debe.ToString("N2")</span> }
                                    </td>
                                    <td class="text-end">
                                        @if (!isViewing && editingLineIdx == idx)
                                        { <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="editHaber" /> }
                                        else { <span class="@(l.Haber > 0 ? "fw-semibold text-success" : "")">@l.Haber.ToString("N2")</span> }
                                    </td>
                                    @if (!isViewing)
                                    {
                                        <td class="text-center">
                                            @if (editingLineIdx == idx)
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="SaveLineEdit"><i class="bi bi-check"></i></button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelLineEdit"><i class="bi bi-x"></i></button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary p-0 px-1" @onclick="() => MoverLineaArriba(idx)" disabled="@(idx == 0)">
                                                    <i class="bi bi-chevron-up" style="font-size:.7rem"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary p-0 px-1" @onclick="() => MoverLineaAbajo(idx)" disabled="@(idx == tempLineas.Count - 1)">
