            TipoComprobanteCodigo = tiposComprobante.FirstOrDefault(t => t.TipoComprobanteId == formTipoCompId)?.Codigo ?? string.Empty,
            Fecha                 = formFecha,
            Gestion               = formFecha.Year,
            TipoRegistro          = "Manual",
            Estado                = viewingEstado,
            Concepto              = formConcepto,
            Glosa                 = formGlosa,
            TipoCambioMoneda      = tiposCambio.FirstOrDefault(t => t.TipoCambioId == formTipoCambioId)?.Moneda,
            ValorTipoCambio       = tiposCambio.FirstOrDefault(t => t.TipoCambioId == formTipoCambioId)?.TasaVenta,
            TipoPagoCodigo        = tiposPago.FirstOrDefault(t => t.TipoPagoId == formTipoPagoId)?.Codigo,
            TipoPagoNombre        = tiposPago.FirstOrDefault(t => t.TipoPagoId == formTipoPagoId)?.Nombre,
            NumeroDocumentoPago   = formNroDocPago,
            RegistradoPor         = formRegistradoPor,
            TotalDebe             = TotalDebe,
            TotalHaber            = TotalHaber,
            Cuadrado              = TotalDebe == TotalHaber
        };
        _vistaPreviewLineas = tempLineas
            .Select((l, i) => new VistaPreviewComprobante.PreviewLinea(
                i + 1, l.CuentaCodigo, l.CuentaNombre,
                l.CentroCostoCodigo, l.Glosa, l.Debe, l.Haber))
            .ToList();
        _vistaPrevia?.Open();
    }

