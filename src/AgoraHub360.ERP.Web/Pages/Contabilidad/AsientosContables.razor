@page "/contabilidad/asientos"
@attribute [Authorize]
@inject AsientoContableHttpService AsientoService
@inject CuentaContableHttpService CuentaService
@inject CentroCostoHttpService CentroCostoService
@inject IJSRuntime JS

<PageTitle>Comprobantes Contables - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-journal-text"></i> Comprobantes Contables</h3>
            <p class="text-muted mb-0">Libro Diario • Registro de comprobantes contables</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-success btn-sm" @onclick="SeedCatalogos" disabled="@seeding">
                @if (seeding) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <i class="bi bi-magic"></i> Generar Catálogos
            </button>
            <button class="btn btn-primary" @onclick="NuevoComprobante">
                <i class="bi bi-plus-circle"></i> Nuevo Comprobante
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* ?????? VISTA LISTA ?????? *@
    @if (!showForm)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Desde</label>
                        <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Hasta</label>
                        <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Tipo</label>
                        <select class="form-select form-select-sm" @bind="filtroTipoComp">
                            <option value="0">Todos</option>
                            @foreach (var t in tiposComprobante)
                            {
                                <option value="@t.TipoComprobanteId">@t.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1 small">Estado</label>
                        <select class="form-select form-select-sm" @bind="filtroEstado">
                            <option value="">Todos</option>
                            <option value="Borrador">Borrador</option>
                            <option value="Contabilizado">Contabilizado</option>
                            <option value="Anulado">Anulado</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input class="form-control form-control-sm" @bind="filtroSearch" placeholder="Buscar..." />
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-sm btn-primary" @onclick="LoadData"><i class="bi bi-search"></i></button>
                    </div>
                    <div class="col-md-auto ms-auto">
                        <button class="btn btn-sm btn-success" @onclick="ExportarExcel" disabled="@(exportando || asientos.Count == 0)" title="Exportar a Excel">
                            @if (exportando) 
                            { 
                                <span class="spinner-border spinner-border-sm me-1"></span> 
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-excel me-1"></i>
                            }
                            Exportar Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                @if (loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (asientos.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-x" style="font-size:2.5rem;"></i>
                        <p class="text-muted mt-3">No hay comprobantes.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tipo</th>
                                    <th>Número</th>
                                    <th>Fecha</th>
                                    <th>Gestión</th>
                                    <th>Concepto / Glosa</th>
                                    <th>Registro</th>
                                    <th>T/C</th>
                                    <th>Documento</th>
                                    <th class="text-end">Debe</th>
                                    <th class="text-end">Haber</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in asientos)
                                {
                                    <tr class="@(a.Estado == "Anulado" ? "text-decoration-line-through text-muted" : "")" style="cursor:pointer" @onclick="() => VerComprobante(a)">
                                        <td><span class="badge bg-secondary">@a.TipoComprobanteCodigo</span></td>
                                        <td><strong>@a.Numero</strong></td>
                                        <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@a.Gestion</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(a.Concepto))
                                            {
                                                <small class="d-block fw-semibold">@a.Concepto</small>
                                            }
                                            <small class="text-muted">@(a.Glosa.Length > 60 ? a.Glosa[..60] + "..." : a.Glosa)</small>
                                        </td>
                                        <td>
                                            <span class="badge @(a.TipoRegistro == "Automático" ? "bg-info text-dark" : "bg-outline-secondary border")">
                                                @a.TipoRegistro
                                            </span>
                                        </td>
                                        <td>
                                            @if (a.ValorTipoCambio.HasValue)
                                            {
                                                <small>@a.TipoCambioMoneda @a.ValorTipoCambio.Value.ToString("N2")</small>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(a.TipoPagoCodigo) && a.TipoPagoCodigo != "S/D")
                                            {
                                                <small>@a.TipoPagoNombre</small>
                                                @if (!string.IsNullOrEmpty(a.NumeroDocumentoPago))
                                                {
                                                    <small class="text-muted d-block">@a.NumeroDocumentoPago</small>
                                                }
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">@a.TotalDebe.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@a.TotalHaber.ToString("N2")</td>
                                        <td>
                                            <span class="badge @GetEstadoBadge(a.Estado)">@a.Estado</span>
                                        </td>
                                        <td class="text-end">
                                            @if (a.Estado == "Borrador")
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick:stopPropagation @onclick="() => Contabilizar(a)" title="Contabilizar">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @* ?????? VISTA FORMULARIO (Crear/Ver/Editar) ?????? *@
    @if (showForm)
    {
        <div class="card"
             @onkeydown="OnKeyDown"
             @onkeydown:preventDefault="@_preventDefaultKey"
             tabindex="-1"
             id="form-comprobante">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-journal-text"></i>
                    @if (isViewing) { <text>Comprobante @formNumero</text> }
                    else if (isEditing) { <text>Editar Comprobante @formNumero</text> }
                    else { <text>Nuevo Comprobante</text> }
                </h5>
                <div>
                    @if (isViewing)
                    {
                        <span class="badge @GetEstadoBadge(viewingEstado) fs-6">@viewingEstado</span>
                    }
                    <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="VolverALista"><i class="bi bi-arrow-left"></i> Volver</button>
                </div>
            </div>
            <div class="card-body">
                @* ?? Cabecera ?? *@
                <div class="row g-3 mb-3">
                    <div class="col-md-2">
                        <label class="form-label">Tipo Comprobante *</label>
                        <select class="form-select" @bind="formTipoCompId" disabled="@isViewing">
                            @foreach (var t in tiposComprobante)
                            {
                                <option value="@t.TipoComprobanteId">@t.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nro Comprobante</label>
                        <input class="form-control" value="@formNumero" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha *</label>
                        <input type="date" class="form-control" @bind="formFecha" disabled="@isViewing" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Gestión</label>
                        <input class="form-control" value="@formFecha.Year" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tipo Cambio</label>
                        <select class="form-select" @bind="formTipoCambioId" disabled="@isViewing">
                            <option value="0">-- Sin T/C --</option>
                            @foreach (var tc in tiposCambio)
                            {
                                <option value="@tc.TipoCambioId">@tc.Moneda — @tc.TasaVenta.ToString("N2")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Documento Pago</label>
                        <select class="form-select" @bind="formTipoPagoId" disabled="@isViewing">
                            @foreach (var tp in tiposPago)
                            {
                                <option value="@tp.TipoPagoId">@tp.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Nro Doc.</label>
                        <input class="form-control" @bind="formNroDocPago" disabled="@isViewing" placeholder="Nro..." />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Concepto (por concepto de)</label>
                        <input class="form-control" @bind="formConcepto" disabled="@isViewing" placeholder="Por concepto de..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Glosa General *</label>
                        <input class="form-control" @bind="formGlosa" disabled="@isViewing" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Registrado por</label>
                        <input class="form-control" value="@formRegistradoPor" readonly />
                    </div>
                </div>

                <hr />

                @* ?? Detalle: GridView de líneas ?? *@
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="mb-0"><i class="bi bi-list-ol me-1"></i> Detalle del Comprobante</h6>
                    @if (!isViewing)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                style="border-color:#7c3aed;color:#7c3aed"
                                @onclick="AbrirModalPlantilla">
                            <i class="bi bi-file-earmark-ruled me-1"></i>Usar Plantilla
                        </button>
                    }
                </div>

                @if (!isViewing)
                {
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-5">
                            <label class="form-label small" for="input-cuenta">Cuenta (buscar por código o nombre)</label>
                            <input id="input-cuenta"
                                   class="form-control form-control-sm"
                                   list="cuentasList"
                                   @bind="searchCuenta" @bind:event="oninput"
                                   @onchange="OnCuentaSelected"
                                   placeholder="Ej: 1.1.3.01 o Inventario..."
                                   aria-label="Buscar cuenta contable" />
                            <datalist id="cuentasList">
                                @foreach (var c in cuentasFiltradas)
                                {
                                    <option value="@c.Codigo - @c.Nombre" data-id="@c.CuentaContableId" />
                                }
                            </datalist>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small" for="input-glosa-nueva">Glosa detalle</label>
                            <input id="input-glosa-nueva"
                                   class="form-control form-control-sm"
                                   @bind="newGlosa"
                                   aria-label="Glosa de la línea" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small" for="input-cc">C. Costo</label>
                            <select id="input-cc"
                                    class="form-select form-select-sm"
                                    @bind="newCentroCostoId"
                                    aria-label="Centro de costo">
                                <option value="0">— Ninguno —</option>
                                @foreach (var cc in centrosCosto)
                                {
                                    <option value="@cc.Id">@cc.Codigo — @cc.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small" for="input-debe">Debe</label>
                            <input id="input-debe"
                                   type="number" step="0.01"
                                   class="form-control form-control-sm"
                                   value="@newDebe"
                                   @oninput="OnNewDebeInput"
                                   aria-label="Monto Debe" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small" for="input-haber">Haber</label>
                            <input id="input-haber"
                                   type="number" step="0.01"
                                   class="form-control form-control-sm"
                                   value="@newHaber"
                                   @oninput="OnNewHaberInput"
                                   @onkeydown="OnHaberKeyDown"
                                   aria-label="Monto Haber" />
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-success btn-sm w-100"
                                    @onclick="AddLinea"
                                    disabled="@(newCuentaId == 0)"
                                    aria-label="Agregar línea al comprobante">
                                <i class="bi bi-plus" aria-hidden="true"></i> Agregar
                            </button>
                        </div>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-bordered table-sm mb-0"
                           role="table"
                           aria-label="Detalle del comprobante contable"
                           aria-live="polite">
                        <thead class="table-light">
                            <tr role="row">
                                <th scope="col" style="width:40px">#</th>
                                <th scope="col" style="width:120px">Código</th>
                                <th scope="col">Nombre Cuenta</th>
                                <th scope="col">Glosa Detalle</th>
                                <th scope="col" style="width:110px">C. Costo</th>
                                <th scope="col" class="text-end" style="width:130px">Debe</th>
                                <th scope="col" class="text-end" style="width:130px">Haber</th>
                                @if (!isViewing) { <th scope="col" style="width:120px"><span class="visually-hidden">Acciones</span></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (tempLineas.Count == 0)
                            {
                                <tr><td colspan="@(isViewing ? 7 : 8)" class="text-center text-muted py-3">Sin líneas de detalle</td></tr>
                            }
                            @for (int i = 0; i < tempLineas.Count; i++)
                            {
                                var idx = i;
                                var l = tempLineas[i];
                                <tr>
                                    <td class="text-center">@(i + 1)</td>
                                    <td><code>@l.CuentaCodigo</code></td>
                                    <td>@l.CuentaNombre</td>
                                    <td>
                                        @if (!isViewing && editingLineIdx == idx)
                                        {
                                            <input class="form-control form-control-sm" @bind="editGlosa" />
                                        }
                                        else
                                        {
                                            @l.Glosa
                                        }
                                    </td>
                                    <td>
                                        @if (l.CentroCostoId.HasValue && !string.IsNullOrEmpty(l.CentroCostoCodigo))
                                        {
                                            <span class="badge"
                                                  style="background:#ede9fe;color:#7c3aed;font-size:.7rem;font-weight:500">
                                                @l.CentroCostoCodigo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!isViewing && editingLineIdx == idx)
                                        {
                                            <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="editDebe" />
                                        }
                                        else
                                        {
                                            <span class="@(l.Debe > 0 ? "fw-semibold text-primary" : "")">@l.Debe.ToString("N2")</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!isViewing && editingLineIdx == idx)
                                        {
                                            <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="editHaber" />
                                        }
                                        else
                                        {
                                            <span class="@(l.Haber > 0 ? "fw-semibold text-success" : "")">@l.Haber.ToString("N2")</span>
                                        }
                                    </td>
                                    @if (!isViewing)
                                    {
                                        <td class="text-center">
                                            @if (editingLineIdx == idx)
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="SaveLineEdit" title="Guardar edición" aria-label="Guardar edición de línea @(idx+1)">
                                                    <i class="bi bi-check" aria-hidden="true"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelLineEdit" title="Cancelar edición" aria-label="Cancelar edición de línea @(idx+1)">
                                                    <i class="bi bi-x" aria-hidden="true"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary p-0 px-1" style="line-height:1.2"
                                                        @onclick="() => MoverLineaArriba(idx)"
                                                        title="Subir línea"
                                                        aria-label="Mover línea @(idx+1) hacia arriba"
                                                        disabled="@(idx == 0)">
                                                    <i class="bi bi-chevron-up" style="font-size:.7rem" aria-hidden="true"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary p-0 px-1" style="line-height:1.2"
                                                        @onclick="() => MoverLineaAbajo(idx)"
                                                        title="Bajar línea"
                                                        aria-label="Mover línea @(idx+1) hacia abajo"
                                                        disabled="@(idx == tempLineas.Count - 1)">
                                                    <i class="bi bi-chevron-down" style="font-size:.7rem" aria-hidden="true"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => StartLineEdit(idx)"
                                                        title="Editar línea"
                                                        aria-label="Editar línea @(idx+1)">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RemoveLinea(idx)"
                                                        title="Eliminar línea"
                                                        aria-label="Eliminar línea @(idx+1)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="5" class="text-end">TOTALES:</td>
                                <td class="text-end text-primary">@TotalDebe.ToString("N2")</td>
                                <td class="text-end text-success">@TotalHaber.ToString("N2")</td>
                                @if (!isViewing) { <td></td> }
                            </tr>
                            <tr>
                                <td colspan="@(isViewing ? 7 : 8)" class="text-end">
                                    @if (TotalDebe == TotalHaber && tempLineas.Count >= 2)
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Comprobante cuadrado — Diferencia: 0.00</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Diferencia: @Math.Abs(TotalDebe - TotalHaber).ToString("N2")</span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @* ?? Barra de estado del comprobante ????????????????????????????? *@
                @if (!isViewing)
                {
                    <div class="rounded-2 px-3 py-2 mt-2 mb-1 d-flex align-items-center justify-content-between"
                         style="@BarraEstadoStyle">
                        <span style="font-size:.82rem;font-weight:500">
                            @if (tempLineas.Count == 0)
                            {
                                <i class="bi bi-dash-circle me-1"></i>
                                <text>Sin líneas de detalle</text>
                            }
                            else if (TotalDebe == TotalHaber)
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                                <text>Comprobante cuadrado</text>
                            }
                            else
                            {
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <text>Diferencia: <strong>@Math.Abs(TotalDebe - TotalHaber).ToString("N2")</strong></text>
                            }
                        </span>
                        <span style="font-size:.78rem;opacity:.75">
                            Debe: <strong>@TotalDebe.ToString("N2")</strong>
                            &nbsp;|&nbsp;
                            Haber: <strong>@TotalHaber.ToString("N2")</strong>
                        </span>
                    </div>
                }

                @* ?? Documentos de Respaldo ?????????????????????????????????????? *@
                <div class="mt-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="mb-0">
                            <i class="bi bi-paperclip me-1"></i>
                            Documentos de Respaldo
                            @if (adjuntos.Count > 0)
                            {
                                <span class="badge bg-secondary rounded-pill ms-1" style="font-size:.7rem">@adjuntos.Count</span>
                            }
                        </h6>
                        @if (editingId > 0)
                        {
                            <label class="btn btn-sm btn-outline-primary mb-0 @(adjuntos.Count >= MaxAdjuntos || uploadingDoc ? "disabled" : "")"
                                   title="@(adjuntos.Count >= MaxAdjuntos ? "Máximo 5 archivos" : "Adjuntar archivo")">
                                @if (uploadingDoc)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <text>Subiendo...</text>
                                }
                                else
                                {
                                    <i class="bi bi-upload me-1"></i>
                                    <text>Adjuntar archivo</text>
                                }
                                <InputFile OnChange="OnFileSelected"
                                           accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls"
                                           style="display:none"
                                           disabled="@(adjuntos.Count >= MaxAdjuntos || uploadingDoc)" />
                            </label>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(docErrorMsg))
                    {
                        <div class="alert alert-warning alert-dismissible py-2 mb-2" style="font-size:.83rem">
                            <i class="bi bi-exclamation-triangle me-1"></i> @docErrorMsg
                            <button type="button" class="btn-close btn-close-sm" @onclick="() => docErrorMsg = null"></button>
                        </div>
                    }

                    @if (adjuntos.Count == 0)
                    {
                        <div class="border border-2 border-dashed rounded-3 text-center py-4"
                             style="border-color:#d1d5db!important;background:#f9fafb;color:#9ca3af">
                            <i class="bi bi-cloud-upload" style="font-size:2rem;opacity:.5"></i>
                            <p class="mb-0 mt-1" style="font-size:.82rem">
                                @if (editingId > 0)
                                {
                                    <text>Use el botón <strong>Adjuntar archivo</strong> para subir archivos de respaldo.</text>
                                }
                                else
                                {
                                    <text>Guarde el comprobante primero para adjuntar documentos.</text>
                                }
                            </p>
                            <p class="mb-0" style="font-size:.74rem;color:#d1d5db">PDF, JPG, PNG, XLSX · máx 10 MB · máx 5 archivos</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border rounded-2">
                            @foreach (var adj in adjuntos)
                            {
                                <div class="list-group-item d-flex align-items-center gap-2 py-2 px-3">
                                    <span class="badge rounded-1 fw-semibold" style="@GetDocBadgeStyle(adj.MimeType);font-size:.7rem;min-width:36px;text-align:center">
                                        @GetDocExtLabel(adj.MimeType)
                                    </span>
                                    <span class="flex-grow-1 text-truncate" style="font-size:.82rem" title="@adj.FileName">
                                        @if (!string.IsNullOrEmpty(adj.Url))
                                        {
                                            <a href="@adj.Url" target="_blank" class="text-decoration-none text-dark">@adj.FileName</a>
                                        }
                                        else { @adj.FileName }
                                    </span>
                                    <span class="text-muted" style="font-size:.72rem;white-space:nowrap">@FormatBytes(adj.SizeBytes)</span>
                                    @if (!string.IsNullOrEmpty(adj.Descripcion))
                                    {
                                        <span class="text-muted fst-italic" style="font-size:.72rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                              title="@adj.Descripcion">@adj.Descripcion</span>
                                    }
                                    @if (!isViewing || viewingEstado == "Borrador")
                                    {
                                        <button class="btn btn-link btn-sm p-0 text-danger ms-1"
                                                @onclick="() => RemoverDocumento(adj)"
                                                title="Quitar adjunto" disabled="@uploadingDoc">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>

            @* ?? Barra de acciones inferior ?? *@
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex gap-2">
                        @if (isViewing && viewingEstado == "Borrador")
                        {
                            <button class="btn btn-warning" @onclick="EditarComprobante"
                                    aria-label="Editar comprobante">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> Editar
                            </button>
                        }
                        @if (isViewing && viewingEstado == "Contabilizado")
                        {
                            <button class="btn btn-danger" @onclick="AnularComprobante"
                                    aria-label="Anular comprobante @formNumero">
                                <i class="bi bi-x-octagon" aria-hidden="true"></i> Anular
                            </button>
                        }
                        @if (isViewing)
                        {
                            <button class="btn btn-outline-info" @onclick="CopiarComprobante"
                                    aria-label="Crear copia del comprobante">
                                <i class="bi bi-copy" aria-hidden="true"></i> Copiar
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="AbrirVistaPrevia"
                                    aria-label="Abrir vista previa para imprimir (Ctrl+P)">
                                <i class="bi bi-eye me-1" aria-hidden="true"></i>Vista Previa
                            </button>
                        }
                        @if (!isViewing)
                        {
                            <button class="btn btn-outline-info"
                                    title="Duplicar como nuevo borrador"
                                    aria-label="Duplicar comprobante como nuevo borrador"
                                    @onclick="DuplicarComprobante"
                                    disabled="@(saving || tempLineas.Count == 0)">
                                <i class="bi bi-copy me-1" aria-hidden="true"></i>Duplicar
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary" @onclick="NuevoComprobante"
                                aria-label="Crear nuevo comprobante">
                            <i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Nuevo
                        </button>
                        @if (!isViewing)
                        {
                            <button class="btn btn-secondary" @onclick="GuardarBorrador"
                                    disabled="@BotonGuardarDeshabilitado"
                                    title="@TooltipGuardar"
                                    aria-label="@TooltipGuardar (Ctrl+S)"
                                    aria-disabled="@BotonGuardarDeshabilitado">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                                <i class="bi bi-floppy me-1" aria-hidden="true"></i>Guardar
                            </button>
                            <button class="btn btn-primary" @onclick="GuardarYContabilizar"
                                    disabled="@BotonGuardarDeshabilitado"
                                    title="@TooltipContabilizar"
                                    aria-label="@TooltipContabilizar"
                                    aria-disabled="@BotonGuardarDeshabilitado">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                                <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Contabilizar
                            </button>
                        }
                    </div>
                </div>

                @* ?? Hint de atajos de teclado ?? *@
                @if (!isViewing)
                {
                    <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-3"
                         aria-label="Atajos de teclado disponibles"
                         style="font-size:.72rem;color:#9ca3af">
                        <span><kbd>Ctrl</kbd>+<kbd>S</kbd> Guardar borrador</span>
                        <span><kbd>Ctrl</kbd>+<kbd>P</kbd> Vista previa</span>
                        <span><kbd>Enter</kbd> en Haber ? agregar línea</span>
                        <span><kbd>Tab</kbd> navegar campos</span>
                        <span><kbd>Esc</kbd> cerrar modales</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* Modal de plantillas *@
<PlantillaComprobanteModal @ref="_plantillaModal"
                           OnSeleccionar="OnPlantillaSeleccionada" />

@* Vista previa de comprobante *@
<VistaPreviewComprobante @ref="_vistaPrevia"
                         Comprobante="@(_vistaPreviewDto)"
                         LineasTemp="@(_vistaPreviewLineas)" />

@* Popup de error emergente *@
@if (showPopupError)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> Error de Validación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showPopupError = false"></button>
                </div>
                <div class="modal-body"><p>@popupErrorMessage</p></div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="() => showPopupError = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ?? State ??????????????????????????????????????????????????????????????????
    private List<AsientoContableDto> asientos = new();
    private List<CuentaContableDto> cuentasMov = new();
    private List<TipoComprobanteDto> tiposComprobante = new();
    private List<TipoCambioDto> tiposCambio = new();
    private List<TipoPagoDto> tiposPago = new();
    private List<CentroCostoDto> centrosCosto = new();
    private bool loading = true;
    private bool saving = false;
    private bool seeding = false;
    private string? successMessage;
    private string? errorMessage;
    private bool exportando = false;

    // ?? Filtros ????????????????????????????????????????????????????????????????
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private string filtroEstado = "";
    private int filtroTipoComp = 0;
    private string filtroSearch = "";

    // ?? Form ???????????????????????????????????????????????????????????????????
    private bool showForm = false;
    private bool isViewing = false;
    private bool isEditing = false;
    private long editingId = 0;
    private string formNumero = "(auto)";
    private int formTipoCompId;
    private DateTime formFecha = DateTime.Today;
    private string? formConcepto;
    private string formGlosa = "";
    private int formTipoCambioId = 0;
    private int formTipoPagoId;
    private string? formNroDocPago;
    private string formRegistradoPor = "";
    private string viewingEstado = "";
    private List<TempLinea> tempLineas = new();

    // ?? Nueva línea ????????????????????????????????????????????????????????????
    private string searchCuenta = "";
    private int newCuentaId;
    private string? newGlosa;
    private int newCentroCostoId;
    private decimal newDebe;
    private decimal newHaber;

    // ?? Edición inline ?????????????????????????????????????????????????????????
    private int editingLineIdx = -1;
    private string? editGlosa;
    private decimal editDebe;
    private decimal editHaber;

    // ?? Popup ??????????????????????????????????????????????????????????????????
    private bool showPopupError;
    private string popupErrorMessage = "";

    // ?? Documentos ?????????????????????????????????????????????????????????????
    private List<ComprobanteDocumentoDto> adjuntos = new();
    private bool uploadingDoc;
    private string? docErrorMsg;
    private const int MaxAdjuntos = 5;
    private const long MaxDocSizeBytes = 10 * 1024 * 1024;

    private static bool IsAllowedMime(string mime) =>
        mime is "application/pdf"
            or "image/jpeg" or "image/jpg"
            or "image/png"
            or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            or "application/vnd.ms-excel";

    // ?? Computed ???????????????????????????????????????????????????????????????
    private decimal TotalDebe  => tempLineas.Sum(l => l.Debe);
    private decimal TotalHaber => tempLineas.Sum(l => l.Haber);

    private bool BotonGuardarDeshabilitado =>
        saving || formTipoCompId == 0
        || string.IsNullOrWhiteSpace(formGlosa)
        || tempLineas.Count < 2
        || TotalDebe != TotalHaber;

    private string TooltipGuardar
    {
        get
        {
            if (formTipoCompId == 0)                  return "Seleccione un tipo de comprobante";
            if (string.IsNullOrWhiteSpace(formGlosa)) return "Ingrese la glosa general";
            if (tempLineas.Count < 2)                 return "Agregue al menos 2 líneas";
            if (TotalDebe != TotalHaber)              return $"Diferencia: {Math.Abs(TotalDebe - TotalHaber):N2}";
            return "Guardar comprobante";
        }
    }

    private string TooltipContabilizar =>
        BotonGuardarDeshabilitado ? TooltipGuardar : "Guardar y contabilizar en un paso";

    private string BarraEstadoStyle =>
        tempLineas.Count == 0   ? "background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb" :
        TotalDebe == TotalHaber ? "background:#ecfdf5;color:#065f46;border:1px solid #6ee7b7" :
                                  "background:#fef2f2;color:#991b1b;border:1px solid #fca5a5";

    private IEnumerable<CuentaContableDto> cuentasFiltradas =>
        string.IsNullOrWhiteSpace(searchCuenta) ? cuentasMov :
        cuentasMov.Where(c =>
            c.Codigo.Contains(searchCuenta, StringComparison.OrdinalIgnoreCase)
            || c.Nombre.Contains(searchCuenta, StringComparison.OrdinalIgnoreCase)
            || $"{c.Codigo} - {c.Nombre}".Contains(searchCuenta, StringComparison.OrdinalIgnoreCase))
        .Take(20);

    private record TempLinea(
        int CuentaId, string CuentaCodigo, string CuentaNombre,
        string? Glosa, decimal Debe, decimal Haber,
        int? CentroCostoId, string? CentroCostoCodigo);

    // ?? Lifecycle ??????????????????????????????????????????????????????????????
    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogos();
        await LoadData();
    }

    private async Task LoadCatalogos()
    {
        try
        {
            tiposComprobante = await AsientoService.GetTiposComprobanteAsync();
            tiposCambio      = await AsientoService.GetTiposCambioAsync();
            tiposPago        = await AsientoService.GetTiposPagoAsync();
            centrosCosto     = await CentroCostoService.GetAllAsync();
            if (tiposComprobante.Count > 0) formTipoCompId = tiposComprobante[0].TipoComprobanteId;
            if (tiposPago.Count > 0) formTipoPagoId = tiposPago.FirstOrDefault(p => p.Codigo == "S/D")?.TipoPagoId ?? tiposPago[0].TipoPagoId;
            var usd = tiposCambio.FirstOrDefault(t => t.Moneda == "USD");
            if (usd is not null) formTipoCambioId = usd.TipoCambioId;
        }
        catch { }
    }

    private async Task LoadCuentas()
    {
        if (cuentasMov.Count == 0)
            cuentasMov = await CuentaService.GetAllAsync(permiteMovimientos: true);
    }

    private async Task LoadData()
    {
        loading = true; errorMessage = null;
        try
        {
            var tipoId = filtroTipoComp > 0 ? (int?)filtroTipoComp : null;
            asientos = await AsientoService.GetAllAsync(filtroDesde, filtroHasta,
                string.IsNullOrEmpty(filtroEstado) ? null : filtroEstado, tipoId,
                string.IsNullOrEmpty(filtroSearch) ? null : filtroSearch);
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }

    // ?? Navegación ?????????????????????????????????????????????????????????????
    private async Task NuevoComprobante()
    {
        await LoadCuentas();
        isViewing = false; isEditing = false; editingId = 0;
        formNumero = "(auto)";
        formTipoCompId = tiposComprobante.Count > 0 ? tiposComprobante[0].TipoComprobanteId : 0;
        formFecha = DateTime.Today;
        formConcepto = null; formGlosa = "";
        formTipoCambioId = tiposCambio.FirstOrDefault(t => t.Moneda == "USD")?.TipoCambioId ?? 0;
        formTipoPagoId = tiposPago.FirstOrDefault(p => p.Codigo == "S/D")?.TipoPagoId ?? 0;
        formNroDocPago = null; formRegistradoPor = "(usuario actual)";
        viewingEstado = "";
        tempLineas = new(); editingLineIdx = -1;
        adjuntos = new(); docErrorMsg = null;
        showForm = true;
    }

    private async Task VerComprobante(AsientoContableDto a)
    {
        await LoadCuentas();
        isViewing = true; isEditing = false; editingId = a.AsientoContableId;
        formNumero = a.Numero;
        formTipoCompId = a.TipoComprobanteId ?? 0;
        formFecha = a.Fecha; formConcepto = a.Concepto; formGlosa = a.Glosa;
        formTipoCambioId = a.TipoCambioId ?? 0;
        formTipoPagoId = a.TipoPagoId ?? 0;
        formNroDocPago = a.NumeroDocumentoPago;
        formRegistradoPor = a.RegistradoPor ?? "";
        viewingEstado = a.Estado;
        tempLineas = a.Lineas.Select(l => new TempLinea(
            l.CuentaContableId, l.CuentaCodigo, l.CuentaNombre,
            l.Glosa, l.Debe, l.Haber,
            l.CentroCostoId, l.CentroCostoCodigo)).ToList();
        editingLineIdx = -1;
        adjuntos = await AsientoService.GetDocumentosAsync(a.AsientoContableId);
        docErrorMsg = null;
        showForm = true;
    }

    private void EditarComprobante() { isViewing = false; isEditing = true; editingLineIdx = -1; }
    private async Task VolverALista() { showForm = false; await LoadData(); }

    // ?? Líneas ?????????????????????????????????????????????????????????????????
    private void OnCuentaSelected(ChangeEventArgs e)
    {
        var val = (e.Value?.ToString() ?? "").Trim();
        if (string.IsNullOrEmpty(val)) { newCuentaId = 0; return; }

        // Estrategia 1: el valor coincide exactamente con "CODIGO - Nombre"
        var match = cuentasMov.FirstOrDefault(c =>
            string.Equals($"{c.Codigo} - {c.Nombre}", val, StringComparison.OrdinalIgnoreCase));

        // Estrategia 2: el valor empieza con el código (el usuario escribió solo el código)
        match ??= cuentasMov.FirstOrDefault(c =>
            val.StartsWith(c.Codigo, StringComparison.OrdinalIgnoreCase));

        // Estrategia 3: el código está contenido en el valor seleccionado
        match ??= cuentasMov.FirstOrDefault(c =>
            val.Contains(c.Codigo, StringComparison.OrdinalIgnoreCase));

        newCuentaId = match?.CuentaContableId ?? 0;
    }

    private void AddLinea()
    {
        if (newCuentaId == 0) { ShowPopup("Seleccione una cuenta contable válida."); return; }
        if (newDebe > 0 && newHaber > 0) { ShowPopup("Una línea no puede tener montos en Debe y Haber simultáneamente."); return; }
        if (newDebe == 0 && newHaber == 0) { ShowPopup("Ingrese un monto en Debe o en Haber."); return; }
        var cuenta = cuentasMov.First(c => c.CuentaContableId == newCuentaId);
        int? ccId = newCentroCostoId > 0 ? newCentroCostoId : null;
        string? ccCodigo = ccId.HasValue ? centrosCosto.FirstOrDefault(c => c.Id == ccId.Value)?.Codigo : null;
        tempLineas.Add(new TempLinea(cuenta.CuentaContableId, cuenta.Codigo, cuenta.Nombre,
            newGlosa, newDebe, newHaber, ccId, ccCodigo));
        searchCuenta = ""; newCuentaId = 0; newGlosa = null;
        newCentroCostoId = 0; newDebe = 0; newHaber = 0;
    }

    private void RemoveLinea(int idx)
    {
        if (editingLineIdx == idx) editingLineIdx = -1;
        tempLineas.RemoveAt(idx);
    }

    private void StartLineEdit(int idx)
    {
        editingLineIdx = idx;
        var l = tempLineas[idx];
        editGlosa = l.Glosa; editDebe = l.Debe; editHaber = l.Haber;
    }

    private void SaveLineEdit()
    {
        if (editDebe > 0 && editHaber > 0) { ShowPopup("Una línea no puede tener montos en Debe y Haber simultáneamente."); return; }
        if (editDebe == 0 && editHaber == 0) { ShowPopup("Ingrese un monto en Debe o en Haber."); return; }
        var old = tempLineas[editingLineIdx];
        tempLineas[editingLineIdx] = old with { Glosa = editGlosa, Debe = editDebe, Haber = editHaber };
        editingLineIdx = -1;
    }

    private void CancelLineEdit() => editingLineIdx = -1;

    // ?? Exclusión mutua Debe / Haber ???????????????????????????????????????????
    private void OnNewDebeInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v) && v > 0) { newDebe = v; newHaber = 0; }
        else newDebe = 0;
    }

    private void OnNewHaberInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v) && v > 0) { newHaber = v; newDebe = 0; }
        else newHaber = 0;
    }

    // ?? Reordenar líneas ???????????????????????????????????????????????????????
    private void MoverLineaArriba(int idx)
    {
        if (idx <= 0 || idx >= tempLineas.Count) return;
        (tempLineas[idx - 1], tempLineas[idx]) = (tempLineas[idx], tempLineas[idx - 1]);
        if (editingLineIdx == idx)          editingLineIdx = idx - 1;
        else if (editingLineIdx == idx - 1) editingLineIdx = idx;
    }

    private void MoverLineaAbajo(int idx)
    {
        if (idx < 0 || idx >= tempLineas.Count - 1) return;
        (tempLineas[idx], tempLineas[idx + 1]) = (tempLineas[idx + 1], tempLineas[idx]);
        if (editingLineIdx == idx)          editingLineIdx = idx + 1;
        else if (editingLineIdx == idx + 1) editingLineIdx = idx;
    }

    // ?? Duplicar ???????????????????????????????????????????????????????????????
    private void DuplicarComprobante()
    {
        var lineasCopiadas = tempLineas.ToList();
        isViewing = false; isEditing = false; editingId = 0;
        formNumero     = "(auto)";
        viewingEstado  = "";
        tempLineas     = lineasCopiadas;
        editingLineIdx = -1;
        adjuntos       = new();
        docErrorMsg    = null;
        successMessage = "Líneas copiadas. Ajuste los datos y guarde el nuevo comprobante.";
    }

    // ?? Guardar ????????????????????????????????????????????????????????????????
    private Task GuardarBorrador()      => GuardarComprobante(false);
    private Task GuardarYContabilizar() => GuardarComprobante(true);

    private async Task GuardarComprobante(bool contabilizar = false)
    {
        if (TotalDebe != TotalHaber)
        {
            ShowPopup($"El comprobante no cuadra. Debe: {TotalDebe:N2}, Haber: {TotalHaber:N2}. Diferencia: {Math.Abs(TotalDebe - TotalHaber):N2}");
            return;
        }
        saving = true; errorMessage = null;
        try
        {
            var lineas = tempLineas.Select(l => new CreateAsientoLineaDto
            {
                CuentaContableId = l.CuentaId, Debe = l.Debe, Haber = l.Haber,
                Glosa = l.Glosa, CentroCostoId = l.CentroCostoId
            }).ToList();

            long savedId;
            if (isEditing)
            {
                var dto = new UpdateAsientoContableDto
                {
                    TipoComprobanteId = formTipoCompId, Fecha = formFecha, Concepto = formConcepto,
                    Glosa = formGlosa, TipoCambioId = formTipoCambioId > 0 ? formTipoCambioId : null,
                    TipoPagoId = formTipoPagoId > 0 ? formTipoPagoId : null,
                    NumeroDocumentoPago = formNroDocPago, Lineas = lineas
                };
                var r = await AsientoService.UpdateAsync(editingId, dto);
                if (!r.Success) { ShowPopup(r.Message ?? "Error al actualizar."); return; }
                savedId = r.Data!.AsientoContableId;
                successMessage = "Comprobante actualizado.";
            }
            else
            {
                var dto = new CreateAsientoContableDto
                {
                    TipoComprobanteId = formTipoCompId, Fecha = formFecha, Concepto = formConcepto,
                    Glosa = formGlosa, TipoCambioId = formTipoCambioId > 0 ? formTipoCambioId : null,
                    TipoPagoId = formTipoPagoId > 0 ? formTipoPagoId : null,
                    NumeroDocumentoPago = formNroDocPago, Lineas = lineas
                };
                var r = await AsientoService.CreateAsync(dto);
                if (!r.Success) { ShowPopup(r.Message ?? "Error al crear."); return; }
                savedId = r.Data!.AsientoContableId;
                successMessage = "Comprobante creado.";
            }

            if (contabilizar)
            {
                var rc = await AsientoService.ContabilizarAsync(savedId);
                if (rc.Success) { successMessage = "Comprobante contabilizado."; await VerComprobante(rc.Data!); return; }
                errorMessage = $"Guardado pero no contabilizado: {rc.Message}";
            }

            var saved = await AsientoService.GetByIdAsync(savedId);
            if (saved is not null) await VerComprobante(saved);
        }
        catch (Exception ex) { ShowPopup(ex.Message); }
        finally { saving = false; }
    }

    // ?? Acciones ???????????????????????????????????????????????????????????????
    private async Task Contabilizar(AsientoContableDto a)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Contabilizar comprobante {a.Numero}?")) return;
        try
        {
            var r = await AsientoService.ContabilizarAsync(a.AsientoContableId);
            if (r.Success) { successMessage = $"Comprobante {a.Numero} contabilizado."; await LoadData(); }
            else ShowPopup(r.Message ?? "Error.");
        }
        catch (Exception ex) { ShowPopup(ex.Message); }
    }

    private async Task AnularComprobante()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Anular comprobante {formNumero}? Se revertirán los saldos.")) return;
        try
        {
            var r = await AsientoService.AnularAsync(editingId);
            if (r.Success) { successMessage = "Comprobante anulado."; await VerComprobante(r.Data!); }
            else ShowPopup(r.Message ?? "Error.");
        }
        catch (Exception ex) { ShowPopup(ex.Message); }
    }

    private async Task CopiarComprobante()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Crear una copia del comprobante {formNumero}?")) return;
        try
        {
            var r = await AsientoService.CopiarAsync(editingId);
            if (r.Success) { successMessage = $"Comprobante copiado como {r.Data!.Numero}."; await VerComprobante(r.Data!); }
            else ShowPopup(r.Message ?? "Error.");
        }
        catch (Exception ex) { ShowPopup(ex.Message); }
    }

    private async Task SeedCatalogos()
    {
        seeding = true;
        try
        {
            var r = await AsientoService.SeedCatalogosAsync();
            if (r.Success) { successMessage = r.Message ?? "Catálogos generados."; await LoadCatalogos(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { seeding = false; }
    }

    private void ShowPopup(string msg) { popupErrorMessage = msg; showPopupError = true; }

    // ?? Atajos de teclado ??????????????????????????????????????????????????????

    private bool _preventDefaultKey;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        _preventDefaultKey = false;

        switch (e.Key)
        {
            // Ctrl+S ? Guardar borrador
            case "s" or "S" when e.CtrlKey && !isViewing && !BotonGuardarDeshabilitado:
                _preventDefaultKey = true;
                await GuardarBorrador();
                break;

            // Ctrl+P ? Vista previa
            case "p" or "P" when e.CtrlKey:
                _preventDefaultKey = true;
                AbrirVistaPrevia();
                break;

            // Escape ? cerrar popup de error o volver a lista si no hay modal abierto
            case "Escape":
                if (showPopupError)
                    showPopupError = false;
                break;
        }
    }

    /// Enter en el campo Haber ? agrega la línea si hay cuenta seleccionada.
    private void OnHaberKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && newCuentaId != 0)
            AddLinea();
    }

