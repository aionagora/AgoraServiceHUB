    private void OnPlantillaSeleccionada(List<PlantillaContableLineaDto> lineas)
    {
        foreach (var l in lineas)
        {
            var debe  = l.TipoMovimiento == "Debe"  ? l.Factor : 0m;
            var haber = l.TipoMovimiento == "Haber" ? l.Factor : 0m;
            tempLineas.Add(new TempLinea(l.CuentaContableId, l.CuentaCodigo, l.CuentaNombre,
                l.Glosa, debe, haber, null, null));
        }
    }

    // ?? Documentos adjuntos ????????????????????????????????????????????????????
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        docErrorMsg = null;
        if (editingId == 0) { docErrorMsg = "Guarde el comprobante primero para adjuntar documentos."; return; }
        var file = e.File;
        if (adjuntos.Count >= MaxAdjuntos) { docErrorMsg = $"Máximo {MaxAdjuntos} archivos por comprobante."; return; }
        if (file.Size > MaxDocSizeBytes) { docErrorMsg = "El archivo supera el límite de 10 MB."; return; }
        if (!IsAllowedMime(file.ContentType)) { docErrorMsg = "Tipo no permitido. Use PDF, JPG, PNG o XLSX."; return; }
        uploadingDoc = true; StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(MaxDocSizeBytes);
            var result = await AsientoService.SubirYAdjuntarAsync(editingId, stream, file.Name, file.ContentType);
            if (result.Success && result.Data is not null) adjuntos.Add(result.Data);
            else docErrorMsg = result.Message ?? "Error al subir el archivo.";
        }
        catch (Exception ex) { docErrorMsg = $"Error: {ex.Message}"; }
        finally { uploadingDoc = false; }
    }

    private async Task RemoverDocumento(ComprobanteDocumentoDto adj)
    {
        docErrorMsg = null;
        try
        {
            var r = await AsientoService.RemoverDocumentoAsync(editingId, adj.Id);
            if (r.Success) adjuntos.Remove(adj);
            else docErrorMsg = r.Message ?? "Error al remover el adjunto.";
        }
        catch (Exception ex) { docErrorMsg = ex.Message; }
    }

