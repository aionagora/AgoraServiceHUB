@page "/contabilidad/sumas-saldos"
@attribute [Authorize]
@inject EstadoFinancieroHttpService ReporteService
@inject IJSRuntime JS

<PageTitle>Sumas y Saldos - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-table"></i> Balance de Comprobación — Sumas y Saldos</h3>
            <p class="text-muted mb-0">Verificación de partida doble por período</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="fechaDesde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="fechaHasta" />
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-sm btn-primary" @onclick="Generar" disabled="@loading">
                        @if (loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-calculator"></i> Generar
                    </button>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-sm btn-success" @onclick="ExportarExcel" disabled="@(exportando || data == null)">
                        @if (exportando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </button>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Imprimir" disabled="@(data == null)">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (data != null)
    {
        <div id="printArea">
            <div class="card">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h4 class="fw-bold">@data.Empresa</h4>
                        <h5>BALANCE DE COMPROBACIÓN — SUMAS Y SALDOS</h5>
                        <p class="text-muted">Del @data.FechaDesde.ToString("dd/MM/yyyy") al @data.FechaHasta.ToString("dd/MM/yyyy") — Gestión @data.Gestion</p>
                        <p class="small text-muted">(Expresado en Bolivianos)</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th rowspan="2" class="align-middle text-center">Código</th>
                                    <th rowspan="2" class="align-middle">Nombre de la Cuenta</th>
                                    <th colspan="2" class="text-center">SUMAS</th>
                                    <th colspan="2" class="text-center">SALDOS</th>
                                </tr>
                                <tr>
                                    <th class="text-end">Debe</th>
                                    <th class="text-end">Haber</th>
                                    <th class="text-end">Deudor</th>
                                    <th class="text-end">Acreedor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (data.Lineas.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-4">No hay movimientos en el período seleccionado.</td></tr>
                                }
                                @foreach (var l in data.Lineas)
                                {
                                    <tr>
                                        <td><code>@l.Codigo</code></td>
                                        <td>@l.Nombre</td>
                                        <td class="text-end">@l.SumaDebe.ToString("N2")</td>
                                        <td class="text-end">@l.SumaHaber.ToString("N2")</td>
                                        <td class="text-end @(l.SaldoDeudor > 0 ? "fw-semibold text-primary" : "")">@l.SaldoDeudor.ToString("N2")</td>
                                        <td class="text-end @(l.SaldoAcreedor > 0 ? "fw-semibold text-success" : "")">@l.SaldoAcreedor.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="2" class="text-end">TOTALES:</td>
                                    <td class="text-end">@data.TotalSumaDebe.ToString("N2")</td>
                                    <td class="text-end">@data.TotalSumaHaber.ToString("N2")</td>
                                    <td class="text-end text-primary">@data.TotalSaldoDeudor.ToString("N2")</td>
                                    <td class="text-end text-success">@data.TotalSaldoAcreedor.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="text-center mt-3">
                        @if (data.TotalSumaDebe == data.TotalSumaHaber)
                        {
                            <span class="badge bg-success fs-6"><i class="bi bi-check-circle-fill"></i> Las sumas cuadran (Debe = Haber)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6"><i class="bi bi-exclamation-triangle-fill"></i> Las sumas NO cuadran — Diferencia: @Math.Abs(data.TotalSumaDebe - data.TotalSumaHaber).ToString("N2")</span>
                        }
                        @if (data.TotalSaldoDeudor == data.TotalSaldoAcreedor)
                        {
                            <span class="badge bg-success fs-6 ms-2"><i class="bi bi-check-circle-fill"></i> Los saldos cuadran (Deudor = Acreedor)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 ms-2"><i class="bi bi-exclamation-triangle-fill"></i> Los saldos NO cuadran — Diferencia: @Math.Abs(data.TotalSaldoDeudor - data.TotalSaldoAcreedor).ToString("N2")</span>
                        }
                    </div>

                    <div class="mt-3 text-muted small">
                        <strong>@data.Lineas.Count</strong> cuentas con movimientos en el período.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DateTime fechaDesde = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime fechaHasta = DateTime.Today;
    private SumasYSaldosDto? data;
    private bool loading;
    private bool exportando;
    private string? errorMessage;

    private async Task Generar()
    {
        loading = true; errorMessage = null;
        try
        {
            data = await ReporteService.GetSumasYSaldosAsync(fechaDesde, fechaHasta);
            if (data == null) errorMessage = "No se pudo generar el reporte de Sumas y Saldos.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }

    private async Task ExportarExcel()
    {
        exportando = true;
        try
        {
            var bytes = await ReporteService.ExportSumasYSaldosExcelAsync(fechaDesde, fechaHasta);
            if (bytes != null)
                await JS.InvokeVoidAsync("downloadFile",
                    $"Sumas_Saldos_{fechaDesde:yyyyMMdd}_{fechaHasta:yyyyMMdd}.xlsx",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { exportando = false; }
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("eval", "window.print()");
    }
}
