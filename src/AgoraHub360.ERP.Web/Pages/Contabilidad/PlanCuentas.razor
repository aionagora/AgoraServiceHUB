@page "/contabilidad/plan-cuentas"
@attribute [Authorize]
@inject CuentaContableHttpService CuentaService
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Plan de Cuentas - AgoraHub360 ERP</PageTitle>

<AppPageHeader Title="Plan de Cuentas"
               Subtitle="Estructura jerárquica del plan de cuentas contable"
               Icon="@Icons.Material.Filled.AccountBalance">
    <Actions>
        <MudButton Variant="@Variant.Outlined"
                   Color="@Color.Success"
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Disabled="@seeding"
                   OnClick="@SeedPlanCuentas">
            Generar Plan Estándar
        </MudButton>
        <MudButton Variant="@Variant.Filled"
                   Color="@Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@ShowCreateModal">
            Nueva Cuenta
        </MudButton>
    </Actions>
</AppPageHeader>

@* ── Alertas ── *@
@if (!string.IsNullOrEmpty(successMessage))
{
    <MudAlert Severity="@Severity.Success" Variant="@Variant.Filled" Dense="true" Class="mb-4">
        <MudText Typo="@Typo.body2">@successMessage</MudText>
    </MudAlert>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="@Severity.Error" Variant="@Variant.Filled" Dense="true" Class="mb-4">
        <MudText Typo="@Typo.body2">@errorMessage</MudText>
    </MudAlert>
}

@* ── Filtros y Acciones ── *@
<AppSectionCard Title="Filtros" Subtitle="Buscar cuentas por código o nombre">
    <Actions>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="@Size.Small" OnClick="@LoadData" Title="Recargar" />
        @if (viewMode == "tree")
        {
            <MudIconButton Icon="@Icons.Material.Filled.UnfoldMore" Size="@Size.Small" OnClick="@ExpandAll" Title="Expandir todo" />
            <MudIconButton Icon="@Icons.Material.Filled.UnfoldLess" Size="@Size.Small" OnClick="@CollapseAll" Title="Colapsar todo" />
        }
    </Actions>
    <ChildContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="searchText"
                              Label="Buscar"
                              Placeholder="Código o nombre..."
                              Variant="@Variant.Outlined"
                              Dense="true"
                              Clearable="true"
                              For="@(() => searchText)" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudSelect T="string" @bind-Value="viewMode"
                           Label="Vista"
                           Variant="@Variant.Outlined"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("tree")">Árbol</MudSelectItem>
                    <MudSelectItem T="string" Value="@("flat")">Lista plana</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="3" md="2" Class="d-flex align-items-end">
                <MudText Typo="@Typo.body2" Class="mud-text-secondary">
                    @allCuentas.Count cuentas
                </MudText>
            </MudItem>
        </MudGrid>
    </ChildContent>
</AppSectionCard>

@* ── Importar desde CSV ── *@
<MudPaper Elevation="1" Class="pa-4 mb-6">
    <MudText Typo="@Typo.subtitle1" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.FileUpload" Class="me-2" Color="@Color.Primary" />
        Importar desde CSV
    </MudText>
    <MudGrid>
        <MudItem xs="12" sm="8" md="6">
            <InputFile OnChange="@(args => OnFileSelected(args.GetMultipleFiles().ToArray()))" accept=".csv" />
            @if (_selectedFileName is not null)
            {
                <MudText Typo="@Typo.body2" Class="mt-2 mud-text-secondary">@_selectedFileName</MudText>
            }
        </MudItem>
    </MudGrid>
    @if (_selectedFileName is not null)
    {
        <MudGrid Class="mt-2">
            <MudItem>
                <MudButton Variant="@Variant.Filled"
                           Color="@Color.Primary"
                           StartIcon="@Icons.Material.Filled.Preview"
                           Disabled="@_previewLoading"
                           OnClick="@PreviewImport">
                    Vista previa
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Variant="@Variant.Filled"
                           Color="@Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@(!_previewDone || _hasPreviewErrors || _importLoading)"
                           OnClick="@ConfirmImport">
                    Importar
                </MudButton>
            </MudItem>
            <MudItem Class="d-flex align-items-center">
                <MudButton Variant="@Variant.Text"
                           Color="@Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ClearImport">
                    Cancelar
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    @if (_previewLoading)
    {
        <MudProgressCircular Indeterminate="true" Size="@Size.Small" Class="mt-4" />
    }
    @if (_importResult is not null)
    {
        <MudAlert Severity="@(_importResult.Errors == 0 ? Severity.Success : Severity.Warning)"
                  Variant="@Variant.Filled"
                  Class="mt-4">
            <MudText>
                @(_importResult.Errors == 0
                    ? $"✓ Se importaron {_importResult.Created} cuentas correctamente."
                    : $"⚠ Se importaron {_importResult.Created} cuentas, {_importResult.Skipped} omitidas, {_importResult.Errors} errores.")
            </MudText>
        </MudAlert>
        @if (_importResult.ErrorRows.Count > 0)
        {
            <MudTable Items="@_importResult.ErrorRows" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>Fila</MudTh>
                    <MudTh>Error</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.Fila?.ToString() ?? "—")</MudTd>
                    <MudTd><MudText Color="@Color.Error">@context.Mensaje</MudText></MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
    @if (_previewResult is not null && _previewDone)
    {
        <MudAlert Severity="@(_previewResult.CanImport ? Severity.Success : Severity.Warning)"
                  Variant="@Variant.Outlined"
                  Class="mt-4">
            <MudText>
                @(_previewResult.CanImport
                    ? $"✓ {_previewResult.ValidRows} cuentas válidas listas para importar (\"{_previewResult.FileName}\")."
                    : $"⚠ {_previewResult.TotalRows} filas procesadas: {_previewResult.ValidRows} válidas, {_previewResult.InvalidRows} inválidas.")
            </MudText>
        </MudAlert>
        @if (_previewResult.Rows.Any(r => !r.IsValid))
        {
            <MudTable Items="@_previewResult.Rows.Where(r => !r.IsValid)" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>Fila</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Errores</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RowNumber</MudTd>
                    <MudTd><MudText Typo="@Typo.body2" Class="font-weight-bold">@context.Codigo</MudText></MudTd>
                    <MudTd>
                        @foreach (var err in context.Errors)
                        {
                            <MudText Color="@Color.Error" Typo="@Typo.caption">@err</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        @if (_previewResult.Rows.Any(r => r.IsValid))
        {
            <MudTable Items="@_previewResult.Rows.Where(r => r.IsValid)" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Nivel</MudTh>
                    <MudTh>Padre</MudTh>
                    <MudTh style="text-align:center;">Mov.</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudText Typo="@Typo.caption" Class="mud-text-secondary">@context.RowNumber</MudText></MudTd>
                    <MudTd><MudText Typo="@Typo.body2" Class="font-weight-bold">@context.Codigo</MudText></MudTd>
                    <MudTd><MudText Typo="@Typo.body2">@context.Nombre</MudText></MudTd>
                    <MudTd><AppStatusChip Status="@context.TipoCuenta" /></MudTd>
                    <MudTd><MudChip T="string" Size="@Size.Small">N@(context.Nivel)</MudChip></MudTd>
                    <MudTd><MudText Typo="@Typo.body2" Class="mud-text-secondary">@(context.CodigoPadre ?? "—")</MudText></MudTd>
                    <MudTd Style="text-align:center;">
                        @if (context.EsMovimiento)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="@Size.Small" Color="@Color.Success" />
                        }
                        else
                        {
                            <MudText Typo="@Typo.body2" Class="mud-text-disabled">—</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</MudPaper>

@* ── Contenido ── *@
@if (loading)
{
    <AppLoadingState Message="Cargando plan de cuentas..." />
}
else if (allCuentas.Count == 0)
{
    <AppEmptyState Title="No hay cuentas contables"
                   Description="Use 'Generar Plan Estándar' para crear el plan de cuentas Bolivia/NIIF o agregue cuentas manualmente."
                   Icon="@Icons.Material.Filled.AccountBalance">
        <Actions>
            <MudButton Variant="@Variant.Filled"
                       Color="@Color.Success"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="@SeedPlanCuentas">
                Generar Plan Estándar
            </MudButton>
        </Actions>
    </AppEmptyState>
}
else if (viewMode == "tree")
{
    <MudPaper Elevation="1" Class="pa-0">
        <MudTable Items="@flatTreeRows"
                  Hover="true"
                  Dense="true"
                  Class="mb-0">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<FlatTreeRow, object>(r => r.Cuenta.Codigo)">Código</MudTableSortLabel></MudTh>
                <MudTh>Nombre</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Naturaleza</MudTh>
                <MudTh Style="text-align:center;">Mov.</MudTh>
                <MudTh Style="text-align:end;">Saldo</MudTh>
                <MudTh Style="text-align:end;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var row = context;
                    var visible = IsRowVisible(row) && MatchesSearch(row.Cuenta);
                }
                @if (visible)
                {
                    <MudTr Class="@(row.Cuenta.PermiteMovimientos ? "" : "mud-theme-override")">
                        <MudTd Style="@($"padding-left:{20 + row.Depth * 24}px")">
                            @if (row.Cuenta.SubCuentas.Count > 0)
                            {
                                <MudIconButton Size="@Size.Small"
                                               Icon="@(expandedCodes.Contains(row.Cuenta.Codigo) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                               OnClick="() => ToggleExpand(row.Cuenta.Codigo)" />
                            }
                            else
                            {
                                <span style="display:inline-block;width:36px;"></span>
                            }
                            <MudText Typo="@Typo.body2" Class="font-weight-bold mud-primary-text" Style="display:inline;">@row.Cuenta.Codigo</MudText>
                        </MudTd>
                        <MudTd>
                            @if (!row.Cuenta.PermiteMovimientos)
                            {
                                <MudText Typo="@Typo.body2" Class="font-weight-bold">@row.Cuenta.Nombre</MudText>
                            }
                            else
                            {
                                <MudText Typo="@Typo.body2">@row.Cuenta.Nombre</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            <AppStatusChip Status="@row.Cuenta.Tipo" />
                        </MudTd>
                        <MudTd><MudText Typo="@Typo.body2">@row.Cuenta.Naturaleza</MudText></MudTd>
                        <MudTd Style="text-align:center;">
                            @if (row.Cuenta.PermiteMovimientos)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="@Size.Small" Color="@Color.Success" />
                            }
                            else
                            {
                                <MudText Typo="@Typo.body2" Class="mud-text-disabled">—</MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align:end;">
                            @if (row.Cuenta.SaldoActual != 0)
                            {
                                <MudText Typo="@Typo.body2">@row.Cuenta.SaldoActual.ToString("N2")</MudText>
                            }
                            else
                            {
                                <MudText Typo="@Typo.body2" Class="mud-text-disabled">—</MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align:end;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="@Size.Small"
                                           Color="@Color.Primary"
                                           OnClick="() => ShowEditModal(row.Cuenta)"
                                           Title="Editar" />
                            @if (!row.Cuenta.PermiteMovimientos)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                               Size="@Size.Small"
                                               Color="@Color.Success"
                                               OnClick="() => ShowCreateChildModal(row.Cuenta)"
                                               Title="Agregar subcuenta" />
                            }
                            @if (row.Cuenta.SaldoActual == 0 && row.Cuenta.SubCuentas.Count == 0)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="@Size.Small"
                                               Color="@Color.Error"
                                               OnClick="() => ConfirmDeleteCuenta(row.Cuenta)"
                                               Title="Eliminar" />
                            }
                        </MudTd>
                    </MudTr>
                }
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Class="pa-0">
        <MudTable Items="@FilterFlat(allCuentas)"
                  Hover="true"
                  Dense="true"
                  Class="mb-0">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Nombre</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Naturaleza</MudTh>
                <MudTh>Nivel</MudTh>
                <MudTh>Padre</MudTh>
                <MudTh Style="text-align:center;">Mov.</MudTh>
                <MudTh Style="text-align:end;">Saldo</MudTh>
                <MudTh Style="text-align:end;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var c = context;
                }
                <MudTr>
                    <MudTd><MudText Typo="@Typo.body2" Class="font-weight-bold mud-primary-text">@c.Codigo</MudText></MudTd>
                    <MudTd><MudText Typo="@Typo.body2">@c.Nombre</MudText></MudTd>
                    <MudTd>
                        <AppStatusChip Status="@c.Tipo" />
                    </MudTd>
                    <MudTd><MudText Typo="@Typo.body2">@c.Naturaleza</MudText></MudTd>
                    <MudTd><MudChip T="string" Size="@Size.Small" Color="@Color.Default">N@(c.Nivel)</MudChip></MudTd>
                    <MudTd><MudText Typo="@Typo.body2" Class="mud-text-secondary">@(c.CuentaPadreCodigo ?? "—")</MudText></MudTd>
                    <MudTd Style="text-align:center;">
                        @if (c.PermiteMovimientos)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="@Size.Small" Color="@Color.Success" />
                        }
                        else
                        {
                            <MudText Typo="@Typo.body2" Class="mud-text-disabled">—</MudText>
                        }
                    </MudTd>
                    <MudTd Style="text-align:end;">
                        @if (c.SaldoActual != 0)
                        {
                            <MudText Typo="@Typo.body2">@c.SaldoActual.ToString("N2")</MudText>
                        }
                        else
                        {
                            <MudText Typo="@Typo.body2" Class="mud-text-disabled">—</MudText>
                        }
                    </MudTd>
                    <MudTd Style="text-align:end;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="@Size.Small"
                                       Color="@Color.Primary"
                                       OnClick="() => ShowEditModal(c)"
                                       Title="Editar" />
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                       Size="@Size.Small"
                                       Color="@Color.Success"
                                       OnClick="() => ShowCreateChildModal(c)"
                                       Title="Agregar subcuenta" />
                        @if (c.SaldoActual == 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="@Size.Small"
                                           Color="@Color.Error"
                                           OnClick="() => ConfirmDeleteCuenta(c)"
                                           Title="Eliminar" />
                        }
                    </MudTd>
                </MudTr>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* ── Variables ── *@
@code {

    // ── Estado general ──
    private List<CuentaContableDto> allCuentas = new();
    private List<CuentaContableDto> treeCuentas = new();
    private List<FlatTreeRow> flatTreeRows = new();
    private bool loading = true;
    private bool saving = false;
    private bool seeding = false;
    private string? successMessage;
    private string? errorMessage;
    private string viewMode = "tree";
    private string searchText = "";

    // ── Import CSV ──
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private bool _previewLoading;
    private bool _previewDone;
    private bool _hasPreviewErrors;
    private bool _importLoading;
    private PlanCuentaImportPreviewDto? _previewResult;
    private PlanCuentaImportResultDto? _importResult;

    // ── Expanded nodes ──
    private HashSet<string> expandedCodes = new();

    private record FlatTreeRow(CuentaContableDto Cuenta, int Depth, string? ParentCode);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true; errorMessage = null;
        try
        {
            var t1 = CuentaService.GetAllAsync();
            var t2 = CuentaService.GetTreeAsync();
            await Task.WhenAll(t1, t2);
            allCuentas = await t1;
            treeCuentas = await t2;
            // Expand level 1 by default
            foreach (var c in treeCuentas)
                expandedCodes.Add(c.Codigo);
            RebuildFlatTree();
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }

    private void RebuildFlatTree()
    {
        flatTreeRows = new();
        foreach (var root in treeCuentas)
            FlattenTree(root, 0, null);
    }

    private void FlattenTree(CuentaContableDto cuenta, int depth, string? parentCode)
    {
        flatTreeRows.Add(new FlatTreeRow(cuenta, depth, parentCode));
        foreach (var child in cuenta.SubCuentas.OrderBy(c => c.Codigo))
            FlattenTree(child, depth + 1, cuenta.Codigo);
    }

    private bool IsRowVisible(FlatTreeRow row)
    {
        if (row.Depth == 0) return true;
        var current = row;
        while (current.ParentCode != null)
        {
            if (!expandedCodes.Contains(current.ParentCode)) return false;
            current = flatTreeRows.FirstOrDefault(r => r.Cuenta.Codigo == current.ParentCode)!;
            if (current is null) break;
        }
        return true;
    }

    private bool MatchesSearch(CuentaContableDto c)
    {
        if (string.IsNullOrWhiteSpace(searchText)) return true;
        var s = searchText.ToLower();
        return c.Codigo.ToLower().Contains(s) || c.Nombre.ToLower().Contains(s);
    }

    private void ToggleExpand(string codigo)
    {
        if (!expandedCodes.Add(codigo))
            expandedCodes.Remove(codigo);
    }

    private void ExpandAll()
    {
        foreach (var row in flatTreeRows.Where(r => r.Cuenta.SubCuentas.Count > 0))
            expandedCodes.Add(row.Cuenta.Codigo);
    }

    private void CollapseAll()
    {
        expandedCodes.Clear();
    }

    // ?? Filter helpers ??
    private List<CuentaContableDto> FilterFlat(List<CuentaContableDto> cuentas)
    {
        if (string.IsNullOrWhiteSpace(searchText)) return cuentas;
        var s = searchText.ToLower();
        return cuentas.Where(c => c.Codigo.ToLower().Contains(s) || c.Nombre.ToLower().Contains(s)).ToList();
    }

    // ── CRUD con MudDialog ──
    private async Task ShowCreateModal()
    {
        var parameters = new DialogParameters<CuentaDialog>
        {
            { x => x.IsEditing, false },
            { x => x.AllCuentas, allCuentas }
        };
        var dialog = await DialogService.ShowAsync<CuentaDialog>("Nueva Cuenta Contable", parameters);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            successMessage = "Cuenta creada correctamente.";
            await LoadData();
        }
    }

    private async Task ShowCreateChildModal(CuentaContableDto padre)
    {
        var parameters = new DialogParameters<CuentaDialog>
        {
            { x => x.IsEditing, false },
            { x => x.AllCuentas, allCuentas },
            { x => x.PadreCuenta, padre }
        };
        var dialog = await DialogService.ShowAsync<CuentaDialog>("Nueva Subcuenta", parameters);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            successMessage = "Subcuenta creada correctamente.";
            await LoadData();
        }
    }

    private async Task ShowEditModal(CuentaContableDto cuenta)
    {
        var parameters = new DialogParameters<CuentaDialog>
        {
            { x => x.IsEditing, true },
            { x => x.AllCuentas, allCuentas },
            { x => x.CuentaEditando, cuenta }
        };
        var dialog = await DialogService.ShowAsync<CuentaDialog>("Editar Cuenta Contable", parameters);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            successMessage = "Cuenta actualizada correctamente.";
            await LoadData();
        }
    }

    private async Task ConfirmDeleteCuenta(CuentaContableDto cuenta)
    {
        var parameters = new DialogParameters<AppConfirmDialog>
        {
            { x => x.Title, "Eliminar cuenta contable" },
            { x => x.Message, $"¿Eliminar la cuenta {cuenta.Codigo} — {cuenta.Nombre}?" },
            { x => x.ConfirmText, "Esta acción no se puede deshacer si la cuenta tiene saldos." },
            { x => x.ConfirmLabel, "Eliminar" },
            { x => x.ConfirmColor, Color.Error },
            { x => x.ConfirmIcon, Icons.Material.Filled.Delete }
        };
        var dialog = await DialogService.ShowAsync<AppConfirmDialog>("Confirmar eliminación", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        try
        {
            var r = await CuentaService.DeleteAsync(cuenta.CuentaContableId);
            if (r.Success) { successMessage = "Cuenta eliminada."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task SeedPlanCuentas()
    {
        var parameters = new DialogParameters<AppConfirmDialog>
        {
            { x => x.Title, "Generar plan de cuentas estándar" },
            { x => x.Message, "¿Generar el plan de cuentas estándar Bolivia/NIIF? Esto creará cuentas predefinidas." },
            { x => x.ConfirmText, "Solo debe ejecutarse una vez por empresa." },
            { x => x.ConfirmLabel, "Generar" },
            { x => x.ConfirmColor, Color.Success },
            { x => x.ConfirmIcon, Icons.Material.Filled.AutoAwesome }
        };
        var dialog = await DialogService.ShowAsync<AppConfirmDialog>("Confirmar", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        seeding = true; errorMessage = null;
        try
        {
            var r = await CuentaService.SeedPlanCuentasAsync();
            if (r.Success) { successMessage = r.Message ?? $"Plan de cuentas generado: {r.Data} cuentas."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { seeding = false; }
    }

    // ── Import CSV ──
    private void OnFileSelected(IBrowserFile[] files)
    {
        if (files.Length == 0) return;
        _selectedFile = files[0];
        _selectedFileName = _selectedFile.Name;
        _previewResult = null;
        _importResult = null;
        _previewDone = false;
        _hasPreviewErrors = false;
    }

    private async Task PreviewImport()
    {
        if (_selectedFile is null) return;
        _previewLoading = true;
        _previewResult = null;
        _importResult = null;
        _hasPreviewErrors = false;
        errorMessage = null;
        try
        {
            using var ms = new MemoryStream();
            await _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(ms.ToArray()), "file", _selectedFileName ?? "cuentas.csv");
            _previewResult = await CuentaService.ImportPreviewAsync(content);
            _previewDone = true;
            _hasPreviewErrors = !_previewResult.CanImport;
            if (_previewResult.CanImport)
            {
                Snackbar.Add($"✓ {_previewResult.ValidRows} cuentas válidas en vista previa", Severity.Success);
            }
            else
            {
                Snackbar.Add($"⚠ {_previewResult.InvalidRows} filas con errores en la vista previa", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar archivo: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally { _previewLoading = false; }
    }

    private async Task ConfirmImport()
    {
        if (_selectedFile is null || _previewResult is null || _hasPreviewErrors) return;
        _importLoading = true;
        _importResult = null;
        errorMessage = null;
        try
        {
            using var ms = new MemoryStream();
            await _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(ms.ToArray()), "file", _selectedFileName ?? "cuentas.csv");
            _importResult = await CuentaService.ImportConfirmAsync(content);
            if (_importResult.Errors == 0)
            {
                Snackbar.Add($"✓ {_importResult.Created} cuentas importadas", Severity.Success);
                await LoadData();
                ClearImport();
            }
            else
            {
                Snackbar.Add($"⚠ {_importResult.Created} importadas, {_importResult.Skipped} omitidas, {_importResult.Errors} errores", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al importar: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally { _importLoading = false; }
    }

    private void ClearImport()
    {
        _selectedFile = null;
        _selectedFileName = null;
        _previewResult = null;
        _importResult = null;
        _previewDone = false;
        _hasPreviewErrors = false;
    }
}
