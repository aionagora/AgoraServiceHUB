@page "/contabilidad/plan-cuentas"
@attribute [Authorize]
@inject CuentaContableHttpService CuentaService
@inject IJSRuntime JS

<PageTitle>Plan de Cuentas - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-journal-bookmark-fill"></i> Plan de Cuentas</h3>
            <p class="text-muted mb-0">Estructura jerárquica del plan de cuentas contable</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="SeedPlanCuentas" disabled="@seeding">
                @if (seeding) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <i class="bi bi-magic"></i> Generar Plan Estándar
            </button>
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nueva Cuenta
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* ?? Filtros ?? *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label mb-1 small">Buscar</label>
                    <input class="form-control form-control-sm" @bind="searchText" @bind:event="oninput" placeholder="Código o nombre..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Vista</label>
                    <select class="form-select form-select-sm" @bind="viewMode">
                        <option value="tree">Árbol</option>
                        <option value="flat">Lista plana</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadData"><i class="bi bi-arrow-clockwise"></i> Recargar</button>
                    @if (viewMode == "tree")
                    {
                        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="ExpandAll"><i class="bi bi-arrows-expand"></i> Expandir</button>
                        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CollapseAll"><i class="bi bi-arrows-collapse"></i> Colapsar</button>
                    }
                </div>
                <div class="col-md-auto ms-auto">
                    <span class="badge bg-secondary">@allCuentas.Count cuentas</span>
                </div>
            </div>
        </div>
    </div>

    @* ?? Contenido ?? *@
    <div class="card">
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else if (allCuentas.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-3">No hay cuentas contables. Use <strong>"Generar Plan Estándar"</strong> para crear el plan de cuentas Bolivia/NIIF.</p>
                </div>
            }
            else if (viewMode == "tree")
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Naturaleza</th>
                                <th class="text-center">Movimientos</th>
                                <th class="text-end">Saldo</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in flatTreeRows)
                            {
                                @if (IsRowVisible(row) && MatchesSearch(row.Cuenta))
                                {
                                    <tr class="@(row.Cuenta.PermiteMovimientos ? "" : "table-light")">
                                        <td style="padding-left:@(20 + row.Depth * 24)px">
                                            @if (row.Cuenta.SubCuentas.Count > 0)
                                            {
                                                <button class="btn btn-sm btn-link p-0 me-1 text-dark" @onclick="() => ToggleExpand(row.Cuenta.Codigo)">
                                                    <i class="bi @(expandedCodes.Contains(row.Cuenta.Codigo) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="display:inline-block;width:20px;"></span>
                                            }
                                            <code class="fw-bold">@row.Cuenta.Codigo</code>
                                        </td>
                                        <td>
                                            @if (!row.Cuenta.PermiteMovimientos)
                                            {
                                                <strong>@row.Cuenta.Nombre</strong>
                                            }
                                            else
                                            {
                                                @row.Cuenta.Nombre
                                            }
                                        </td>
                                        <td><span class="badge @GetTipoBadge(row.Cuenta.Tipo)">@row.Cuenta.Tipo</span></td>
                                        <td><small>@row.Cuenta.Naturaleza</small></td>
                                        <td class="text-center">@(row.Cuenta.PermiteMovimientos ? "?" : "—")</td>
                                        <td class="text-end">@(row.Cuenta.SaldoActual != 0 ? row.Cuenta.SaldoActual.ToString("N2") : "—")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(row.Cuenta)" title="Editar"><i class="bi bi-pencil"></i></button>
                                            @if (!row.Cuenta.PermiteMovimientos)
                                            {
                                                <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => ShowCreateChildModal(row.Cuenta)" title="Agregar subcuenta"><i class="bi bi-plus"></i></button>
                                            }
                                            @if (row.Cuenta.SaldoActual == 0 && row.Cuenta.SubCuentas.Count == 0)
                                            {
                                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCuenta(row.Cuenta)" title="Eliminar"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Naturaleza</th>
                                <th>Nivel</th>
                                <th>Padre</th>
                                <th class="text-center">Mov.</th>
                                <th class="text-end">Saldo</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in FilterFlat(allCuentas))
                            {
                                <tr>
                                    <td><code class="fw-bold">@c.Codigo</code></td>
                                    <td>@c.Nombre</td>
                                    <td><span class="badge @GetTipoBadge(c.Tipo)">@c.Tipo</span></td>
                                    <td><small>@c.Naturaleza</small></td>
                                    <td><span class="badge bg-light text-dark">N@c.Nivel</span></td>
                                    <td><small class="text-muted">@(c.CuentaPadreCodigo ?? "—")</small></td>
                                    <td class="text-center">@(c.PermiteMovimientos ? "?" : "—")</td>
                                    <td class="text-end">@(c.SaldoActual != 0 ? c.SaldoActual.ToString("N2") : "—")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(c)" title="Editar"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => ShowCreateChildModal(c)" title="Agregar subcuenta"><i class="bi bi-plus"></i></button>
                                        @if (c.SaldoActual == 0)
                                        {
                                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCuenta(c)" title="Eliminar"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ?????? Modal Crear/Editar ?????? *@
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-journal-plus"></i> @(isEditing ? "Editar" : "Nueva") Cuenta Contable</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!isEditing)
                    {
                        <div class="mb-3">
                            <label class="form-label">Código *</label>
                            <input class="form-control" @bind="formCodigo" placeholder="Ej: 1.1.3.06" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Código</label>
                            <input class="form-control" value="@formCodigo" disabled />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input class="form-control" @bind="formNombre" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tipo *</label>
                            <select class="form-select" @bind="formTipo">
                                <option value="1">Activo</option>
                                <option value="2">Pasivo</option>
                                <option value="3">Patrimonio</option>
                                <option value="4">Ingreso</option>
                                <option value="5">Gasto</option>
                                <option value="6">Costo</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Naturaleza *</label>
                            <select class="form-select" @bind="formNaturaleza">
                                <option value="1">Deudora</option>
                                <option value="2">Acreedora</option>
                            </select>
                        </div>
                    </div>
                    @if (!isEditing)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nivel</label>
                                <input type="number" min="1" max="10" class="form-control" @bind="formNivel" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cuenta Padre</label>
                                <select class="form-select" @bind="formPadreId">
                                    <option value="">— Ninguna (raíz) —</option>
                                    @foreach (var c in allCuentas.Where(x => !x.PermiteMovimientos).OrderBy(x => x.Codigo))
                                    {
                                        <option value="@c.CuentaContableId">@c.Codigo — @c.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkMov" @bind="formPermiteMovimientos" />
                            <label class="form-check-label" for="chkMov">Permite movimientos (cuenta de detalle)</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="2" @bind="formDescripcion"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveCuenta" disabled="@(saving || string.IsNullOrWhiteSpace(formCodigo) || string.IsNullOrWhiteSpace(formNombre))">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(isEditing ? "Actualizar" : "Crear")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CuentaContableDto> allCuentas = new();
    private List<CuentaContableDto> treeCuentas = new();
    private List<FlatTreeRow> flatTreeRows = new();
    private bool loading = true;
    private bool saving = false;
    private bool seeding = false;
    private string? successMessage;
    private string? errorMessage;
    private string viewMode = "tree";
    private string searchText = "";

    // Modal
    private bool showModal;
    private bool isEditing;
    private int editingId;
    private string formCodigo = "";
    private string formNombre = "";
    private byte formTipo = 1;
    private byte formNaturaleza = 1;
    private int formNivel = 1;
    private int? formPadreId;
    private bool formPermiteMovimientos;
    private string? formDescripcion;

    // Expanded nodes
    private HashSet<string> expandedCodes = new();

    private record FlatTreeRow(CuentaContableDto Cuenta, int Depth, string? ParentCode);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true; errorMessage = null;
        try
        {
            var t1 = CuentaService.GetAllAsync();
            var t2 = CuentaService.GetTreeAsync();
            await Task.WhenAll(t1, t2);
            allCuentas = await t1;
            treeCuentas = await t2;
            // Expand level 1 by default
            foreach (var c in treeCuentas)
                expandedCodes.Add(c.Codigo);
            RebuildFlatTree();
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }

    private void RebuildFlatTree()
    {
        flatTreeRows = new();
        foreach (var root in treeCuentas)
            FlattenTree(root, 0, null);
    }

    private void FlattenTree(CuentaContableDto cuenta, int depth, string? parentCode)
    {
        flatTreeRows.Add(new FlatTreeRow(cuenta, depth, parentCode));
        foreach (var child in cuenta.SubCuentas.OrderBy(c => c.Codigo))
            FlattenTree(child, depth + 1, cuenta.Codigo);
    }

    private bool IsRowVisible(FlatTreeRow row)
    {
        if (row.Depth == 0) return true;
        // Walk up parentCode chain — all ancestors must be expanded
        var current = row;
        while (current.ParentCode != null)
        {
            if (!expandedCodes.Contains(current.ParentCode)) return false;
            current = flatTreeRows.FirstOrDefault(r => r.Cuenta.Codigo == current.ParentCode)!;
            if (current is null) break;
        }
        return true;
    }

    private bool MatchesSearch(CuentaContableDto c)
    {
        if (string.IsNullOrWhiteSpace(searchText)) return true;
        var s = searchText.ToLower();
        return c.Codigo.ToLower().Contains(s) || c.Nombre.ToLower().Contains(s);
    }

    private void ToggleExpand(string codigo)
    {
        if (!expandedCodes.Add(codigo))
            expandedCodes.Remove(codigo);
    }

    private void ExpandAll()
    {
        foreach (var row in flatTreeRows.Where(r => r.Cuenta.SubCuentas.Count > 0))
            expandedCodes.Add(row.Cuenta.Codigo);
    }

    private void CollapseAll()
    {
        expandedCodes.Clear();
    }

    // ?? Filter helpers ??
    private List<CuentaContableDto> FilterFlat(List<CuentaContableDto> cuentas)
    {
        if (string.IsNullOrWhiteSpace(searchText)) return cuentas;
        var s = searchText.ToLower();
        return cuentas.Where(c => c.Codigo.ToLower().Contains(s) || c.Nombre.ToLower().Contains(s)).ToList();
    }

    // ?? CRUD ??
    private void ShowCreateModal()
    {
        isEditing = false; editingId = 0;
        formCodigo = ""; formNombre = ""; formTipo = 1; formNaturaleza = 1;
        formNivel = 1; formPadreId = null; formPermiteMovimientos = false; formDescripcion = null;
        showModal = true;
    }

    private void ShowCreateChildModal(CuentaContableDto padre)
    {
        isEditing = false; editingId = 0;
        formCodigo = padre.Codigo + ".";
        formNombre = "";
        formTipo = byte.TryParse(TipoToNumber(padre.Tipo), out var t) ? t : (byte)1;
        formNaturaleza = padre.Naturaleza == "Acreedora" ? (byte)2 : (byte)1;
        formNivel = padre.Nivel + 1;
        formPadreId = padre.CuentaContableId;
        formPermiteMovimientos = false;
        formDescripcion = null;
        showModal = true;
    }

    private void ShowEditModal(CuentaContableDto cuenta)
    {
        isEditing = true; editingId = cuenta.CuentaContableId;
        formCodigo = cuenta.Codigo;
        formNombre = cuenta.Nombre;
        formTipo = byte.TryParse(TipoToNumber(cuenta.Tipo), out var t) ? t : (byte)1;
        formNaturaleza = cuenta.Naturaleza == "Acreedora" ? (byte)2 : (byte)1;
        formNivel = cuenta.Nivel;
        formPadreId = cuenta.CuentaPadreId;
        formPermiteMovimientos = cuenta.PermiteMovimientos;
        formDescripcion = cuenta.Descripcion;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveCuenta()
    {
        saving = true; errorMessage = null;
        try
        {
            if (isEditing)
            {
                var dto = new UpdateCuentaContableDto
                {
                    Nombre = formNombre,
                    Tipo = formTipo,
                    Naturaleza = formNaturaleza,
                    PermiteMovimientos = formPermiteMovimientos,
                    Descripcion = formDescripcion
                };
                var r = await CuentaService.UpdateAsync(editingId, dto);
                if (r.Success) { successMessage = $"Cuenta {formCodigo} actualizada."; CloseModal(); await LoadData(); }
                else errorMessage = r.Message;
            }
            else
            {
                var dto = new CreateCuentaContableDto
                {
                    Codigo = formCodigo,
                    Nombre = formNombre,
                    Tipo = formTipo,
                    Naturaleza = formNaturaleza,
                    Nivel = formNivel,
                    CuentaPadreId = formPadreId,
                    PermiteMovimientos = formPermiteMovimientos,
                    Descripcion = formDescripcion
                };
                var r = await CuentaService.CreateAsync(dto);
                if (r.Success) { successMessage = $"Cuenta {formCodigo} creada."; CloseModal(); await LoadData(); }
                else errorMessage = r.Message;
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { saving = false; }
    }

    private async Task DeleteCuenta(CuentaContableDto cuenta)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar cuenta {cuenta.Codigo} — {cuenta.Nombre}?")) return;
        try
        {
            var r = await CuentaService.DeleteAsync(cuenta.CuentaContableId);
            if (r.Success) { successMessage = "Cuenta eliminada."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task SeedPlanCuentas()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Generar el plan de cuentas estándar Bolivia/NIIF? Esto creará ~100 cuentas predefinidas.")) return;
        seeding = true; errorMessage = null;
        try
        {
            var r = await CuentaService.SeedPlanCuentasAsync();
            if (r.Success) { successMessage = r.Message ?? $"Plan de cuentas generado: {r.Data} cuentas."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { seeding = false; }
    }

    // ?? Helpers ??
    private static string GetTipoBadge(string tipo) => tipo switch
    {
        "Activo" => "bg-primary",
        "Pasivo" => "bg-danger",
        "Patrimonio" => "bg-success",
        "Ingreso" => "bg-info text-dark",
        "Gasto" => "bg-warning text-dark",
        "Costo" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string TipoToNumber(string tipo) => tipo switch
    {
        "Activo" => "1",
        "Pasivo" => "2",
        "Patrimonio" => "3",
        "Ingreso" => "4",
        "Gasto" => "5",
        "Costo" => "6",
        _ => "1"
    };
}
