@page "/accesos"
@page "/accesos/{ModuloId}"
@attribute [Authorize]
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@(_modulo is null ? "M\u00f3dulos" : _modulo.Nombre) - AgoraHub360 ERP</PageTitle>

<!-- ?? Cabecera ??????????????????????????????????????????????? -->
<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        @if (_modulo is not null)
        {
            <button class="hub-back-btn" @onclick="Volver" title="Ver todos los m\u00f3dulos">
                <i class="bi bi-arrow-left"></i>
            </button>
            <span class="hub-back-icon" style="background:@_modulo.BgColor;color:@_modulo.Color">
                <i class="bi @_modulo.Icono"></i>
            </span>
        }
        <div>
            <h1 class="mb-0">
                @if (_modulo is null)
                {
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>
                    <span>M&oacute;dulos del Sistema</span>
                }
                else
                {
                    @_modulo.Nombre
                }
            </h1>
            <p class="text-muted mb-0 small">
                @(_modulo is null
                    ? "Selecciona un m\u00f3dulo para ver sus accesos directos"
                    : _modulo.Descripcion)
            </p>
        </div>
    </div>
    @if (_modulo is not null)
    {
        <a href="/accesos" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-grid-3x3-gap me-1"></i>Todos los m&oacute;dulos
        </a>
    }
</div>

<!-- ?????????????????????????????????????????????????????????? -->
<!-- VISTA 1 — Grid de módulos (sin parámetro)                -->
<!-- ?????????????????????????????????????????????????????????? -->
@if (_modulo is null)
{
    <div class="row g-3">
        @foreach (var m in _modulos)
        {
            if (m.SoloAdmin)
            {
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <a href="/accesos/@m.Id" class="hub-module-card">
                                <span class="hub-module-icon" style="background:@m.BgColor;color:@m.Color">
                                    <i class="bi @m.Icono"></i>
                                </span>
                                <div class="hub-module-info">
                                    <span class="hub-module-name">@m.Nombre</span>
                                    <span class="hub-module-desc">@m.Descripcion</span>
                                </div>
                                <div class="hub-module-count">
                                    <span>@m.Items.Count</span>
                                    <small>accesos</small>
                                </div>
                                <i class="bi bi-chevron-right hub-module-arrow"></i>
                            </a>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
            else
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <a href="/accesos/@m.Id" class="hub-module-card">
                        <span class="hub-module-icon" style="background:@m.BgColor;color:@m.Color">
                            <i class="bi @m.Icono"></i>
                        </span>
                        <div class="hub-module-info">
                            <span class="hub-module-name">@m.Nombre</span>
                            <span class="hub-module-desc">@m.Descripcion</span>
                        </div>
                        <div class="hub-module-count">
                            <span>@m.Items.Count</span>
                            <small>accesos</small>
                        </div>
                        <i class="bi bi-chevron-right hub-module-arrow"></i>
                    </a>
                </div>
            }
        }
    </div>
}

<!-- ?????????????????????????????????????????????????????????? -->
<!-- VISTA 2 — Panel de accesos del módulo                    -->
<!-- ?????????????????????????????????????????????????????????? -->
@if (_modulo is not null)
{
    <div class="hub-panel-enter">
        <div class="row g-3">
            @foreach (var item in _modulo.Items)
            {
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <a href="@item.Url" class="hub-item-card @(item.EsDashboard ? "hub-item-dashboard" : "")">
                        @if (item.EsDashboard)
                        {
                            <span class="hub-item-badge">Dashboard</span>
                        }
                        <i class="bi @item.Icono" style="color:@item.Color"></i>
                        <span class="hub-item-name">@item.Nombre</span>
                    </a>
                </div>
            }
        </div>
    </div>
}

