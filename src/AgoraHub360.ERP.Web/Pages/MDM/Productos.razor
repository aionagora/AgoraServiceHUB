@page "/mdm/productos"
@attribute [Authorize]
@inject ProductoHttpService ProductoService
@inject CatalogoHttpService CatalogoService
@inject UnidadMedidaHttpService UnidadMedidaService
@inject IJSRuntime JS

<PageTitle>Productos</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>?? Productos</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nuevo Producto
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando productos...</p>
        </div>
    }
    else if (productos.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay productos registrados.
            @if (catalogos.Count == 0)
            {
                <span> Primero crea un <strong>Catálogo</strong> y una <strong>Unidad de Medida</strong>.</span>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-sm">
                        <thead>
                            <tr>
                                <th>Nombre Comercial</th>
                                <th>Nombre Genérico</th>
                                <th>Marca</th>
                                <th>UdM</th>
                                <th>Tipo</th>
                                <th>Catálogo</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in productos)
                            {
                                <tr>
                                    <td><strong>@p.CommercialName</strong></td>
                                    <td><small>@p.GenericName</small></td>
                                    <td>@(p.BrandName ?? "-")</td>
                                    <td><span class="badge bg-info">@p.DefaultUomCode</span></td>
                                    <td><small>@GetKindLabel(p.ProductKind)</small></td>
                                    <td><span class="badge bg-secondary">@p.CatalogName</span></td>
                                    <td>
                                        <span class="badge @(p.Activo ? "bg-success" : "bg-secondary")">
                                            @(p.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(p)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteProducto(p)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo Producto</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (catalogos.Count == 0)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Debe crear al menos un <strong>Catálogo</strong> antes de crear productos.
                        </div>
                    }
                    else if (unidades.Count == 0)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Debe crear al menos una <strong>Unidad de Medida</strong> antes de crear productos.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="createDto" OnValidSubmit="CreateProducto">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nombre Comercial *</label>
                                    <InputText class="form-control" @bind-Value="createDto.CommercialName" placeholder="Nombre comercial" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nombre Genérico *</label>
                                    <InputText class="form-control" @bind-Value="createDto.GenericName" placeholder="Nombre genérico" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Unidad de Medida *</label>
                                    <InputSelect class="form-select" @bind-Value="createDto.DefaultUomId">
                                        <option value="0">-- Seleccionar UdM --</option>
                                        @foreach (var um in unidades)
                                        {
                                            <option value="@um.UomId">@um.Name (@um.Code)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Catálogo *</label>
                                    <InputSelect class="form-select" @bind-Value="createDto.CatalogId">
                                        <option value="0">-- Seleccionar catálogo --</option>
                                        @foreach (var cat in catalogos)
                                        {
                                            <option value="@cat.CatalogId">@cat.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Tipo</label>
                                    <InputSelect class="form-select" @bind-Value="createDto.ProductKind">
                                        <option value="1">Artículo</option>
                                        <option value="2">Servicio</option>
                                        <option value="3">Kit</option>
                                        <option value="4">Materia Prima</option>
                                        <option value="5">Embalaje</option>
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Descripción Corta</label>
                                <InputText class="form-control" @bind-Value="createDto.ShortDescription" placeholder="Descripción breve del producto" />
                            </div>
                            <div class="row">
                                <div class="col-auto mb-3">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" id="stockable" @bind-Value="createDto.IsStockable" />
                                        <label class="form-check-label" for="stockable">Control de Stock</label>
                                    </div>
                                </div>
                                <div class="col-auto mb-3">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" id="sellable" @bind-Value="createDto.IsSellable" />
                                        <label class="form-check-label" for="sellable">Vendible</label>
                                    </div>
                                </div>
                                <div class="col-auto mb-3">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" id="purchasable" @bind-Value="createDto.IsPurchasable" />
                                        <label class="form-check-label" for="purchasable">Comprable</label>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                                <button type="submit" class="btn btn-primary" disabled="@(saving || createDto.DefaultUomId == 0 || createDto.CatalogId == 0)">
                                    @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Guardar
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Producto</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateProducto">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre Comercial *</label>
                                <InputText class="form-control" @bind-Value="updateDto.CommercialName" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre Genérico *</label>
                                <InputText class="form-control" @bind-Value="updateDto.GenericName" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Unidad de Medida *</label>
                                <InputSelect class="form-select" @bind-Value="updateDto.DefaultUomId">
                                    <option value="0">-- Seleccionar UdM --</option>
                                    @foreach (var um in unidades)
                                    {
                                        <option value="@um.UomId">@um.Name (@um.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tipo</label>
                                <InputSelect class="form-select" @bind-Value="updateDto.ProductKind">
                                    <option value="1">Artículo</option>
                                    <option value="2">Servicio</option>
                                    <option value="3">Kit</option>
                                    <option value="4">Materia Prima</option>
                                    <option value="5">Embalaje</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <InputCheckbox class="form-check-input" id="activoEdit" @bind-Value="updateDto.Activo" />
                                    <label class="form-check-label" for="activoEdit">Activo</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción Corta</label>
                            <InputText class="form-control" @bind-Value="updateDto.ShortDescription" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Actualizar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto2> productos = new();
    private List<CatalogDto> catalogos = new();
    private List<UomDto> unidades = new();

    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private string? successMessage;

    private CreateProductDto2 createDto = new();
    private UpdateProductDto2 updateDto = new();
    private long editingId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;
            var tProductos = ProductoService.GetAllAsync();
            var tUnidades = UnidadMedidaService.GetAllAsync();
            var tCatalogos = CatalogoService.GetAllAsync();
            await Task.WhenAll(tProductos, tUnidades, tCatalogos);
            productos = await tProductos;
            unidades = await tUnidades;
            catalogos = await tCatalogos;
        }
        catch (Exception ex) { errorMessage = $"Error al cargar datos: {ex.Message}"; }
        finally { loading = false; }
    }

    private static string GetKindLabel(byte kind) => kind switch
    {
        1 => "Artículo",
        2 => "Servicio",
        3 => "Kit",
        4 => "Materia Prima",
        5 => "Embalaje",
        _ => kind.ToString()
    };

    private void ShowCreateModal()
    {
        createDto = new CreateProductDto2
        {
            ProductKind = 1,
            IsStockable = true,
            IsSellable = true,
            IsPurchasable = true,
            CatalogId = catalogos.FirstOrDefault()?.CatalogId ?? 0,
            DefaultUomId = unidades.FirstOrDefault()?.UomId ?? 0
        };
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private void ShowEditModal(ProductDto2 p)
    {
        updateDto = new UpdateProductDto2
        {
            ProductKind = p.ProductKind,
            GenericName = p.GenericName,
            CommercialName = p.CommercialName,
            ShortDescription = p.ShortDescription,
            LongDescription = p.LongDescription,
            BrandId = p.BrandId,
            ManufacturerId = p.ManufacturerId,
            DefaultUomId = p.DefaultUomId,
            IsStockable = p.IsStockable,
            IsSellable = p.IsSellable,
            IsPurchasable = p.IsPurchasable,
            LifecycleStatusId = p.LifecycleStatusId,
            Activo = p.Activo
        };
        editingId = p.ProductId;
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private async Task CreateProducto()
    {
        if (createDto.DefaultUomId == 0 || createDto.CatalogId == 0) return;
        try
        {
            saving = true;
            errorMessage = null;
            var response = await ProductoService.CreateAsync(createDto);
            if (response.Success) { successMessage = "Producto creado exitosamente."; CloseCreateModal(); await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task UpdateProducto()
    {
        try
        {
            saving = true;
            errorMessage = null;
            var response = await ProductoService.UpdateAsync(editingId, updateDto);
            if (response.Success) { successMessage = "Producto actualizado exitosamente."; CloseEditModal(); await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task DeleteProducto(ProductDto2 p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el producto '{p.CommercialName}'?")) return;
        try
        {
            var response = await ProductoService.DeleteAsync(p.ProductId);
            if (response.Success) { successMessage = "Producto eliminado exitosamente."; await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error al eliminar: {ex.Message}"; }
    }
}
