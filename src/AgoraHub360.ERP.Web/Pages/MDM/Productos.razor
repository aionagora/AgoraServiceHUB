                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }

                        @* ?????? Tab 3: Códigos ?????? *@
                        @if (wizardTab == "w-codes")
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-2"><label class="form-label small">Tipo *</label><select class="form-select form-select-sm" @bind="wCodeForm.CodeType"><option value="0">--</option><option value="1">Cód. Barras</option><option value="2">SKU</option><option value="3">EAN</option><option value="4">Otro</option></select></div>
                                <div class="col-md-3"><label class="form-label small">Valor *</label><input class="form-control form-control-sm" @bind="wCodeForm.Valor" /></div>
                                <div class="col-md-2"><label class="form-label small">Desde</label><InputDate class="form-control form-control-sm" @bind-Value="wCodeForm.ValidFrom" /></div>
                                <div class="col-md-2"><label class="form-label small">Hasta</label><InputDate class="form-control form-control-sm" @bind-Value="wCodeForm.ValidTo" /></div>
                                <div class="col-md-1"><div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="wCodeForm.IsPrimary" id="wcPrim" /><label class="form-check-label small" for="wcPrim">Ppal</label></div></div>
                                <div class="col-md-2"><button class="btn btn-success btn-sm w-100" @onclick="WizardAddCode" disabled="@(saving || wCodeForm.CodeType == 0 || string.IsNullOrWhiteSpace(wCodeForm.Valor))"><i class="bi bi-plus"></i> Agregar</button></div>
                            </div>
                            @if (wizardCodes.Count == 0) { <p class="text-muted small">Sin códigos agregados.</p> }
                            else
                            {
                                <table class="table table-sm table-bordered mb-0">
                                    <thead><tr><th>Tipo</th><th>Valor</th><th class="text-center">Ppal</th><th>Vigencia</th><th class="text-end"></th></tr></thead>
                                    <tbody>
                                        @foreach (var c in wizardCodes)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">@CodeTypeLabel(c.CodeType)</span></td>
                                                <td><code>@c.Valor</code></td>
                                                <td class="text-center">@if(c.IsPrimary){<i class="bi bi-star-fill text-warning"></i>}</td>
                                                <td><small>@(c.ValidFrom?.ToString("dd/MM/yy") ?? "—") ? @(c.ValidTo?.ToString("dd/MM/yy") ?? "—")</small></td>
                                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => WizardDeleteCode(c.ProductCodeId)"><i class="bi bi-x-lg"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
