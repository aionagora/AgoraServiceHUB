@page "/mdm/productos"
@attribute [Authorize]
@inject ProductoHttpService ProductoService
@inject CatalogoHttpService CatalogoService
@inject UnidadMedidaHttpService UnidadMedidaService
@inject BrandHttpService BrandService
@inject ManufacturerHttpService ManufacturerService
@inject MdmVariantHttpService VariantService
@inject ProductUomHttpService ProductUomService
@inject ProductCodeHttpService ProductCodeService
@inject MdmAttributeHttpService AttributeService
@inject MdmCompanyProductHttpService CompanyProductService
@inject EmpresaHttpService EmpresaSvc
@inject IJSRuntime JS

<PageTitle>Productos</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-box-seam-fill"></i> Productos</h3>
            <p class="text-muted mb-0">Catálogo de productos con relaciones</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nuevo Producto
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Cargando productos...</p>
        </div>
    }
    else if (productos.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay productos registrados.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <span>Productos <span class="badge bg-secondary ms-1">@productos.Count</span></span>
                <input type="text" class="form-control form-control-sm" style="max-width:250px"
                       placeholder="Buscar..." @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px"></th>
                                <th>Nombre Comercial</th>
                                <th>Nombre Genérico</th>
                                <th>Marca</th>
                                <th>Fabricante</th>
                                <th>UdM</th>
                                <th>Tipo</th>
                                <th>Catálogo</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in FilteredProducts)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(p.ProductId)" title="Ver relaciones">
                                            <i class="bi @(expandedId == p.ProductId ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        </button>
                                    </td>
                                    <td><strong>@p.CommercialName</strong></td>
                                    <td><small class="text-muted">@p.GenericName</small></td>
                                    <td><small>@(p.BrandName ?? "—")</small></td>
                                    <td><small>@(p.ManufacturerName ?? "—")</small></td>
                                    <td><span class="badge bg-info text-dark">@p.DefaultUomCode</span></td>
                                    <td><span class="badge bg-secondary">@GetKindLabel(p.ProductKind)</span></td>
                                    <td><small>@p.CatalogName</small></td>
                                    <td>
                                        <span class="badge @(p.Activo ? "bg-success" : "bg-secondary")">
                                            @(p.Activo ? p.LifecycleStatusCode : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(p)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteProducto(p)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                                @if (expandedId == p.ProductId)
                                {
                                    <tr>
                                        <td colspan="10" class="bg-light p-0">
                                            @if (loadingDetail)
                                            {
                                                <div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>
                                            }
                                            else
                                            {
                                                @* ?? Tabs de relaciones ?? *@
                                                <ul class="nav nav-tabs px-3 pt-2">
                                                    <li class="nav-item">
                                                        <button class="nav-link @(activeTab == "variantes" ? "active" : "")" @onclick='() => activeTab = "variantes"'>
                                                            <i class="bi bi-intersect"></i> Variantes <span class="badge bg-secondary">@detailVariants.Count</span>
                                                        </button>
                                                    </li>
                                                    <li class="nav-item">
                                                        <button class="nav-link @(activeTab == "uom" ? "active" : "")" @onclick='() => activeTab = "uom"'>
                                                            <i class="bi bi-rulers"></i> UdM <span class="badge bg-secondary">@detailUoms.Count</span>
                                                        </button>
                                                    </li>
                                                    <li class="nav-item">
                                                        <button class="nav-link @(activeTab == "codigos" ? "active" : "")" @onclick='() => activeTab = "codigos"'>
                                                            <i class="bi bi-upc-scan"></i> Códigos <span class="badge bg-secondary">@detailCodes.Count</span>
                                                        </button>
                                                    </li>
                                                    <li class="nav-item">
                                                        <button class="nav-link @(activeTab == "atributos" ? "active" : "")" @onclick='() => activeTab = "atributos"'>
                                                            <i class="bi bi-list-check"></i> Atributos <span class="badge bg-secondary">@detailAttrs.Count</span>
                                                        </button>
                                                    </li>
                                                    <li class="nav-item">
                                                        <button class="nav-link @(activeTab == "empresa" ? "active" : "")" @onclick='() => activeTab = "empresa"'>
                                                            <i class="bi bi-building"></i> Prod. Empresa <span class="badge bg-secondary">@detailCompany.Count</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                                <div class="p-3">
                                                    @* ?? Tab Variantes ?? *@
                                                    @if (activeTab == "variantes")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <strong>Variantes del producto</strong>
                                                            <a href="mdm/variantes" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i> Gestionar</a>
                                                        </div>
                                                        @if (detailVariants.Count == 0)
                                                        {
                                                            <p class="text-muted small">Sin variantes.</p>
                                                        }
                                                        else
                                                        {
                                                            <table class="table table-sm table-bordered mb-0">
                                                                <thead><tr><th>SKU</th><th>Nombre</th><th>Código Barras</th><th>Ejes</th><th>Estado</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var v in detailVariants)
                                                                    {
                                                                        <tr>
                                                                            <td><code>@v.Sku</code></td>
                                                                            <td>@(v.VariantName ?? "—")</td>
                                                                            <td><small>@(v.Barcode ?? "—")</small></td>
                                                                            <td>
                                                                                @foreach (var ax in v.AxisValues)
                                                                                {
                                                                                    <span class="badge bg-outline-secondary me-1">@ax.AttributeName: @(ax.OptionValue ?? ax.ValueString ?? "—")</span>
                                                                                }
                                                                            </td>
                                                                            <td><span class="badge @(v.Activo ? "bg-success" : "bg-secondary")">@(v.Activo ? "Activo" : "Inactivo")</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }

                                                    @* ?? Tab UdM ?? *@
                                                    @if (activeTab == "uom")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <strong>Unidades de Medida Alternativas</strong>
                                                            <button class="btn btn-sm btn-success" @onclick="() => ShowAddUomModal(p.ProductId)"><i class="bi bi-plus"></i> Agregar</button>
                                                        </div>
                                                        @if (detailUoms.Count == 0) { <p class="text-muted small">Sin UdM alternativas.</p> }
                                                        else
                                                        {
                                                            <table class="table table-sm table-bordered mb-0">
                                                                <thead><tr><th>UdM</th><th>Código</th><th class="text-center">Base</th><th class="text-end">Factor</th><th>Cód. Barras</th><th class="text-end"></th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var u in detailUoms)
                                                                    {
                                                                        <tr>
                                                                            <td>@u.UomName</td>
                                                                            <td><code>@u.UomCode</code></td>
                                                                            <td class="text-center">@if(u.IsBase){<i class="bi bi-star-fill text-warning"></i>}</td>
                                                                            <td class="text-end">@u.FactorToBase.ToString("N6")</td>
                                                                            <td><small>@(u.Barcode ?? "—")</small></td>
                                                                            <td class="text-end">
                                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUom(p.ProductId, u.ProductUomId)"><i class="bi bi-x-lg"></i></button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }

                                                    @* ?? Tab Códigos ?? *@
                                                    @if (activeTab == "codigos")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <strong>Códigos de Producto</strong>
                                                            <button class="btn btn-sm btn-success" @onclick="() => ShowAddCodeModal(p.ProductId)"><i class="bi bi-plus"></i> Agregar</button>
                                                        </div>
                                                        @if (detailCodes.Count == 0) { <p class="text-muted small">Sin códigos.</p> }
                                                        else
                                                        {
                                                            <table class="table table-sm table-bordered mb-0">
                                                                <thead><tr><th>Tipo</th><th>Valor</th><th class="text-center">Principal</th><th>Vigencia</th><th class="text-end"></th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var c in detailCodes)
                                                                    {
                                                                        <tr>
                                                                            <td><span class="badge bg-secondary">@CodeTypeLabel(c.CodeType)</span></td>
                                                                            <td><code>@c.Valor</code></td>
                                                                            <td class="text-center">@if(c.IsPrimary){<i class="bi bi-star-fill text-warning"></i>}</td>
                                                                            <td><small>@(c.ValidFrom?.ToString("dd/MM/yy") ?? "—") ? @(c.ValidTo?.ToString("dd/MM/yy") ?? "—")</small></td>
                                                                            <td class="text-end">
                                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCode(p.ProductId, c.ProductCodeId)"><i class="bi bi-x-lg"></i></button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }

                                                    @* ?? Tab Atributos ?? *@
                                                    @if (activeTab == "atributos")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <strong>Atributos del Producto</strong>
                                                            <button class="btn btn-sm btn-success" @onclick="() => ShowAddAttrModal(p.ProductId)"><i class="bi bi-plus"></i> Asignar</button>
                                                        </div>
                                                        @if (detailAttrs.Count == 0) { <p class="text-muted small">Sin atributos.</p> }
                                                        else
                                                        {
                                                            <table class="table table-sm table-bordered mb-0">
                                                                <thead><tr><th>Atributo</th><th>Valor</th><th>Vigencia</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var a in detailAttrs)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@a.AttributeName</strong></td>
                                                                            <td>@FormatAttrValue(a)</td>
                                                                            <td><small>@(a.ValidFrom?.ToString("dd/MM/yy") ?? "—") ? @(a.ValidTo?.ToString("dd/MM/yy") ?? "—")</small></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }

                                                    @* ?? Tab Productos Empresa ?? *@
                                                    @if (activeTab == "empresa")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <strong>Activaciones por Empresa</strong>
                                                            <a href="mdm/productos-empresa" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i>Gestionar</a>
                                                        </div>
                                                        @if (detailCompany.Count == 0) { <p class="text-muted small">No activado en ninguna empresa.</p> }
                                                        else
                                                        {
                                                            <table class="table table-sm table-bordered mb-0">
                                                                <thead><tr><th>SKU</th><th>Cód. Interno</th><th class="text-center">POS</th><th class="text-center">Ecom</th><th class="text-center">B2B</th><th class="text-end">Stock Min</th><th class="text-end">Stock Max</th><th>Estado</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var cp in detailCompany)
                                                                    {
                                                                        <tr>
                                                                            <td><code>@cp.Sku</code></td>
                                                                            <td><small>@(cp.CodigoInterno ?? "—")</small></td>
                                                                            <td class="text-center"><i class="bi @(cp.IsVisiblePOS ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary")"></i></td>
                                                                            <td class="text-center"><i class="bi @(cp.IsVisibleEcommerce ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary")"></i></td>
                                                                            <td class="text-center"><i class="bi @(cp.IsVisibleB2B ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary")"></i></td>
                                                                            <td class="text-end">@(cp.MinStock?.ToString("N2") ?? "—")</td>
                                                                            <td class="text-end">@(cp.MaxStock?.ToString("N2") ?? "—")</td>
                                                                            <td><span class="badge @(cp.Activo ? "bg-success" : "bg-secondary")">@(cp.Activo ? "Activo" : "Inactivo")</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@* ?? Modal Crear (Wizard con pestañas) ?? *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle"></i> Nuevo Producto
                        @if (createdProductId > 0)
                        {
                            <span class="badge bg-success ms-2"><i class="bi bi-check-circle"></i> Guardado</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-0">
                    @* ?? Tabs del wizard ?? *@
                    <ul class="nav nav-tabs px-3 pt-3">
                        <li class="nav-item">
                            <button class="nav-link @(wizardTab == "datos" ? "active" : "")" @onclick='() => wizardTab = "datos"'>
                                <i class="bi bi-1-circle-fill me-1"></i> Datos Básicos
                                @if (createdProductId > 0) { <i class="bi bi-check-circle-fill text-success ms-1"></i> }
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(wizardTab == "w-uom" ? "active" : "") @(createdProductId == 0 ? "disabled" : "")" @onclick='() => { if (createdProductId > 0) wizardTab = "w-uom"; }'>
                                <i class="bi bi-2-circle-fill me-1"></i> UdM <span class="badge bg-secondary ms-1">@wizardUoms.Count</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(wizardTab == "w-codes" ? "active" : "") @(createdProductId == 0 ? "disabled" : "")" @onclick='() => { if (createdProductId > 0) wizardTab = "w-codes"; }'>
                                <i class="bi bi-3-circle-fill me-1"></i> Códigos <span class="badge bg-secondary ms-1">@wizardCodes.Count</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(wizardTab == "w-attrs" ? "active" : "") @(createdProductId == 0 ? "disabled" : "")" @onclick='() => { if (createdProductId > 0) wizardTab = "w-attrs"; }'>
                                <i class="bi bi-4-circle-fill me-1"></i> Atributos <span class="badge bg-secondary ms-1">@wizardAttrs.Count</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(wizardTab == "w-variants" ? "active" : "") @(createdProductId == 0 ? "disabled" : "")" @onclick='() => { if (createdProductId > 0) wizardTab = "w-variants"; }'>
                                <i class="bi bi-5-circle-fill me-1"></i> Variantes <span class="badge bg-secondary ms-1">@wizardVariants.Count</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(wizardTab == "w-empresa" ? "active" : "") @(createdProductId == 0 ? "disabled" : "")" @onclick='() => { if (createdProductId > 0) wizardTab = "w-empresa"; }'>
                                <i class="bi bi-6-circle-fill me-1"></i> Empresa <span class="badge bg-secondary ms-1">@wizardCompany.Count</span>
                            </button>
                        </li>
                    </ul>

                    <div class="p-3">
                        @if (!string.IsNullOrEmpty(wizardError))
                        {
                            <div class="alert alert-danger alert-dismissible py-2"><i class="bi bi-exclamation-triangle-fill"></i> @wizardError <button type="button" class="btn-close" @onclick="() => wizardError = null"></button></div>
                        }
                        @if (!string.IsNullOrEmpty(wizardSuccess))
                        {
                            <div class="alert alert-success alert-dismissible py-2"><i class="bi bi-check-circle-fill"></i> @wizardSuccess <button type="button" class="btn-close" @onclick="() => wizardSuccess = null"></button></div>
                        }

                        @* ?????? Tab 1: Datos Básicos ?????? *@
                        @if (wizardTab == "datos")
                        {
                            @if (catalogos.Count == 0 || unidades.Count == 0)
                            {
                                <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Debe crear al menos un <strong>Catálogo</strong> y una <strong>Unidad de Medida</strong>.</div>
                            }
                            else
                            {
                                <fieldset disabled="@(createdProductId > 0)">
                                    <div class="row">
                                        <div class="col-md-6 mb-3"><label class="form-label">Nombre Comercial *</label><input class="form-control" @bind="createDto.CommercialName" placeholder="Nombre comercial" /></div>
                                        <div class="col-md-6 mb-3"><label class="form-label">Nombre Genérico *</label><input class="form-control" @bind="createDto.GenericName" placeholder="Nombre genérico" /></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 mb-3"><label class="form-label">Catálogo *</label><select class="form-select" @bind="createDto.CatalogId"><option value="0">-- Seleccionar --</option>@foreach (var c in catalogos) { <option value="@c.CatalogId">@c.Name</option> }</select></div>
                                        <div class="col-md-4 mb-3"><label class="form-label">UdM Base *</label><select class="form-select" @bind="createDto.DefaultUomId"><option value="0">-- Seleccionar --</option>@foreach (var u in unidades) { <option value="@u.UomId">@u.Name (@u.Code)</option> }</select></div>
                                        <div class="col-md-4 mb-3"><label class="form-label">Tipo</label><select class="form-select" @bind="createDto.ProductKind"><option value="1">Bien</option><option value="2">Servicio</option><option value="3">Kit</option><option value="4">BOM</option></select></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3"><label class="form-label">Marca</label><select class="form-select" @bind="createDto.BrandId"><option value="">-- Sin marca --</option>@foreach (var b in brands) { <option value="@b.BrandId">@b.Name</option> }</select></div>
                                        <div class="col-md-6 mb-3"><label class="form-label">Fabricante</label><select class="form-select" @bind="createDto.ManufacturerId"><option value="">-- Sin fabricante --</option>@foreach (var m in manufacturers) { <option value="@m.ManufacturerId">@m.Name @(!string.IsNullOrEmpty(m.Country) ? $"({m.Country})" : "")</option> }</select></div>
                                    </div>
                                    <div class="mb-3"><label class="form-label">Descripción Corta</label><input class="form-control" @bind="createDto.ShortDescription" /></div>
                                    <div class="row">
                                        <div class="col-auto"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="createDto.IsStockable" id="wcSt" /><label class="form-check-label" for="wcSt">Stockable</label></div></div>
                                        <div class="col-auto"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="createDto.IsSellable" id="wcSe" /><label class="form-check-label" for="wcSe">Vendible</label></div></div>
                                        <div class="col-auto"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="createDto.IsPurchasable" id="wcPu" /><label class="form-check-label" for="wcPu">Comprable</label></div></div>
                                    </div>
                                </fieldset>
                                @if (createdProductId > 0)
                                {
                                    <div class="alert alert-info mt-3 mb-0"><i class="bi bi-info-circle"></i> Producto guardado. Continue con las pestañas para agregar relaciones, o cierre este diálogo.</div>
                                }
                            }
                        }

                        @* ?????? Tab 2: UdM Alternativas ?????? *@
                        @if (wizardTab == "w-uom")
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-3"><label class="form-label small">UdM *</label><select class="form-select form-select-sm" @bind="wUomForm.UomId"><option value="0">-- Seleccionar --</option>@foreach (var u in unidades) { <option value="@u.UomId">@u.Name (@u.Code)</option> }</select></div>
                                <div class="col-md-2"><label class="form-label small">Factor *</label><input type="number" step="0.000001" class="form-control form-control-sm" @bind="wUomForm.FactorToBase" /></div>
                                <div class="col-md-3"><label class="form-label small">Cód. Barras</label><input class="form-control form-control-sm" @bind="wUomForm.Barcode" /></div>
                                <div class="col-md-2"><div class="form-check form-check-inline mt-3"><input class="form-check-input" type="checkbox" @bind="wUomForm.IsBase" id="wuBase" /><label class="form-check-label" for="wuBase">Base</label></div></div>
                                <div class="col-md-2"><button class="btn btn-success btn-sm w-100" @onclick="() => WizardAddUom()" disabled="@(saving || wUomForm.UomId == 0)"><i class="bi bi-plus"></i> Agregar</button></div>
                            </div>
                            @if (wizardUoms.Count == 0) { <p class="text-muted small">Sin UdM alternativas agregadas.</p> }
                            else
