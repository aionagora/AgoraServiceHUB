                        @* ?????? Tab 4: Atributos ?????? *@
                        @if (wizardTab == "w-attrs")
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-4">
                                    <label class="form-label small">Atributo *</label>
                                    <select class="form-select form-select-sm" @bind="wAttrForm.AttributeId" @bind:after="OnWizardAttrSelected">
                                        <option value="0">-- Seleccionar --</option>
                                        @foreach (var a in allAttributes) { <option value="@a.AttributeId">@a.Name — @DataTypeLabel(a.DataType)</option> }
                                    </select>
                                </div>
                                @if (wizardSelectedAttr is not null)
                                {
                                    <div class="col-md-4">
                                        @if (wizardSelectedAttr.DataType == 6 && wizardSelectedAttr.Options.Count > 0)
                                        { <label class="form-label small">Opción</label><select class="form-select form-select-sm" @bind="wAttrForm.OptionId"><option value="">--</option>@foreach (var o in wizardSelectedAttr.Options) { <option value="@o.OptionId">@o.Value</option> }</select> }
                                        else if (wizardSelectedAttr.DataType == 1)
                                        { <label class="form-label small">Texto</label><input class="form-control form-control-sm" @bind="wAttrForm.ValueString" /> }
                                        else if (wizardSelectedAttr.DataType == 2)
                                        { <label class="form-label small">Decimal</label><input type="number" step="0.0001" class="form-control form-control-sm" @bind="wAttrForm.ValueDecimal" /> }
                                        else if (wizardSelectedAttr.DataType == 3)
                                        { <label class="form-label small">Entero</label><input type="number" class="form-control form-control-sm" @bind="wAttrForm.ValueInt" /> }
                                        else if (wizardSelectedAttr.DataType == 4)
                                        { <div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="wAttrForm.ValueBool" id="waBool" /><label class="form-check-label" for="waBool">Sí/No</label></div> }
                                        else if (wizardSelectedAttr.DataType == 5)
                                        { <label class="form-label small">Fecha</label><InputDate class="form-control form-control-sm" @bind-Value="wAttrForm.ValueDate" /> }
                                        else
                                        { <label class="form-label small">Valor</label><input class="form-control form-control-sm" @bind="wAttrForm.ValueString" /> }
                                    </div>
                                }
                                <div class="col-md-2"><button class="btn btn-success btn-sm w-100 mt-4" @onclick="WizardAddAttr" disabled="@(saving || wAttrForm.AttributeId == 0)"><i class="bi bi-plus"></i> Asignar</button></div>
                            </div>
                            @if (wizardAttrs.Count == 0) { <p class="text-muted small">Sin atributos asignados.</p> }
                            else
                            {
                                <table class="table table-sm table-bordered mb-0">
                                    <thead><tr><th>Atributo</th><th>Valor</th><th>Vigencia</th></tr></thead>
                                    <tbody>@foreach (var a in wizardAttrs) { <tr><td><strong>@a.AttributeName</strong></td><td>@FormatAttrValue(a)</td><td><small>@(a.ValidFrom?.ToString("dd/MM/yy") ?? "—") ? @(a.ValidTo?.ToString("dd/MM/yy") ?? "—")</small></td></tr> }</tbody>
                                </table>
                            }
                        }

                        @* ?????? Tab 5: Variantes ?????? *@
                        @if (wizardTab == "w-variants")
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-3"><label class="form-label small">SKU Variante *</label><input class="form-control form-control-sm" @bind="wVariantForm.Sku" placeholder="SKU-VAR-001" /></div>
                                <div class="col-md-3"><label class="form-label small">Código de Barras</label><input class="form-control form-control-sm" @bind="wVariantForm.Barcode" /></div>
                                <div class="col-md-4">
                                    <label class="form-label small">Eje (Atributo variante)</label>
                                    <div class="input-group input-group-sm">
                                        <select class="form-select" @bind="wVariantAxisAttrId">
                                            <option value="0">-- Atributo --</option>
                                            @foreach (var a in variantAxisAttributes) { <option value="@a.AttributeId">@a.Name</option> }
                                        </select>
                                        <input class="form-control" @bind="wVariantAxisValue" placeholder="Valor" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="WizardAddAxis"><i class="bi bi-plus"></i></button>
                                    </div>
                                </div>
                                <div class="col-md-2"><button class="btn btn-success btn-sm w-100 mt-4" @onclick="WizardAddVariant" disabled="@(saving || string.IsNullOrWhiteSpace(wVariantForm.Sku))"><i class="bi bi-plus"></i> Crear</button></div>
                            </div>
                            @if (wVariantForm.AxisValues?.Count > 0)
                            {
                                <div class="mb-2">
                                    @foreach (var ax in wVariantForm.AxisValues)
                                    {
                                        <span class="badge bg-primary me-1">@ax.AttributeName: @(ax.OptionValue ?? ax.ValueString ?? "—") <i class="bi bi-x" style="cursor:pointer" @onclick="() => wVariantForm.AxisValues.Remove(ax)"></i></span>
                                    }
                                </div>
                            }
                            @if (wizardVariants.Count == 0) { <p class="text-muted small">Sin variantes creadas.</p> }
                            else
                            {
                                <table class="table table-sm table-bordered mb-0">
                                    <thead><tr><th>SKU</th><th>Barcode</th><th>Nombre</th><th>Ejes</th><th class="text-end"></th></tr></thead>
                                    <tbody>
                                        @foreach (var v in wizardVariants)
                                        {
                                            <tr>
                                                <td><code>@v.Sku</code></td><td><small>@(v.Barcode ?? "—")</small></td><td>@(v.VariantName ?? "—")</td>
                                                <td>@foreach (var ax in v.AxisValues) { <span class="badge bg-outline-secondary me-1">@ax.AttributeName: @(ax.OptionValue ?? ax.ValueString ?? "—")</span> }</td>
                                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => WizardDeleteVariant(v.VariantId)"><i class="bi bi-x-lg"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }

                        @* ?????? Tab 6: Activar en Empresa ?????? *@
                        @if (wizardTab == "w-empresa")
                        {
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-3"><label class="form-label small">SKU Empresa *</label><input class="form-control form-control-sm" @bind="wCompanyForm.Sku" placeholder="EMP-SKU-001" /></div>
                                <div class="col-md-2"><label class="form-label small">Cód. Interno</label><input class="form-control form-control-sm" @bind="wCompanyForm.CodigoInterno" /></div>
                                <div class="col-md-1"><div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="wCompanyForm.IsVisiblePOS" id="wePOS" /><label class="form-check-label small" for="wePOS">POS</label></div></div>
                                <div class="col-md-1"><div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="wCompanyForm.IsVisibleEcommerce" id="weEco" /><label class="form-check-label small" for="weEco">Ecom</label></div></div>
                                <div class="col-md-1"><div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="wCompanyForm.IsVisibleB2B" id="weB2B" /><label class="form-check-label small" for="weB2B">B2B</label></div></div>
                                <div class="col-md-1"><label class="form-label small">Stock Min</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="wCompanyForm.MinStock" /></div>
                                <div class="col-md-1"><label class="form-label small">Stock Max</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="wCompanyForm.MaxStock" /></div>
                                <div class="col-md-2"><button class="btn btn-success btn-sm w-100 mt-4" @onclick="WizardAddCompany" disabled="@(saving || string.IsNullOrWhiteSpace(wCompanyForm.Sku))"><i class="bi bi-plus"></i> Activar</button></div>
                            </div>
                            @if (wizardCompany.Count == 0) { <p class="text-muted small">No activado en ninguna empresa.</p> }
                            else
                            {
                                <table class="table table-sm table-bordered mb-0">
                                    <thead><tr><th>SKU</th><th>Cód. Int.</th><th class="text-center">POS</th><th class="text-center">Ecom</th><th class="text-center">B2B</th><th class="text-end">Min</th><th class="text-end">Max</th><th class="text-end"></th></tr></thead>
                                    <tbody>
                                        @foreach (var cp in wizardCompany)
                                        {
                                            <tr>
                                                <td><code>@cp.Sku</code></td>
                                                <td><small>@(cp.CodigoInterno ?? "—")</small></td>
                                                <td class="text-center"><i class="bi @(cp.IsVisiblePOS ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary")"></i></td>
                                                <td class="text-center"><i class="bi @(cp.IsVisibleEcommerce ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary")"></i></td>
                                                <td class="text-center"><i class="bi @(cp.IsVisibleB2B ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary")"></i></td>
                                                <td class="text-end">@(cp.MinStock?.ToString("N2") ?? "—")</td>
                                                <td class="text-end">@(cp.MaxStock?.ToString("N2") ?? "—")</td>
                                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => WizardDeleteCompany(cp.CompanyProductId)"><i class="bi bi-x-lg"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <div>
                        @if (createdProductId > 0 && wizardTab != "datos")
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="WizardPrev"><i class="bi bi-arrow-left"></i> Anterior</button>
                        }
                    </div>
                    <div>
                        @if (createdProductId == 0)
                        {
                            <button class="btn btn-secondary me-2" @onclick="CloseCreateModal">Cancelar</button>
                            <button class="btn btn-primary" @onclick="WizardCreateProduct" disabled="@(saving || createDto.CatalogId == 0 || createDto.DefaultUomId == 0 || string.IsNullOrWhiteSpace(createDto.CommercialName))">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> } <i class="bi bi-save"></i> Guardar y Continuar
                            </button>
                        }
                        else if (wizardTab != "w-empresa")
                        {
                            <button class="btn btn-outline-secondary me-2" @onclick="CloseCreateModal">Cerrar</button>
                            <button class="btn btn-primary" @onclick="WizardNext"><i class="bi bi-arrow-right"></i> Siguiente</button>
                        }
                        else
                        {
                            <button class="btn btn-success" @onclick="CloseCreateModal"><i class="bi bi-check-circle"></i> Finalizar</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ?? Form models ??
    private class AddUomForm { public int UomId { get; set; } public decimal FactorToBase { get; set; } = 1; public string? Barcode { get; set; } public bool IsBase { get; set; } }
    private class AddCodeForm { public byte CodeType { get; set; } public string Valor { get; set; } = ""; public DateOnly? ValidFrom { get; set; } public DateOnly? ValidTo { get; set; } public bool IsPrimary { get; set; } }
    private class AddAttrForm { public long AttributeId { get; set; } public string? ValueString { get; set; } public decimal? ValueDecimal { get; set; } public int? ValueInt { get; set; } public bool? ValueBool { get; set; } public DateOnly? ValueDate { get; set; } public long? OptionId { get; set; } }
    private class WizardVariantForm { public string Sku { get; set; } = ""; public string? Barcode { get; set; } public List<VariantAxisValueDto> AxisValues { get; set; } = new(); }
    private class WizardCompanyForm { public string Sku { get; set; } = ""; public string? CodigoInterno { get; set; } public bool IsVisiblePOS { get; set; } = true; public bool IsVisibleEcommerce { get; set; } public bool IsVisibleB2B { get; set; } public decimal? MinStock { get; set; } public decimal? MaxStock { get; set; } }

    // ?? State ??
    private List<ProductDto2> productos = new();
    private List<CatalogDto> catalogos = new();
    private List<UomDto> unidades = new();
    private List<BrandDto> brands = new();
    private List<ManufacturerDto> manufacturers = new();
    private List<AttributeDefinitionDto> allAttributes = new();

    // Detail state (expand row)
    private List<ProductVariantDto> detailVariants = new();
    private List<ProductUomDto> detailUoms = new();
    private List<ProductCodeDto> detailCodes = new();
    private List<ProductAttributeDto> detailAttrs = new();
    private List<CompanyProductDto> detailCompany = new();
    private AttributeDefinitionDto? selectedAttrDef;

    // Wizard state
    private long createdProductId;
    private string wizardTab = "datos";
    private string? wizardError;
    private string? wizardSuccess;
    private List<ProductUomDto> wizardUoms = new();
    private List<ProductCodeDto> wizardCodes = new();
    private List<ProductAttributeDto> wizardAttrs = new();
    private List<ProductVariantDto> wizardVariants = new();
    private List<CompanyProductDto> wizardCompany = new();
    private AddUomForm wUomForm = new();
    private AddCodeForm wCodeForm = new();
    private AddAttrForm wAttrForm = new();
    private WizardVariantForm wVariantForm = new();
    private WizardCompanyForm wCompanyForm = new();
    private AttributeDefinitionDto? wizardSelectedAttr;
    private long wVariantAxisAttrId;
    private string wVariantAxisValue = "";

    private IReadOnlyList<AttributeDefinitionDto> variantAxisAttributes =>
        allAttributes.Where(a => a.IsVariantAxis).ToList();

    private bool loading = true;
    private bool saving = false;
    private bool loadingDetail = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool showAddUomModal = false;
    private bool showAddCodeModal = false;
    private bool showAddAttrModal = false;
    private string? errorMessage;
    private string? successMessage;
    private string searchText = "";
    private string activeTab = "variantes";
    private long editingId;
    private long expandedId;
    private long modalProductId;

    private CreateProductDto2 createDto = new();
    private UpdateProductDto2 updateDto = new();
    private AddUomForm addUomForm = new();
    private AddCodeForm addCodeForm = new();
    private AddAttrForm addAttrForm = new();

    private List<ProductDto2> FilteredProducts => string.IsNullOrWhiteSpace(searchText)
        ? productos
        : productos.Where(p =>
            p.CommercialName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            p.GenericName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.BrandName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true; errorMessage = null;
        try
        {
            var t1 = ProductoService.GetAllAsync();
            var t2 = UnidadMedidaService.GetAllAsync();
            var t3 = CatalogoService.GetAllAsync();
            var t4 = BrandService.GetAllAsync();
            var t5 = ManufacturerService.GetAllAsync();
            var t6 = AttributeService.GetAllAsync();
            await Task.WhenAll(t1, t2, t3, t4, t5, t6);
            productos = await t1; unidades = await t2; catalogos = await t3;
            brands = await t4; manufacturers = await t5; allAttributes = await t6;

            // Auto-seed: if no catalogs or UoMs exist, create default data for the company
            if (!catalogos.Any() || !unidades.Any())
            {
                await EmpresaSvc.SeedMyCompanyAsync();
                unidades = await UnidadMedidaService.GetAllAsync();
                catalogos = await CatalogoService.GetAllAsync();
            }
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { loading = false; }
    }

    // ?? Expand detail (row tabs) ??
    private async Task ToggleDetail(long productId)
    {
        if (expandedId == productId) { expandedId = 0; return; }
        expandedId = productId; activeTab = "variantes"; loadingDetail = true;
        try
        {
            var tv = VariantService.GetByParentAsync(productId);
            var tu = ProductUomService.GetByProductAsync(productId);
            var tc = ProductCodeService.GetByProductAsync(productId);
            var ta = AttributeService.GetProductAttributesAsync(productId);
            var te = CompanyProductService.GetAllAsync();
            await Task.WhenAll(tv, tu, tc, ta, te);
            detailVariants = await tv; detailUoms = await tu; detailCodes = await tc;
            detailAttrs = await ta; detailCompany = (await te).Where(cp => cp.ProductId == productId).ToList();
        }
        catch { detailVariants = new(); detailUoms = new(); detailCodes = new(); detailAttrs = new(); detailCompany = new(); }
        finally { loadingDetail = false; }
    }

    // ?????? WIZARD ??????
    private void ShowCreateModal()
    {
        createdProductId = 0; wizardTab = "datos"; wizardError = null; wizardSuccess = null;
        wizardUoms = new(); wizardCodes = new(); wizardAttrs = new(); wizardVariants = new(); wizardCompany = new();
        wUomForm = new(); wCodeForm = new(); wAttrForm = new(); wVariantForm = new(); wCompanyForm = new();
        wizardSelectedAttr = null; wVariantAxisAttrId = 0; wVariantAxisValue = "";
        createDto = new() { ProductKind = 1, IsStockable = true, IsSellable = true, IsPurchasable = true,
            CatalogId = catalogos.FirstOrDefault()?.CatalogId ?? 0, DefaultUomId = unidades.FirstOrDefault()?.UomId ?? 0 };
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        if (createdProductId > 0) { _ = LoadData(); }
    }

    private static readonly string[] WizardTabs = ["datos", "w-uom", "w-codes", "w-attrs", "w-variants", "w-empresa"];
    private void WizardNext() { var i = Array.IndexOf(WizardTabs, wizardTab); if (i < WizardTabs.Length - 1) wizardTab = WizardTabs[i + 1]; }
    private void WizardPrev() { var i = Array.IndexOf(WizardTabs, wizardTab); if (i > 0) wizardTab = WizardTabs[i - 1]; }

    private async Task WizardCreateProduct()
    {
        if (createDto.DefaultUomId == 0 || createDto.CatalogId == 0 || string.IsNullOrWhiteSpace(createDto.CommercialName)) return;
        saving = true; wizardError = null;
        try
        {
            var r = await ProductoService.CreateAsync(createDto);
            if (r.Success && r.Data != null) { createdProductId = r.Data.ProductId; wizardSuccess = $"Producto '{r.Data.CommercialName}' creado (ID: {createdProductId}). Continue agregando relaciones."; wizardTab = "w-uom"; }
            else wizardError = r.Message;
        }
        catch (Exception ex) { wizardError = ex.Message; }
        finally { saving = false; }
    }

    // Wizard – UdM
    private async Task WizardAddUom()
    {
        if (wUomForm.UomId == 0) return;
        saving = true; wizardError = null;
        try
        {
            var r = await ProductUomService.CreateAsync(new CreateProductUomDto(createdProductId, wUomForm.UomId, wUomForm.IsBase, wUomForm.FactorToBase, wUomForm.Barcode));
            if (r.Success) { wizardSuccess = "UdM agregada."; wUomForm = new(); wizardUoms = await ProductUomService.GetByProductAsync(createdProductId); }
            else wizardError = r.Message;
        }
        catch (Exception ex) { wizardError = ex.Message; }
        finally { saving = false; }
    }
    private async Task WizardDeleteUom(long id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar esta UdM?")) return;
        try { var r = await ProductUomService.DeleteAsync(id); if (r.Success) { wizardUoms = await ProductUomService.GetByProductAsync(createdProductId); wizardSuccess = "UdM eliminada."; } else wizardError = r.Message; }
        catch (Exception ex) { wizardError = ex.Message; }
    }

    // Wizard – Códigos
    private async Task WizardAddCode()
    {
        if (wCodeForm.CodeType == 0 || string.IsNullOrWhiteSpace(wCodeForm.Valor)) return;
        saving = true; wizardError = null;
        try
        {
            var r = await ProductCodeService.CreateAsync(new CreateProductCodeDto(modalProductId, addCodeForm.CodeType, addCodeForm.Valor, ValidFrom: addCodeForm.ValidFrom, ValidTo: addCodeForm.ValidTo, IsPrimary: addCodeForm.IsPrimary));
            if (r.Success) { successMessage = "Código asignado."; showAddCodeModal = false; expandedId = 0; await ToggleDetail(modalProductId); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { saving = false; }
    }
    private async Task WizardDeleteCode(long id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar este código?")) return;
        try { var r = await ProductCodeService.DeleteAsync(id); if (r.Success) { wizardCodes = await ProductCodeService.GetByProductAsync(createdProductId); wizardSuccess = "Código eliminado."; } else wizardError = r.Message; }
        catch (Exception ex) { wizardError = ex.Message; }
