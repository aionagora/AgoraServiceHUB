@page "/mdm/productos"
@attribute [Authorize]
@inject ProductoHttpService ProductoService
@inject CategoriaProductoHttpService CategoriaService
@inject UnidadMedidaHttpService UnidadMedidaService
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>?? Products</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> New Product
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Loading products...</p>
        </div>
    }
    else if (productos.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No products registered.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-sm">
                        <thead>
                            <tr>
                                <th>Commercial Name</th>
                                <th>Generic Name</th>
                                <th>Brand</th>
                                <th>UoM</th>
                                <th>Kind</th>
                                <th>Catalog</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in productos)
                            {
                                <tr>
                                    <td><strong>@p.CommercialName</strong></td>
                                    <td><small>@p.GenericName</small></td>
                                    <td>@(p.BrandName ?? "-")</td>
                                    <td><span class="badge bg-info">@p.DefaultUomCode</span></td>
                                    <td><small>@p.ProductKind</small></td>
                                    <td><span class="badge bg-secondary">@p.CatalogName</span></td>
                                    <td>
                                        <span class="badge @(p.Activo ? "bg-success" : "bg-secondary")">
                                            @(p.Activo ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(p)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteProducto(p)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Product</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateProducto">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Commercial Name *</label>
                                <InputText class="form-control" @bind-Value="createDto.CommercialName" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Generic Name *</label>
                                <InputText class="form-control" @bind-Value="createDto.GenericName" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Unit of Measure *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.DefaultUomId">
                                    <option value="0">-- Select UoM --</option>
                                    @foreach (var um in unidades)
                                    {
                                        <option value="@um.UomId">@um.Name (@um.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Catalog *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.CatalogId">
                                    <option value="0">-- Select Catalog --</option>
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.CatalogId">@cat.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kind</label>
                                <InputSelect class="form-select" @bind-Value="createDto.ProductKind">
                                    <option value="1">Item</option>
                                    <option value="2">Service</option>
                                    <option value="3">Kit</option>
                                    <option value="4">Raw Material</option>
                                    <option value="5">Packaging</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Short Description</label>
                            <InputText class="form-control" @bind-Value="createDto.ShortDescription" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Save
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Product</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateProducto">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Commercial Name *</label>
                                <InputText class="form-control" @bind-Value="updateDto.CommercialName" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Generic Name *</label>
                                <InputText class="form-control" @bind-Value="updateDto.GenericName" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Unit of Measure *</label>
                                <InputSelect class="form-select" @bind-Value="updateDto.DefaultUomId">
                                    <option value="0">-- Select UoM --</option>
                                    @foreach (var um in unidades)
                                    {
                                        <option value="@um.UomId">@um.Name (@um.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kind</label>
                                <InputSelect class="form-select" @bind-Value="updateDto.ProductKind">
                                    <option value="1">Item</option>
                                    <option value="2">Service</option>
                                    <option value="3">Kit</option>
                                    <option value="4">Raw Material</option>
                                    <option value="5">Packaging</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <InputCheckbox class="form-check-input" @bind-Value="updateDto.Activo" />
                                    <label class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Short Description</label>
                            <InputText class="form-control" @bind-Value="updateDto.ShortDescription" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Update
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto2> productos = new();
    private List<CatalogDto> categorias = new();
    private List<UomDto> unidades = new();

    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private string? successMessage;

    private CreateProductDto2 createDto = new();
    private UpdateProductDto2 updateDto = new();
    private long editingId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;
            var p = ProductoService.GetAllAsync();
            var u = UnidadMedidaService.GetAllAsync();
            await Task.WhenAll(p, u);
            productos = await p;
            unidades = await u;
        }
        catch (Exception ex) { errorMessage = $"Error loading data: {ex.Message}"; }
        finally { loading = false; }
    }

    private void ShowCreateModal()
    {
        createDto = new CreateProductDto2 { ProductKind = 1, IsStockable = true, IsSellable = true, IsPurchasable = true };
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private void ShowEditModal(ProductDto2 p)
    {
        updateDto = new UpdateProductDto2
        {
            ProductKind = p.ProductKind,
            GenericName = p.GenericName,
            CommercialName = p.CommercialName,
            ShortDescription = p.ShortDescription,
            LongDescription = p.LongDescription,
            BrandId = p.BrandId,
            ManufacturerId = p.ManufacturerId,
            DefaultUomId = p.DefaultUomId,
            IsStockable = p.IsStockable,
            IsSellable = p.IsSellable,
            IsPurchasable = p.IsPurchasable,
            LifecycleStatusId = p.LifecycleStatusId,
            Activo = p.Activo
        };
        editingId = p.ProductId;
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private async Task CreateProducto()
    {
        try
        {
            saving = true;
            errorMessage = null;
            var response = await ProductoService.CreateAsync(createDto);
            if (response.Success) { successMessage = "Product created."; CloseCreateModal(); await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task UpdateProducto()
    {
        try
        {
            saving = true;
            errorMessage = null;
            var response = await ProductoService.UpdateAsync(editingId, updateDto);
            if (response.Success) { successMessage = "Product updated."; CloseEditModal(); await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task DeleteProducto(ProductDto2 p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete product '{p.CommercialName}'?")) return;
        try
        {
            var response = await ProductoService.DeleteAsync(p.ProductId);
            if (response.Success) { successMessage = "Product deleted."; await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error deleting: {ex.Message}"; }
    }
}
