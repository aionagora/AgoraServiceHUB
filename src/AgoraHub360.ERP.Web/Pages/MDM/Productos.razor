@code {
    private List<ProductoDto> productos = new();
    private List<CategoriaProductoDto> categorias = new();
    private List<UnidadMedidaDto> unidadesMedida = new();
    
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private string? successMessage;
    
    private CreateProductoDto createDto = new();
    private UpdateProductoDto updateDto = new();
    private int editingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;
            
            var productosTask = ProductoService.GetAllAsync();
            var categoriasTask = CategoriaService.GetAllAsync();
            var unidadesTask = UnidadMedidaService.GetAllAsync();
            
            await Task.WhenAll(productosTask, categoriasTask, unidadesTask);
            
            productos = await productosTask;
            categorias = await categoriasTask;
            unidadesMedida = await unidadesTask;

            if (categorias.Count == 0)
            {
                errorMessage = "Debe crear al menos una categoría antes de agregar productos.";
            }

            if (unidadesMedida.Count == 0)
            {
                errorMessage = "Debe crear al menos una unidad de medida antes de agregar productos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        if (categorias.Count == 0 || unidadesMedida.Count == 0)
        {
            errorMessage = "Debe crear categorías y unidades de medida antes de crear productos.";
            return;
        }

        createDto = new CreateProductoDto();
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private void ShowEditModal(ProductoDto producto)
    {
        updateDto = new UpdateProductoDto
        {
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            CategoriaProductoId = producto.CategoriaProductoId,
            UnidadMedidaId = producto.UnidadMedidaId,
            PrecioCompra = producto.PrecioCompra,
            PrecioVenta = producto.PrecioVenta,
            StockMinimo = producto.StockMinimo,
            Sku = producto.Sku,
            TipoProducto = producto.TipoProducto,
            ControlStock = producto.ControlStock,
            CostoBase = producto.CostoBase,
            Activo = producto.Activo
        };
        editingId = producto.Id;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task CreateProducto()
    {
        try
        {
            saving = true;
            errorMessage = null;
            successMessage = null;

            var response = await ProductoService.CreateAsync(createDto);

            if (response.Success)
            {
                successMessage = "Producto creado exitosamente";
                CloseCreateModal();
                await LoadData();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateProducto()
    {
        try
        {
            saving = true;
            errorMessage = null;
            successMessage = null;

            var response = await ProductoService.UpdateAsync(editingId, updateDto);

            if (response.Success)
            {
                successMessage = "Producto actualizado exitosamente";
                CloseEditModal();
                await LoadData();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteProducto(ProductoDto producto)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el producto '{producto.Nombre}'?"))
            return;

        try
        {
            errorMessage = null;
            successMessage = null;

            var response = await ProductoService.DeleteAsync(producto.Id);
            if (response.Success)
            {
                successMessage = "Producto eliminado exitosamente";
                await LoadData();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
    }
}
