{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Proveedor</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateProveedor">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Código *</label>
                                <InputText class="form-control" @bind-Value="updateDto.Codigo" placeholder="Ej: PROV-001" />
                                <ValidationMessage For="@(() => updateDto.Codigo)" />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Razón Social *</label>
                                <InputText class="form-control" @bind-Value="updateDto.RazonSocial" placeholder="Nombre o razón social" />
                                <ValidationMessage For="@(() => updateDto.RazonSocial)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="updateDto.NIT" placeholder="NIT" />
                                <ValidationMessage For="@(() => updateDto.NIT)" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tipo de Proveedor *</label>
                                <InputSelect class="form-select" @bind-Value="updateDto.TipoProveedor">
                                    <option value="Local">Local</option>
                                    <option value="Internacional">Internacional</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => updateDto.TipoProveedor)" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Condición de Pago</label>
                                <InputText class="form-control" @bind-Value="updateDto.CondicionPago" placeholder="Ej: Contado, 30 días" />
                                <ValidationMessage For="@(() => updateDto.CondicionPago)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="updateDto.Telefono" placeholder="77123456" />
                                <ValidationMessage For="@(() => updateDto.Telefono)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" type="email" @bind-Value="updateDto.Email" placeholder="proveedor@ejemplo.com" />
                                <ValidationMessage For="@(() => updateDto.Email)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre Contacto</label>
                                <InputText class="form-control" @bind-Value="updateDto.NombreContacto" placeholder="Persona de contacto" />
                                <ValidationMessage For="@(() => updateDto.NombreContacto)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">País</label>
                                <InputText class="form-control" @bind-Value="updateDto.Pais" placeholder="Bolivia" />
                                <ValidationMessage For="@(() => updateDto.Pais)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputTextArea class="form-control" @bind-Value="updateDto.Direccion" rows="2" placeholder="Dirección completa" />
                            <ValidationMessage For="@(() => updateDto.Direccion)" />
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="activoCheckProv" @bind-Value="updateDto.Activo" />
                            <label class="form-check-label" for="activoCheckProv">Activo</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Actualizar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProveedorDto> proveedores = new();
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private string? successMessage;
    private CreateProveedorDto createDto = new();
    private UpdateProveedorDto updateDto = new();
    private int editingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadProveedores();
    }

    private async Task LoadProveedores()
    {
        try
        {
            loading = true;
            errorMessage = null;
            proveedores = await ProveedorService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar proveedores: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        createDto = new CreateProveedorDto();
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private void ShowEditModal(ProveedorDto proveedor)
    {
        updateDto = new UpdateProveedorDto
        {
            Codigo = proveedor.Codigo,
            RazonSocial = proveedor.RazonSocial,
            NIT = proveedor.NIT,
            Telefono = proveedor.Telefono,
            Email = proveedor.Email,
            Direccion = proveedor.Direccion,
            NombreContacto = proveedor.NombreContacto,
            TipoProveedor = proveedor.TipoProveedor,
            Pais = proveedor.Pais,
            CondicionPago = proveedor.CondicionPago,
            Activo = proveedor.Activo
        };
        editingId = proveedor.Id;
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private async Task CreateProveedor()
    {
        try
        {
            saving = true;
            errorMessage = null;
            successMessage = null;

            var response = await ProveedorService.CreateAsync(createDto);

            if (response.Success)
            {
                successMessage = "Proveedor creado exitosamente";
                CloseCreateModal();
                await LoadProveedores();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateProveedor()
    {
        try
        {
            saving = true;
            errorMessage = null;
            successMessage = null;

            var response = await ProveedorService.UpdateAsync(editingId, updateDto);

            if (response.Success)
            {
                successMessage = "Proveedor actualizado exitosamente";
                CloseEditModal();
                await LoadProveedores();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteProveedor(ProveedorDto proveedor)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el proveedor '{proveedor.RazonSocial}'?"))
            return;

        try
        {
            errorMessage = null;
            successMessage = null;

            var response = await ProveedorService.DeleteAsync(proveedor.Id);
            if (response.Success)
            {
                successMessage = "Proveedor eliminado exitosamente";
                await LoadProveedores();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
    }
}
