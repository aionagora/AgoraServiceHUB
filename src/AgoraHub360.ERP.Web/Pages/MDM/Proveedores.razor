@page "/mdm/proveedores"
@attribute [Authorize]
@inject ProveedorHttpService ProveedorService
@inject IJSRuntime JS
@using ProveedorDto = AgoraHub360.ERP.Shared.DTOs.MDM.ProveedorDto
@using CreateProveedorDto = AgoraHub360.ERP.Shared.DTOs.MDM.CreateProveedorDto
@using UpdateProveedorDto = AgoraHub360.ERP.Shared.DTOs.MDM.UpdateProveedorDto

<PageTitle>Proveedores</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>?? Proveedores</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nuevo Proveedor
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando proveedores...</p>
        </div>
    }
    else if (proveedores.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay proveedores registrados. Crea el primer proveedor usando el botón "Nuevo Proveedor".
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Razón Social</th>
                                <th>NIT</th>
                                <th>Tipo</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proveedor in proveedores)
                            {
                                <tr>
                                    <td><code>@proveedor.Codigo</code></td>
                                    <td><strong>@proveedor.RazonSocial</strong></td>
                                    <td>@proveedor.NIT</td>
                                    <td>
                                        <span class="badge bg-info">@proveedor.TipoProveedor</span>
                                    </td>
                                    <td>@(proveedor.Telefono ?? "-")</td>
                                    <td>@(proveedor.Email ?? "-")</td>
                                    <td>
                                        @if (proveedor.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(proveedor)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteProveedor(proveedor)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@* Modal Crear *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo Proveedor</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateProveedor">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Código *</label>
                                <InputText class="form-control" @bind-Value="createDto.Codigo" placeholder="Ej: PROV-001" />
                                <ValidationMessage For="@(() => createDto.Codigo)" />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Razón Social *</label>
                                <InputText class="form-control" @bind-Value="createDto.RazonSocial" placeholder="Nombre o razón social" />
                                <ValidationMessage For="@(() => createDto.RazonSocial)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="createDto.NIT" placeholder="NIT" />
                                <ValidationMessage For="@(() => createDto.NIT)" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tipo de Proveedor *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.TipoProveedor">
                                    <option value="Local">Local</option>
                                    <option value="Internacional">Internacional</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => createDto.TipoProveedor)" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Condición de Pago</label>
                                <InputText class="form-control" @bind-Value="createDto.CondicionPago" placeholder="Ej: Contado, 30 días" />
                                <ValidationMessage For="@(() => createDto.CondicionPago)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="createDto.Telefono" placeholder="77123456" />
                                <ValidationMessage For="@(() => createDto.Telefono)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" type="email" @bind-Value="createDto.Email" placeholder="proveedor@ejemplo.com" />
                                <ValidationMessage For="@(() => createDto.Email)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre Contacto</label>
                                <InputText class="form-control" @bind-Value="createDto.NombreContacto" placeholder="Persona de contacto" />
                                <ValidationMessage For="@(() => createDto.NombreContacto)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">País</label>
                                <InputText class="form-control" @bind-Value="createDto.Pais" placeholder="Bolivia" />
                                <ValidationMessage For="@(() => createDto.Pais)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputTextArea class="form-control" @bind-Value="createDto.Direccion" rows="2" placeholder="Dirección completa" />
                            <ValidationMessage For="@(() => createDto.Direccion)" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Editar *@
