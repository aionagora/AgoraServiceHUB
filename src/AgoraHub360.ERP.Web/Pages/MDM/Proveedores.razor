@page "/mdm/proveedores"
@attribute [Authorize]
@inject ProveedorHttpService ProveedorSvc

<PageTitle>Proveedores - AgoraHub360 ERP</PageTitle>

<div class="page-header">
    <h1>Proveedores</h1>
    <p class="text-muted mb-0">Datos Maestros &rsaquo; Proveedores</p>
</div>

@if (!string.IsNullOrEmpty(_mensaje))
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
        @_mensaje
        <button type="button" class="btn-close" @onclick="() => _mensaje = null"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <div class="d-flex align-items-center gap-3">
            <span>Proveedores (@ItemsFiltrados.Count)</span>
            <input type="text" class="form-control form-control-sm" placeholder="Buscar..."
                   style="width: 220px;" @bind="_search" @bind:event="oninput" />
        </div>
        <button class="btn btn-primary btn-sm" @onclick="ShowCrear">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Proveedor
        </button>
    </div>

    @if (_loading)
    {
        <div class="card-body text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-truck" style="font-size: 3rem; color: var(--agora-text-light);"></i>
            <p class="text-muted mt-3">No hay proveedores registrados.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Razon Social</th>
                        <th>NIT</th>
                        <th>Tipo</th>
                        <th>Telefono</th>
                        <th>Email</th>
                        <th>Contacto</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ItemsPaginados)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Codigo</td>
                            <td>@item.RazonSocial</td>
                            <td>@(item.NIT ?? "—")</td>
                            <td>
                                <span class="badge @(item.TipoProveedor == "Internacional" ? "bg-info" : "bg-secondary")">
                                    @item.TipoProveedor
                                </span>
                            </td>
                            <td>@(item.Telefono ?? "—")</td>
                            <td>@(item.Email ?? "—")</td>
                            <td>@(item.NombreContacto ?? "—")</td>
                            <td class="text-center">
                                <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">
                                    @(item.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm me-1"
                                        @onclick="() => ShowEditar(item)" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm"
                                        @onclick="() => ConfirmDelete(item)" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPaginas > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center py-2">
                <small class="text-muted">Mostrando @ItemsPaginados.Count de @ItemsFiltrados.Count</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => _currentPage--">&laquo;</button>
                        </li>
                        @for (var p = 1; p <= TotalPaginas; p++)
                        {
                            var page = p;
                            <li class="page-item @(page == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => _currentPage = page">@page</button>
                            </li>
                        }
                        <li class="page-item @(_currentPage >= TotalPaginas ? "disabled" : "")">
                            <button class="page-link" @onclick="() => _currentPage++">&raquo;</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<!-- Modal Crear/Editar -->
@if (_showForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editId.HasValue ? "Editar Proveedor" : "Nuevo Proveedor")</h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Codigo *</label>
                                <InputText class="form-control" @bind-Value="_formModel.Codigo" />
                                <ValidationMessage For="() => _formModel.Codigo" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Razon Social *</label>
                                <InputText class="form-control" @bind-Value="_formModel.RazonSocial" />
                                <ValidationMessage For="() => _formModel.RazonSocial" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="_formModel.NIT" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Telefono</label>
                                <InputText class="form-control" @bind-Value="_formModel.Telefono" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="_formModel.Email" />
                                <ValidationMessage For="() => _formModel.Email" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Direccion</label>
                                <InputText class="form-control" @bind-Value="_formModel.Direccion" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nombre Contacto</label>
                                <InputText class="form-control" @bind-Value="_formModel.NombreContacto" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Tipo Proveedor *</label>
                                <InputSelect class="form-select" @bind-Value="_formModel.TipoProveedor">
                                    <option value="Local">Local</option>
                                    <option value="Internacional">Internacional</option>
                                </InputSelect>
                            </div>
                            @if (_formModel.TipoProveedor == "Internacional")
                            {
                                <div class="col-md-4">
                                    <label class="form-label">Pais</label>
                                    <InputText class="form-control" @bind-Value="_formModel.Pais" />
                                </div>
                            }
                            <div class="col-md-4">
                                <label class="form-label">Condicion de Pago</label>
                                <InputSelect class="form-select" @bind-Value="_formModel.CondicionPago">
                                    <option value="">— Seleccionar —</option>
                                    <option value="Contado">Contado</option>
                                    <option value="30 dias">30 dias</option>
                                    <option value="60 dias">60 dias</option>
                                    <option value="90 dias">90 dias</option>
                                </InputSelect>
                            </div>
                        </div>
                        @if (_editId.HasValue)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_formActivo" />
                                <label class="form-check-label">Activo</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @(_editId.HasValue ? "Guardar" : "Crear Proveedor")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal Eliminar -->
@if (_deleteTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="() => _deleteTarget = null"></button>
                </div>
                <div class="modal-body">
                    <p>Eliminar al proveedor <strong>@_deleteTarget.RazonSocial</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deleteTarget = null">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteAsync" disabled="@_saving">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProveedorDto> _items = new();
    private bool _loading = true, _saving;
    private string? _mensaje;
    private bool _esError;

    private bool _showForm;
    private int? _editId;
    private CreateProveedorDto _formModel = new();
    private bool _formActivo = true;
    private ProveedorDto? _deleteTarget;

    private string _search = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 15;

    private List<ProveedorDto> ItemsFiltrados => _items
        .Where(i => string.IsNullOrEmpty(_search)
            || i.Codigo.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || i.RazonSocial.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (i.NIT ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<ProveedorDto> ItemsPaginados => ItemsFiltrados
        .Skip((_currentPage - 1) * _pageSize)
        .Take(_pageSize)
        .ToList();

    private int TotalPaginas => (int)Math.Ceiling(ItemsFiltrados.Count / (double)_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try { _items = await ProveedorSvc.GetAllAsync(); }
        catch { _mensaje = "Error al cargar proveedores."; _esError = true; }
        _loading = false;
    }

    private void ShowCrear()
    {
        _editId = null;
        _formModel = new CreateProveedorDto();
        _formActivo = true;
        _showForm = true;
    }

    private void ShowEditar(ProveedorDto item)
    {
        _editId = item.Id;
        _formModel = new CreateProveedorDto
        {
            Codigo = item.Codigo,
            RazonSocial = item.RazonSocial,
            NIT = item.NIT,
            Direccion = item.Direccion,
            Telefono = item.Telefono,
            Email = item.Email,
            NombreContacto = item.NombreContacto,
            TipoProveedor = item.TipoProveedor,
            Pais = item.Pais,
            CondicionPago = item.CondicionPago
        };
        _formActivo = item.Activo;
        _showForm = true;
    }

    private void CloseForm() { _showForm = false; _editId = null; }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                var dto = new UpdateProveedorDto
                {
                    Codigo = _formModel.Codigo,
                    RazonSocial = _formModel.RazonSocial,
                    NIT = _formModel.NIT,
                    Direccion = _formModel.Direccion,
                    Telefono = _formModel.Telefono,
                    Email = _formModel.Email,
                    NombreContacto = _formModel.NombreContacto,
                    TipoProveedor = _formModel.TipoProveedor,
                    Pais = _formModel.Pais,
                    CondicionPago = _formModel.CondicionPago,
                    Activo = _formActivo
                };
                var r = await ProveedorSvc.UpdateAsync(_editId.Value, dto);
                if (!r.Success) { _mensaje = r.Message; _esError = true; _saving = false; return; }
                _mensaje = "Proveedor actualizado."; _esError = false;
            }
            else
            {
                var r = await ProveedorSvc.CreateAsync(_formModel);
                if (!r.Success) { _mensaje = r.Message; _esError = true; _saving = false; return; }
                _mensaje = "Proveedor creado."; _esError = false;
            }
            CloseForm();
            await LoadDataAsync();
        }
        catch { _mensaje = "Error de comunicacion."; _esError = true; }
        _saving = false;
    }

    private void ConfirmDelete(ProveedorDto item) => _deleteTarget = item;

    private async Task DeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            var r = await ProveedorSvc.DeleteAsync(_deleteTarget.Id);
            _mensaje = r.Success ? "Proveedor eliminado." : r.Message;
            _esError = !r.Success;
            _deleteTarget = null;
            await LoadDataAsync();
        }
        catch { _mensaje = "Error de comunicacion."; _esError = true; }
        _saving = false;
    }
}
