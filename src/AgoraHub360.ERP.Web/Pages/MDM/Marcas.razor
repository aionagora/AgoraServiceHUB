@page "/mdm/marcas"
@attribute [Authorize]
@inject BrandHttpService BrandService
@inject IJSRuntime JS

<PageTitle>Marcas - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-bookmark-star-fill"></i> Marcas</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nueva Marca
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando marcas...</p>
        </div>
    }
    else if (brands.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay marcas registradas.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <span>Marcas <span class="badge bg-secondary ms-1">@brands.Count</span></span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Logo URL</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in brands)
                            {
                                <tr>
                                    <td><strong>@b.Name</strong></td>
                                    <td><small class="text-muted">@(b.LogoUrl ?? "—")</small></td>
                                    <td>
                                        <span class="badge @(b.Activo ? "bg-success" : "bg-secondary")">
                                            @(b.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(b)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(b)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva Marca</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="Create">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="createDto.Name" placeholder="Ej: Samsung" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Logo URL</label>
                            <InputText class="form-control" @bind-Value="createDto.LogoUrl" placeholder="https://..." />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Marca</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="Update">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="updateDto.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Logo URL</label>
                            <InputText class="form-control" @bind-Value="updateDto.LogoUrl" />
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="activoCheck" @bind-Value="updateDto.Activo" />
                            <label class="form-check-label" for="activoCheck">Activo</label>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BrandDto> brands = new();
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private string? successMessage;
    private long editingId;

    private CreateBrandModel createDto = new();
    private UpdateBrandModel updateDto = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        errorMessage = null;
        try { brands = await BrandService.GetAllAsync(); }
        catch (Exception ex) { errorMessage = $"Error al cargar: {ex.Message}"; }
        finally { loading = false; }
    }

    private void ShowCreateModal() { createDto = new(); showCreateModal = true; }
    private void ShowEditModal(BrandDto b)
    {
        editingId = b.BrandId;
        updateDto = new() { Name = b.Name, LogoUrl = b.LogoUrl, Activo = b.Activo };
        showEditModal = true;
    }
    private void CloseModal() { showCreateModal = false; showEditModal = false; }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(createDto.Name)) return;
        saving = true; errorMessage = null;
        try
        {
            var r = await BrandService.CreateAsync(new CreateBrandDto(createDto.Name.Trim(), createDto.LogoUrl?.Trim()));
            if (r.Success) { successMessage = $"Marca '{createDto.Name}' creada."; CloseModal(); await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { saving = false; }
    }

    private async Task Update()
    {
        if (string.IsNullOrWhiteSpace(updateDto.Name)) return;
        saving = true; errorMessage = null;
        try
        {
            var r = await BrandService.UpdateAsync(editingId, new UpdateBrandDto(updateDto.Name.Trim(), updateDto.LogoUrl?.Trim(), updateDto.Activo));
            if (r.Success) { successMessage = "Marca actualizada."; CloseModal(); await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { saving = false; }
    }

    private async Task Delete(BrandDto b)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar marca '{b.Name}'?")) return;
        try
        {
            var r = await BrandService.DeleteAsync(b.BrandId);
            if (r.Success) { successMessage = "Marca eliminada."; await LoadData(); }
            else errorMessage = r.Message;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private class CreateBrandModel { public string Name { get; set; } = ""; public string? LogoUrl { get; set; } }
    private class UpdateBrandModel { public string Name { get; set; } = ""; public string? LogoUrl { get; set; } public bool Activo { get; set; } = true; }
}
