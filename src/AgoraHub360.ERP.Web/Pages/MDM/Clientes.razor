@page "/mdm/clientes"
@attribute [Authorize]
@inject ClienteHttpService ClienteService
@inject IJSRuntime JS

<PageTitle>Clientes</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>?? Clientes</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nuevo Cliente
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando clientes...</p>
        </div>
    }
    else if (clientes.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay clientes registrados. Crea el primer cliente usando el botón "Nuevo Cliente".
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Razón Social</th>
                                <th>NIT</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in clientes)
                            {
                                <tr>
                                    <td>@cliente.Id</td>
                                    <td><strong>@cliente.RazonSocial</strong></td>
                                    <td>@cliente.NIT</td>
                                    <td>@(cliente.Telefono ?? "-")</td>
                                    <td>@(cliente.Email ?? "-")</td>
                                    <td>
                                        @if (cliente.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(cliente)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCliente(cliente)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@* Modal Crear *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo Cliente</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateCliente">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Razón Social *</label>
                                <InputText class="form-control" @bind-Value="createDto.RazonSocial" placeholder="Nombre o razón social" />
                                <ValidationMessage For="@(() => createDto.RazonSocial)" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">NIT *</label>
                                <InputText class="form-control" @bind-Value="createDto.NIT" placeholder="NIT o CI" />
                                <ValidationMessage For="@(() => createDto.NIT)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="createDto.Telefono" placeholder="77123456" />
                                <ValidationMessage For="@(() => createDto.Telefono)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" type="email" @bind-Value="createDto.Email" placeholder="cliente@ejemplo.com" />
                                <ValidationMessage For="@(() => createDto.Email)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputTextArea class="form-control" @bind-Value="createDto.Direccion" rows="2" placeholder="Dirección completa" />
                            <ValidationMessage For="@(() => createDto.Direccion)" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Editar *@
@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Cliente</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateCliente">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Razón Social *</label>
                                <InputText class="form-control" @bind-Value="updateDto.RazonSocial" placeholder="Nombre o razón social" />
                                <ValidationMessage For="@(() => updateDto.RazonSocial)" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">NIT *</label>
                                <InputText class="form-control" @bind-Value="updateDto.NIT" placeholder="NIT o CI" />
                                <ValidationMessage For="@(() => updateDto.NIT)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="updateDto.Telefono" placeholder="77123456" />
                                <ValidationMessage For="@(() => updateDto.Telefono)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" type="email" @bind-Value="updateDto.Email" placeholder="cliente@ejemplo.com" />
                                <ValidationMessage For="@(() => updateDto.Email)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputTextArea class="form-control" @bind-Value="updateDto.Direccion" rows="2" placeholder="Dirección completa" />
                            <ValidationMessage For="@(() => updateDto.Direccion)" />
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="activoCheck" @bind-Value="updateDto.Activo" />
                            <label class="form-check-label" for="activoCheck">Activo</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Actualizar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ClienteDto> clientes = new();
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private string? successMessage;
    private CreateClienteDto createDto = new();
    private UpdateClienteDto updateDto = new();
    private int editingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientes();
    }

    private async Task LoadClientes()
    {
        try
        {
            loading = true;
            errorMessage = null;
            clientes = await ClienteService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar clientes: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        createDto = new CreateClienteDto();
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private void ShowEditModal(ClienteDto cliente)
    {
        updateDto = new UpdateClienteDto
        {
            RazonSocial = cliente.RazonSocial,
            NIT = cliente.NIT,
            Telefono = cliente.Telefono,
            Email = cliente.Email,
            Direccion = cliente.Direccion,
            Activo = cliente.Activo
        };
        editingId = cliente.Id;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task CreateCliente()
    {
        try
        {
            saving = true;
            errorMessage = null;
            successMessage = null;

            var response = await ClienteService.CreateAsync(createDto);

            if (response.Success)
            {
                successMessage = "Cliente creado exitosamente";
                CloseCreateModal();
                await LoadClientes();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateCliente()
    {
        try
        {
            saving = true;
            errorMessage = null;
            successMessage = null;

            var response = await ClienteService.UpdateAsync(editingId, updateDto);

            if (response.Success)
            {
                successMessage = "Cliente actualizado exitosamente";
                CloseEditModal();
                await LoadClientes();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteCliente(ClienteDto cliente)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el cliente '{cliente.RazonSocial}'?"))
            return;

        try
        {
            errorMessage = null;
            successMessage = null;

            var response = await ClienteService.DeleteAsync(cliente.Id);
            if (response.Success)
            {
                successMessage = "Cliente eliminado exitosamente";
                await LoadClientes();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
    }
}
