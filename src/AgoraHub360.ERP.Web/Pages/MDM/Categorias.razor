@page "/mdm/categorias"
@attribute [Authorize]
@inject CategoriaProductoHttpService CategoriaService
@inject IJSRuntime JS

<PageTitle>Categories</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>?? Categories</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> New Category
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Loading categories...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    else if (categorias.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No categories registered.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Path</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in categorias)
                            {
                                <tr>
                                    <td>@cat.CategoryId</td>
                                    <td><strong>@cat.Name</strong></td>
                                    <td><small class="text-muted">@cat.Path</small></td>
                                    <td>
                                        <span class="badge @(cat.Activo ? "bg-success" : "bg-secondary")">
                                            @(cat.Activo ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(cat)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCategoria(cat)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Category</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="mb-3">
                            <label class="form-label">Name *</label>
                            <InputText class="form-control" @bind-Value="createDto.Name" placeholder="E.g.: Electronics" />
                            <ValidationMessage For="@(() => createDto.Name)" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Save
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Category</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="mb-3">
                            <label class="form-label">Name *</label>
                            <InputText class="form-control" @bind-Value="updateDto.Name" placeholder="E.g.: Electronics" />
                            <ValidationMessage For="@(() => updateDto.Name)" />
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="activoCheck" @bind-Value="updateDto.Activo" />
                            <label class="form-check-label" for="activoCheck">Active</label>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Save
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto> categorias = new();
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private CreateCategoryDto createDto = new();
    private UpdateCategoryDto updateDto = new();
    private long editingId;

    protected override async Task OnInitializedAsync() => await LoadCategorias();

    private async Task LoadCategorias()
    {
        try
        {
            loading = true;
            errorMessage = null;
            categorias = await CategoriaService.GetAllAsync();
        }
        catch (Exception ex) { errorMessage = $"Error loading categories: {ex.Message}"; }
        finally { loading = false; }
    }

    private void ShowCreateModal()
    {
        createDto = new CreateCategoryDto();
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private void ShowEditModal(CategoryDto cat)
    {
        updateDto = new UpdateCategoryDto
        {
            ParentCategoryId = cat.ParentCategoryId,
            Name = cat.Name,
            SortOrder = cat.SortOrder,
            Activo = cat.Activo
        };
        editingId = cat.CategoryId;
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private async Task CreateCategoria()
    {
        try
        {
            saving = true;
            errorMessage = null;
            var response = await CategoriaService.CreateAsync(createDto);
            if (response.Success) { CloseCreateModal(); await LoadCategorias(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task UpdateCategoria()
    {
        try
        {
            saving = true;
            errorMessage = null;
            var response = await CategoriaService.UpdateAsync(editingId, updateDto);
            if (response.Success) { CloseEditModal(); await LoadCategorias(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task DeleteCategoria(CategoryDto cat)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete category '{cat.Name}'?")) return;
        try
        {
            var response = await CategoriaService.DeleteAsync(cat.CategoryId);
            if (response.Success) await LoadCategorias();
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error deleting: {ex.Message}"; }
    }
}
