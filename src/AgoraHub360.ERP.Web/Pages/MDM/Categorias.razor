@page "/mdm/categorias"
@attribute [Authorize]
@inject CategoriaProductoHttpService CategoriaService
@inject CatalogoHttpService CatalogoService
@inject IJSRuntime JS

<PageTitle>Categorías - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>??? Categorías</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nueva Categoría
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando categorías...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    else if (categorias.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay categorías registradas.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Catálogo</th>
                                <th>Ruta</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in categorias)
                            {
                                <tr>
                                    <td><strong>@cat.Name</strong></td>
                                    <td><span class="badge bg-secondary">@GetCatalogName(cat.CatalogId)</span></td>
                                    <td><small class="text-muted">@cat.Path</small></td>
                                    <td>
                                        <span class="badge @(cat.Activo ? "bg-success" : "bg-secondary")">
                                            @(cat.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(cat)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCategoria(cat)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva Categoría</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="mb-3">
                            <label class="form-label">Catálogo *</label>
                            <InputSelect class="form-select" @bind-Value="createDto.CatalogId">
                                <option value="0">-- Seleccionar catálogo --</option>
                                @foreach (var c in catalogos)
                                {
                                    <option value="@c.CatalogId">@c.Name</option>
                                }
                            </InputSelect>
                            @if (createDto.CatalogId == 0)
                            {
                                <div class="text-danger small mt-1">El catálogo es obligatorio.</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="createDto.Name" placeholder="Ej: Electrónica" />
                            <ValidationMessage For="@(() => createDto.Name)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Orden</label>
                            <InputNumber class="form-control" @bind-Value="createDto.SortOrder" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@(saving || createDto.CatalogId == 0)">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Categoría</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="updateDto.Name" placeholder="Ej: Electrónica" />
                            <ValidationMessage For="@(() => updateDto.Name)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Orden</label>
                            <InputNumber class="form-control" @bind-Value="updateDto.SortOrder" />
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="activoCheck" @bind-Value="updateDto.Activo" />
                            <label class="form-check-label" for="activoCheck">Activo</label>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto> categorias = new();
    private List<CatalogDto> catalogos = new();
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private CreateCategoryDto createDto = new();
    private UpdateCategoryDto updateDto = new();
    private long editingId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;
            var tCat = CategoriaService.GetAllAsync();
            var tCatalogos = CatalogoService.GetAllAsync();
            await Task.WhenAll(tCat, tCatalogos);
            categorias = await tCat;
            catalogos = await tCatalogos;
        }
        catch (Exception ex) { errorMessage = $"Error al cargar datos: {ex.Message}"; }
        finally { loading = false; }
    }

    private string GetCatalogName(long catalogId)
        => catalogos.FirstOrDefault(c => c.CatalogId == catalogId)?.Name ?? catalogId.ToString();

    private void ShowCreateModal()
    {
        createDto = new CreateCategoryDto { CatalogId = catalogos.FirstOrDefault()?.CatalogId ?? 0 };
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private void ShowEditModal(CategoryDto cat)
    {
        updateDto = new UpdateCategoryDto
        {
            ParentCategoryId = cat.ParentCategoryId,
            Name = cat.Name,
            SortOrder = cat.SortOrder,
            Activo = cat.Activo
        };
        editingId = cat.CategoryId;
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private async Task CreateCategoria()
    {
        if (createDto.CatalogId == 0) return;
        try
        {
            saving = true;
            errorMessage = null;
            var response = await CategoriaService.CreateAsync(createDto);
            if (response.Success) { CloseCreateModal(); await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task UpdateCategoria()
    {
        try
        {
            saving = true;
            errorMessage = null;
            var response = await CategoriaService.UpdateAsync(editingId, updateDto);
            if (response.Success) { CloseEditModal(); await LoadData(); }
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task DeleteCategoria(CategoryDto cat)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar categoría '{cat.Name}'?")) return;
        try
        {
            var response = await CategoriaService.DeleteAsync(cat.CategoryId);
            if (response.Success) await LoadData();
            else errorMessage = response.Message;
        }
        catch (Exception ex) { errorMessage = $"Error al eliminar: {ex.Message}"; }
    }
}
