@page "/mdm/categorias"
@attribute [Authorize]
@inject CategoriaProductoHttpService CategoriaService
@inject IJSRuntime JS

<PageTitle>Categorías de Producto</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>?? Categorías de Producto</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nueva Categoría
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando categorías...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    else if (categorias.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay categorías registradas. Crea la primera categoría usando el botón "Nueva Categoría".
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in categorias)
                            {
                                <tr>
                                    <td>@cat.Id</td>
                                    <td><strong>@cat.Nombre</strong></td>
                                    <td>@cat.Descripcion</td>
                                    <td>
                                        @if (cat.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(cat)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCategoria(cat)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@* Modal Crear *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva Categoría</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="createDto.Nombre" placeholder="Ej: Electrónica" />
                            <ValidationMessage For="@(() => createDto.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea class="form-control" @bind-Value="createDto.Descripcion" rows="3" placeholder="Descripción opcional" />
                            <ValidationMessage For="@(() => createDto.Descripcion)" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Editar *@
@if (showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Categoría</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="UpdateCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="updateDto.Nombre" placeholder="Ej: Electrónica" />
                            <ValidationMessage For="@(() => updateDto.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea class="form-control" @bind-Value="updateDto.Descripcion" rows="3" placeholder="Descripción opcional" />
                            <ValidationMessage For="@(() => updateDto.Descripcion)" />
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="activoCheck" @bind-Value="updateDto.Activo" />
                            <label class="form-check-label" for="activoCheck">Activo</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaProductoDto> categorias = new();
    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private string? errorMessage;
    private CreateCategoriaProductoDto createDto = new();
    private UpdateCategoriaProductoDto updateDto = new();
    private int editingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategorias();
    }

    private async Task LoadCategorias()
    {
        try
        {
            loading = true;
            errorMessage = null;
            categorias = await CategoriaService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar categorías: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        createDto = new CreateCategoriaProductoDto();
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private void ShowEditModal(CategoriaProductoDto cat)
    {
        updateDto = new UpdateCategoriaProductoDto
        {
            Nombre = cat.Nombre,
            Descripcion = cat.Descripcion,
            Activo = cat.Activo
        };
        editingId = cat.Id;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task CreateCategoria()
    {
        try
        {
            saving = true;
            errorMessage = null;

            var response = await CategoriaService.CreateAsync(createDto);

            if (response.Success)
            {
                await JS.InvokeVoidAsync("alert", response.Message ?? "Categoría guardada exitosamente");
                CloseCreateModal();
                await LoadCategorias();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateCategoria()
    {
        try
        {
            saving = true;
            errorMessage = null;

            var response = await CategoriaService.UpdateAsync(editingId, updateDto);

            if (response.Success)
            {
                await JS.InvokeVoidAsync("alert", response.Message ?? "Categoría actualizada exitosamente");
                CloseEditModal();
                await LoadCategorias();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteCategoria(CategoriaProductoDto cat)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la categoría '{cat.Nombre}'?"))
            return;

        try
        {
            var response = await CategoriaService.DeleteAsync(cat.Id);
            if (response.Success)
            {
                await JS.InvokeVoidAsync("alert", "Categoría eliminada exitosamente");
                await LoadCategorias();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
    }
}
