@page "/"
@attribute [Authorize]
@inject DashboardDataService DashSvc

<PageTitle>Dashboard - AgoraHub360 ERP</PageTitle>

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard Ejecutivo</h1>
        <p class="text-muted mb-0">Control general · @DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh" disabled="@loading">
        <i class="bi @(loading ? "bi-arrow-repeat" : "bi-arrow-clockwise")"></i> Actualizar
    </button>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3 text-muted">Cargando indicadores...</p>
    </div>
}
else
{
    @* KPIs maestros *@
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Productos Activos</div>
                        <div class="stat-value">@mdm.ProductosActivos</div>
                        <small class="text-muted">@mdm.ClientesActivos clientes · @mdm.ProveedoresActivos proveedores</small>
                    </div>
                    <div class="stat-icon" style="background:rgba(245,158,11,.1);color:var(--agora-warning)">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Compras del Mes</div>
                        <div class="stat-value">@compras.TotalComprasMes.ToString("N0")</div>
                        <small class="text-muted">@compras.OcTotal OC · @compras.RecepcionesMes recepciones</small>
                    </div>
                    <div class="stat-icon" style="background:rgba(59,130,246,.1);color:var(--agora-info)">
                        <i class="bi bi-cart-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Movimientos Inventario (mes)</div>
                        <div class="stat-value">@inventario.MovimientosMes</div>
                        <small class="text-muted">@inventario.EntradaMes entradas · @inventario.SalidaMes salidas</small>
                    </div>
                    <div class="stat-icon" style="background:rgba(34,197,94,.1);color:var(--agora-success)">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Asientos del Mes</div>
                        <div class="stat-value">@contabilidad.AsientosMes</div>
                        <small class="text-muted">@contabilidad.AsientosContabilizados contabilizados · @contabilidad.AsientosBorrador borradores</small>
                    </div>
                    <div class="stat-icon" style="background:rgba(139,92,246,.1);color:#8b5cf6">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Flujo de Compras *@
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-diagram-3 me-1"></i>Flujo de Compras — Estado Actual</span>
                    <a href="/dashboard/compras" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                </div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col">
                            <a href="/compras/pedidos" class="text-decoration-none">
                                <div class="border rounded p-3 @(compras.OpPendienteAprobacion > 0 ? "border-warning bg-warning bg-opacity-10" : "")">
                                    <div class="fs-4 fw-bold @(compras.OpPendienteAprobacion > 0 ? "text-warning" : "text-muted")">
                                        @(compras.OpBorrador + compras.OpEnRevision + compras.OpPendienteAprobacion + compras.OpAprobadas)
                                    </div>
                                    <div class="small text-muted">Pedidos Internos</div>
                                    @if (compras.OpPendienteAprobacion > 0)
                                    {
                                        <span class="badge bg-warning text-dark mt-1">@compras.OpPendienteAprobacion pte. aprobación</span>
                                    }
                                </div>
                            </a>
                        </div>
                        <div class="col-auto d-flex align-items-center"><i class="bi bi-arrow-right text-muted fs-5"></i></div>
                        <div class="col">
                            <a href="/compras/ordenes" class="text-decoration-none">
                                <div class="border rounded p-3 @(compras.OcBorrador > 0 ? "border-info bg-info bg-opacity-10" : "")">
                                    <div class="fs-4 fw-bold text-primary">@compras.OcTotal</div>
                                    <div class="small text-muted">Órdenes de Compra</div>
                                    @if (compras.OcAprobadas > 0) { <span class="badge bg-success mt-1">@compras.OcAprobadas aprobadas</span> }
                                    @if (compras.OcBorrador > 0) { <span class="badge bg-secondary mt-1">@compras.OcBorrador borradores</span> }
                                </div>
                            </a>
                        </div>
                        <div class="col-auto d-flex align-items-center"><i class="bi bi-arrow-right text-muted fs-5"></i></div>
                        <div class="col">
                            <a href="/compras/recepciones" class="text-decoration-none">
                                <div class="border rounded p-3 @(compras.RecepcionesConDif > 0 ? "border-danger bg-danger bg-opacity-10" : "")">
                                    <div class="fs-4 fw-bold text-info">@compras.RecepcionesMes</div>
                                    <div class="small text-muted">Recepciones (mes)</div>
                                    @if (compras.RecepcionesConDif > 0) { <span class="badge bg-danger mt-1">@compras.RecepcionesConDif con diferencias</span> }
                                </div>
                            </a>
                        </div>
                        <div class="col-auto d-flex align-items-center"><i class="bi bi-arrow-right text-muted fs-5"></i></div>
                        <div class="col">
                            <a href="/compras/expedientes" class="text-decoration-none">
                                <div class="border rounded p-3 @(compras.ExpEnAduana > 0 ? "border-warning bg-warning bg-opacity-10" : "")">
                                    <div class="fs-4 fw-bold @(compras.ExpEnAduana > 0 ? "text-warning" : "text-muted")">
                                        @(compras.ExpEnTransito + compras.ExpEnAduana + compras.ExpLiberados)
                                    </div>
                                    <div class="small text-muted">Expedientes Activos</div>
                                    @if (compras.ExpEnTransito > 0) { <span class="badge bg-info text-dark mt-1">@compras.ExpEnTransito tránsito</span> }
                                    @if (compras.ExpEnAduana > 0) { <span class="badge bg-warning text-dark mt-1">@compras.ExpEnAduana aduana</span> }
                                </div>
                            </a>
                        </div>
                        <div class="col-auto d-flex align-items-center"><i class="bi bi-arrow-right text-muted fs-5"></i></div>
                        <div class="col">
                            <a href="/compras/importaciones" class="text-decoration-none">
                                <div class="border rounded p-3 @(compras.HojasNoLiquidadas > 0 ? "border-danger bg-danger bg-opacity-10" : "")">
                                    <div class="fs-4 fw-bold @(compras.HojasNoLiquidadas > 0 ? "text-danger" : "text-muted")">@compras.HojasNoLiquidadas</div>
                                    <div class="small text-muted">Hojas sin liquidar</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Alertas + Expedientes + Accesos *@
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header py-3"><i class="bi bi-bell-fill text-warning me-1"></i>Alertas y Pendientes</div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (compras.OpPendienteAprobacion > 0)
                        {
                            <li class="list-group-item list-group-item-warning px-3 py-2">
                                <a href="/compras/pedidos" class="text-decoration-none text-dark d-flex justify-content-between">
                                    <span><i class="bi bi-clipboard2-check me-2"></i><strong>@compras.OpPendienteAprobacion</strong> pedido(s) pte. aprobación</span>
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        @if (compras.OcBorrador > 0)
                        {
                            <li class="list-group-item px-3 py-2">
                                <a href="/compras/ordenes" class="text-decoration-none text-dark d-flex justify-content-between">
                                    <span><i class="bi bi-cart me-2 text-secondary"></i><strong>@compras.OcBorrador</strong> OC sin confirmar</span>
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        @if (compras.ExpEnAduana > 0)
                        {
                            <li class="list-group-item list-group-item-warning px-3 py-2">
                                <a href="/compras/expedientes" class="text-decoration-none text-dark d-flex justify-content-between">
                                    <span><i class="bi bi-building me-2"></i><strong>@compras.ExpEnAduana</strong> expediente(s) en aduana</span>
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        @if (compras.RecepcionesConDif > 0)
                        {
                            <li class="list-group-item list-group-item-danger px-3 py-2">
                                <a href="/compras/recepciones" class="text-decoration-none text-dark d-flex justify-content-between">
                                    <span><i class="bi bi-exclamation-triangle me-2"></i><strong>@compras.RecepcionesConDif</strong> recepción(es) con diferencias</span>
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        @if (contabilidad.AsientosBorrador > 0)
                        {
                            <li class="list-group-item px-3 py-2">
                                <a href="/contabilidad/asientos" class="text-decoration-none text-dark d-flex justify-content-between">
                                    <span><i class="bi bi-journal-text me-2 text-secondary"></i><strong>@contabilidad.AsientosBorrador</strong> asiento(s) sin contabilizar</span>
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        @if (compras.HojasNoLiquidadas > 0)
                        {
                            <li class="list-group-item list-group-item-danger px-3 py-2">
                                <a href="/compras/importaciones" class="text-decoration-none text-dark d-flex justify-content-between">
                                    <span><i class="bi bi-receipt-cutoff me-2"></i><strong>@compras.HojasNoLiquidadas</strong> hoja(s) sin liquidar</span>
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        @if (!HayAlertas)
                        {
                            <li class="list-group-item text-center text-muted py-4">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                <p class="mb-0 mt-2 small">Sin alertas pendientes</p>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-globe-americas me-1"></i>Expedientes Activos</span>
                    <a href="/compras/expedientes" class="btn btn-sm btn-link py-0">Ver todos</a>
                </div>
                <div class="card-body p-0">
                    @if (compras.ExpedientesActivos.Count == 0)
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-ship fs-4 d-block mb-2"></i>Sin expedientes activos
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var exp in compras.ExpedientesActivos)
                            {
                                <li class="list-group-item px-3 py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong class="small">@exp.Numero</strong>
                                            <div class="text-muted" style="font-size:.75rem">
                                                @(exp.PaisOrigen ?? "—") ? @(exp.PuertoDestino ?? "—")
                                                @if (exp.ETA.HasValue) { <span> · ETA @exp.ETA.Value.ToString("dd/MM")</span> }
                                            </div>
                                        </div>
                                        <span class="badge @GetExpBadge(exp.Estado)" style="font-size:.7rem">@GetExpLabel(exp.Estado)</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header py-3"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Accesos Rápidos</div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Dashboards por módulo</p>
                    <div class="d-grid gap-2 mb-3">
                        <a href="/dashboard/compras" class="btn btn-outline-primary btn-sm text-start"><i class="bi bi-cart-check-fill me-2"></i>Dashboard Compras</a>
                        <a href="/dashboard/inventario" class="btn btn-outline-success btn-sm text-start"><i class="bi bi-box-seam-fill me-2"></i>Dashboard Inventario</a>
                        <a href="/dashboard/contabilidad" class="btn btn-outline-secondary btn-sm text-start"><i class="bi bi-journal-bookmark-fill me-2"></i>Dashboard Contabilidad</a>
                    </div>
                    <p class="text-muted small mb-2">Acciones frecuentes</p>
                    <div class="d-grid gap-2">
                        <a href="/compras/pedidos" class="btn btn-light btn-sm text-start border"><i class="bi bi-plus-circle me-2 text-primary"></i>Nuevo Pedido Interno</a>
                        <a href="/compras/ordenes" class="btn btn-light btn-sm text-start border"><i class="bi bi-plus-circle me-2 text-primary"></i>Nueva Orden de Compra</a>
                        <a href="/contabilidad/asientos" class="btn btn-light btn-sm text-start border"><i class="bi bi-plus-circle me-2 text-primary"></i>Nuevo Asiento Contable</a>
                        <a href="/inventario/movimientos" class="btn btn-light btn-sm text-start border"><i class="bi bi-plus-circle me-2 text-primary"></i>Registrar Movimiento</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Últimas recepciones *@
    @if (compras.UltimasRecepciones.Count > 0)
    {
        <div class="row g-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-box-seam me-1"></i>Últimas Recepciones</span>
                        <a href="/compras/recepciones" class="btn btn-sm btn-link">Ver todas</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Número</th><th>Fecha</th><th>OC Origen</th><th>Almacén</th><th>Diferencias</th><th>Cuarentena</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in compras.UltimasRecepciones)
                                {
                                    <tr>
                                        <td><strong>@r.Numero</strong></td>
                                        <td>@r.FechaRecepcion.ToString("dd/MM/yyyy")</td>
                                        <td>@r.OrdenCompraNumero</td>
                                        <td>@r.AlmacenNombre</td>
                                        <td>@if (r.TieneDiferencias) { <span class="badge bg-danger">@(r.TipoDiferencia ?? "Diferencias")</span> } else { <span class="badge bg-success">OK</span> }</td>
                                        <td>@if (r.EnCuarentena) { <span class="badge bg-warning text-dark">Cuarentena</span> } else { <span class="text-muted small">—</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool loading = true;
    private ComprasKpis compras = new();
    private InventarioKpis inventario = new();
    private ContabilidadKpis contabilidad = new();
    private MdmKpis mdm = new();

    private bool HayAlertas =>
        compras.OpPendienteAprobacion > 0 || compras.OcBorrador > 0 ||
        compras.ExpEnAduana > 0 || compras.RecepcionesConDif > 0 ||
        contabilidad.AsientosBorrador > 0 || compras.HojasNoLiquidadas > 0;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        loading = true;
        try
        {
            var result = await DashSvc.GetAllKpisAsync();
            compras      = result.Compras;
            inventario   = result.Inventario;
            contabilidad = result.Contabilidad;
            mdm          = result.Mdm;
        }
        catch { }
        finally { loading = false; }
    }

    private static string GetExpBadge(string estado) => estado switch
    {
        "EnTransito"        => "bg-info text-dark",
        "Arribado"          => "bg-primary",
        "EnAduana"          => "bg-warning text-dark",
        "ObservacionAduana" => "bg-danger",
        _                   => "bg-secondary"
    };

    private static string GetExpLabel(string estado) => estado switch
    {
        "EnTransito"        => "En Tránsito",
        "EnAduana"          => "En Aduana",
        "ObservacionAduana" => "Obs. Aduana",
        _                   => estado
    };
}
