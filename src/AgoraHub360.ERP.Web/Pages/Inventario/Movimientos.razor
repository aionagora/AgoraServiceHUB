@page "/inventario/movimientos"
@attribute [Authorize]
@inject MovimientoInventarioHttpService InvService
@inject AlmacenHttpService AlmacenService
@inject ProductoHttpService ProductoService
@inject IJSRuntime JS

<PageTitle>Movimientos de Inventario - AgoraHub360 ERP</PageTitle>

<div class="page-header">
    <h1>Movimientos de Inventario</h1>
    <p class="text-muted mb-0">Inventario &rsaquo; Movimientos</p>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-1 small">Tipo</label>
                <select class="form-select form-select-sm" @bind="filtroTipo">
                    <option value="">Todos</option>
                    <option value="Entrada">Entrada</option>
                    <option value="Salida">Salida</option>
                    <option value="Ajuste">Ajuste</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 small">Almacen</label>
                <select class="form-select form-select-sm" @bind="filtroAlmacenId">
                    <option value="0">Todos</option>
                    @foreach (var alm in almacenes)
                    {
                        <option value="@alm.Id">@alm.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 small">Desde</label>
                <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 small">Hasta</label>
                <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
            </div>
            <div class="col-md-auto">
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadData">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
            </div>
            <div class="col-md-auto ms-auto">
                <button class="btn btn-sm btn-primary" @onclick="ShowCreateModal">
                    <i class="bi bi-plus-circle"></i> Nuevo Movimiento
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de movimientos -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <span>Historial de Movimientos <span class="badge bg-secondary ms-1">@movimientos.Count</span></span>
    </div>
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Cargando movimientos...</p>
            </div>
        }
        else if (movimientos.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size:2.5rem; color:var(--agora-text-light);"></i>
                <p class="text-muted mt-3">No hay movimientos registrados.</p>
                <button class="btn btn-primary btn-sm" @onclick="ShowCreateModal">
                    <i class="bi bi-plus-circle"></i> Registrar primer movimiento
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Numero</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Producto</th>
                            <th>Almacen</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Costo Unit.</th>
                            <th class="text-end">Total</th>
                            <th>Referencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mov in movimientos)
                        {
                            <tr>
                                <td><code class="small">@mov.Numero</code></td>
                                <td>@mov.FechaMovimiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @GetBadgeClass(mov.TipoMovimiento)">
                                        @GetTipoIcon(mov.TipoMovimiento) @mov.TipoMovimiento
                                    </span>
                                </td>
                                <td>
                                    <code class="small">@mov.ProductoCodigo</code>
                                    <span class="ms-1">@mov.ProductoNombre</span>
                                </td>
                                <td>
                                    @mov.AlmacenNombre
                                    @if (!string.IsNullOrEmpty(mov.AlmacenDestinoNombre))
                                    {
                                        <span class="text-muted"> &rarr; @mov.AlmacenDestinoNombre</span>
                                    }
                                </td>
                                <td class="text-end fw-bold">@mov.Cantidad.ToString("N4")</td>
                                <td class="text-end">@mov.CostoUnitario.ToString("N4")</td>
                                <td class="text-end">@mov.CostoTotal.ToString("N2")</td>
                                <td><small class="text-muted">@mov.Referencia</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Nuevo Movimiento -->
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>Nuevo Movimiento de Inventario</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="CreateMovimiento">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small" />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tipo de Movimiento *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.TipoMovimiento">
                                    <option value="Entrada">Entrada</option>
                                    <option value="Salida">Salida</option>
                                    <option value="Ajuste">Ajuste</option>
                                    <option value="Transferencia">Transferencia</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fecha *</label>
                                <InputDate class="form-control" @bind-Value="createDto.FechaMovimiento" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Referencia</label>
                                <InputText class="form-control" @bind-Value="createDto.Referencia" placeholder="OC-001, FAC-001..." />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Producto *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.ProductoId">
                                    <option value="0">-- Seleccione producto --</option>
                                    @foreach (var p in productos)
                                    {
                                        <option value="@p.Id">[@p.Codigo] @p.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => createDto.ProductoId)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Almacen Origen *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.AlmacenId">
                                    <option value="0">-- Seleccione almacen --</option>
                                    @foreach (var alm in almacenes)
                                    {
                                        <option value="@alm.Id">@alm.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => createDto.AlmacenId)" />
                            </div>
                        </div>

                        @if (createDto.TipoMovimiento == "Transferencia")
                        {
                            <div class="mb-3">
                                <label class="form-label">Almacen Destino *</label>
                                <InputSelect class="form-select" @bind-Value="createDto.AlmacenDestinoId">
                                    <option value="">-- Seleccione almacen destino --</option>
                                    @foreach (var alm in almacenes.Where(a => a.Id != createDto.AlmacenId))
                                    {
                                        <option value="@alm.Id">@alm.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Cantidad *</label>
                                <InputNumber class="form-control" @bind-Value="createDto.Cantidad" />
                                <ValidationMessage For="@(() => createDto.Cantidad)" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">
                                    Costo Unitario
                                    @if (createDto.TipoMovimiento == "Salida" || createDto.TipoMovimiento == "Transferencia")
                                    {
                                        <small class="text-muted ms-1">(costo promedio auto)</small>
                                    }
                                </label>
                                <InputNumber class="form-control"
                                             @bind-Value="createDto.CostoUnitario"
                                             disabled="@(createDto.TipoMovimiento == "Salida" || createDto.TipoMovimiento == "Transferencia")" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Observaciones</label>
                                <InputText class="form-control" @bind-Value="createDto.Observaciones" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Registrar Movimiento
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MovimientoInventarioDto> movimientos = new();
    private List<AlmacenDto> almacenes = new();
    private List<ProductoDto> productos = new();

    private bool loading = true;
    private bool saving = false;
    private bool showCreateModal = false;
    private string? errorMessage;
    private string? successMessage;

    private string filtroTipo = "";
    private int filtroAlmacenId = 0;
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;

    private CreateMovimientoInventarioDto createDto = new();

    protected override async Task OnInitializedAsync()
    {
        var almTask = AlmacenService.GetAllAsync();
        var prodTask = ProductoService.GetAllAsync();
        await Task.WhenAll(almTask, prodTask);
        almacenes = await almTask;
        productos = await prodTask;
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        errorMessage = null;
        try
        {
            movimientos = await InvService.GetMovimientosAsync(
                almacenId: filtroAlmacenId > 0 ? filtroAlmacenId : null,
                tipo: string.IsNullOrEmpty(filtroTipo) ? null : filtroTipo,
                desde: filtroDesde,
                hasta: filtroHasta);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar movimientos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        if (productos.Count == 0 || almacenes.Count == 0)
        {
            errorMessage = "Debe tener productos y almacenes registrados para registrar movimientos.";
            return;
        }
        createDto = new CreateMovimientoInventarioDto { FechaMovimiento = DateTime.Today };
        showCreateModal = true;
    }

    private void CloseModal() => showCreateModal = false;

    private async Task CreateMovimiento()
    {
        saving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var response = await InvService.CreateAsync(createDto);
            if (response.Success)
            {
                successMessage = $"Movimiento {response.Data?.Numero} registrado exitosamente.";
                CloseModal();
                await LoadData();
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private static string GetBadgeClass(string tipo) => tipo switch
    {
        "Entrada"       => "bg-success",
        "Salida"        => "bg-danger",
        "Ajuste"        => "bg-warning text-dark",
        "Transferencia" => "bg-info text-dark",
        _               => "bg-secondary"
    };

    private static string GetTipoIcon(string tipo) => tipo switch
    {
        "Entrada"       => "↑",
        "Salida"        => "↓",
        "Ajuste"        => "±",
        "Transferencia" => "⇄",
        _               => ""
    };
}
