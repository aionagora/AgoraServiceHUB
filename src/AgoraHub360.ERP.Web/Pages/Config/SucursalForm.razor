@using AgoraHub360.ERP.Shared.DTOs.Sucursal
@using AgoraHub360.ERP.Shared.DTOs.Empresa
@inject EmpresaHttpService EmpresaSvc

@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditId.HasValue ? "Editar Sucursal" : "Nueva Sucursal")</h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync"></button>
                </div>
                @if (!EditId.HasValue)
                {
                    <EditForm Model="_createModel" OnValidSubmit="HandleValidSubmitAsync">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Empresa *</label>
                                <InputSelect class="form-select" @bind-Value="_createModel.EmpresaId">
                                    <option value="0">— Seleccionar Empresa —</option>
                                    @foreach (var emp in Empresas)
                                    {
                                        <option value="@emp.Id">@emp.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _createModel.EmpresaId" />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Nombre *</label>
                                    <InputText class="form-control" @bind-Value="_createModel.Nombre" />
                                    <ValidationMessage For="() => _createModel.Nombre" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">C&oacute;digo</label>
                                    <InputText class="form-control" @bind-Value="_createModel.Codigo" />
                                    <ValidationMessage For="() => _createModel.Codigo" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Direcci&oacute;n</label>
                                <InputText class="form-control" @bind-Value="_createModel.Direccion" />
                                <ValidationMessage For="() => _createModel.Direccion" />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Ciudad</label>
                                    <InputText class="form-control" @bind-Value="_createModel.Ciudad" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Tel&eacute;fono</label>
                                    <InputText class="form-control" @bind-Value="_createModel.Telefono" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Email</label>
                                    <InputText class="form-control" @bind-Value="_createModel.Email" />
                                    <ValidationMessage For="() => _createModel.Email" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" @bind-Value="_createModel.EsCentral" id="chkEsCentral_c" />
                                        <label class="form-check-label" for="chkEsCentral_c">Es Central (Principal)</label>
                                    </div>
                                    <small class="text-muted d-block">Establecer esta sucursal como casa matriz de la empresa seleccionada.</small>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@Saving">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Crear Sucursal
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="_updateModel" OnValidSubmit="HandleValidSubmitAsync">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Nombre *</label>
                                    <InputText class="form-control" @bind-Value="_updateModel.Nombre" />
                                    <ValidationMessage For="() => _updateModel.Nombre" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">C&oacute;digo</label>
                                    <InputText class="form-control" @bind-Value="_updateModel.Codigo" />
                                    <ValidationMessage For="() => _updateModel.Codigo" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Direcci&oacute;n</label>
                                <InputText class="form-control" @bind-Value="_updateModel.Direccion" />
                                <ValidationMessage For="() => _updateModel.Direccion" />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Ciudad</label>
                                    <InputText class="form-control" @bind-Value="_updateModel.Ciudad" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Tel&eacute;fono</label>
                                    <InputText class="form-control" @bind-Value="_updateModel.Telefono" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Email</label>
                                    <InputText class="form-control" @bind-Value="_updateModel.Email" />
                                    <ValidationMessage For="() => _updateModel.Email" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" @bind-Value="_updateModel.EsCentral" id="chkEsCentral_u" />
                                        <label class="form-check-label" for="chkEsCentral_u">Es Central (Principal)</label>
                                    </div>
                                    <small class="text-muted d-block">Establecer esta sucursal como casa matriz de la empresa seleccionada.</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" @bind-Value="_updateModel.Activo" id="chkActivo_u" />
                                        <label class="form-check-label" for="chkActivo_u">Activa</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@Saving">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar Cambios
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int? EditId { get; set; }
    [Parameter] public int? DefaultEmpresaId { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    [Parameter] public EventCallback<(bool esEdit, object dto)> OnSave { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public List<EmpresaDto> Empresas { get; set; } = new();

    private CrearSucursalDto _createModel = new();
    private ActualizarSucursalDto _updateModel = new();

    private bool _wasShown = false;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown && !EditId.HasValue)
        {
            // Initializing new model with the selected EmpresaId from the main view
            _createModel = new CrearSucursalDto { Activo = true, EmpresaId = DefaultEmpresaId ?? 0 };
        }
        _wasShown = Show;
    }

    public void LoadForEdit(SucursalDto sucursal)
    {
        _updateModel = new ActualizarSucursalDto
        {
            Nombre = sucursal.Nombre,
            Codigo = sucursal.Codigo,
            Direccion = sucursal.Direccion,
            Ciudad = sucursal.Ciudad,
            Telefono = sucursal.Telefono,
            Email = sucursal.Email,
            EsCentral = sucursal.EsCentral,
            Activo = sucursal.Activo
        };
        StateHasChanged();
    }

    private object Model => EditId.HasValue ? _updateModel : _createModel;

    private async Task HandleValidSubmitAsync()
    {
        await OnSave.InvokeAsync((EditId.HasValue, Model));
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync(false);
    }
}
