@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int? EditId { get; set; }
    [Parameter] public int? DefaultEmpresaId { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    [Parameter] public EventCallback<(bool esEdit, object dto)> OnSave { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public List<EmpresaDto> Empresas { get; set; } = new();

    private CrearSucursalDto _createModel = new();
    private ActualizarSucursalDto _updateModel = new();

    private bool _wasShown = false;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown && !EditId.HasValue)
        {
            // Initializing new model with the selected EmpresaId from the main view
            _createModel = new CrearSucursalDto { Activo = true, EmpresaId = DefaultEmpresaId ?? 0 };
        }
        _wasShown = Show;
    }

    public void LoadForEdit(SucursalDto sucursal)
    {
        _updateModel = new ActualizarSucursalDto
        {
            Nombre = sucursal.Nombre,
            Codigo = sucursal.Codigo,
            CodigoInterno = sucursal.CodigoInterno,
            Sigla = sucursal.Sigla,
            Descripcion = sucursal.Descripcion,
            Pais = sucursal.Pais,
            Departamento = sucursal.Departamento,
            Provincia = sucursal.Provincia,
            Zona = sucursal.Zona,
            Referencia = sucursal.Referencia,
            Latitud = sucursal.Latitud,
            Longitud = sucursal.Longitud,
            UrlMapa = sucursal.UrlMapa,
            Direccion = sucursal.Direccion,
            Ciudad = sucursal.Ciudad,
            ResponsableNombre = sucursal.ResponsableNombre,
            ResponsableCargo = sucursal.ResponsableCargo,
            Celular = sucursal.Celular,
            WhatsApp = sucursal.WhatsApp,
            EmailAlternativo = sucursal.EmailAlternativo,
            Telefono = sucursal.Telefono,
            Email = sucursal.Email,
            EsCentral = sucursal.EsCentral,
            PermiteVentas = sucursal.PermiteVentas,
            PermiteCompras = sucursal.PermiteCompras,
            PermiteInventario = sucursal.PermiteInventario,
            PermiteDespacho = sucursal.PermiteDespacho,
            PermiteFacturacion = sucursal.PermiteFacturacion,
            ManejaAlmacen = sucursal.ManejaAlmacen,
            CodigoSucursalFiscal = sucursal.CodigoSucursalFiscal,
            PrefijoDocumental = sucursal.PrefijoDocumental,
            Observaciones = sucursal.Observaciones,
            Activo = sucursal.Activo
        };
        StateHasChanged();
    }

    private object Model => EditId.HasValue ? _updateModel : _createModel;

    private async Task HandleValidSubmitAsync()
    {
        await OnSave.InvokeAsync((EditId.HasValue, Model));
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync(false);
    }
}
