    // Moneda Base
    // ══════════════════════════════════════════════════

    private async Task GuardarMonedaAsync()
    {
        if (!_puedeAccederSeccion)
            return;

        if (_empresa is null || _monedaSeleccionada == _empresa.MonedaBaseId) return;
        _savingMoneda = true;
        try
        {
            var updateDto = new UpdateEmpresaDto
            {
                Nombre = _empresa.Nombre,
                NIT = _empresa.NIT,
                Direccion = _empresa.Direccion,
                Telefono = _empresa.Telefono,
                Email = _empresa.Email,
                MonedaBaseId = _monedaSeleccionada,
                Activo = _empresa.Activo
            };
            var result = await EmpresaSvc.UpdateAsync(_empresa.Id, updateDto);
            if (result.Success)
            {
                _empresa.MonedaBaseId = _monedaSeleccionada;
                _mensaje = $"Moneda base actualizada a {_monedaSeleccionada}.";
                _esError = false;
            }
            else { _mensaje = result.Message; _esError = true; }
        }
        catch { _mensaje = "Error al actualizar la moneda base."; _esError = true; }
        _savingMoneda = false;
    }

