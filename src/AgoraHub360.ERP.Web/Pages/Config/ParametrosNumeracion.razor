    /// <summary>Inicializa las series base comunes de un ERP.</summary>
    private async Task InicializarSeriesBase()
    {
        if (!_puedeAccederSeccion)
            return;

        _saving = true;
        var series = new[]
        {
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "OC",  Descripcion = "Orden de Compra",          Prefijo = "OC-",  SiguienteNumero = 1, LongitudNumero = 6 },
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "REC", Descripcion = "Recepción de Mercadería",  Prefijo = "REC-", SiguienteNumero = 1, LongitudNumero = 6 },
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "FAC", Descripcion = "Factura de Venta",         Prefijo = "FAC-", SiguienteNumero = 1, LongitudNumero = 6 },
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "PED", Descripcion = "Pedido de Venta",          Prefijo = "PED-", SiguienteNumero = 1, LongitudNumero = 6 },
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "NC",  Descripcion = "Nota de Crédito",          Prefijo = "NC-",  SiguienteNumero = 1, LongitudNumero = 6 },
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "ND",  Descripcion = "Nota de Débito",           Prefijo = "ND-",  SiguienteNumero = 1, LongitudNumero = 6 },
            new CrearNumeracionDocumentoRequestDto { TipoDocumento = "MOV", Descripcion = "Movimiento de Inventario", Prefijo = "MOV-", SiguienteNumero = 1, LongitudNumero = 6 },
        };

        var errores = 0;
        foreach (var serie in series)
        {
            try
            {
                var result = await NumSvc.CreateAsync(serie);
                if (!result.Success) errores++;
            }
            catch { errores++; }
        }

        _mensaje = errores == 0
            ? $"{series.Length} series base inicializadas exitosamente."
            : $"Se crearon {series.Length - errores} series, {errores} ya existían o fallaron.";
        _esError = errores > 0;

        _numeraciones = await NumSvc.GetAllAsync();
        _saving = false;
    }

