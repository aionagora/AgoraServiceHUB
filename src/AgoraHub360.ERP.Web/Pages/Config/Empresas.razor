@page "/config/empresas"
@attribute [Authorize]
@inject EmpresaHttpService EmpresaSvc
@inject EmpresaStateService EmpresaState
@inject SesionUsuarioStateService SesionState
@inject UiAuthorizationService UiAuth

<PageTitle>Empresas - AgoraHub360 ERP</PageTitle>

<div class="page-header">
    <h1>Empresas</h1>
    <p class="text-muted mb-0">Sistema &rsaquo; Empresas</p>
</div>

@if (!string.IsNullOrEmpty(_mensaje))
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @_mensaje
        <button type="button" class="btn-close" @onclick="() => _mensaje = null"></button>
    </div>
}

<!-- Listado -->
@if (!_puedeAccederSeccion)
{
    <div class="alert alert-warning" role="alert">
        No tienes permisos para acceder a esta sección.
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
            <span>
                @if (_esModoGlobal)
                {
                    <span>Empresas globales (@_empresas.Count)</span>
                }
                else
                {
                    <span>Empresas de mi tenant (@_empresas.Count)</span>
                }
            </span>
            @if (_puedeCrearEmpresa)
            {
                <button class="btn btn-primary btn-sm" @onclick="ShowCrear">
                    <i class="bi bi-plus-circle me-1"></i> Nueva Empresa
                </button>
            }
        </div>

        @if (_loading)
        {
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Cargando empresas...</p>
            </div>
        }
        else if (_empresas.Count == 0)
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-building" style="font-size: 3rem; color: var(--agora-text-light);"></i>
                <p class="text-muted mt-3">No hay empresas registradas.</p>
                @if (_puedeCrearEmpresa)
                {
                    <button class="btn btn-primary btn-sm" @onclick="ShowCrear">
                        <i class="bi bi-plus-circle me-1"></i> Crear primera empresa
                    </button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>NIT</th>
                        <th>Email</th>
                        <th>Telefono</th>
                        <th>Moneda</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in _empresas)
                    {
                        <tr>
                            <td class="fw-semibold">@emp.Nombre</td>
                            <td>@(emp.NIT ?? "—")</td>
                            <td>@(emp.Email ?? "—")</td>
                            <td>@(emp.Telefono ?? "—")</td>
                            <td>@(emp.MonedaBaseId ?? "—")</td>
                            <td class="text-center">
                                @if (emp.Activo)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (_puedeAdministrarEmpresas)
                                {
                                    <button class="btn btn-outline-success btn-sm me-1"
                                            @onclick="() => GenerarParametrosBasicosAsync(emp)" title="Generar parámetros básicos"
                                            disabled="@_saving">
                                        <i class="bi bi-gear-wide-connected"></i>
                                    </button>
                                    <button class="btn btn-outline-primary btn-sm me-1"
                                            @onclick="() => ShowEditar(emp)" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ConfirmDelete(emp)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
        </div>
}

<!-- Modal Crear/Editar -->
@if (_showForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editId.HasValue ? "Editar Empresa" : "Nueva Empresa")</h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="_formModel.Nombre" />
                            <ValidationMessage For="() => _formModel.Nombre" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="_formModel.NIT" />
                                <ValidationMessage For="() => _formModel.NIT" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Moneda Base</label>
                                <InputSelect class="form-select" @bind-Value="_formModel.MonedaBaseId">
                                    <option value="">— Seleccionar —</option>
                                    <option value="BOB">BOB - Boliviano</option>
                                    <option value="USD">USD - Dolar</option>
                                    <option value="EUR">EUR - Euro</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Direccion</label>
                            <InputText class="form-control" @bind-Value="_formModel.Direccion" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Telefono</label>
                                <InputText class="form-control" @bind-Value="_formModel.Telefono" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="_formModel.Email" />
                                <ValidationMessage For="() => _formModel.Email" />
                            </div>
                        </div>
                        @if (_editId.HasValue)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_formActivo" />
                                <label class="form-check-label">Activa</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(_editId.HasValue ? "Guardar Cambios" : "Crear Empresa")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal Confirmar Eliminacion -->
@if (_deleteTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminacion</h5>
                    <button type="button" class="btn-close" @onclick="() => _deleteTarget = null"></button>
                </div>
                <div class="modal-body">
                    <p>Eliminar la empresa <strong>@_deleteTarget.Nombre</strong>?</p>
                    <p class="text-muted small">Esta accion no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deleteTarget = null">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmpresaDto> _empresas = new();
    private bool _loading = true;
    private bool _saving;
    private string? _mensaje;
    private bool _esError;
    private bool _puedeAccederSeccion;
    private bool _esModoGlobal;
    private bool _puedeAdministrarEmpresas;
    private bool _puedeCrearEmpresa;

    // Form
    private bool _showForm;
    private int? _editId;
    private CreateEmpresaDto _formModel = new();
    private bool _formActivo = true;

    // Delete
    private EmpresaDto? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        _esModoGlobal = UiAuth.IsPlatformAdmin;
        _puedeAccederSeccion = UiAuth.IsPlatformAdmin || UiAuth.IsTenantAdmin;
        _puedeAdministrarEmpresas = UiAuth.CanManageEmpresas();
        _puedeCrearEmpresa = UiAuth.CanCreateEmpresa();

        if (!_puedeAccederSeccion)
        {
            _loading = false;
            return;
        }

        if (!_esModoGlobal && !SesionState.HasTenantSelected)
        {
            _mensaje = "Selecciona una empresa activa para continuar.";
            _esError = true;
            _loading = false;
            return;
        }

        await LoadEmpresasAsync();
    }

    private async Task LoadEmpresasAsync()
    {
        _loading = true;
        try
        {
            _empresas = _esModoGlobal
                ? await EmpresaSvc.GetAllAsync()
                : await EmpresaSvc.GetMisEmpresasAsync();

            EmpresaState.SetEmpresas(_empresas);
        }
        catch
        {
            _mensaje = "Error al cargar empresas. Verifique la conexion con la API.";
            _esError = true;
        }
        _loading = false;
    }

    private void ShowCrear()
    {
        if (!_puedeCrearEmpresa)
            return;

        _editId = null;
        _formModel = new CreateEmpresaDto { MonedaBaseId = "BOB" };
        _formActivo = true;
        _showForm = true;
    }

    private void ShowEditar(EmpresaDto emp)
    {
        if (!_puedeAdministrarEmpresas)
            return;

        _editId = emp.Id;
        _formModel = new CreateEmpresaDto
        {
            Nombre = emp.Nombre,
            NIT = emp.NIT,
            Direccion = emp.Direccion,
            Telefono = emp.Telefono,
            Email = emp.Email,
            MonedaBaseId = emp.MonedaBaseId
        };
        _formActivo = emp.Activo;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _editId = null;
    }

    private async Task SaveAsync()
    {
        if (!_puedeAdministrarEmpresas && !_puedeCrearEmpresa)
            return;

        _saving = true;
        try
        {
            if (!_puedeAdministrarEmpresas && _editId.HasValue)
            {
                _mensaje = "No tienes permisos para acceder a esta sección.";
                _esError = true;
                _saving = false;
                return;
            }

            if (!_puedeCrearEmpresa && !_editId.HasValue)
            {
                _mensaje = "No tienes permisos para acceder a esta sección.";
                _esError = true;
                _saving = false;
                return;
            }

            if (_editId.HasValue)
            {
                var updateDto = new UpdateEmpresaDto
                {
                    Nombre = _formModel.Nombre,
                    NIT = _formModel.NIT,
                    Direccion = _formModel.Direccion,
                    Telefono = _formModel.Telefono,
                    Email = _formModel.Email,
                    MonedaBaseId = _formModel.MonedaBaseId,
                    Activo = _formActivo
                };
                var result = await EmpresaSvc.UpdateAsync(_editId.Value, updateDto);
                if (result.Success)
                {
                    _mensaje = "Empresa actualizada exitosamente.";
                    _esError = false;
                }
                else
                {
                    _mensaje = SanitizeError(result.Message, "No se pudo actualizar la empresa.");
                    _esError = true;
                    _saving = false;
                    return;
                }
            }
            else
            {
                var result = await EmpresaSvc.CreateAsync(_formModel);
                if (result.Success)
                {
                    _mensaje = "Empresa creada exitosamente.";
                    _esError = false;
                }
                else
                {
                    _mensaje = SanitizeError(result.Message, "No se pudo crear la empresa.");
                    _esError = true;
                    _saving = false;
                    return;
                }
            }

            CloseForm();
            await LoadEmpresasAsync();
        }
        catch
        {
            _mensaje = "Error de comunicacion con el servidor.";
            _esError = true;
        }
        _saving = false;
    }

    private void ConfirmDelete(EmpresaDto emp)
    {
        if (!_puedeAdministrarEmpresas)
            return;

        _deleteTarget = emp;
    }

    private async Task DeleteAsync()
    {
        if (!_puedeAdministrarEmpresas)
            return;

        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            var result = await EmpresaSvc.DeleteAsync(_deleteTarget.Id);
            if (result.Success)
            {
                _mensaje = "Empresa eliminada exitosamente.";
                _esError = false;
            }
            else
            {
                _mensaje = SanitizeError(result.Message, "No se pudo eliminar la empresa.");
                _esError = true;
            }
            _deleteTarget = null;
            await LoadEmpresasAsync();
        }
        catch
        {
            _mensaje = "Error de comunicacion con el servidor.";
            _esError = true;
        }
        _saving = false;
    }

    private async Task GenerarParametrosBasicosAsync(EmpresaDto empresa)
    {
        if (!_puedeAdministrarEmpresas)
            return;

        _saving = true;
        try
        {
            var result = await EmpresaSvc.GenerarConfiguracionBasicaAsync(empresa.Id);
            if (result.Success && result.Data is not null)
            {
                var data = result.Data;
                _mensaje =
                    $"Configuración básica generada para '{empresa.Nombre}'. " +
                    $"Parámetros: {data.ParametrosCreados}/{data.ParametrosExistentes}, " +
                    $"Numeraciones: {data.NumeracionesCreadas}/{data.NumeracionesExistentes}, " +
                    $"Catálogos: {data.CatalogosCreados}/{data.CatalogosExistentes}.";
                _esError = false;
            }
            else
            {
                _mensaje = SanitizeError(result.Message, "No se pudo generar la configuración básica.");
                _esError = true;
            }
        }
        catch
        {
            _mensaje = "Error de comunicación con el servidor.";
            _esError = true;
        }
        _saving = false;
    }

    private static string SanitizeError(string? message, string fallback)
    {
        if (string.IsNullOrWhiteSpace(message))
            return fallback;

        if (message.Contains("Error HTTP", StringComparison.OrdinalIgnoreCase)
            || message.Contains("System.", StringComparison.OrdinalIgnoreCase)
            || message.Contains("stack", StringComparison.OrdinalIgnoreCase)
            || message.Contains("trace", StringComparison.OrdinalIgnoreCase)
            || message.Contains("Exception", StringComparison.OrdinalIgnoreCase)
            || message.Contains("{"))
        {
            return fallback;
        }

        return message;
    }
}
