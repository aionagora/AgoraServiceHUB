@page "/config/empresas"

<PageTitle>Empresas - AgoraHub360 ERP</PageTitle>

<div class="page-header">
    <h1>Empresas</h1>
    <p class="text-muted mb-0">Sistema &rsaquo; Empresas</p>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <span>Listado de Empresas</span>
        <button class="btn btn-primary btn-sm" disabled>
            <i class="bi bi-plus-circle me-1"></i> Nueva Empresa
        </button>
    </div>
    <div class="card-body text-center py-5">
        <i class="bi bi-building" style="font-size: 3rem; color: var(--agora-text-light);"></i>
        <p class="text-muted mt-3">Modulo en construccion.</p>
    </div>
</div>
