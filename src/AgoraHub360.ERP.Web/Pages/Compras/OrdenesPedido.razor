        hrFormAlmacenDestino   = 0;
        hrFormProveedorCliente = null;
        hrFormFechaDocumento   = DateTime.Today;
        hrFormETA              = null;
        hrFormObservaciones    = null;
        hrError                = null;
        showCrearHrModal       = true;
    }

    private void ConfirmDeleteHr(HojaRutaDto hr) => hrAEliminar = hr;

    private async Task SaveCrearHr()
    {
        if (hrFormAlmacenOrigen == 0) { hrError = "Seleccione el almacén de origen."; return; }
        hrSaving = true; hrError = null;
        StateHasChanged();
        try
        {
            var dto = new CreateHojaRutaDto
            {
                TipoOP           = hrFormTipoOP,
                SubTipo          = hrFormSubTipo,
                AlmacenOrigenId  = hrFormAlmacenOrigen,
                AlmacenDestinoId = hrFormAlmacenDestino > 0 ? hrFormAlmacenDestino : null,
                ProveedorCliente = hrFormProveedorCliente,
                FechaDocumento   = hrFormFechaDocumento,
                ETA              = hrFormETA,
                Observaciones    = hrFormObservaciones,
                OrdenPedidoId    = editingOpId,
            };
            var r = await HrService.CreateAsync(dto);
            if (r.Success && r.Data is not null)
            {
                showCrearHrModal = false;
                hojasRuta        = await HrService.GetByOrdenPedidoAsync(editingOpId);
            }
            else
            {
                hrError = r.Message ?? "No se pudo crear la Hoja de Ruta.";
            }
        }
        catch (Exception ex) { hrError = ex.Message; }
        finally { hrSaving = false; StateHasChanged(); }
    }

    private async Task ExecuteDeleteHr()
    {
        if (hrAEliminar is null) return;
        hrSaving = true;
        StateHasChanged();
        try
        {
            var r = await HrService.DeleteAsync(hrAEliminar.HojaRutaId);
            if (r.Success)
                hojasRuta = await HrService.GetByOrdenPedidoAsync(editingOpId);
            else
                hrError = r.Message ?? "No se pudo eliminar.";
        }
        catch (Exception ex) { hrError = ex.Message; }
        finally
        {
            hrAEliminar = null;
            hrSaving    = false;
            StateHasChanged();
        }
    }

