@page "/compras/pedidos"
@attribute [Authorize]
@inject OrdenPedidoHttpService OpService
@inject AlmacenHttpService AlmacenService
@inject MdmCompanyProductHttpService CompanyProductService
@inject AuthenticationStateProvider AuthStateProvider
@inject HojaRutaHttpService HrService
@inject NavigationManager Nav

<PageTitle>Órdenes de Pedido - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-clipboard2-check-fill"></i> Órdenes de Pedido</h3>
            <p class="text-muted mb-0">Solicitudes internas de compra (paso 1 del flujo)</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="GoToCreatePage">
                <i class="bi bi-plus-circle"></i> Nueva OP
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* ?? Filtros ?? *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Estado</label>
                    <select class="form-select form-select-sm" @bind="filtroEstado">
                        <option value="">Todos</option>
                        <option value="Borrador">@("Borrador".ToNombre())</option>
                        <option value="EnRevision">@("EnRevision".ToNombre())</option>
                        <option value="AbastecidoConStock">@("AbastecidoConStock".ToNombre())</option>
                        <option value="PendienteAprobacion">@("PendienteAprobacion".ToNombre())</option>
                        <option value="Aprobado">@("Aprobado".ToNombre())</option>
                        <option value="Rechazado">@("Rechazado".ToNombre())</option>
                        <option value="Anulado">@("Anulado".ToNombre())</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadData">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ?? Tabla ?? *@
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
            <span>Pedidos <span class="badge bg-secondary ms-1">@pedidos.Count</span></span>
        </div>
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando...</p>
                </div>
            }
            else if (pedidos.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-3">No hay órdenes de pedido registradas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px"></th>
                                <th>Número</th>
                                <th>Fecha</th>
                                <th>Empresa</th>
                                <th>Sucursal</th>
                                <th>Cliente</th>
                                <th>Entrega</th>
                                <th>Urgencia</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var op in pedidos)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(op.OrdenPedidoId)" title="Ver líneas">
                                            <i class="bi @(expandedId == op.OrdenPedidoId ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        </button>
                                    </td>
                                    <td><strong>@op.Numero</strong></td>
                                    <td>@op.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>@op.EmpresaNombre</td>
                                    <td>@(op.SucursalNombre ?? "—")</td>
                                    <td>@(op.ClienteNombre ?? "—")</td>
                                    <td>
                                        <div>@(op.ClienteSucursalNombre ?? "—")</div>
                                        <div class="small text-muted">@(op.DireccionEntrega ?? "Sin dirección")</div>
                                    </td>
                                    <td>
                                        <span class="badge @op.Urgencia.ToUrgenciaBadgeClass()">@op.Urgencia</span>
                                    </td>
                                    <td>
                                        <span class="badge @op.Estado.ToBadgeClass()">@op.Estado.ToNombre()</span>
                                    </td>
                                    <td class="text-end">
                                        @if (op.Estado == "Borrador")
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => GoToEditPage(op.OrdenPedidoId)" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => EnviarRevision(op)" title="Enviar a revisión">
                                                <i class="bi bi-send"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePedido(op)" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        @if (op.Estado == "EnRevision")
                                        {
                                            <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ShowRevisarStockModal(op)" title="Revisar stock">
                                                <i class="bi bi-boxes"></i> Stock
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => AnularPedido(op)" title="Anular">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        @if (op.Estado == "PendienteAprobacion")
                                        {
                                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => ShowAprobarModal(op, true)" title="Aprobar">
                                                <i class="bi bi-hand-thumbs-up"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowAprobarModal(op, false)" title="Rechazar">
                                                <i class="bi bi-hand-thumbs-down"></i>
                                            </button>
                                        }
                                        @if (op.Estado == "Aprobado")
                                        {
                                            <a href="/compras/ordenes" class="btn btn-sm btn-outline-primary" title="Ir a crear OC">
                                                <i class="bi bi-cart-plus"></i> Crear OC
                                            </a>
                                        }
                                    </td>
                                </tr>
                                @if (expandedId == op.OrdenPedidoId)
                                {
                                    <tr>
                                        <td colspan="10" class="bg-light p-0">
                                            <div class="p-3">
                                                <div class="row g-2 mb-2">
                                                    <div class="col-md-3"><strong>Empresa:</strong> @op.EmpresaNombre</div>
                                                    <div class="col-md-3"><strong>Sucursal empresa:</strong> @(op.SucursalNombre ?? "—")</div>
                                                    <div class="col-md-3"><strong>Cliente:</strong> @(op.ClienteNombre ?? "—")</div>
                                                    <div class="col-md-3"><strong>Sucursal cliente:</strong> @(op.ClienteSucursalNombre ?? "—")</div>
                                                    <div class="col-md-6"><strong>Dirección entrega:</strong> @(op.DireccionEntrega ?? "—")</div>
                                                    <div class="col-md-3"><strong>Referencia entrega:</strong> @(op.ReferenciaEntrega ?? "—")</div>
                                                    <div class="col-md-3"><strong>Contacto relacionado:</strong> @(op.ContactoRelacionado ?? "—")</div>
                                                </div>

                                                <strong><i class="bi bi-list-ol"></i> Líneas — @op.Numero</strong>
                                                @if (op.Lineas.Count == 0)
                                                {
                                                    <p class="text-muted small mt-2">Sin líneas.</p>
                                                }
                                                else
                                                {
                                                    <table class="table table-sm table-bordered mt-2 mb-1">
                                                        <thead>
                                                            <tr>
                                                                <th>#</th>
                                                                <th>SKU</th>
                                                                <th>Descripción</th>
                                                                <th>UdM</th>
                                                                <th class="text-end">Cant. Solic.</th>
                                                                <th class="text-end">Stock Disp.</th>
                                                                <th class="text-end">En Tránsito</th>
                                                                <th class="text-end">A Comprar</th>
                                                                <th>Notas</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var l in op.Lineas)
                                                            {
                                                                <tr>
                                                                    <td>@l.NumeroLinea</td>
                                                                    <td><code>@l.ProductoSku</code></td>
                                                                    <td>@l.Descripcion</td>
                                                                    <td>@l.UnidadMedida</td>
                                                                    <td class="text-end">@l.CantidadSolicitada.ToString("N2")</td>
                                                                    <td class="text-end">@(l.CantidadStockDisponible?.ToString("N2") ?? "—")</td>
                                                                    <td class="text-end">@(l.CantidadEnTransito?.ToString("N2") ?? "—")</td>
                                                                    <td class="text-end">@(l.CantidadAComprar?.ToString("N2") ?? "—")</td>
                                                                    <td class="small text-muted">@l.Notas</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                                @if (!string.IsNullOrEmpty(op.ObservacionesRevisionStock))
                                                {
                                                    <div class="alert alert-info py-1 px-2 small mt-1">
                                                        <i class="bi bi-info-circle"></i> <strong>Obs. stock:</strong> @op.ObservacionesRevisionStock
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(op.MotivoRechazo))
                                                {
                                                    <div class="alert alert-danger py-1 px-2 small mt-1">
                                                        <i class="bi bi-x-circle"></i> <strong>Motivo rechazo:</strong> @op.MotivoRechazo
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ???????????????????????????????????????????????????????????????????????
   MODAL: Crear / Editar OP
?????????????????????????????????????????????????????????????????????? *@
@if (showFormModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard2-plus"></i> @(isEditing ? "Editar Orden de Pedido" : "Nueva Orden de Pedido")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2">@modalError</div>
                    }

                    @* ?? Nav-tabs ?? *@
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(opModalTab == "datos" ? "active" : "")"
                                    @onclick='() => opModalTab = "datos"'>
                                <i class="bi bi-card-list me-1"></i>Datos
                            </button>
                        </li>
                        @if (isEditing)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(opModalTab == "tareas" ? "active" : "")"
                                        @onclick='() => opModalTab = "tareas"'>
                                    <i class="bi bi-check2-square me-1"></i>Tareas
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(opModalTab == "hoja-ruta" ? "active" : "")"
                                        @onclick="SwitchToHojaRuta">
                                    <i class="bi bi-map me-1"></i>Hoja de Ruta
                                    @if (hrLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm ms-1" style="width:.7rem;height:.7rem"></span>
                                    }
                                    else if (hojasRuta.Count > 0)
                                    {
                                        <span class="badge bg-primary ms-1" style="font-size:.65rem">@hojasRuta.Count</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>

                    @* ?? Pestaña Datos ?? *@
                    @if (opModalTab == "datos")
                    {
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Fecha Emisión <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="formFechaEmision" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Requerida</label>
                            <input type="date" class="form-control" @bind="formFechaRequerida" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Solicitante</label>
                            <input type="text" class="form-control bg-light" value="@formSolicitanteNombre" readonly
                                   title="Asignado automáticamente al usuario que ingresa al sistema" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Centro de Costo</label>
                            <input type="text" class="form-control" @bind="formCentroCosto" placeholder="Opcional" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Urgencia <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="formUrgencia">
                                <option value="Normal">Normal</option>
                                <option value="Urgente">Urgente</option>
                                <option value="Critico">Crítico</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Almacén Destino <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="formAlmacenId">
                                <option value="0">— Seleccionar —</option>
                                @foreach (var a in almacenes)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" rows="2" @bind="formObservaciones"></textarea>
                        </div>
                    </div>

                    @* ?? Líneas ?? *@
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong><i class="bi bi-list-ol"></i> Líneas del Pedido</strong>
                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="AddLinea">
                            <i class="bi bi-plus"></i> Agregar línea
                        </button>
                    </div>
                    @if (tempLineas.Count == 0)
                    {
                        <p class="text-muted small">Sin líneas. Agregue al menos una.</p>
                    }
                    else
                    {
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Descripción</th>
                                    <th>UdM</th>
                                    <th class="text-end" style="width:120px">Cantidad</th>
                                    <th>Notas</th>
                                    <th style="width:50px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < tempLineas.Count; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" value="@tempLineas[idx].CompanyProductId"
                                                    @onchange="e => OnProductoChange(idx, e)">
                                                <option value="0">— Producto —</option>
                                                @foreach (var cp in companyProducts)
                                                {
                                                    <option value="@cp.CompanyProductId">[@cp.Sku] @cp.NombreComercial</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   value="@tempLineas[idx].Descripcion"
                                                   @onchange="e => { tempLineas[idx] = tempLineas[idx] with { Descripcion = e.Value?.ToString() ?? string.Empty }; }" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" style="width:80px"
                                                   value="@tempLineas[idx]. UnidadMedida"
                                                   @onchange="e => { tempLineas[idx] = tempLineas[idx] with { UnidadMedida = e.Value?.ToString() ?? string.Empty }; }" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-end" min="0.01" step="0.01"
                                                   value="@tempLineas[idx].CantidadSolicitada"
                                                   @onchange="e => tempLineas[idx] = tempLineas[idx] with { CantidadSolicitada = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 1 }" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   value="@tempLineas[idx].Notas"
                                                   @onchange="e => tempLineas[idx] = tempLineas[idx] with { Notas = e.Value?.ToString() }" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLinea(idx)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    } @* fin pestaña datos *@

                    @* ?? Pestaña Tareas (solo en edición) ?? *@
                    @if (opModalTab == "tareas" && isEditing)
                    {
                        var opDto    = pedidos.FirstOrDefault(o => o.OrdenPedidoId == editingOpId);
                        var opEstado = opDto?.Estado ?? "";
                        <TareasTab EntityType="OrdenPedido"
                                   EntityId="@((int)editingOpId)"
                                   IsReadOnly="@(opEstado is "Cerrado" or "Anulado" or "Rechazado")"
                                   OnTareaCompletada="LoadData" />
                    }
                    @* ?? Pestaña Hoja de Ruta (solo en edición) ?? *@
                    @if (opModalTab == "hoja-ruta" && isEditing)
                    {
                        @if (hrLoading)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary"></div>
                                <p class="mt-2 text-muted small">Cargando hojas de ruta...</p>
                            </div>
                        }
                        else
                        {
                            @* ?? Botón crear HR vinculada ?? *@
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">
                                    Hojas de ruta vinculadas a esta orden de pedido
                                </span>
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="ShowCrearHrModal"
                                        disabled="@hrSaving">
                                    <i class="bi bi-plus-circle me-1"></i>Nueva Hoja de Ruta
                                </button>
                            </div>

                            @if (!string.IsNullOrEmpty(hrError))
                            {
                                <div class="alert alert-danger py-2 small">@hrError</div>
                            }

                            @if (hojasRuta.Count == 0)
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-map" style="font-size:2rem;color:#9ca3af"></i>
                                    <p class="text-muted mt-2 small">No hay hojas de ruta vinculadas a este pedido.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var hr in hojasRuta)
                                {
                                    <div class="card mb-3 border">
                                        @* ?? Cabecera de la HR ?? *@
                                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-map-fill text-primary"></i>
                                                <strong>@hr.NumeroHojaRuta</strong>
                                                <span class="badge @HrEstadoBadge(hr.Estado)">@hr.Estado</span>
                                                <span class="badge bg-secondary" style="font-size:.65rem">@hr.SubEstado</span>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <a href="/logistica/hojas-ruta" class="btn btn-xs btn-outline-secondary p-0 px-1"
                                                   title="Ver en módulo Logística">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </a>
                                                @if (hr.Estado == "BORRADOR")
                                                {
                                                    <button class="btn btn-xs btn-outline-danger p-0 px-1"
                                                            @onclick="() => ConfirmDeleteHr(hr)"
                                                            title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        @* ?? Datos de la HR ?? *@
                                        <div class="card-body py-2 px-3">
                                            <div class="row g-2" style="font-size:.82rem">
                                                <div class="col-md-3">
                                                    <span class="text-muted">Tipo:</span>
                                                    <strong>@hr.TipoOP / @hr.SubTipo</strong>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="text-muted">Fecha Doc.:</span>
                                                    <strong>@hr.FechaDocumento.ToString("dd/MM/yyyy")</strong>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="text-muted">ETA:</span>
                                                    <strong>@(hr.ETA?.ToString("dd/MM/yyyy") ?? "—")</strong>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="text-muted">Responsable:</span>
                                                    <strong>@hr.ResponsableUsuario</strong>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="text-muted">Almacén Origen:</span>
                                                    <strong>@(hr.AlmacenOrigenNombre ?? "—")</strong>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="text-muted">Almacén Destino:</span>
                                                    <strong>@(hr.AlmacenDestinoNombre ?? "—")</strong>
                                                </div>
                                                @if (!string.IsNullOrEmpty(hr.ProveedorCliente))
                                                {
                                                    <div class="col-md-6">
                                                        <span class="text-muted">Proveedor/Cliente:</span>
                                                        <strong>@hr.ProveedorCliente</strong>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(hr.Observaciones))
                                                {
                                                    <div class="col-12">
                                                        <span class="text-muted">Obs.:</span> @hr.Observaciones
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        @* ?? Historial de estados ?? *@
                                        @if (hr.Historial.Count > 0)
                                        {
                                            <div class="card-footer py-1 px-3 bg-light">
                                                <small class="text-muted fw-semibold">Historial de estados</small>
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    @foreach (var h in hr.Historial.OrderBy(x => x.FechaCambio))
                                                    {
                                                        <span class="badge bg-light text-dark border" style="font-size:.65rem">
                                                            @h.FechaCambio.ToString("dd/MM HH:mm") — @h.EstadoNuevo / @h.SubEstadoNuevo
                                                            @if (!string.IsNullOrEmpty(h.Observaciones))
                                                            {
                                                                <span class="ms-1 text-muted"">(@h.Observaciones)</span>
                                                            }
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@saving">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SavePedido" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(isEditing ? "Guardar Cambios" : "Crear Pedido")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ?? Modal: Crear Hoja de Ruta vinculada ?? *@
@if (showCrearHrModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.6);z-index:1060">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-map-fill me-1"></i>Nueva Hoja de Ruta</h5>
                    <button type="button" class="btn-close" @onclick="() => showCrearHrModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(hrError))
                    {
                        <div class="alert alert-danger py-2">@hrError</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="hrFormTipoOP">
                                <option value="INTERNA">INTERNA</option>
                                <option value="CLIENTE">CLIENTE</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sub-tipo <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="hrFormSubTipo">
                                @if (hrFormTipoOP == "INTERNA")
                                {
                                    <option value="IMPORTACION">IMPORTACION</option>
                                    <option value="TRASPASO_INTERNO">TRASPASO_INTERNO</option>
                                    <option value="DEVOLUCION">DEVOLUCION</option>
                                    <option value="AJUSTE">AJUSTE</option>
                                }
                                else
                                {
                                    <option value="ENTREGA">ENTREGA</option>
                                    <option value="RECOJO">RECOJO</option>
                                    <option value="DEVOLUCION_CLI">DEVOLUCION_CLI</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Almacén Origen <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="hrFormAlmacenOrigen">
                                <option value="0">— Seleccionar —</option>
                                @foreach (var a in almacenes)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Almacén Destino</label>
                            <select class="form-select" @bind="hrFormAlmacenDestino">
                                <option value="0">— Ninguno —</option>
                                @foreach (var a in almacenes)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Documento <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="hrFormFechaDocumento" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">ETA</label>
                            <input type="date" class="form-control" @bind="hrFormETA" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Proveedor / Cliente</label>
                            <input class="form-control" @bind="hrFormProveedorCliente" placeholder="Nombre del proveedor o cliente" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Observaciones</label>
                            <input class="form-control" @bind="hrFormObservaciones" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCrearHrModal = false" disabled="@hrSaving">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveCrearHr" disabled="@hrSaving">
                        @if (hrSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Crear Hoja de Ruta
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ?? Modal: Confirmar eliminar HR ?? *@
