        _            => "bg-light text-dark border"
    };

    // ?? Hojas de ruta: modal crear vinculada ???????????????????????????????????
    private void ShowCrearHrModal()
    {
        hrFormTipoOP           = "INTERNA";
        hrFormSubTipo          = "IMPORTACION";
