@* ?? Modal: Revisar Stock ?? *@
@if (showStockModal && selectedOp is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-boxes"></i> Revisión de Stock — @selectedOp.Numero</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2">@modalError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold">¿El stock cubre el pedido?</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="stockSi" name="stockCubre"
                                   checked="@stockCubre" @onchange="() => stockCubre = true" />
                            <label class="form-check-label" for="stockSi">Sí — Abastecer con stock disponible</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="stockNo" name="stockCubre"
                                   checked="@(!stockCubre)" @onchange="() => stockCubre = false" />
                            <label class="form-check-label" for="stockNo">No — Enviar a aprobación para compra</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" rows="2" @bind="stockObservaciones"></textarea>
                    </div>
                    <hr />
                    <strong>Líneas del pedido:</strong>
                    <table class="table table-sm table-bordered mt-2">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Descripción</th>
                                <th class="text-end">Solic.</th>
                                <th class="text-end">Stock Disp.</th>
                                <th class="text-end">En Tránsito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in stockLineas)
                            {
                                <tr>
                                    <td><code>@l.ProductoSku</code></td>
                                    <td>@l.Descripcion</td>
                                    <td class="text-end">@l.CantidadSolicitada.ToString("N2")</td>
                                    <td class="text-end">
                                        <input type="number" class="form-control form-control-sm text-end" min="0" step="0.01"
                                               style="width:90px"
                                               value="@l.CantidadStockDisponible"
                                               @onchange="e => UpdateStockLinea(l, e, isStock: true)" />
                                    </td>
                                    <td class="text-end">
                                        <input type="number" class="form-control form-control-sm text-end" min="0" step="0.01"
                                               style="width:90px"
                                               value="@l.CantidadEnTransito"
                                               @onchange="e => UpdateStockLinea(l, e, isStock: false)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@saving">Cancelar</button>
                    <button class="btn btn-primary" @onclick="ConfirmarStock" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Confirmar Revisión de Stock
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ?? Modal: Aprobar / Rechazar ?? *@
@if (showAprobarModal && selectedOp is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (aprobando)
                        {
                            <><i class="bi bi-hand-thumbs-up text-success"></i> Aprobar Pedido</>
                        }
                        else
                        {
                            <><i class="bi bi-hand-thumbs-down text-danger"></i> Rechazar Pedido</>
                        }
                        — @selectedOp.Numero
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2">@modalError</div>
                    }
                    @if (!aprobando)
                    {
                        <div class="mb-3">
                            <label class="form-label">Motivo del Rechazo <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="motivoRechazo"
                                      placeholder="Indique el motivo del rechazo..."></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success py-2">
                            <i class="bi bi-check-circle-fill"></i>
                            Se aprobará el pedido <strong>@selectedOp.Numero</strong>. Se podrá generar una Orden de Compra.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@saving">Cancelar</button>
                    <button class="btn @(aprobando ? "btn-success" : "btn-danger")" @onclick="ConfirmarAprobar" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(aprobando ? "Aprobar" : "Rechazar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ?? Estado general ??????????????????????????????????????????????????????
    private List<OrdenPedidoDto> pedidos = new();
    private List<AlmacenDto> almacenes = new();
    private List<CompanyProductDto> companyProducts = new();

    private bool loading = true;
    private bool saving = false;
    private string? successMessage;
    private string? errorMessage;
    private string? modalError;
    private long? expandedId;

    // Usuario autenticado
    private string _currentUserName = "";

    // ?? Filtros ?????????????????????????????????????????????????????????????
    private string filtroEstado = "";
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;

    // ?? Form Create/Edit ????????????????????????????????????????????????????
    private bool showFormModal;
    private bool isEditing;
    private long editingOpId;
    private string opModalTab = "datos";   // "datos" | "tareas"
    private DateTime formFechaEmision = DateTime.Today;
    private DateTime? formFechaRequerida;
    private string formSolicitanteNombre = "";
    private string? formCentroCosto;
    private string formUrgencia = "Normal";
    private int formAlmacenId;
    private string? formObservaciones;
    private List<CreateOrdenPedidoLineaDto> tempLineas = new();

    // ?? Stock modal ??????????????????????????????????????????????????????????
    private bool showStockModal;
    private OrdenPedidoDto? selectedOp;
    private bool stockCubre = true;
    private string? stockObservaciones;
    private List<StockLineaVm> stockLineas = new();

    // ?? Aprobar modal ????????????????????????????????????????????????????????
    private bool showAprobarModal;
    private bool aprobando;
    private string? motivoRechazo;

    // ?? Hoja de ruta ????????????????????????????????????????????????????????
    private bool hrLoading;
    private bool hrSaving;
    private string? hrError;
    private List<HojaRutaDto> hojasRuta = new();
    private HojaRutaDto? hrAEliminar;

    // Campos form nueva HR
    private bool showCrearHrModal;
    private string hrFormTipoOP      = "INTERNA";
    private string hrFormSubTipo     = "IMPORTACION";
    private int    hrFormAlmacenOrigen;
    private int    hrFormAlmacenDestino;   // 0 = ninguno
    private string? hrFormProveedorCliente;
    private DateTime hrFormFechaDocumento = DateTime.Today;
    private DateTime? hrFormETA;
    private string? hrFormObservaciones;

    // ?? Init ?????????????????????????????????????????????????????????????????
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserName = authState.User.Identity?.Name ?? "";

        var a = await AlmacenService.GetAllAsync();
        var cp = await CompanyProductService.GetAllAsync();
        almacenes = a;
        companyProducts = cp;
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        StateHasChanged();
        pedidos = await OpService.GetAllAsync(
            string.IsNullOrEmpty(filtroEstado) ? null : filtroEstado,
            filtroDesde, filtroHasta);
        loading = false;
        StateHasChanged();
    }

    private void ToggleDetail(long id) =>
        expandedId = expandedId == id ? null : id;

    // ?? Modales ??????????????????????????????????????????????????????????????
    private void ShowCreateModal()
    {
        isEditing = false;
        editingOpId = 0;
        opModalTab = "datos";
        formFechaEmision = DateTime.Today;
        formFechaRequerida = null;
        formSolicitanteNombre = _currentUserName;
        formCentroCosto = null;
        formUrgencia = "Normal";
        formAlmacenId = 0;
        formObservaciones = null;
        tempLineas = new();
        modalError = null;
        showFormModal = true;
    }

    private void GoToCreatePage() => Nav.NavigateTo("/compras/pedidos/nuevo");

    private void GoToEditPage(long id) => Nav.NavigateTo($"/compras/pedidos/editar/{id}");

    private void ShowEditModal(OrdenPedidoDto op)
    {
        isEditing = true;
        editingOpId = op.OrdenPedidoId;
        opModalTab = "datos";
        formFechaEmision = op.FechaEmision;
        formFechaRequerida = op.FechaRequerida;
        formSolicitanteNombre = op.SolicitanteNombre;
        formCentroCosto = op.CentroCosto;
        formUrgencia = op.Urgencia;
        formAlmacenId = op.AlmacenDestinoId;
        formObservaciones = op.Observaciones;
        tempLineas = op.Lineas.Select(l => new CreateOrdenPedidoLineaDto(
            l.CompanyProductId, l.Descripcion, l.UnidadMedida, l.CantidadSolicitada, l.Notas)).ToList();
        modalError = null;
        hojasRuta  = new();
        hrError    = null;
        showFormModal = true;
    }

    private void ShowRevisarStockModal(OrdenPedidoDto op)
    {
        selectedOp = op;
        stockCubre = true;
        stockObservaciones = null;
        stockLineas = op.Lineas.Select(l => new StockLineaVm
        {
            OrdenPedidoLineaId = l.OrdenPedidoLineaId,
            ProductoSku = l.ProductoSku,
            Descripcion = l.Descripcion,
            CantidadSolicitada = l.CantidadSolicitada,
            CantidadStockDisponible = 0,
            CantidadEnTransito = 0
        }).ToList();
        modalError = null;
        showStockModal = true;
    }

    private void ShowAprobarModal(OrdenPedidoDto op, bool aprobar)
    {
        selectedOp = op;
        aprobando = aprobar;
        motivoRechazo = null;
        modalError = null;
        showAprobarModal = true;
    }

    private void CloseModal()
    {
        showFormModal = false;
        showStockModal = false;
        showAprobarModal = false;
        selectedOp = null;
    }

    private async Task SwitchToHojaRuta()
    {
        opModalTab = "hoja-ruta";
        hrLoading  = true;
        hrError    = null;
        StateHasChanged();
        try
        {
            hojasRuta = await HrService.GetByOrdenPedidoAsync(editingOpId);
        }
        catch
        {
            hrError   = "Error al cargar las hojas de ruta.";
            hojasRuta = new();
        }
        finally
        {
            hrLoading = false;
            StateHasChanged();
        }
    }

    // ?? Líneas form ??????????????????????????????????????????????????????????
    private void AddLinea() =>
        tempLineas.Add(new CreateOrdenPedidoLineaDto(0, "", "UND", 1));

    private void RemoveLinea(int idx) =>
        tempLineas.RemoveAt(idx);

    private void OnProductoChange(int idx, ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), out var cpId)) return;
        var cp = companyProducts.FirstOrDefault(p => p.CompanyProductId == cpId);
        if (cp is null) return;
        tempLineas[idx] = tempLineas[idx] with
        {
            CompanyProductId = cpId,
            Descripcion = cp.NombreComercial,
            UnidadMedida = "UND"
        };
    }

    // ?? Acciones ?????????????????????????????????????????????????????????????
    private async Task SavePedido()
    {
        saving = true; modalError = null;
        try
        {
            if (formAlmacenId == 0) { modalError = "Seleccione un almacén destino."; return; }
            if (tempLineas.Count == 0) { modalError = "Agregue al menos una línea."; return; }

            if (isEditing)
            {
                var dto = new UpdateOrdenPedidoDto(formFechaEmision, formFechaRequerida,
                    formCentroCosto, formUrgencia, formAlmacenId, formObservaciones);
                var r = await OpService.UpdateAsync(editingOpId, dto);
                if (r.Success) { successMessage = "Pedido actualizado."; CloseModal(); await LoadData(); }
                else modalError = r.Message;
            }
            else
            {
                var dto = new CreateOrdenPedidoDto(
                    formFechaEmision, formFechaRequerida,
                    formCentroCosto, formUrgencia, formAlmacenId,
                    Observaciones: formObservaciones,
                    Lineas: tempLineas.Count > 0 ? tempLineas : null);
                var r = await OpService.CreateAsync(dto);
                if (r.Success)
                {
                    successMessage = $"Pedido {r.Data?.Numero} creado.";
                    CloseModal();
                    await LoadData();
                    // Abrir el pedido recién creado en pestaña Tareas para visualizar los hitos generados
                    if (r.Data is not null)
                    {
                        var nuevo = pedidos.FirstOrDefault(o => o.OrdenPedidoId == r.Data.OrdenPedidoId);
                        if (nuevo is not null)
                        {
                            ShowEditModal(nuevo);
                            opModalTab = "tareas";
                        }
                    }
                }
                else modalError = r.Message;
            }
        }
        catch (Exception ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

    private async Task EnviarRevision(OrdenPedidoDto op)
    {
        var r = await OpService.EnviarRevisionAsync(op.OrdenPedidoId);
        if (r.Success) { successMessage = $"Pedido {op.Numero} enviado a revisión."; await LoadData(); }
        else errorMessage = r.Message;
    }

    private async Task ConfirmarStock()
    {
        saving = true; modalError = null;
        try
        {
            var dto = new RevisarStockOrdenPedidoDto(
                stockCubre, stockObservaciones,
                stockLineas.Select(l => new RevisionStockLineaDto(
                    l.OrdenPedidoLineaId, l.CantidadStockDisponible, l.CantidadEnTransito)).ToList());
            var r = await OpService.RevisarStockAsync(selectedOp!.OrdenPedidoId, dto);
            if (r.Success)
            {
                successMessage = stockCubre
                    ? $"Pedido {selectedOp.Numero} abastecido con stock."
                    : $"Pedido {selectedOp.Numero} enviado a aprobación.";
                CloseModal(); await LoadData();
            }
            else modalError = r.Message;
        }
        catch (Exception ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

    private async Task ConfirmarAprobar()
    {
        if (!aprobando && string.IsNullOrWhiteSpace(motivoRechazo))
        {
            modalError = "Indique el motivo del rechazo."; return;
        }
        saving = true; modalError = null;
        try
        {
            var dto = new AprobarRechazarOrdenPedidoDto(aprobando, motivoRechazo);
            var r = await OpService.AprobarRechazarAsync(selectedOp!.OrdenPedidoId, dto);
            if (r.Success)
            {
                successMessage = aprobando
                    ? $"Pedido {selectedOp.Numero} aprobado. Se puede generar la OC."
                    : $"Pedido {selectedOp.Numero} rechazado.";
                CloseModal(); await LoadData();
            }
            else modalError = r.Message;
        }
        catch (Exception ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

    private async Task AnularPedido(OrdenPedidoDto op)
    {
        var r = await OpService.AnularAsync(op.OrdenPedidoId);
        if (r.Success) { successMessage = $"Pedido {op.Numero} anulado."; await LoadData(); }
        else errorMessage = r.Message;
    }

    private async Task DeletePedido(OrdenPedidoDto op)
    {
        var r = await OpService.DeleteAsync(op.OrdenPedidoId);
        if (r.Success) { successMessage = $"Pedido {op.Numero} eliminado."; await LoadData(); }
        else errorMessage = r.Message;
    }

    private void UpdateStockLinea(StockLineaVm l, ChangeEventArgs e, bool isStock)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var v)) return;
        if (isStock) l.CantidadStockDisponible = v;
        else l.CantidadEnTransito = v;
    }

    // ?? Helpers ??????????????????????????????????????????????????????????????

