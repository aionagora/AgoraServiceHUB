@page "/compras/expedientes"
@attribute [Authorize]
@inject ExpedienteImportacionHttpService ExpService
@inject OrdenCompraHttpService OcService

<PageTitle>Expedientes de Importación - AgoraHub360 ERP</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="bi bi-globe-americas"></i> Expedientes de Importación</h3>
            <p class="text-muted mb-0">Tracking completo del ciclo de importación (embarque ? levante)</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle"></i> Nuevo Expediente
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* ?? Filtros ?? *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Estado</label>
                    <select class="form-select form-select-sm" @bind="filtroEstado">
                        <option value="">Todos</option>
                        <option value="Borrador">Borrador</option>
                        <option value="EnTransito">En Tránsito</option>
                        <option value="Arribado">Arribado</option>
                        <option value="EnAduana">En Aduana</option>
                        <option value="ObservacionAduana">Con Observación</option>
                        <option value="Liberado">Liberado</option>
                        <option value="Cerrado">Cerrado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadData">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ?? Tabla ?? *@
    <div class="card">
        <div class="card-header py-3">
            Expedientes <span class="badge bg-secondary ms-1">@expedientes.Count</span>
        </div>
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando...</p>
                </div>
            }
            else if (expedientes.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-3">No hay expedientes de importación registrados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px"></th>
                                <th>Número</th>
                                <th>Incoterm</th>
                                <th>Forwarder</th>
                                <th>Origen</th>
                                <th>ETD</th>
                                <th>ETA</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in expedientes)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(exp.ExpedienteImportacionId)" title="Ver detalle">
                                            <i class="bi @(expandedId == exp.ExpedienteImportacionId ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        </button>
                                    </td>
                                    <td><strong>@exp.Numero</strong></td>
                                    <td>@(exp.Incoterm ?? "—")</td>
                                    <td>@(exp.Forwarder ?? "—")</td>
                                    <td>@(exp.PaisOrigen ?? "—")</td>
                                    <td>@(exp.ETD?.ToString("dd/MM/yy") ?? "—")</td>
                                    <td>@(exp.ETA?.ToString("dd/MM/yy") ?? "—")</td>
                                    <td>
                                        <span class="badge @GetEstadoBadge(exp.Estado)">@GetEstadoLabel(exp.Estado)</span>
                                        @if (exp.TuvoObservacionAduana)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" title="Tuvo observación aduanera">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (exp.Estado == "Borrador")
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEmbarqueModal(exp)" title="Datos de embarque">
                                                <i class="bi bi-ship"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => ShowConfirmarSalidaModal(exp)" title="Confirmar salida">
                                                <i class="bi bi-arrow-right-circle"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteExpediente(exp)" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        @if (exp.Estado == "EnTransito")
                                        {
                                            <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ShowEmbarqueModal(exp)" title="Actualizar embarque">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => ShowArriboModal(exp)" title="Registrar arribo">
                                                <i class="bi bi-geo-alt-fill"></i> Arribo
                                            </button>
                                        }
                                        @if (exp.Estado == "Arribado")
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowDespachoModal(exp)" title="Iniciar despacho aduanero">
                                                <i class="bi bi-building"></i> Aduana
                                            </button>
                                        }
                                        @if (exp.Estado == "EnAduana")
                                        {
                                            <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => ShowObservacionModal(exp)" title="Registrar observación">
                                                <i class="bi bi-exclamation-triangle"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => ShowLevanteModal(exp)" title="Registrar levante">
                                                <i class="bi bi-check-circle"></i> Levante
                                            </button>
                                        }
                                        @if (exp.Estado == "ObservacionAduana")
                                        {
                                            <button class="btn btn-sm btn-outline-info" @onclick="() => SubsanarObservacion(exp)" title="Subsanar observación">
                                                <i class="bi bi-arrow-counterclockwise"></i> Subsanar
                                            </button>
                                        }
                                        @if (exp.Estado == "Liberado")
                                        {
                                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowHitoModal(exp)" title="Agregar hito">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-dark" @onclick="() => CerrarExpediente(exp)" title="Cerrar expediente">
                                                <i class="bi bi-lock"></i> Cerrar
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-link ms-1" @onclick="() => ShowHitoModal(exp)" title="Agregar hito de tracking">
                                            <i class="bi bi-plus-square"></i>
                                        </button>
                                    </td>
                                </tr>
                                @if (expandedId == exp.ExpedienteImportacionId)
                                {
                                    <tr>
                                        <td colspan="9" class="bg-light p-0">
                                            <div class="p-3">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <h6><i class="bi bi-info-circle"></i> Detalle del Embarque</h6>
                                                        <table class="table table-sm table-borderless mb-0">
                                                            <tr><th class="w-50">Transporte</th><td>@(exp.ModalidadTransporte ?? "—")</td></tr>
                                                            <tr><th>Puerto Origen</th><td>@(exp.PuertoOrigen ?? "—")</td></tr>
                                                            <tr><th>Puerto Destino</th><td>@(exp.PuertoDestino ?? "—")</td></tr>
                                                            <tr><th>BL / AWB</th><td>@(exp.NumeroBLAWB ?? "—")</td></tr>
                                                            <tr><th>ATD</th><td>@(exp.ATD?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                                                            <tr><th>ATA</th><td>@(exp.ATA?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                                                            <tr><th>DUI / DIM</th><td>@(exp.NumeroDUIDIM ?? "—")</td></tr>
                                                            <tr><th>Despachante</th><td>@(exp.Despachante ?? "—")</td></tr>
                                                            <tr><th>Total Tributos</th><td>@(exp.TotalTributos?.ToString("N2") ?? "—")</td></tr>
                                                            <tr><th>Levante</th><td>@(exp.FechaLevante?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                                                            <tr><th>Seguro</th><td>@(exp.Aseguradora ?? "—") @(exp.NumeroPólizaSeguro != null ? $"#{exp.NumeroPólizaSeguro}" : "")</td></tr>
                                                        </table>
                                                        @if (!string.IsNullOrEmpty(exp.DetalleObservacionAduana))
                                                        {
                                                            <div class="alert alert-warning py-1 px-2 small mt-2">
                                                                <i class="bi bi-exclamation-triangle-fill"></i> <strong>Obs. aduana:</strong> @exp.DetalleObservacionAduana
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h6><i class="bi bi-cart-check"></i> Órdenes de Compra vinculadas</h6>
                                                        @if (exp.OrdenesCompraNumeros.Count == 0)
                                                        {
                                                            <p class="text-muted small">Sin OCs vinculadas.</p>
                                                        }
                                                        else
                                                        {
                                                            <ul class="list-unstyled mb-3">
                                                                @foreach (var num in exp.OrdenesCompraNumeros)
                                                                {
                                                                    <li><span class="badge bg-primary me-1"><i class="bi bi-cart-fill"></i></span> @num</li>
                                                                }
                                                            </ul>
                                                        }

                                                        <h6><i class="bi bi-clock-history"></i> Hitos de Tracking</h6>
                                                        @if (exp.Hitos.Count == 0)
                                                        {
                                                            <p class="text-muted small">Sin hitos registrados.</p>
                                                        }
                                                        else
                                                        {
                                                            <ul class="list-group list-group-flush">
                                                                @foreach (var h in exp.Hitos.OrderBy(x => x.FechaHito))
                                                                {
                                                                    <li class="list-group-item px-0 py-1 bg-transparent">
                                                                        <span class="badge bg-secondary me-1">@h.FechaHito.ToString("dd/MM/yy")</span>
                                                                        <strong>@h.TipoHito</strong>
                                                                        @if (!string.IsNullOrEmpty(h.Descripcion))
                                                                        {
                                                                            <span class="text-muted small ms-1">— @h.Descripcion</span>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ???????????????????????????????????????????????????????????????????????
   MODAL: Crear Expediente
?????????????????????????????????????????????????????????????????????? *@
@if (showCreateModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-globe-americas"></i> Nuevo Expediente de Importación</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError)) { <div class="alert alert-danger py-2">@modalError</div> }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Órdenes de Compra a vincular <span class="text-danger">*</span></label>
                            <p class="text-muted small mb-2">Seleccione una o más OC aprobadas para este expediente.</p>
                            <div style="max-height:180px;overflow-y:auto;border:1px solid #dee2e6;border-radius:.375rem;padding:.5rem">
                                @foreach (var oc in ordenesAprobadas)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="oc_@oc.OrdenCompraId"
                                               checked="@selectedOcIds.Contains(oc.OrdenCompraId)"
                                               @onchange="e => ToggleOc(oc.OrdenCompraId, (bool)e.Value!)" />
                                        <label class="form-check-label small" for="oc_@oc.OrdenCompraId">
                                            <strong>@oc.Numero</strong> — @oc.ProveedorNombre (@oc.MonedaId @oc.Total.ToString("N2"))
                                        </label>
                                    </div>
                                }
                                @if (ordenesAprobadas.Count == 0)
                                {
                                    <p class="text-muted small mb-0">No hay OC en estado Aprobado disponibles.</p>
                                }
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Incoterm</label>
                            <select class="form-select" @bind="formIncoterm">
                                <option value="">— Seleccionar —</option>
                                <option>EXW</option><option>FCA</option><option>CPT</option><option>CIP</option>
                                <option>DAP</option><option>DPU</option><option>DDP</option>
                                <option>FAS</option><option>FOB</option><option>CFR</option><option>CIF</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Modalidad Transporte</label>
                            <select class="form-select" @bind="formModalidadTransporte">
                                <option value="">— Seleccionar —</option>
                                <option value="Maritimo">Marítimo</option>
                                <option value="Aereo">Aéreo</option>
                                <option value="Terrestre">Terrestre</option>
                                <option value="Multimodal">Multimodal</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">País Origen</label>
                            <input type="text" class="form-control" @bind="formPaisOrigen" placeholder="ej. China" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Puerto Origen</label>
                            <input type="text" class="form-control" @bind="formPuertoOrigen" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Puerto Destino</label>
                            <input type="text" class="form-control" @bind="formPuertoDestino" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Forwarder</label>
                            <input type="text" class="form-control" @bind="formForwarder" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Aseguradora</label>
                            <input type="text" class="form-control" @bind="formAseguradora" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Póliza Seguro</label>
                            <input type="text" class="form-control" @bind="formPolizaSeguro" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" rows="2" @bind="formObservaciones"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@saving">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveExpediente" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Crear Expediente
                    </button>
                </div>
            </div>
        </div>
    </div>
}

