            var dto = new CreateExpedienteImportacionDto(
                selectedOcIds.ToList(), formIncoterm, formModalidadTransporte,
                formPaisOrigen, formPuertoOrigen, formPuertoDestino,
                formForwarder, formAseguradora, formPolizaSeguro, formObservaciones);
            var r = await ExpService.CreateAsync(dto);
            if (r.Success) { successMessage = $"Expediente {r.Data?.Numero} creado."; CloseModal(); await LoadData(); }
            else modalError = r.Message;
        }
        catch (Exception ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

