@* ?? Modal: Confirmar Salida ?? *@
@if (showSalidaModal && selectedExp is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-right-circle"></i> Confirmar Salida — @selectedExp.Numero</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError)) { <div class="alert alert-danger py-2">@modalError</div> }
                    <label class="form-label">Fecha de Salida (ATD) <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" @bind="formFechaSalida" />
