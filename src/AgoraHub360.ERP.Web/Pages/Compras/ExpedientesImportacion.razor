@* ?? Modal: Despacho Aduanero ?? *@
@if (showDespachoModal && selectedExp is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-building"></i> Despacho Aduanero — @selectedExp.Numero</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError)) { <div class="alert alert-danger py-2">@modalError</div> }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Número DUI/DIM <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="formDUIDIM" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Despachante <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="formDespachante" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha Presentación <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="formFechaDespacho" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total Tributos</label>
                            <input type="number" class="form-control text-end" min="0" step="0.01" @bind="formTotalTributos" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" rows="2" @bind="formObservaciones"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@saving">Cancelar</button>
                    <button class="btn btn-warning" @onclick="ConfirmarDespacho" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Iniciar Despacho Aduanero
                    </button>
                </div>
            </div>
        </div>
    </div>
}

