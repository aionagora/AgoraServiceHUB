@inject PlantillaContableHttpService PlantillaService

@if (_visible)
{
    <div class="modal show d-block" tabindex="-1" role="dialog"
         style="background:rgba(0,0,0,.45)"
         @onclick="OnBackdropClick">

        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered"
             role="document"
             @onclick:stopPropagation>

            <div class="modal-content">

                @* ?? Header ?? *@
                <div class="modal-header" style="background:#f8fafc;border-bottom:1px solid #e5e7eb">
                    <div>
                        <h5 class="modal-title mb-0">
                            <i class="bi bi-file-earmark-ruled me-2" style="color:#7c3aed"></i>
                            Seleccionar Plantilla Contable
                        </h5>
                        <small class="text-muted">Las líneas se agregarán al comprobante actual</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                @* ?? Search bar ?? *@
                <div class="px-3 pt-3 pb-2" style="background:#f8fafc;border-bottom:1px solid #f3f4f6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-secondary"></i></span>
                        <input type="text" class="form-control"
                               placeholder="Buscar por nombre o código..."
                               value="@_search"
                               @oninput="OnSearchInput" />
                        @if (!string.IsNullOrEmpty(_search))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>

                @* ?? Body ?? *@
                <div class="modal-body p-3">

                    @if (_loading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width:2rem;height:2rem"></div>
                            <p class="text-muted mt-2 mb-0 small">Cargando plantillas...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i> @_error
                        </div>
                    }
                    else if (_filtered.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark-x" style="font-size:2.5rem;opacity:.4"></i>
                            <p class="mt-2 mb-0">
                                @if (string.IsNullOrEmpty(_search))
                                {
                                    <text>No hay plantillas disponibles.</text>
                                }
                                else
                                {
                                    <text>Sin resultados para <strong>"@_search"</strong>.</text>
                                }
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var p in _filtered)
                            {
                                var isSelected = _selected?.PlantillaContableId == p.PlantillaContableId;
                                <div class="col-md-6">
                                    <div class="card h-100 border @(isSelected ? "border-primary shadow-sm" : "border-light")"
                                         style="cursor:pointer;transition:box-shadow .15s,border-color .15s;@(isSelected ? "background:#eff6ff" : "")"
                                         @onclick="() => SelectPlantilla(p)"
                                         @onmouseover="() => _hovered = p.PlantillaContableId"
                                         @onmouseout="() => _hovered = 0">

                                        <div class="card-body pb-2">

                                            @* Nombre + check *@
                                            <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                                                <div>
                                                    <span class="badge rounded-1 me-1"
                                                          style="background:#ede9fe;color:#7c3aed;font-size:.68rem">
                                                        @p.Codigo
                                                    </span>
                                                    <strong style="font-size:.9rem">@p.Nombre</strong>
                                                </div>
                                                @if (isSelected)
                                                {
                                                    <i class="bi bi-check-circle-fill text-primary flex-shrink-0 mt-1"></i>
                                                }
                                            </div>

                                            @* Tipo documento + línea count *@
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <span class="badge bg-secondary rounded-pill" style="font-size:.65rem">
                                                    @p.TipoDocumento
                                                </span>
                                                <span class="text-muted" style="font-size:.75rem">
                                                    <i class="bi bi-list-ol me-1"></i>@p.Lineas.Count
                                                    @(p.Lineas.Count == 1 ? "línea" : "líneas")
                                                </span>
                                            </div>

                                            @* Descripción *@
                                            @if (!string.IsNullOrEmpty(p.Descripcion))
                                            {
                                                <p class="text-muted mb-2" style="font-size:.75rem;line-height:1.3">
                                                    @p.Descripcion
                                                </p>
                                            }

                                            @* Badges de cuentas *@
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var l in p.Lineas.OrderBy(x => x.NumeroLinea))
                                                {
                                                    <span class="badge rounded-1"
                                                          style="background:@(l.TipoMovimiento == "Debe" ? "#eff6ff" : "#f0fdf4");
                                                                 color:@(l.TipoMovimiento == "Debe" ? "#1d4ed8" : "#15803d");
                                                                 font-size:.65rem;font-family:ui-monospace,monospace"
                                                          title="@l.CuentaNombre — @l.TipoMovimiento">
                                                        @l.CuentaCodigo
                                                        <span style="font-size:.6rem;opacity:.7">(@l.TipoMovimiento[0])</span>
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        @* Glosa plantilla *@
                                        @if (!string.IsNullOrWhiteSpace(p.GlosaPlantilla))
                                        {
                                            <div class="card-footer py-1 px-3" style="background:#fafafa;font-size:.72rem;color:#6b7280">
                                                <i class="bi bi-chat-left-text me-1"></i>@p.GlosaPlantilla
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* ?? Footer ?? *@
                <div class="modal-footer justify-content-between" style="background:#f8fafc">
                    <span class="text-muted small">
                        @if (_filtered.Count > 0)
                        {
                            <text>@_filtered.Count plantilla@(_filtered.Count != 1 ? "s" : "")</text>
                        }
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Close">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_selected is null)"
                                @onclick="Confirm">
                            <i class="bi bi-plus-circle me-1"></i>
                            Agregar líneas
                            @if (_selected is not null)
                            {
                                <span class="badge bg-white text-primary rounded-pill ms-1"
                                      style="font-size:.65rem">
                                    @_selected.Lineas.Count
                                </span>
                            }
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

@code {
    // ?? Parameters ????????????????????????????????????????????????????????????

    /// <summary>
    /// Se invoca al confirmar la selección.
    /// Recibe la lista de líneas de la plantilla elegida.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<List<PlantillaContableLineaDto>> OnSeleccionar { get; set; }

    // ?? State ?????????????????????????????????????????????????????????????????

    private bool _visible;
    private bool _loading;
    private string? _error;
    private string _search = string.Empty;

    private List<PlantillaContableDto> _plantillas = new();
    private List<PlantillaContableDto> _filtered   = new();
    private PlantillaContableDto?      _selected;
    private int                        _hovered;

    // ?? Public API ????????????????????????????????????????????????????????????

    /// <summary>Abre el modal y carga las plantillas.</summary>
    public async Task OpenAsync()
    {
        _visible  = true;
        _search   = string.Empty;
        _selected = null;
        _error    = null;
        StateHasChanged();

        await LoadPlantillasAsync();
    }

    // ?? Internals ?????????????????????????????????????????????????????????????

    private async Task LoadPlantillasAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _plantillas = await PlantillaService.GetAllAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _error = $"Error al cargar plantillas: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _search = string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _filtered = _plantillas.Where(p => p.Activo).ToList();
            return;
        }
        var term = _search.Trim();
        _filtered = _plantillas
            .Where(p => p.Activo &&
                        (p.Nombre.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                         p.Codigo.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                         (p.Descripcion?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)))
            .ToList();
    }

    private void SelectPlantilla(PlantillaContableDto p)
    {
        _selected = _selected?.PlantillaContableId == p.PlantillaContableId ? null : p;
    }

    private async Task Confirm()
    {
        if (_selected is null) return;

        var lineas = _selected.Lineas
            .OrderBy(l => l.NumeroLinea)
            .ToList();

        Close();
        await OnSeleccionar.InvokeAsync(lineas);
    }

    private void Close()
    {
        _visible  = false;
        _selected = null;
        _search   = string.Empty;
    }

    private void OnBackdropClick() => Close();
}
