@namespace AgoraHub360.ERP.Web.Components.Common

<MudPaper Elevation="1" Class="pa-6 mb-6">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <MudText Typo="@Typo.subtitle1" Class="mud-text-primary font-weight-semibold">@Title</MudText>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="@Typo.caption" Class="mud-text-secondary mt-1">@Subtitle</MudText>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="d-flex align-items-center gap-2">
                    @Actions
                </div>
            }
        </div>
    }
    <div>
        @ChildContent
    </div>
</MudPaper>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
