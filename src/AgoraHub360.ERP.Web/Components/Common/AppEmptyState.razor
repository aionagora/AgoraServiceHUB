@namespace AgoraHub360.ERP.Web.Components.Common

<MudPaper Elevation="0" Class="d-flex flex-column align-items-center justify-content-center pa-12">
    <MudIcon Icon="@Icon" Size="@Size.Large" Class="mud-text-disabled mb-4" Style="font-size: 3rem !important; opacity: 0.5;" />
    <MudText Typo="@Typo.h6" Class="mud-text-secondary mb-1">@Title</MudText>
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="@Typo.body2" Class="mud-text-disabled mb-4">@Description</MudText>
    }
    @if (Actions is not null)
    {
        <div class="mt-2">
            @Actions
        </div>
    }
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "No hay datos disponibles";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public RenderFragment? Actions { get; set; }
}
