@namespace AgoraHub360.ERP.Web.Components.Common

<MudPaper Elevation="0" Class="d-flex flex-column align-items-center justify-content-center pa-12">
    <MudProgressCircular Indeterminate="true" Color="@Color.Primary" Size="@Size.Large" />
    <MudText Typo="@Typo.body2" Class="mud-text-secondary mt-4">
        @Message
    </MudText>
</MudPaper>

@code {
    [Parameter] public string Message { get; set; } = "Cargando datos...";
}
