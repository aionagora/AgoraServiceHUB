@namespace AgoraHub360.ERP.Web.Components.Common

<MudPaper Elevation="0" Class="d-flex align-items-center justify-content-between mb-6 pb-4" Style="border-bottom: 1px solid var(--mud-palette-lines-default);">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <MudIcon Icon="@Icon" Size="@Size.Medium" Color="@Color.Primary" />
        }
        <div>
            <MudText Typo="@Typo.h4" Class="mb-0">@Title</MudText>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <MudText Typo="@Typo.body2" Class="mud-text-secondary mt-1">@Subtitle</MudText>
            }
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex align-items-center gap-2">
            @Actions
        </div>
    }
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
