@namespace AgoraHub360.ERP.Web.Components.Layout

@if (Items is not null && Items.Any())
{
    <MudBreadcrumbs Class="mb-4">
        @foreach (var item in Items)
        {
            <MudLink Href="@item.Href" Typo="@Typo.body2" Class="mud-breadcrumb-link">@item.Title</MudLink>
            @if (item != Items.Last())
            {
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="@Size.Small" Class="mud-breadcrumb-separator" />
            }
        }
    </MudBreadcrumbs>
}

@code {
    [Parameter] public List<BreadcrumbItem> Items { get; set; } = new();

    public record BreadcrumbItem(string Title, string? Href = null);
}
