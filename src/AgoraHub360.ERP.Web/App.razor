<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <div class="text-center py-5">
                                <i class="bi bi-shield-exclamation" style="font-size: 3rem; color: var(--agora-warning);"></i>
                                <h3 class="mt-3">Acceso denegado</h3>
                                <p class="text-muted">No tiene permisos para acceder a esta página.</p>
                                <a href="" class="btn btn-primary">Volver al Dashboard</a>
                            </div>
                        </LayoutView>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Verificando autenticación...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrado - AgoraHub360</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="text-center py-5">
                    <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: var(--agora-warning);"></i>
                    <h3 class="mt-3">Pagina no encontrada</h3>
                    <p class="text-muted">La ruta solicitada no existe.</p>
                    <a href="" class="btn btn-primary">Volver al Dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
