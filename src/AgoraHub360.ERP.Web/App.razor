<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>No encontrado - AgoraHub360</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="text-center py-5">
                <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: var(--agora-warning);"></i>
                <h3 class="mt-3">Pagina no encontrada</h3>
                <p class="text-muted">La ruta solicitada no existe.</p>
                <a href="" class="btn btn-primary">Volver al Dashboard</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
